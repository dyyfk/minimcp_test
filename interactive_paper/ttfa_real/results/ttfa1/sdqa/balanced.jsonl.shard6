{"id": "sdqa0087", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1883638280, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How many lanes does the autobahn have?", "input_path": "/data/sdqa_audio/sdqa0087.wav", "input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "input_samples": 86693, "input_s": 5.418, "n_real_chunks": 6, "score": 0.7878, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "The Autobahn is not a single road but rather a network of highways across Germany, so it doesn't have one standard number of lanes. However, most sections are designed with multiple lanes in each direction to accommodate high traffic volumes and speeds.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_balanced_local.wav", "sha256": "2ae3f6fff15f5902a2d0fea81fc11c7b91bdcd6d76281b0936c32cdb91ef3cfb", "sr": 24000, "seconds": 15.28}}, "chunks": [[0, 1, 1.0, 1.061, 1.109, 1, 0, 0], [1, 1, 2.0, 2.06, 2.108, 1, 0, 0], [2, 1, 3.0, 3.062, 3.11, 1, 0, 0], [3, 1, 4.0, 4.065, 4.116, 1, 0, 0], [4, 1, 5.0, 5.064, 5.119, 1, 0, 0], [5, 1, 5.418, 5.477, 6.047, 0, 24000, 0], [6, 0, 6.418, 6.48, 7.105, 0, 24000, 0], [7, 0, 7.418, 7.48, 8.025, 0, 24000, 0], [8, 0, 8.418, 8.482, 9.022, 0, 24000, 0], [9, 0, 9.418, 9.482, 10.075, 0, 24000, 0], [10, 0, 10.418, 10.483, 11.0