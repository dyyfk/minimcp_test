{"id": "sdqa0109", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1592117040, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is Emmanouil Pappas known for?", "input_path": "/data/sdqa_audio/sdqa0109.wav", "input_sha256": "cd86ad4118c5bc5c85121d73b0df2a3f4d73b9b9a95b6fe05126fbae83223506", "input_samples": 71959, "input_s": 4.497, "n_real_chunks": 5, "score": 0.815, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Immanuel Pappas — more commonly spelled Emmanouel Pappas — is known as a Greek revolutionary leader in the Greek War of Independence, especially for leading and financing the 1821 uprising in Macedonia/Chalkidiki against Ottoman rule. He was also a wealthy merchant and member of the Filiki Etaireia. (en.wikipedia.org)", "expert_answer": "Immanuel Pappas — more commonly spelled **Emmanouel Pappas** — is known as a **Greek revolutionary leader in the Greek War of Independence**, especially for leading and financing the 1821 uprising in **Macedonia/Chalkidiki** against Ottoman rule. He was also a wealthy merchant and member of the **Filiki Etaireia**. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Emmanouel_Pappas?utm_source=openai))", "transcript": "What is Immanuel Pappas known for?\n", "asr_s": 0.72, "expert_s": 3.95, "expert_input_samples": 71959, "expert_input_s": 4.497, "expert_input_sha256": "cd86ad4118c5bc5c85121d73b0df2a3f4d73b9b9a95b6fe05126fbae83223506", "expert_timed_out": false, "wait_s": 3.391, "relay_synth_ms": 10878, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio