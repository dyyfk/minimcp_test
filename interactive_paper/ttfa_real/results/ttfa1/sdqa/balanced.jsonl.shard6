{"id": "sdqa0077", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4158527175, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the difference between speed and velocity?", "input_path": "/data/sdqa_audio/sdqa0077.wav", "input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "input_samples": 86352, "input_s": 5.397, "n_real_chunks": 6, "score": 0.0903, "act": 0.9976, "is_info": true, "fired": false, "mode": "local", "answer": "Speed is a measure of how fast something moves, while velocity also takes direction into account. So if you're driving at 6 0 miles per hour north, your speed is 6 0 mph, but your velocity is 6 0 mph north. They are similar, but velocity gives you more information about where you're going.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077_balanced_local.wav", "sha256": "9906a09a04fa0c8a90f166578e64f66638826c391935534beb45c64a8c7e47d7", "sr": 24000, "seconds": 16.04}}, "chunks": [[0, 1, 1.0, 1.062, 1.11, 1, 0, 0], [1, 1, 2.0, 2.058, 2.105, 1, 0, 0], [2, 1, 3.0, 3.063, 3.112, 1, 0, 0], [3, 1, 4.0, 4.063, 4.115, 1, 0, 0], [4, 1, 5.0, 5.066, 5.119, 1, 0, 0], [5, 1, 5.397, 5.461, 6.068, 0, 24000, 0], [6, 0, 6.397, 6.459, 7.021, 0, 24000, 0], [7, 0, 7.397, 7.464, 8.087, 0, 24000, 0], [8, 0, 8.397, 8.466, 9.033, 0, 24000, 0], [9, 0, 9.397, 9.465