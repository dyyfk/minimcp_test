{"id": "sdqa0112", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3492556793, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "When was the Epic of Gilgamesh discovered?", "input_path": "/data/sdqa_audio/sdqa0112.wav", "input_sha256": "05bd68ecbbdb974b8fb7a36cba81377d668b5c56daac3c3b6a7f3f9e1fb11d0b", "input_samples": 82256, "input_s": 5.141, "n_real_chunks": 6, "score": 0.439, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The Epic of Gil gamish was discovered in the 19 th century, around the mid-18 00s. Schol ars found clay tablet s in ancient cities like Nineveh in Iraq. These tablets were written in cune form script and contained story fragments from a much older time, dating back to around 2000 BC. Over time, researchers pie ced together these table ts to understand the full epic tale. So, while the story itself is thousands of years old, we only started finding it and learning about it in the 1800s.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 28, "feed_lag_max_ms": 558, "feed_lag_sum_ms": 809, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0112_conservative_local.wav", "sha256": "24e1e968841d19e5ace62ba3bce225133e140225d1317cea0729a2148cd87484", "sr": 24000, "seconds": 27.76}}, "chunks": [[0, 1, 1.0, 1.07, 1.122, 1, 0, 0], [1, 1, 2.0, 2.065, 2.118, 1, 0, 0], [2, 1, 3.0, 3.065, 3.116, 1, 0, 0], [3, 1, 4.0, 4.064, 4.114, 1, 0, 0], [4, 1, 5.0, 5.06