{"id": "sdqa0077", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4158527175, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the difference between speed and velocity?", "input_path": "/data/sdqa_audio/sdqa0077.wav", "input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "input_samples": 86352, "input_s": 5.397, "n_real_chunks": 6, "score": 0.0903, "act": 0.9976, "is_info": true, "fired": false, "mode": "local", "answer": "Speed is a measure of how fast something moves, while velocity also takes direction into account. So if you're driving at 6 0 miles per hour north, your speed is 6 0 mph, but your velocity is 6 0 mph north. They are similar, but velocity gives you more information about where you're going.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077_conservative_local.wav", "sha256": "69b89cae1469df9e13d7beb2b05ef023db4cde269b44e7b436a337fd2d02fbe3", "sr": 24000, "seconds": 16.04}}, "chunks": [[0, 1, 1.0, 1.049, 1.088, 1, 0, 0], [1, 1, 2.0, 2.049, 2.088, 1, 0, 0], [2, 1, 3.0, 3.049, 3.088, 1, 0, 0], [3, 1, 4.0, 4.05, 4.091, 1, 0, 0], [4, 1, 5.0, 5.05, 5.09, 1, 0, 0], [5, 1, 5.397, 5.449, 5.942, 0, 24000, 0], [6, 0, 6.397, 6.448, 6.906, 0, 24000, 0], [7, 0, 7.397, 7.452, 7.929, 0, 24000, 0], [8, 0, 8.397, 8.448, 8.881, 0, 24000, 0], [9, 0, 9.