9, 0, 24000, 0], [45, 0, 45.399, 45.462, 45.969, 0, 24000, 0], [46, 0, 46.399, 46.459, 46.783, 0, 16320, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.399, "last_real_feed_done": 4.454, "onset": 4.948, "gate_read_done": 4.948, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.948, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.948, "first_answer_pcm": 4.948, "session_end": 46.783}, "ttfa_answer_s": 0.549, "ttfa_any_s": 0.549}
{"id": "sdqa0110", "pool": "sdqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1042435797, "protocol": "ttfa-v3", "config_sha256": "dc9d95c8617de77ddb5971c8746f5327f6cd47b10e39975e824f2c8f1acf9b9a", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Who old is the Angel Oak in South Carolina?", "input_path": "/data/sdqa_audio/sdqa0110.wav", "input_sha256": "4a3ee421eedb191e0f116ff620dee77dd1904783059f19f30ca9850ccada11a6", "input_samples": 93520, "input_s": 5.845, "n_real_chunks": 6, "score": 0.5399, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The Angel Oak in South Carolina is estimated to be between 4 00 and 600 years old, making it one of the oldest living things on the East Coast. Its exact age isn't certain because precise dating methods for such ancient trees are challenging, but experts believe it was likely planted around the time of European contact with North America, somewhere between the late 15th century and early 16th century.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 20, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0110_local_local.wav", "sha256": "7127571a488332e5b04246cc54fddd02e1f241c6af28c0527dd957adf6e375e2", "sr": 24000, "seconds": 20.28}}, "chunks": [[0, 1, 1.0, 1.054, 1.099, 1, 0, 0], [1, 1, 2.0, 2.059, 2.105, 1, 0, 0], [2, 1, 3.0, 3.057, 3.102, 1, 0, 0], [3, 1, 4.0, 4.057, 4.105, 1, 0, 0], [4, 1, 5.0, 5.055, 5.099, 1, 0, 0], [5, 1, 5.845, 5.9, 6.396, 0, 24000, 0], [6, 0, 6.845, 6.903, 7.39, 0, 24000, 0], [7, 0, 7.845, 7.9, 8.