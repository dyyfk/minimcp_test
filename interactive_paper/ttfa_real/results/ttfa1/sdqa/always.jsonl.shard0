{"id": "sdqa0052", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3045228746, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is the biggest cricket competition?", "input_path": "/data/sdqa_audio/sdqa0052.wav", "input_sha256": "9bacbac5b824f405ad58e6cf57474605388a5ba5e9fd633c403436ddddc7ad13", "input_samples": 64891, "input_s": 4.056, "n_real_chunks": 5, "score": 0.3104, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The biggest cricket competition is the ICC Cricket World Cup — the main international One Day International (ODI) tournament held every four years.", "expert_answer": "The **biggest cricket competition is the ICC Cricket World Cup** — the main international **One Day International (ODI)** tournament held every four years.", "transcript": "What is the biggest cricket competition?\n", "asr_s": 0.64, "expert_s": 1.76, "expert_input_samples": 64000, "expert_input_s": 4.0, "expert_input_sha256": "4e44613c39c29386ee7b5702254cc9be66bfdf861ab5e21e9d748e2933885438", "expert_timed_out": false, "wait_s": 1.562, "relay_synth_ms": 4951, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0052_always_relay.wav", "sha256": "6d62118e2a4aff212cb28963e5239bf57c043d1733b536571e98ff4afbda65bc", "sr": 24000, "seconds": 8.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0052_always_candidate.wav", "sha256": "1c1e6a1d5b9286459d88d837800ea98da150f03c3fcddc6004767e9f5d7a60d7", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0052_always_stall.wav", "sha256": "c18