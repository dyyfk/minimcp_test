{"id": "sdqa0040", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1117245607, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "When was the Argentine Basketball Federation formed?", "input_path": "/data/sdqa_audio/sdqa0040.wav", "input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "input_samples": 92496, "input_s": 5.781, "n_real_chunks": 6, "score": 0.8074, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Argentine Basketball Federation — now the Confederación Argentina de Básquetbol (CAB) — was formed on August 30, 1929. (argentina.basketball)", "expert_answer": "The Argentine Basketball Federation — now the **Confederación Argentina de Básquetbol (CAB)** — was formed on **August 30, 1929**. ([argentina.basketball](https://www.argentina.basketball/mision-y-valores?utm_source=openai))", "transcript": "When was the Argentine Basketball Federation formed?\n", "asr_s": 0.49, "expert_s": 4.44, "expert_input_samples": 92496, "expert_input_s": 5.781, "expert_input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "expert_timed_out": false, "wait_s": 3.791, "relay_synth_ms": 6307, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 216, "feed_lag_sum_ms": 216, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_always_relay.wav", "sha256": "768f53ebbd47e6e084f1d8b528246f114248918e423ee7bc50e9e8bc75a9136c", "sr": 24000, "seconds": 12.52}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_always_candidate.wav", "sha256": "6c04fbcdf8d07ed7fef3c14cef434061b3b6fc0f84f70bb854d377bdb6a6d877", "sr": 24000, "seconds": 1.