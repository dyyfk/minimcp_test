, 1, 3.0, 3.074, 3.131, 1, 0, 0], [3, 1, 3.179, 3.249, 4.014, 0, 24000, 0], [4, 0, 4.179, 4.747, 5.296, 0, 24000, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.179, "last_real_feed_done": 3.249, "onset": 4.014, "gate_read_done": 4.014, "fire": 4.014, "candidate_first_pcm": 4.014, "stall_note": 4.016, "stall_first_pcm": 4.671, "local_first_pcm": null, "wait_start": 5.296, "expert_req": 4.015, "expert_resp": 6.471, "relay_synth_start": 6.471, "relay_first_pcm": 7.309, "relay_synth_end": 10.157, "first_any_pcm": 4.014, "first_answer_pcm": 7.309, "session_end": 10.299}, "ttfa_answer_s": 4.13, "ttfa_any_s": 0.835}
{"id": "sdqa0184", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3901567365, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What's the largest recorded squid?", "input_path": "/data/sdqa_audio/sdqa0184.wav", "input_sha256": "4373c1e976a1d1ebc98058ad53eb5332ab09704d9b6078241a8bc62757cfbd94", "input_samples": 51877, "input_s": 3.242, "n_real_chunks": 4, "score": 0.6767, "act": 0.9987, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The largest recorded squid by mass is the colossal squid (Mesonychoteuthis hamiltoni): a specimen caught in the Ross Sea near Antarctica in 2007 weighed about 495 kg (1,091 lb) and measured 4.2 m (13 ft 9 in) after thawing. (guinnessworldrecords.com) If you mean longest, the giant squid (Architeuthis dux) holds that record, reliably reaching about 13 m (43 ft) in total length. (guinnessworldrecords.com)", "expert_answer": "The **largest recorded squid by mass** is the **colossal squid** (*Mesonychoteuthis hamiltoni*): a specimen caught in the Ross Sea near Antarctica in 2007 weighed about **495 kg (1,091 lb)** and measured **4.2 m (13 ft 9 in)** after thawing. ([guinnessworldrecords.com](https://www.guinnessworldrecords.com/world-records/69429-heaviest-colossal-squid?utm_source=openai))\n\nIf you mean **longest**, the **giant squid** (*Architeuthis dux*) holds that record, reliably reaching about **13 m (43 ft)** in total length. ([guinnessworldrecords.com](https://www.guinnessworldrecords.com/world-records/716793-largest-cephalopods?utm_source=openai))", "transcript": "What's the largest recorded squid?\n", "asr_s": 0.76, "expert_s": 5.39, "expert_input_samples": 51877, "expert_input_s": 3.242, "expert_input_sha256": "4373c1e976a1d1ebc98058ad53eb5332ab09704d9b6078241a8bc62757cfbd94", "expert_timed_out": false, "wait_s": 4.637, "relay_synth_ms": 20360, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0184_always_relay.wav", "sha256": "e54eeb0d6ea66ea0611bdc5cd7b606239755c45a44cab14c3f8afb42b405f7d7", "sr": 24000, "seconds": 35.52}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0184_always_stall.wav", "sha256": "468d4ed7036476c7e3bc27731826816443e61dd8534c000e6dc7e5be6cf4757c", "sr": 24000, "seconds": 2.44}}, "chunks": [[0, 1, 1.0, 1.069, 1.125, 1, 0, 0], [1, 1, 2.0, 2.071, 2.13, 1, 0, 0], [2, 1, 3.0, 3.074, 3.13, 1, 0, 0], [3, 1, 3.242, 3.315, 3.557, 0, 0, 0], [4, 0, 4.242, 4.317, 5.07, 0, 34560, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.242, "last_real_feed_done": 3.315, "onset": 3.557, "gate_read_done": 3.557, "fire": 3.557, "candidate_first_pcm": null, "stall_note": 3.558, "stall_first_pcm": 4.157, "local_first_pcm": null, "wait_start": 5.07, "expert_req": 3.558, "expert_resp": 9.707, "relay_synth_start": 9.707, "relay_first_pcm": 10.541, "relay_synth_end": 30.068, "first_any_pcm": 4.157, "first_answer_pcm": 10.541, "session_end": 30.272}, "ttfa_answer_s": 7.298, "ttfa_any_s": 0.915}
