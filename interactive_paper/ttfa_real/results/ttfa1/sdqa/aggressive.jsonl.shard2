{"id": "sdqa0122", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4211178554, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "How big can a thresher get?", "input_path": "/data/sdqa_audio/sdqa0122.wav", "input_sha256": "a37dd8d4297ca6abd195d1aefa09fadc2fe30515bb9bd1da012a90301a264603", "input_samples": 55554, "input_s": 3.472, "n_real_chunks": 4, "score": 0.7796, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "A thresher shark can get up to about 20 feet (6 meters) long, including its very long tail. The common thresher shark is the largest thresher species; much of its length comes from its tail fin, which can be nearly as long as the rest of its body.", "expert_answer": "A **thresher shark** can get up to about **20 feet (6 meters) long**, including its very long tail.\n\nThe **common thresher shark** is the largest thresher species; much of its length comes from its tail fin, which can be nearly as long as the rest of its body.", "transcript": "How big can a thresher get?\n", "asr_s": 0.68, "expert_s": 2.66, "expert_input_samples": 55554, "expert_input_s": 3.472, "expert_input_sha256": "a37dd8d4297ca6abd195d1aefa09fadc2fe30515bb9bd1da012a90301a264603", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 7119, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 5, "feed_lag_max_ms": 176, "feed_lag_sum_ms": 383, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0122_aggressive_relay.wav", "sha256": "dfa0a949e6572dc0cdb906f339720e96fdafc91752660114d7db1b1d904fd31c", "sr": 24000, "seconds": 16.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0122_aggressive_c