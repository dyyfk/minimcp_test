{"id": "sdqa0077", "pool": "sdqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4158527175, "protocol": "ttfa-v3", "config_sha256": "dc9d95c8617de77ddb5971c8746f5327f6cd47b10e39975e824f2c8f1acf9b9a", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the difference between speed and velocity?", "input_path": "/data/sdqa_audio/sdqa0077.wav", "input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "input_samples": 86352, "input_s": 5.397, "n_real_chunks": 6, "score": 0.0803, "act": 0.9973, "is_info": true, "fired": false, "mode": "local", "answer": "Speed is a measure of how fast something moves, while velocity also takes direction into account. So if you're driving at 6 0 miles per hour north, your speed is 6 0 mph, but your velocity is 6 0 mph north.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 12, "feed_lag_max_ms": 2719, "feed_lag_sum_ms": 15732, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077_local_local.wav", "sha256": "1bff849ed103e1d8b3d6e1d8014e9b597b4d131ff261602dc587f698ab594706", "sr": 24000, "seconds": 12.04}}, "chunks": [[0, 1, 1.0, 1.113, 1.206, 1, 0, 0], [1, 1, 2.0, 2.113, 2.204, 1, 0, 0], [2, 1, 3.0, 3.114, 3.205, 1, 0, 0], [3, 1, 4.0, 4.117, 4.213, 1, 0, 0], [4, 1, 5.0, 5.117, 5.211, 1, 0, 0], [5, 1, 5.397, 5.515, 6.707, 0, 24000, 0], [6, 0, 6.397, 6.826, 7.874, 0, 24000, 0], [7, 0, 7.397, 7.989, 9.085, 0, 24000, 0], [8, 0, 8.397, 9.202, 10.233, 0, 24000, 0], [9, 0, 9.397, 10.352, 11.447, 0, 24000, 0], [10, 0, 10.397, 11.567, 12.762, 0, 24000, 0], [11, 0, 11.397, 12.877, 14.