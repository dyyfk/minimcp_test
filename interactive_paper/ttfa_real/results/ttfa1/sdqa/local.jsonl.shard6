{"id": "sdqa0087", "pool": "sdqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1883638280, "protocol": "ttfa-v3", "config_sha256": "dc9d95c8617de77ddb5971c8746f5327f6cd47b10e39975e824f2c8f1acf9b9a", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How many lanes does the autobahn have?", "input_path": "/data/sdqa_audio/sdqa0087.wav", "input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "input_samples": 86693, "input_s": 5.418, "n_real_chunks": 6, "score": 0.7462, "act": 0.9996, "is_info": true, "fired": false, "mode": "local", "answer": "The Autobahn is not a single highway, but rather a network of highways throughout Germany. Its lane count varies widely depending on the specific stretch and location. In general, many sections have two to four lanes in each direction, with some more heavily trafficked areas having six or more lanes total. So there isn ’t one fixed number, but it typically ranges from two to six lane s per direction across different parts of the system.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 24, "feed_lag_max_ms": 4452, "feed_lag_sum_ms": 50613, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_local_local.wav", "sha256": "f9a5b9611bee164760bff2e731a77eefdd389b3ee81f922ec559e612c1ffca75", "sr": 24000, "seconds": 24.28}}, "chunks": [[0, 1, 1.0, 1.116, 1.209, 1, 0, 0], [1, 1, 2.0, 2.116, 2.21, 1, 0, 0], [2, 1, 3.0, 3.111, 3.201, 1, 0, 0], [3, 1, 4.0, 4.116, 4.211, 1, 0, 0], [4, 1, 5.0, 5.114, 5.208, 1, 0, 0], [5, 1, 5.418, 5.533, 6.51, 0, 24000, 0], [6, 0, 6.418, 6.628, 7.8