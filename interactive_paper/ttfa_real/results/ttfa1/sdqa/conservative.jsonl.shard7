t_real_feed_done": 4.235, "onset": 4.865, "gate_read_done": 4.866, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.865, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.865, "first_answer_pcm": 4.865, "session_end": 44.673}, "ttfa_answer_s": 0.706, "ttfa_any_s": 0.706}
{"id": "sdqa0100", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 658079636, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "How do thermostats work?", "input_path": "/data/sdqa_audio/sdqa0100.wav", "input_sha256": "a4f34bb1b84a9a1627361fd8d508b452490a1ed118152546bff6e44738aef8df", "input_samples": 70381, "input_s": 4.399, "n_real_chunks": 5, "score": 0.4681, "act": 0.9984, "is_info": true, "fired": false, "mode": "local", "answer": "So, the basic idea behind a thermostat is to control the temperature of a room by turning on or off a heating or cooling system. Here's how it works: First, there' s a sensor inside the thermo stat that measure s the current temperature of the room. Then, you set your desired temperature using the dial or digital display. When the room is colder than what you want, the thermo stat turns on the heat ing system to warm it up. Once the temperature reaches your set point, it turn s the heater off. If the room gets too hot, the thermo stat will switch on the cooling system, like an air conditioner, and turns it off when it cools down enough. Modern thermo stats can even learn your schedule and adjust automatically, making the home more comfortable and saving energy.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 36, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0100_conservative_local.wav", "sha256": "8d3540e5b52