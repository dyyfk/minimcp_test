, 12.532, 0, 24000, 0], [12, 0, 12.733, 12.819, 13.534, 0, 24000, 0], [13, 0, 13.733, 13.815, 14.456, 0, 24000, 0], [14, 0, 14.733, 14.81, 15.401, 0, 21120, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.733, "last_real_feed_done": 3.808, "onset": 4.317, "gate_read_done": 4.317, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.317, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.317, "first_answer_pcm": 4.317, "session_end": 15.401}, "ttfa_answer_s": 0.584, "ttfa_any_s": 0.584}
