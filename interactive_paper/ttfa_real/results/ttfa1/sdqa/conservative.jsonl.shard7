{"id": "sdqa0110", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1042435797, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Who old is the Angel Oak in South Carolina?", "input_path": "/data/sdqa_audio/sdqa0110.wav", "input_sha256": "4a3ee421eedb191e0f116ff620dee77dd1904783059f19f30ca9850ccada11a6", "input_samples": 93520, "input_s": 5.845, "n_real_chunks": 6, "score": 0.7366, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "The Angel O ak is estimated to be about 1, 500 years old. It' s considered one of the oldest living things in North America and stands as a remarkable symbol of endurance in South Carolina' s Congaree National Park.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0110_conservative_local.wav", "sha256": "6f08cd8f41c6eee4ec641beb353f2a306756816416c9438048211d6085191c9a", "sr": 24000, "seconds": 14.2}}, "chunks": [[0, 1, 1.0, 1.067, 1.123, 1, 0, 0], [1, 1, 2.0, 2.082, 2.145, 1, 0, 0], [2, 1, 3.0, 3.083, 3.153, 1, 0, 0], [3, 1, 4.0, 4.072, 4.138, 1, 0, 0], [4, 1, 5.0, 5.077, 5.14, 1, 0, 0], [5, 1, 5.845, 5.93, 6.376, 0, 24000, 0], [6, 0, 6.845, 6.915, 7.61, 0, 24000, 0], [7, 0, 7.845, 7.918, 8.583, 0, 24000, 0], [8, 0, 8.845, 8.918, 9.568, 0, 24000, 0], [9, 0, 9.845, 9.915, 10.618, 0, 24000, 0], [10, 0, 10.845, 10.916, 11.569, 0, 24000, 0], [11