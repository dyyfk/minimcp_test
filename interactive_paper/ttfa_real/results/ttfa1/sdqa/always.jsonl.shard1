{"id": "sdqa0070", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1773831012, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Who launched the first satellite?", "input_path": "/data/sdqa_audio/sdqa0070.wav", "input_sha256": "b41548b8e937876e006ff039e7446e2df09916ef7ba00e275ff7a41dd253fee7", "input_samples": 70650, "input_s": 4.416, "n_real_chunks": 5, "score": 0.4141, "act": 0.9994, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Soviet Union launched the first artificial satellite, Sputnik 1, on October 4, 1957.", "expert_answer": "The **Soviet Union** launched the first artificial satellite, **Sputnik 1**, on **October 4, 1957**.", "transcript": "Who launched the first satellite?\n", "asr_s": 0.53, "expert_s": 1.53, "expert_input_samples": 70650, "expert_input_s": 4.416, "expert_input_sha256": "b41548b8e937876e006ff039e7446e2df09916ef7ba00e275ff7a41dd253fee7", "expert_timed_out": false, "wait_s": 1.602, "relay_synth_ms": 3817, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0070_always_relay.wav", "sha256": "604124ede046ecaba9bd8ff323c13f0ab00e1466659c4496443b127719964686", "sr": 24000, "seconds": 7.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0070_always_candidate.wav", "sha256": "7eeb3a2f541a8369760783a2aba194b140bb3468ae4689816d2a1d1d343922ed", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0070_always_stall.wav", "sha256": "c776a296c732623c52de66a6d6e5203e579dc06a128aedb3ea155be2f3999328", "sr": 24000, "seconds": 0.96}}, "chunks": [[0, 1, 1.0, 1.061, 1.112, 1, 0, 0], [1, 1, 2.0, 2.061, 2.11, 1, 0, 0], [2, 1, 3.0, 3.063, 3.114, 1, 0, 0], [3, 1, 4.0, 4.063, 4.115, 1, 0, 0], [4, 1, 4.416, 4.477, 4.853, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.416, "last_real_feed_done": 4.477, "onset": 4.853, "gate_read_done": 4.853, "fire": 4.853, "candidate_first_pcm": 4.853, "stall_note": 4.854, "stall_first_pcm": 5.318, "local_first_pcm": null, "wait_start": 5.318, "expert_req": 4.854, "expert_resp": 6.919, "relay_synth_start": 6.919, "relay_first_pcm": 7.635, "relay_synth_end": 10.737, "first_any_pcm": 4.853, "first_answer_pcm": 7.635, "session_end": 10.863}, "ttfa_answer_s": 3.219, "ttfa_any_s": 0.438}
{"id": "sdqa0081", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2569383741, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "How is henna made?", "input_path": "/data/sdqa_audio/sdqa0081.wav", "input_sha256": "bf41949d74876151fb5491645c01c3881b4179cc01b67a3c7799ebc1fd528a37", "input_samples": 60069, "input_s": 3.754, "n_real_chunks": 4, "score": 0.4017, "act": 0.9978, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Henna is made from the leaves of the henna plant (Lawsonia inermis). The reddish-brown stain comes from lawsone, a natural pigment in the henna leaves that binds to keratin in skin and hair.", "expert_answer": "Henna is made from the **leaves of the henna plant** (*Lawsonia inermis*).\n\nBasic process:\n\n1. **Harvest the leaves** from the henna shrub.\n2. **Dry the leaves** thoroughly.\n3. **Grind them into a fine green powder**.\n4. To make henna paste, the powder is mixed with a liquid such as **water, lemon juice, or tea**, often with **sugar** and **essential oils** to improve texture and dye release.\n5. The paste is left to sit for several hours so the natural dye, **lawsone**, releases.\n6. It is then applied to skin, hair, or fabric.\n\nThe reddish-brown stain comes from **lawsone**, a natural pigment in the henna leaves that binds to keratin in skin and hair.", "transcript": "How is henna made?\n", "asr_s": 0.54, "expert_s": 3.75, "expert_input_samples": 60069, "expert_input_s": 3.754, "expert_input_sha256": "bf41949d74876151fb5491645c01c3881b4179cc01b67a3c7799ebc1fd528a37", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 6218, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 4, "feed_lag_max_ms": 334, "feed_lag_sum_ms": 882, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0081_always_relay.wav", "sha256": "193dc446f7da0ffaad671f9005362f51e57864add06c2bd3691ca78cf0a6c487", "sr": 24000, "seconds": 11.72}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0081_always_candidate.wav", "sha256": "d31420fda792e70a87eb9566c1eff1a4e4ce038bef496601260efe267bc5c493", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0081_always_stall.wav", "sha256": "ba30450b45f8ed13046305687d9ff24d96d495c9b433c2080184953211523961", "sr": 24000, "seconds": 5.28}}, "chunks": [[0, 1, 1.0, 1.059, 1.11, 1, 0, 0], [1, 1, 2.0, 2.063, 2.114, 1, 0, 0], [2, 1, 3.0, 3.066, 3.121, 1, 0, 0], [3, 1, 3.754, 3.82, 4.44, 0, 24000, 0], [4, 0, 4.754, 5.155, 5.936, 0, 24000, 0], [5, 0, 5.754, 5.998, 6.925, 0, 24000, 0], [6, 0, 6.754, 6.992, 7.951, 0, 24000, 0], [7, 0, 7.754, 8.02, 8.883, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.754, "last_real_feed_done": 3.82, "onset": 4.44, "gate_read_done": 4.44, "fire": 4.44, "candidate_first_pcm": 4.44, "stall_note": 4.44, "stall_first_pcm": 5.088, "local_first_pcm": null, "wait_start": 8.883, "expert_req": 4.44, "expert_resp": 8.733, "relay_synth_start": 8.883, "relay_first_pcm": 9.614, "relay_synth_end": 15.102, "first_any_pcm": 4.44, "first_answer_pcm": 9.614, "session_end": 15.253}, "ttfa_answer_s": 5.859, "ttfa_any_s": 0.685}
{"id": "sdqa0091", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2151587452, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "When was Buffy the Vampire Slayer aired?", "input_path": "/data/sdqa_audio/sdqa0091.wav", "input_sha256": "4a0614f8b58efb3accf5d044dafc2d9c07840a664b901647163581a44cf0889e", "input_samples": 89424, "input_s": 5.589, "n_real_chunks": 6, "score": 0.5789, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Buffy the Vampire Slayer aired on television from March 10, 1997, to May 20, 2003. It originally aired on The WB for seasons 1–5, then moved to UPN for seasons 6–7.", "expert_answer": "**Buffy the Vampire Slayer** aired on television from **March 10, 1997, to May 20, 2003**.\n\nIt originally aired on **The WB** for seasons 1–5, then moved to **UPN** for seasons 6–7.", "transcript": "When was Buffy the Vampire Slayer aired?\n", "asr_s": 0.64, "expert_s": 3.39, "expert_input_samples": 80000, "expert_input_s": 5.0, "expert_input_sha256": "eb71aa3f103e7fee6c7666808b41fea2153e1952cd69d20f97faad3f4d922def", "expert_timed_out": false, "wait_s": 3.342, "relay_synth_ms": 8221, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0091_always_relay.wav", "sha256": "e2c1347a4e810eb88148677c13d9142e3dbd9cb4ee3cd24aed5ac82dc354f63b", "sr": 24000, "seconds": 16.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0091_always_candidate.wav", "sha256": "07fe63ffb521fae4fc06e90e3f673d2a3e81e412e1a6663d427ff1f6fe33ca52", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0091_always_stall.wav", "sha256": "93c59572d67520ea1e21fe5a0a7ee28337ed24bc6bcafe3c98f1a630d0abb104", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.062, 1.113, 1, 0, 0], [1, 1, 2.0, 2.062, 2.113, 1, 0, 0], [2, 1, 3.0, 3.061, 3.11, 1, 0, 0], [3, 1, 4.0, 4.061, 4.112, 1, 0, 0], [4, 1, 5.0, 5.064, 5.635, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 5.589, "last_real_feed_done": null, "onset": 5.635, "gate_read_done": 5.635, "fire": 5.635, "candidate_first_pcm": 5.635, "stall_note": 5.636, "stall_first_pcm": 6.319, "local_first_pcm": null, "wait_start": 6.319, "expert_req": 5.636, "expert_resp": 9.66, "relay_synth_start": 9.661, "relay_first_pcm": 10.38, "relay_synth_end": 17.882, "first_any_pcm": 5.635, "first_answer_pcm": 10.38, "session_end": 18.032}, "ttfa_answer_s": 4.791, "ttfa_any_s": 0.046}
{"id": "sdqa0102", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3375832760, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "What was the world champion rugby team in 2018?", "input_path": "/data/sdqa_audio/sdqa0102.wav", "input_sha256": "ee6796e32537a56701a1b1b094c68c81828f311dce4e35aefd1f0b548ba3e924", "input_samples": 111514, "input_s": 6.97, "n_real_chunks": 7, "score": 0.8274, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "In 2018, the Rugby World Cup Sevens world champion was New Zealand. If you mean the 15-a-side Rugby World Cup, there was no tournament in 2018; the reigning men’s world champion at that time was also New Zealand, from the 2015 Rugby World Cup.", "expert_answer": "In **2018**, the **Rugby World Cup Sevens** world champion was **New Zealand**.\n\nIf you mean the 15-a-side **Rugby World Cup**, there was **no tournament in 2018**; the reigning men’s world champion at that time was also **New Zealand**, from the **2015 Rugby World Cup**.", "transcript": "What was the world champion rugby team in 2018?\n", "asr_s": 0.62, "expert_s": 3.93, "expert_input_samples": 111514, "expert_input_s": 6.97, "expert_input_sha256": "ee6796e32537a56701a1b1b094c68c81828f311dce4e35aefd1f0b548ba3e924", "expert_timed_out": false, "wait_s": 3.87, "relay_synth_ms": 8349, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0102_always_relay.wav", "sha256": "df3eae553267d6c6a8307e173834c7450f1f4f122c1ecf8e26ada26f586e0ab9", "sr": 24000, "seconds": 16.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sd