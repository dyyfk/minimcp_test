{"id": "sdqa0129", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1825809842, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "What bird lays the smallest egg?", "input_path": "/data/sdqa_audio/sdqa0129.wav", "input_sha256": "1d48bee7948cc643e72994e730071022a9da2c3ac026f3b58a3709302e67a0a0", "input_samples": 55891, "input_s": 3.493, "n_real_chunks": 4, "score": 0.718, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The bee hummingbird lays the smallest egg of any bird. Its egg is about the size of a coffee bean or pea, roughly 6–7 mm long, and weighs around 0.3 grams.", "expert_answer": "The **bee hummingbird** lays the smallest egg of any bird.\n\nIts egg is about the size of a **coffee bean or pea**, roughly **6–7 mm long**, and weighs around **0.3 grams**.", "transcript": "What bird lays the smallest egg?\n", "asr_s": 0.58, "expert_s": 2.6, "expert_input_samples": 55891, "expert_input_s": 3.493, "expert_input_sha256": "1d48bee7948cc643e72994e730071022a9da2c3ac026f3b58a3709302e67a0a0", "expert_timed_out": false, "wait_s": 2.268, "relay_synth_ms": 5801, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 174, "feed_lag_sum_ms": 174, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0129_always_relay.wav", "sha256": "29704d0c39043ab49009dac2e5b670ed542279c75a418c72cccbb06559fa0a05", "sr": 24000, "seconds": 12.2}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0129_always_candidate.wav", "sha256": "75543413b5f4546bcbe577ca13581433064f17f093a4fbc56110ae9d32f0b9ea", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0129_always_stall.wav",