f2184f7", "sr": 24000, "seconds": 1.72}}, "chunks": [[0, 1, 1.0, 1.096, 1.176, 1, 0, 0], [1, 1, 2.0, 2.084, 2.152, 1, 0, 0], [2, 1, 3.0, 3.096, 3.173, 1, 0, 0], [3, 1, 4.0, 4.104, 4.191, 1, 0, 0], [4, 1, 5.0, 5.086, 5.163, 1, 0, 0], [5, 1, 6.0, 6.091, 6.18, 1, 0, 0], [6, 1, 7.0, 7.097, 7.16, 1, 0, 0], [7, 1, 7.573, 7.76, 8.591, 0, 24000, 0], [8, 0, 8.573, 9.433, 10.04, 0, 17280, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 7.573, "last_real_feed_done": 7.76, "onset": 8.591, "gate_read_done": 8.592, "fire": 8.592, "candidate_first_pcm": 8.591, "stall_note": 8.593, "stall_first_pcm": 9.333, "local_first_pcm": null, "wait_start": 10.04, "expert_req": 8.593, "expert_resp": 10.582, "relay_synth_start": 10.582, "relay_first_pcm": 11.707, "relay_synth_end": 16.656, "first_any_pcm": 8.591, "first_answer_pcm": 11.707, "session_end": 16.846}, "ttfa_answer_s": 4.134, "ttfa_any_s": 1.018}
{"id": "sdqa0085", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2655546148, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is the difference between a telenovela and a soap opera?", "input_path": "/data/sdqa_audio/sdqa0085.wav", "input_sha256": "cf19fb990c40af08e344fadb40602b97f2d718ea2202d380ad47526baa2f1d98", "input_samples": 103418, "input_s": 6.464, "n_real_chunks": 7, "score": 0.3359, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "A telenovela is usually a limited-run serialized drama with a planned ending, while a soap opera is typically an open-ended continuing serial that can run indefinitely.", "expert_answer": "A **telenovela** is usually a **limited-run serialized drama** with a planned ending, while a **soap opera** is typically an **open-ended continuing serial** that can run indefinitely.\n\nKey differences:\n\n- **Length/structure:** Telenovelas often run for a fixed number of episodes or months; soap operas can continue for years or decades.\n- **Ending:** Telenovelas usually have a clear conclusion; soap operas often keep storylines ongoing.\n- **Pace:** Telenovelas tend to move faster, with major plot turns happening quickly.\n- **Origin/style:** Telenovelas are especially associated with Latin America and Spanish- or Portuguese-language TV; soap operas are strongly associated with U.S., British, and other daytime/evening serial traditions.\n- **Story focus:** Telenovelas often center on one main romantic or family conflict; soap operas usually follow many interwoven families and relationships over time.", "transcript": "What is the difference between a telenovela and a soap opera?\n", "asr_s": 0.67, "expert_s": 4.73, "expert_input_samples": 103418, "expert_input_s": 6.464, "expert_input_sha256": "cf19fb990c40af08e344fadb40602b97f2d718ea2202d380ad47526baa2f1d98", "expert_timed_out": false, "wait_s": 4.429, "relay_synth_ms": 7472, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0085_always_relay.wav", "sha256": "d1e16e5997a4afe4c89b7477de2b1d794e3bd6375842ab0d7fd65b75b4b96e8f", "sr": 24000, "seconds": 10.2}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0085_always_candidate.wav", "sha256": "e26bbe1ca1c3cb11d3866758a2a2b9885edd5b9864e86ecd9d5d033009f24755", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0085_always_stall.wav", "sha256": "49d4c043a6bfec5d5245cc898eb3717d9e65a553869ce404fffbbb2c6724406c", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.096, 1.177, 1, 0, 0], [1, 1, 2.0, 2.09, 2.167, 1, 0, 0], [2, 1, 3.0, 3.101, 3.2, 1, 0, 0], [3, 1, 4.0, 4.081, 4.16, 1, 0, 0], [4, 1, 5.0, 5.092, 5.169, 1, 0, 0], [5, 1, 6.0, 6.087, 6.16, 1, 0, 0], [6, 1, 6.464, 6.556, 7.481, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 6.464, "last_real_feed_done": 6.556, "onset": 7.481, "gate_read_done": 7.481, "fire": 7.481, "candidate_first_pcm": 7.481, "stall_note": 7.482, "stall_first_pcm": 8.448, "local_first_pcm": null, "wait_start": 8.448, "expert_req": 7.482, "expert_resp": 12.877, "relay_synth_start": 12.877, "relay_first_pcm": 13.856, "relay_synth_end": 20.35, "first_any_pcm": 7.481, "first_answer_pcm": 13.856, "session_end": 20.554}, "ttfa_answer_s": 7.392, "ttfa_any_s": 1.017}
