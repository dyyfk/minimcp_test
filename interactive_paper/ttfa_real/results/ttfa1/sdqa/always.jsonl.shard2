{"id": "sdqa0130", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 202648663, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is the CBS-affiliated TV station for Green Bay, WI?", "input_path": "/data/sdqa_audio/sdqa0130.wav", "input_sha256": "fc47f6abcaeb5916f5cf85ff516165125a48017c1512ca7c7a24ef36ee786fb4", "input_samples": 95270, "input_s": 5.954, "n_real_chunks": 6, "score": 0.7564, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The CBS affiliate for Green Bay, Wisconsin is WFRV-TV, branded as Local 5, on channel 5. (cbsnews.com)", "expert_answer": "The CBS affiliate for **Green Bay, Wisconsin** is **WFRV-TV**, branded as **Local 5**, on **channel 5**. ([cbsnews.com](https://www.cbsnews.com/news/cbs-tv-stations-affiliates/?utm_source=openai))", "transcript": "What is the CBS affiliated TV station for Green Bay, Wisconsin?\n", "asr_s": 0.71, "expert_s": 4.52, "expert_input_samples": 95270, "expert_input_s": 5.954, "expert_input_sha256": "fc47f6abcaeb5916f5cf85ff516165125a48017c1512ca7c7a24ef36ee786fb4", "expert_timed_out": false, "wait_s": 4.579, "relay_synth_ms": 4386, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0130_always_relay.wav", "sha256": "4491ab3c106d40c34ff3777c15ad6a088e94b357d0903c41a21860d973fef433", "sr": 24000, "seconds": 10.04}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0130_always_candidate.wav", "sha256": "f7455ef1bf288931ceb4539abfbc0919a373217b28405732a1cffdaa52b27dc6", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa