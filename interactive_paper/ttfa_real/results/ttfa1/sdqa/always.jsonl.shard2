{"id": "sdqa0194", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4053139652, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "When did the the Great Revolt start?", "input_path": "/data/sdqa_audio/sdqa0194.wav", "input_sha256": "65b51ae1b726e3a851c281c532e23b2d04c4150bb391e3415e36be132de1d2d7", "input_samples": 41202, "input_s": 2.575, "n_real_chunks": 3, "score": 0.8618, "act": 0.9938, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "If you mean the Green Revolt / Green Movement in Iran, it began in June 2009, immediately after Iran’s disputed presidential election held on June 12, 2009. Protests started the next day, June 13, 2009. If you meant the Green Revolution in agriculture, that began in the 1940s–1960s globally and in India in the mid-1960s.", "expert_answer": "If you mean the **Green Revolt / Green Movement in Iran**, it began **in June 2009**, immediately after Iran’s disputed presidential election held on **June 12, 2009**. Protests started the next day, **June 13, 2009**.\n\nIf you meant the **Green Revolution** in agriculture, that began in the **1940s–1960s globally** and in **India in the mid-1960s**.", "transcript": "When did the Green Revolt start?\n", "asr_s": 0.55, "expert_s": 6.01, "expert_input_samples": 41202, "expert_input_s": 2.575, "expert_input_sha256": "65b51ae1b726e3a851c281c532e23b2d04c4150bb391e3415e36be132de1d2d7", "expert_timed_out": false, "wait_s": 5.843, "relay_synth_ms": 10456, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0194_always_relay.wav", "sha256": "6bad8d87a76fecfd3ee2a291