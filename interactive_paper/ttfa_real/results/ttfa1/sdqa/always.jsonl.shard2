{"id": "sdqa0037", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2477970371, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "When was the Prohibition Era in the US?", "input_path": "/data/sdqa_audio/sdqa0037.wav", "input_sha256": "08faeca9cdf4b8a698dee2bd7a32cc2a3a1ddc0c91b262b89b7f19d2f747e2ec", "input_samples": 66826, "input_s": 4.177, "n_real_chunks": 5, "score": 0.2956, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Prohibition era in the U.S. lasted from January 17, 1920, to December 5, 1933. It began with enforcement of the 18th Amendment and ended when the 21st Amendment repealed it.", "expert_answer": "The **Prohibition era in the U.S.** lasted from **January 17, 1920, to December 5, 1933**. It began with enforcement of the **18th Amendment** and ended when the **21st Amendment** repealed it.", "transcript": "When was the Prohibition era in the U.S.?\n", "asr_s": 0.59, "expert_s": 1.68, "expert_input_samples": 66826, "expert_input_s": 4.177, "expert_input_sha256": "08faeca9cdf4b8a698dee2bd7a32cc2a3a1ddc0c91b262b89b7f19d2f747e2ec", "expert_timed_out": false, "wait_s": 1.357, "relay_synth_ms": 6523, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 92, "feed_lag_sum_ms": 92, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0037_always_relay.wav", "sha256": "adb8a91a266a1c4691fb1c2d174a7d7a83108913c494a16837eb5ae1b232f210", "sr": 24000, "seconds": 13.36}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0037_always_candidate.wav", "sha256": "4057395c08c0a73a45b3f69cf56b09c9ecf4d52d4e836f1222a8779bbdf0f13e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/