{"id": "sdqa0152", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3024153341, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "Why is heavy metal called heavy metal?", "input_path": "/data/sdqa_audio/sdqa0152.wav", "input_sha256": "1953709908b14c35f9515ae55e13bec6f493cad51d8d9ef75e63046cdbeb023e", "input_samples": 44727, "input_s": 2.795, "n_real_chunks": 3, "score": 0.5217, "act": 0.9985, "is_info": true, "fired": false, "mode": "local", "answer": "Well, the term heavy metal is actually a misnomer. It' s not really about the weight of the music or anything like that. It was originally used as a kind of joke back in the 1 9 60s and early 70s when people were trying to describe this new kind of loud, aggressive rock music that was emerging. And they started calling it things like heavy metal because it sounded so intense and powerful. So it's more of a play on words than anything else.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0152_aggressive_local.wav", "sha256": "cc06015ae0470c1060ee916c45be225cb180de106b77fa5555c67679d4e8a0ff", "sr": 24000, "seconds": 22.88}}, "chunks": [[0, 1, 1.0, 1.064, 1.111, 1, 0, 0], [1, 1, 2.0, 2.067, 2.122, 1, 0, 0], [2, 1, 2.795, 2.863, 2.912, 1, 0, 0], [3, 0, 3.795, 3.857, 4.507, 0, 24000, 0], [4, 0, 4.795, 4.857, 5.543, 0, 24000, 0], [5, 0, 5.795, 5.857, 6.51