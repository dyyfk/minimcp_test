{"id": "sdqa0143", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3663522602, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "What is the biggest event in the Australian Football League?", "input_path": "/data/sdqa_audio/sdqa0143.wav", "input_sha256": "2c53ab478bdbd6dbd835251108be447a92ed86e7d967603f20fcf0446aff4c78", "input_samples": 65100, "input_s": 4.069, "n_real_chunks": 5, "score": 0.6298, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The biggest event in the Australian Football League (AFL) is the AFL Grand Final. It is the championship match held at the end of the AFL season, traditionally played at the Melbourne Cricket Ground (MCG), and it determines the league premiership winner.", "expert_answer": "The biggest event in the **Australian Football League (AFL)** is the **AFL Grand Final**.\n\nIt is the championship match held at the end of the AFL season, traditionally played at the **Melbourne Cricket Ground (MCG)**, and it determines the league premiership winner.", "transcript": "What is the biggest event in the Australian Football League?\n", "asr_s": 0.63, "expert_s": 1.68, "expert_input_samples": 65100, "expert_input_s": 4.069, "expert_input_sha256": "2c53ab478bdbd6dbd835251108be447a92ed86e7d967603f20fcf0446aff4c78", "expert_timed_out": false, "wait_s": 1.636, "relay_synth_ms": 7248, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 43, "feed_lag_sum_ms": 43, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0143_aggressive_relay.wav", "sha256": "5233888cf5b7abfe6dc374d3d49d9fcf3061cb2c3e0365baa4f4ce607f9ebe7a", "sr": 24000, "seconds": 15.24