{"id": "sdqa0032", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3822593868, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "When were the Gallic Wars?", "input_path": "/data/sdqa_audio/sdqa0032.wav", "input_sha256": "246f703c3611290671ad0af6fcdc14b667686078b4b2fcc9f58bd1e53c836066", "input_samples": 57338, "input_s": 3.584, "n_real_chunks": 4, "score": 0.2735, "act": 0.9979, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Gaelic Wars is not a single standardly defined war with one fixed date range. It usually refers broadly to wars involving Gaelic peoples in Ireland and Scotland, especially from the medieval period through the early modern period. A common broad range is roughly c. 500 CE to 1746 CE, ending with the Battle of Culloden in Scotland. If you mean the Gaelic Irish wars against English/Tudor conquest in Ireland, those mainly occurred in the 16th and early 17th centuries, especially 1569–1603, ending with the Nine Years’ War in Ireland.", "expert_answer": "The **Gaelic Wars** is not a single standardly defined war with one fixed date range. It usually refers broadly to **wars involving Gaelic peoples in Ireland and Scotland**, especially from the **medieval period through the early modern period**.\n\nA common broad range is roughly **c. 500 CE to 1746 CE**, ending with the **Battle of Culloden** in Scotland.\n\nIf you mean the **Gaelic Irish wars against English/Tudor conquest in Ireland**, those mainly occurred in the **16th and early 17th centuries**, especially **1569–1603**, ending with the **Nine Years’ War in Ireland**.", "transcript": "When were the Gaelic Wars?\n", "asr_s": 0.45, "expert_s": 6.26, "expert_input_samples": 57338, "expert_input_s": 3.584, "expert_input_sha256": "246f703c3611290671ad0af6fcdc14b667686078b4b2fcc9f58bd1e53c836066", "expert_timed_out": false, "wait_s": 6.076, "relay_synth_ms": 17325, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0032_always_relay.wav", "sha256": "4d3d556cdad5294f4f86770f64ca781be2c5cbf14bf59a864e1592b08e8269ef", "sr": 24000, "seconds": 38.76}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0032_always_stall.wav", "sha256": "518b71c3b687ba1203c4b1788451bb2901f0cb460fb86d7f339841e1a68baae6", "sr": 24000, "seconds": 1.36}}, "chunks": [[0, 1, 1.0, 1.057, 1.103, 1, 0, 0], [1, 1, 2.0, 2.061, 2.108, 1, 0, 0], [2, 1, 3.0, 3.068, 3.117, 1, 0, 0], [3, 1, 3.584, 3.642, 3.786, 0, 0, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.584, "last_real_feed_done": 3.642, "onset": 3.786, "gate_read_done": 3.786, "fire": 3.786, "candidate_first_pcm": null, "stall_note": 3.787, "stall_first_pcm": 4.416, "local_first_pcm": null, "wait_start": 4.416, "expert_req": 3.787, "expert_resp": 10.492, "relay_synth_start": 10.493, "relay_first_pcm": 11.179, "relay_synth_end": 27.818, "first_any_pcm": 4.416, "first_answer_pcm": 11.179, "session_end": 27.987}, "ttfa_answer_s": 7.595, "ttfa_any_s": 0.832}
