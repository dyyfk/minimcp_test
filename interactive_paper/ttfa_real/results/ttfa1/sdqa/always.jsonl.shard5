{"id": "sdqa0116", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3611421664, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "Who was the youngest WWE Champion?", "input_path": "/data/sdqa_audio/sdqa0116.wav", "input_sha256": "6b3f1d33d9799febc25b4f0086836888d36127cbe254d64d1d3dd2bbad1fafb8", "input_samples": 95936, "input_s": 5.996, "n_real_chunks": 6, "score": 0.8309, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The youngest WWE Champion was Brock Lesnar, who won the WWE Championship at 25 years old on August 25, 2002, by defeating The Rock at SummerSlam. If you mean youngest world champion in WWE history, that was Randy Orton, who won the World Heavyweight Championship at 24 in 2004.", "expert_answer": "The youngest **WWE Champion** was **Brock Lesnar**, who won the WWE Championship at **25 years old** on **August 25, 2002**, by defeating The Rock at SummerSlam.\n\nIf you mean youngest **world champion in WWE history**, that was **Randy Orton**, who won the World Heavyweight Championship at **24** in 2004.", "transcript": "Who was the youngest WWE champion?\n", "asr_s": 0.84, "expert_s": 4.42, "expert_input_samples": 95936, "expert_input_s": 5.996, "expert_input_sha256": "6b3f1d33d9799febc25b4f0086836888d36127cbe254d64d1d3dd2bbad1fafb8", "expert_timed_out": false, "wait_s": 4.632, "relay_synth_ms": 9446, "onset_chunk": 6, "eot_seen": true, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0116_always_relay.wav", "sha256": "87d86de607bd861bd4ea01ad8d8e1b0895ec8c55163c8783845df86d27715244", "sr": 24000, "seconds": 20.48}, "candidate": {"p