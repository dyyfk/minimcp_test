{"id": "sdqa0143", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3663522602, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "What is the biggest event in the Australian Football League?", "input_path": "/data/sdqa_audio/sdqa0143.wav", "input_sha256": "2c53ab478bdbd6dbd835251108be447a92ed86e7d967603f20fcf0446aff4c78", "input_samples": 65100, "input_s": 4.069, "n_real_chunks": 5, "score": 0.6298, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The biggest event in the Australian Football League (AFL) is the AFL Grand Final. It is the championship-deciding match of the AFL season, traditionally held at the Melbourne Cricket Ground (MCG), and is one of Australia’s major sporting events.", "expert_answer": "The biggest event in the **Australian Football League (AFL)** is the **AFL Grand Final**.\n\nIt is the championship-deciding match of the AFL season, traditionally held at the **Melbourne Cricket Ground (MCG)**, and is one of Australia’s major sporting events.", "transcript": "What is the biggest event in the Australian Football League?\n", "asr_s": 0.88, "expert_s": 1.81, "expert_input_samples": 65100, "expert_input_s": 4.069, "expert_input_sha256": "2c53ab478bdbd6dbd835251108be447a92ed86e7d967603f20fcf0446aff4c78", "expert_timed_out": false, "wait_s": 2.089, "relay_synth_ms": 6725, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 35, "feed_lag_sum_ms": 35, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0143_always_relay.wav", "sha256": "bad2b31a952bbcc03ea32bf028e5e9c5ec62ba88fa2522d100304b50e795b3e0", "sr": 24000, "seconds": 15.28}, "candidate": {"path": "/data/ttfa_real/tt