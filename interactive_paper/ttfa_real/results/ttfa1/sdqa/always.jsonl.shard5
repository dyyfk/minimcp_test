{"id": "sdqa0125", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1701177753, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "When was Albany, NY established?", "input_path": "/data/sdqa_audio/sdqa0125.wav", "input_sha256": "c8d367080629d35783c03f64f2aab3d695b83f456b5546d884f9b56e208b5f85", "input_samples": 62425, "input_s": 3.902, "n_real_chunks": 4, "score": 0.3475, "act": 0.9987, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Albany, New York was established as a city in 1686 when it received its city charter. It was originally settled earlier by the Dutch, with Fort Nassau built in 1614 near the site.", "expert_answer": "**Albany, New York was established as a city in 1686** when it received its city charter.\n\nIt was originally settled earlier by the Dutch, with Fort Nassau built in **1614** near the site.", "transcript": "When was Albany, New York established?\n", "asr_s": 0.83, "expert_s": 2.91, "expert_input_samples": 62425, "expert_input_s": 3.902, "expert_input_sha256": "c8d367080629d35783c03f64f2aab3d695b83f456b5546d884f9b56e208b5f85", "expert_timed_out": false, "wait_s": 2.281, "relay_synth_ms": 5858, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 251, "feed_lag_sum_ms": 251, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0125_always_relay.wav", "sha256": "808ffc9f5ad898d5068bbf9696a351ce0b0380b840c6fac729e2783e0bc4f828", "sr": 24000, "seconds": 12.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0125_always_candidate.wav", "sha256": "a78a150d891e9efab81139f09dfb94aa1e8ca3346d934cbe2802a55b5c3972b5", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa