{"id": "sdqa0095", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2270386789, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Where is the Meyer lemon from?", "input_path": "/data/sdqa_audio/sdqa0095.wav", "input_sha256": "d76b8394e88822dd4fda0346b71047e52214a089a0786f3dfcd9e5770eb3b40b", "input_samples": 76112, "input_s": 4.757, "n_real_chunks": 5, "score": 0.8638, "act": 0.999, "is_info": true, "fired": false, "mode": "local", "answer": "The Meyer lemon is a variety of lemon that originated in California. It' s believed to have been developed in the early 20th century and named after an individual or family associated with its cultivation. So, it's from California.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0095_conservative_local.wav", "sha256": "d79021abbd402de305b25677bd37a9f243f5eecb60e6cfcd281084b6113814df", "sr": 24000, "seconds": 14.36}}, "chunks": [[0, 1, 1.0, 1.066, 1.122, 1, 0, 0], [1, 1, 2.0, 2.067, 2.118, 1, 0, 0], [2, 1, 3.0, 3.068, 3.12, 1, 0, 0], [3, 1, 4.0, 4.07, 4.122, 1, 0, 0], [4, 1, 4.757, 4.825, 5.019, 0, 0, 0], [5, 0, 5.757, 5.824, 6.396, 0, 24000, 0], [6, 0, 6.757, 6.821, 7.438, 0, 24000, 0], [7, 0, 7.757, 7.823, 8.425, 0, 24000, 0], [8, 0, 8.757, 8.825, 9.401, 0, 24000, 0], [9, 0, 9.757, 9.827, 10.516, 0, 24000, 0], [10, 0, 10.757, 10.823, 11.403, 0, 24000, 0], [11, 0, 11.757, 11.825, 12.529, 0, 24000, 0], [12, 0, 12.757, 12.823, 13.378, 0, 24000, 0], [13, 0, 13.757, 13.829, 14.444, 0, 24000, 0], [14, 0, 14.757, 14.827, 15.407, 0, 24000, 0], [15, 0, 15.757, 15.829, 16.523, 0, 24000, 0], [16, 0, 16.757, 16.831, 17.471, 0, 24000, 0], [17, 0, 17.757, 17.833, 18.455, 0, 24000, 0], [18, 0, 18.757, 18.838, 19.672, 0, 32640, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.757, "last_real_feed_done": 4.825, "onset": 5.019, "gate_read_done": 5.019, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 6.396, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 6.396, "first_answer_pcm": 6.396, "session_end": 19.672}, "ttfa_answer_s": 1.639, "ttfa_any_s": 1.639}
{"id": "sdqa0104", "pool": "sdqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 542423949, "protocol": "ttfa-v3", "config_sha256": "090c2d92c356947a63016f36b07b41f7e50a5af6eb8978ebb4bd17bc3458e59b", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What is a motor tic?", "input_path": "/data/sdqa_audio/sdqa0104.wav", "input_sha256": "7b3a62a04f0793fc567b2f80e5b918eeaa7453b7d88fd2a018d2a33fe8151311", "input_samples": 60752, "input_s": 3.797, "n_real_chunks": 4, "score": 0.6576, "act": 0.9972, "is_info": true, "fired": false, "mode": "local", "answer": "A motor tick is a small, rhythmic sound that some people hear coming from their car's engine while it' s running. It's often described as a light tapping or clicking noise. This can happen when the engine is idling or moving slowly. In many cases, a motor tick isn't serious and might just be normal engine operation, especially in older vehicles. However, if the sound gets louder or changes, it could indicate an issue like worn spark plugs, valve problems, or low oil levels. If you notice this tick regularly, it's usually a good idea to have your car checked by a mechanic to make sure everything is working properly.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 36, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0104_conservative_local.wav", "sha256": "dcde0c79ac04954932101188980da66d746b96332d0afdaf5010c805019fce53", "sr": 24000, "seconds": 34.6}}, "chunks": [[0, 1, 1.0, 1.071, 1.126, 1, 0, 0], [1, 1, 2.0, 2.074,