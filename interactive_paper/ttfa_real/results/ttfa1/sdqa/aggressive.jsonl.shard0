{"id": "sdqa0099", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2397378126, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Where in Ireland was Skeffington born?", "input_path": "/data/sdqa_audio/sdqa0099.wav", "input_sha256": "bb061f115359eebac0abc9adaf7ffa49dc522994091f77f5d3468eeef421786f", "input_samples": 87376, "input_s": 5.461, "n_real_chunks": 6, "score": 0.9089, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Francis Sheehy-Skeffington was born in Bailieborough, County Cavan, Ireland. (cavancoco.ie)", "expert_answer": "Francis Sheehy-Skeffington was born in **Bailieborough, County Cavan, Ireland**. ([cavancoco.ie](https://www.cavancoco.ie/library/cavan-history/cavan-local-studies/cavan-biography/francis-sheehy-skeffington/?utm_source=openai))", "transcript": "Where in Ireland was Skeffington born?\n", "asr_s": 0.59, "expert_s": 5.38, "expert_input_samples": 87376, "expert_input_s": 5.461, "expert_input_sha256": "bb061f115359eebac0abc9adaf7ffa49dc522994091f77f5d3468eeef421786f", "expert_timed_out": false, "wait_s": 5.15, "relay_synth_ms": 3046, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0099_aggressive_relay.wav", "sha256": "59d77253db3ed5d036d30a8baacdb11fef033d6024a817c016da5d93d4f11998", "sr": 24000, "seconds": 6.24}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0099_aggressive_candidate.wav", "sha256": "24d9d40daa1a73dc1388a7580379e8a3d247bc8b32d15999407786aca1563cf4", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audi