{"id": "sdqa0040", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1117245607, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "When was the Argentine Basketball Federation formed?", "input_path": "/data/sdqa_audio/sdqa0040.wav", "input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "input_samples": 92496, "input_s": 5.781, "n_real_chunks": 6, "score": 0.8291, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Argentine Basketball Federation — now the Argentine Basketball Confederation (CAB) — was formed on August 30, 1929. (argentina.basketball)", "expert_answer": "The Argentine Basketball Federation — now the **Argentine Basketball Confederation (CAB)** — was formed on **August 30, 1929**. ([argentina.basketball](https://www.argentina.basketball/mision-y-valores?utm_source=openai))", "transcript": "When was the Argentine Basketball Federation formed?\n", "asr_s": 6.33, "expert_s": 5.27, "expert_input_samples": 92496, "expert_input_s": 5.781, "expert_input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "expert_timed_out": false, "wait_s": 4.794, "relay_synth_ms": 5405, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 3, "feed_lag_max_ms": 3305, "feed_lag_sum_ms": 7516, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_aggressive_relay.wav", "sha256": "4d66619c2ab7418d085980b9f7e8c7aec2561af29aeec1340291938876edd524", "sr": 24000, "seconds": 10.84}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_aggressive_candidate.wav", "sha256": "e7f4937771f3553b38f397a5889571a475c80a6b459e12c46f325bd50031a268", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_aggressive_stall.wav", "sha256": "abd29e2903d7635da6405aa52d911cfe4e6ca16c1dd2298fc8a6d0e628cafcaa", "sr": 24000, "seconds": 4.28}}, "chunks": [[0, 1, 1.0, 1.058, 1.104, 1, 0, 0], [1, 1, 2.0, 2.058, 2.104, 1, 0, 0], [2, 1, 3.0, 3.058, 3.105, 1, 0, 0], [3, 1, 4.0, 4.059, 4.107, 1, 0, 0], [4, 1, 5.0, 5.058, 5.107, 1, 0, 0], [5, 1, 5.781, 5.843, 6.257, 0, 24000, 0], [6, 0, 6.781, 8.759, 10.092, 0, 24000, 0], [7, 0, 7.781, 10.261, 12.087, 0, 24000, 0], [8, 0, 8.781, 12.162, 13.064, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 5.781, "last_real_feed_done": 5.843, "onset": 6.257, "gate_read_done": 6.257, "fire": 6.257, "candidate_first_pcm": 6.257, "stall_note": 6.259, "stall_first_pcm": 8.681, "local_first_pcm": null, "wait_start": 13.064, "expert_req": 6.259, "expert_resp": 17.858, "relay_synth_start": 17.859, "relay_first_pcm": 18.584, "relay_synth_end": 23.265, "first_any_pcm": 6.257, "first_answer_pcm": 18.584, "session_end": 23.402}, "ttfa_answer_s": 12.803, "ttfa_any_s": 0.476}
{"id": "sdqa0076", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2161714769, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is the biggest diamond?", "input_path": "/data/sdqa_audio/sdqa0076.wav", "input_sha256": "be190608a30fcf3298ff349d133468603b6c8a37c3c9b3eddba7039a778f9714", "input_samples": 66932, "input_s": 4.183, "n_real_chunks": 5, "score": 0.7939, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The biggest gem-quality diamond ever found is the Cullinan Diamond, discovered in South Africa in 1905. It weighed 3,106 carats in rough form and was later cut into several famous stones, including the Great Star of Africa. (guinnessworldrecords.com) If counting non-gem black carbonado diamonds, the largest recorded is the Sergio, at about 3,167 carats. (gem.org.au)", "expert_answer": "The **biggest gem-quality diamond ever found** is the **Cullinan Diamond**, discovered in South Africa in **1905**. It weighed **3,106 carats** in rough form and was later cut into several famous stones, including the **Great Star of Africa**. ([guinnessworldrecords.com](https://www.guinnessworldrecords.com/world-records/66759-largest-diamond?utm_source=openai))\n\nIf counting **non-gem black carbonado diamonds**, the largest recorded is the **Sergio**, at about **3,167 carats**. ([gem.org.au](https://www.gem.org.au/ag-article/black-diamonds-and-carbonados-a-reflective-overview/?utm_source=openai))", "transcript": "What is the biggest diamond?\n", "asr_s": 1.62, "expert_s": 6.66, "expert_input_samples": 64000, "expert_input_s": 4.0, "expert_input_sha256": "1bbc6f3fc2ea9c66c385060d01b2406617b05344366927fa4aee4e53eea864ec", "expert_timed_out": false, "wait_s": 7.335, "relay_synth_ms": 15826, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0076_aggressive_relay.wav", "sha256": "3145af02b70ff426cb83c4f3bb42b6b1b8102e5414a0fa9dd2a0f1c937392126", "sr": 24000, "seconds": 32.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0076_aggressive_candidate.wav", "sha256": "01d598abbb4ffd37fee44de4b4aa068a681ca5e6326f9a58397a1e740779d8fc", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0076_aggressive_stall.wav", "sha256": "6165c8a683d58612b6ea7df7b3fb315badc6b8332edaedbda50b8000e501f249", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.062, 1.113, 1, 0, 0], [1, 1, 2.0, 2.064, 2.115, 1, 0, 0], [2, 1, 3.0, 3.064, 3.114, 1, 0, 0], [3, 1, 4.0, 4.064, 4.675, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.183, "last_real_feed_done": null, "onset": 4.675, "gate_read_done": 4.675, "fire": 4.675, "candidate_first_pcm": 4.675, "stall_note": 4.676, "stall_first_pcm": 5.626, "local_first_pcm": null, "wait_start": 5.626, "expert_req": 4.676, "expert_resp": 12.96, "relay_synth_start": 12.961, "relay_first_pcm": 13.681, "relay_synth_end": 28.788, "first_any_pcm": 4.675, "first_answer_pcm": 13.681, "session_end": 28.975}, "ttfa_answer_s": 9.497, "ttfa_any_s": 0.492}
{"id": "sdqa0089", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2550015759, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Who was the last King of Bosnia?", "input_path": "/data/sdqa_audio/sdqa0089.wav", "input_sha256": "5ed8e24b38f612a31d3c3a9c432d0ead5e3bb5781b31fad8e66cd9421d59d20a", "input_samples": 72698, "input_s": 4.544, "n_real_chunks": 5, "score": 0.7888, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The last king of Bosnia was Stephen Tomašević (Stjepan Tomašević), who reigned from 1461 to 1463. He was executed after the Ottoman conquest of Bosnia in 1463.", "expert_answer": "The last king of Bosnia was **Stephen Tomašević** (Stjepan Tomašević), who reigned from **1461 to 1463**. He was executed after the Ottoman conquest of Bosnia in **1463**.", "transcript": "Who was the last king of Bosnia?\n", "asr_s": 0.86, "expert_s": 2.61, "expert_input_samples": 72698, "expert_input_s": 4.544, "expert_input_sha256": "5ed8e24b38f612a31d3c3a9c432d0ead5e3bb5781b31fad8e66cd9421d59d20a", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 6638, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 9, "feed_lag_max_ms": 105, "feed_lag_sum_ms": 193, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0089_aggressive_relay.wav", "sha256": "dd8a52ed86fb3f2e989541a7c3c4b547ddbc86009ad4c1a5cc4ece1c1866109a", "sr": 24000, "seconds": 13.96}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0089_aggressive_candidate.wav", "sha256": "decec49eb056b05f9c8ecbcc8339f28c428e13179bb928519df4c9be6bc75fd6", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/