{"id": "sdqa0155", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 707034974, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Where is Flanders?", "input_path": "/data/sdqa_audio/sdqa0155.wav", "input_sha256": "d35a0cbf376ba45dc1e922545d97dec06ba1d2456f3dff50310880b185affa9e", "input_samples": 36675, "input_s": 2.292, "n_real_chunks": 3, "score": 0.4046, "act": 0.9941, "is_info": true, "fired": false, "mode": "local", "answer": "Flanders is a region in the northern part of Belgium. It covers most of the country except for the eastern area, which belongs to Wall onia. The main cities include Antwer p, Ghent, and Brus sels, though Brussels is technically shared between Flem ish and French-speaking communities. F landers has its own government, language policy, and cultural identity, being primarily Dutch speaking. It's known for its cycling culture, historic cities, and industrial heritage.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 21, "feed_lag_max_ms": 87, "feed_lag_sum_ms": 87, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0155_aggressive_local.wav", "sha256": "a6e9303c3fa953af32b01c72cdafb00126e9e7a980b63a3cacc473ddc48cb391", "sr": 24000, "seconds": 21.28}}, "chunks": [[0, 1, 1.0, 1.065, 1.117, 1, 0, 0], [1, 1, 2.0, 2.067, 2.12, 1, 0, 0], [2, 1, 2.292, 2.357, 2.408, 1, 0, 0], [3, 0, 3.292, 3.359, 3.818, 0, 24000, 0], [4, 0, 4.292, 4.358, 4.964, 0, 24000, 0], [5, 0, 5.292, 5.364,