e16187e388a40ac373", "sr": 24000, "seconds": 2.08}}, "chunks": [[0, 1, 1.0, 1.062, 1.111, 1, 0, 0], [1, 1, 2.0, 2.066, 2.117, 1, 0, 0], [2, 1, 3.0, 3.064, 3.114, 1, 0, 0], [3, 1, 4.0, 4.064, 4.113, 1, 0, 0], [4, 1, 5.0, 5.06, 5.11, 1, 0, 0], [5, 1, 6.0, 6.064, 6.115, 1, 0, 0], [6, 1, 7.0, 7.052, 7.092, 1, 0, 0], [7, 1, 8.0, 8.053, 8.096, 1, 0, 0], [8, 1, 8.298, 8.363, 9.007, 0, 24000, 0], [9, 0, 9.298, 9.527, 9.911, 0, 25920, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 8.298, "last_real_feed_done": 8.363, "onset": 9.007, "gate_read_done": 9.007, "fire": 9.007, "candidate_first_pcm": 9.007, "stall_note": 9.008, "stall_first_pcm": 9.477, "local_first_pcm": null, "wait_start": 9.911, "expert_req": 9.008, "expert_resp": 14.188, "relay_synth_start": 14.188, "relay_first_pcm": 14.892, "relay_synth_end": 18.846, "first_any_pcm": 9.007, "first_answer_pcm": 14.892, "session_end": 18.976}, "ttfa_answer_s": 6.594, "ttfa_any_s": 0.709}
{"id": "sdqa0088", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3774420889, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "What is the pink tax?", "input_path": "/data/sdqa_audio/sdqa0088.wav", "input_sha256": "ad620eaa41fe881723d5c9e86415e8d2b035cb0fc932e733dee933cc4bbd8d86", "input_samples": 66554, "input_s": 4.16, "n_real_chunks": 5, "score": 0.8019, "act": 0.9964, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The pink tax is the tendency for products and services marketed to women to cost more than similar or identical versions marketed to men. Examples often cited include razors, deodorant, shampoo, clothing, dry cleaning, and personal care products. It is not usually a formal tax charged by the government; rather, it refers to gender-based price differences in the marketplace. The term can also include cases where necessities used primarily by women, such as menstrual products, are taxed or priced in ways critics view as unfair.", "expert_answer": "The **pink tax** is the tendency for products and services marketed to women to cost more than similar or identical versions marketed to men.\n\nExamples often cited include **razors, deodorant, shampoo, clothing, dry cleaning, and personal care products**. It is not usually a formal tax charged by the government; rather, it refers to **gender-based price differences** in the marketplace.\n\nThe term can also include cases where necessities used primarily by women, such as menstrual products, are taxed or priced in ways critics view as unfair.", "transcript": "What is the pink tax?\n", "asr_s": 0.66, "expert_s": 3.53, "expert_input_samples": 66554, "expert_input_s": 4.16, "expert_input_sha256": "ad620eaa41fe881723d5c9e86415e8d2b035cb0fc932e733dee933cc4bbd8d86", "expert_timed_out": false, "wait_s": 3.231, "relay_synth_ms": 14272, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 64, "feed_lag_sum_ms": 64, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_aggressive_relay.wav", "sha256": "d42ecd4bf91e7000c531e2d9f74eea2e66622b76455efbd8d1ec949632564982", "sr": 24000, "seconds": 36.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_aggressive_candidate.wav", "sha256": "176a11cf1faa950a1563a997e58d7f7d0124d38d460c4a6646912747282db44e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_aggressive_stall.wav", "sha256": "b5697519f552d3e12ca72f6885d803bc500e8d1bf4090097c1e5bb850d122d1b", "sr": 24000, "seconds": 2.08}}, "chunks": [[0, 1, 1.0, 1.062, 1.107, 1, 0, 0], [1, 1, 2.0, 2.063, 2.109, 1, 0, 0], [2, 1, 3.0, 3.051, 3.091, 1, 0, 0], [3, 1, 4.0, 4.062, 4.108, 1, 0, 0], [4, 1, 4.16, 4.218, 4.731, 0, 24000, 0], [5, 0, 5.16, 5.284, 5.689, 0, 25920, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.16, "last_real_feed_done": 4.218, "onset": 4.731, "gate_read_done": 4.731, "fire": 4.731, "candidate_first_pcm": 4.731, "stall_note": 4.732, "stall_first_pcm": 5.224, "local_first_pcm": null, "wait_start": 5.689, "expert_req": 4.732, "expert_resp": 8.92, "relay_synth_start": 8.92, "relay_first_pcm": 9.48, "relay_synth_end": 23.193, "first_any_pcm": 4.731, "first_answer_pcm": 9.48, "session_end": 23.653}, "ttfa_answer_s": 5.32, "ttfa_any_s": 0.571}
{"id": "sdqa0100", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 658079636, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "How do thermostats work?", "input_path": "/data/sdqa_audio/sdqa0100.wav", "input_sha256": "a4f34bb1b84a9a1627361fd8d508b452490a1ed118152546bff6e44738aef8df", "input_samples": 70381, "input_s": 4.399, "n_real_chunks": 5, "score": 0.2686, "act": 0.9986, "is_info": true, "fired": false, "mode": "local", "answer": "A thermostat is a device that control s the temperature in your home or office. It' s usually connected to a heating system, like a furnace or an air conditioner. When you set the desired temperature on the thermostat, it constantly monitor s the room's temperature using a sensor. If the room gets too hot or too cold, the thermo stat sends a signal to turn the heat er on or off, or sometimes switch between different modes depending on the system. This helps maintain a comfortable temperature without wasting energy.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 25, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0100_aggressive_local.wav", "sha256": "554b011480018e876225b2f39b631394a4672b775548807369f4cee570872c65", "sr": 24000, "seconds": 25.28}}, "chunks": [[0, 1, 1.0, 1.057, 1.098, 1, 0, 0], [1, 1, 2.0, 2.049, 2.089, 1, 0, 0], [2, 1, 3.0, 3.061, 3.109, 1, 0, 0], [3, 1, 4.0, 4.063, 4.114, 1, 0, 0], [4, 1, 4.399,