{"id": "sdqa0181", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2565326090, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Where were the Moors from?", "input_path": "/data/sdqa_audio/sdqa0181.wav", "input_sha256": "2f828778eeab6687da8557955971d68817d1f9ecf7254223a4f7f2bc6adebf10", "input_samples": 52915, "input_s": 3.307, "n_real_chunks": 4, "score": 0.7616, "act": 0.9974, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Moors were primarily Muslim peoples from North Africa, especially the Maghreb region—modern-day Morocco, Algeria, Tunisia, and parts of Libya. The term was also used broadly in medieval Europe for Muslims of Berber and Arab origin who ruled or lived in parts of Spain and Portugal.", "expert_answer": "The **Moors** were primarily **Muslim peoples from North Africa**, especially the **Maghreb** region—modern-day **Morocco, Algeria, Tunisia, and parts of Libya**. The term was also used broadly in medieval Europe for Muslims of **Berber and Arab** origin who ruled or lived in parts of **Spain and Portugal**.", "transcript": "Where were the Moors from?\n", "asr_s": 1.23, "expert_s": 2.78, "expert_input_samples": 52915, "expert_input_s": 3.307, "expert_input_sha256": "2f828778eeab6687da8557955971d68817d1f9ecf7254223a4f7f2bc6adebf10", "expert_timed_out": false, "wait_s": 2.612, "relay_synth_ms": 9307, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 130, "feed_lag_sum_ms": 130, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0181_aggressive_relay.wav", "sha256": "e63de215068f0a9e024d82cd01da9a65e6651a66a7566547840b6fa7b9203d0b", "sr": 24000, "seconds": 1