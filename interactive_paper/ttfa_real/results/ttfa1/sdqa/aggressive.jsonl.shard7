{"id": "sdqa0017", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2709827905, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "When did Marxism develop?", "input_path": "/data/sdqa_audio/sdqa0017.wav", "input_sha256": "c6b745ef8328a05cf2ad5dd1456d1566ee56271b5c3781987c40baf8cf67cebe", "input_samples": 55973, "input_s": 3.498, "n_real_chunks": 4, "score": 0.0629, "act": 0.9983, "is_info": true, "fired": false, "mode": "local", "answer": "Marx ism developed in the mid-1 9th century, around the 1840 s and 5 0s. It was founded by Karl Mar x and Friedrich En gels, primarily as a response to industrial ization and the economic conditions of the time. Their ideas became widely influential, especially through works like \"The Communist Manifesto\" and \"Das Kapital.\"", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 27, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0017_aggressive_local.wav", "sha256": "bc07aca287cb0b2f5ff52a592d1f391dffb8735e8fc136a1389ba6f4e86ff410", "sr": 24000, "seconds": 26.32}}, "chunks": [[0, 1, 1.0, 1.063, 1.112, 1, 0, 0], [1, 1, 2.0, 2.061, 2.108, 1, 0, 0], [2, 1, 3.0, 3.063, 3.112, 1, 0, 0], [3, 1, 3.498, 3.56, 3.675, 0, 0, 0], [4, 0, 4.498, 4.564, 5.179, 0, 24000, 0], [5, 0, 5.498, 5.549, 6.009, 0, 24000, 0], [6, 0, 6.498, 6.563, 7.125, 0, 24000, 0], [7, 0, 7.498, 7.566, 8.058, 0, 24000, 0], [8, 0, 8.498, 8.564, 9.005, 0, 24