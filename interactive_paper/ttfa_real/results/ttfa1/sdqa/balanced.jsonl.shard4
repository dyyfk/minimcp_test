{"id": "sdqa0022", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4207089165, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When was the first web page released?", "input_path": "/data/sdqa_audio/sdqa0022.wav", "input_sha256": "38b927ee48ef03a78f28f4c4395a1543710a850fdc138d7128ac0ae16706b51d", "input_samples": 66021, "input_s": 4.126, "n_real_chunks": 5, "score": 0.528, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "The first web page was released in 1 991. It was created by Tim Bern ers-Lee, the inventor of the World Wide Web. This early page served as an introduction to the web and explained its purpose. It marked the beginning of the internet as we know it today.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 33, "feed_lag_sum_ms": 33, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0022_balanced_local.wav", "sha256": "768f505b401c447f5f28c4512cbd2c44c9d08a42c516c110c25d7943f3939f3a", "sr": 24000, "seconds": 14.24}}, "chunks": [[0, 1, 1.0, 1.072, 1.129, 1, 0, 0], [1, 1, 2.0, 2.074, 2.139, 1, 0, 0], [2, 1, 3.0, 3.09, 3.161, 1, 0, 0], [3, 1, 4.0, 4.086, 4.16, 1, 0, 0], [4, 1, 4.126, 4.245, 5.103, 0, 24000, 0], [5, 0, 5.126, 5.204, 5.911, 0, 24000, 0], [6, 0, 6.126, 6.209, 7.071, 0, 24000, 0], [7, 0, 7.126, 7.204, 7.888, 0, 24000, 0], [8, 0, 8.126, 8.216, 9.004, 0, 24000, 0], [9, 0, 9.126, 9.206, 10.007, 0, 24000, 0], [10, 0, 10.126, 10.