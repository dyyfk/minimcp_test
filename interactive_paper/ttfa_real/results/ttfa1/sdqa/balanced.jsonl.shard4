{"id": "sdqa0084", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3914292146, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What did Augustus become Roman Emperor?", "input_path": "/data/sdqa_audio/sdqa0084.wav", "input_sha256": "b0351a7cdae9d93d63e47eb070ad1f825d8dab1b3e220d1928480ce4633bca52", "input_samples": 93861, "input_s": 5.866, "n_real_chunks": 6, "score": 0.3337, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "Augustus became Roman emperor in 27 BC.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 4, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0084_balanced_local.wav", "sha256": "d2b49ecfd302487d91b60b6ad15a3487eea2fd568451cab28703785356a2fdcc", "sr": 24000, "seconds": 4.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.133, 1, 0, 0], [1, 1, 2.0, 2.086, 2.156, 1, 0, 0], [2, 1, 3.0, 3.073, 3.131, 1, 0, 0], [3, 1, 4.0, 4.073, 4.134, 1, 0, 0], [4, 1, 5.0, 5.086, 5.154, 1, 0, 0], [5, 1, 5.866, 5.937, 6.498, 0, 24000, 0], [6, 0, 6.866, 6.935, 7.561, 0, 24000, 0], [7, 0, 7.866, 7.936, 8.605, 0, 24000, 0], [8, 0, 8.866, 8.937, 9.637, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 5.866, "last_real_feed_done": 5.937, "onset": 6.498, "gate_read_done": 6.498, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 6.498, "wait_start"