{"id": "sdqa0039", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1946877636, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What does GDP stand for?", "input_path": "/data/sdqa_audio/sdqa0039.wav", "input_sha256": "6bc21f00b1063cc05b5ddf5a14771c622c7045d36536ed39ee00a4bb272a5e2d", "input_samples": 55447, "input_s": 3.465, "n_real_chunks": 4, "score": 0.23, "act": 0.9993, "is_info": true, "fired": false, "mode": "local", "answer": "GDP stands for gross domestic product. It' s a measure of the total value of all goods and services produced within a country over a specific period, usually a year. It' s often used as an indicator of a country's economic health.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0039_balanced_local.wav", "sha256": "592c2c2633cc9a8d3dd98de814c750d159518e0b9ccc6920f413c25ab0f89b28", "sr": 24000, "seconds": 14.28}}, "chunks": [[0, 1, 1.0, 1.078, 1.14, 1, 0, 0], [1, 1, 2.0, 2.081, 2.146, 1, 0, 0], [2, 1, 3.0, 3.081, 3.144, 1, 0, 0], [3, 1, 3.465, 3.548, 4.278, 0, 24000, 0], [4, 0, 4.465, 4.548, 5.231, 0, 24000, 0], [5, 0, 5.465, 5.554, 6.332, 0, 24000, 0], [6, 0, 6.465, 6.549, 7.304, 0, 24000, 0], [7, 0, 7.465, 7.538, 8.249, 0, 24000, 0], [8, 0, 8.465, 8.537, 9.22, 0, 24000, 0], [9, 0, 9.465, 9.547, 10.301, 0, 24000, 0], [10, 0, 10.465, 10.55, 11.245, 0, 24000, 0], [11, 0, 