{"id": "sdqa0048", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1280071829, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What's the biggest wasp?", "input_path": "/data/sdqa_audio/sdqa0048.wav", "input_sha256": "88342713270cf1daba8d80233b1b6c12472f5e1c87cc2a2e799dc2cef1fda4be", "input_samples": 67578, "input_s": 4.224, "n_real_chunks": 5, "score": 0.869, "act": 0.9974, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The biggest wasp depends on how you measure it: Largest social wasp / hornet: Northern giant hornet (Vespa mandarinia), also called the Asian giant hornet. Queens can reach about 5 cm / 2 in long. , Largest by wingspan: Giant tarantula-hawk wasp (Pepsis heros), with a recorded wingspan of about 12.15 cm / 4.75 in. If you mean record wingspan: the giant tarantula hawk.", "expert_answer": "The **biggest wasp** depends on how you measure it:\n\n- **Largest social wasp / hornet:** **Northern giant hornet** (*Vespa mandarinia*), also called the Asian giant hornet. Queens can reach about **5 cm / 2 in** long.\n- **Largest by wingspan:** **Giant tarantula-hawk wasp** (*Pepsis heros*), with a recorded wingspan of about **12.15 cm / 4.75 in**. Guinness lists it as the largest wasp and largest hymenopteran. ([guinnessworldrecords.com](https://www.guinnessworldrecords.com/world-records/341649-largest-wasp?utm_source=openai))\n\nSo, if you mean the biggest “classic” wasp/hornet people usually think of: **the northern giant hornet**. If you mean record wingspan: **the giant tarantula hawk**.", "transcript": "What's the biggest wasp?\n", "asr_s": 3.85, "expert_s": 7.28, "expert_input_samples": 67578, "expert_input_s": 4.224, "expert_input_sha256": "88342713270cf1daba8d80233b1b6c12472f5e1c87cc2a2e799dc2cef1fda4be", "expert_timed_out": false, "wait_s": 6.463, "relay_synth_ms": 16985, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 3439, "feed_lag_sum_ms": 3439, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0048_balanced_relay.wav", "sha256": "aa45d9e8eff73943891166ed7efb4ee0f61572c94868ba39f983bde0fdd2fd16", "sr": 24000, "seconds": 26.84}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0048_balanced_candidate.wav", "sha256": "3a13d8af9b8d33cd397d4150de7a61b15b98a3ed24d0d688c1a2b7b1cca98ce7", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0048_balanced_stall.wav", "sha256": "f135b7d556748afca022ced48b0e319df75c01cf433d06e2daa6c12f486a7035", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.078, 1.14, 1, 0, 0], [1, 1, 2.0, 2.077, 2.137, 1, 0, 0], [2, 1, 3.0, 3.083, 3.15, 1, 0, 0], [3, 1, 4.0, 4.09, 4.162, 1, 0, 0], [4, 1, 4.224, 4.313, 5.058, 0, 24000, 0], [5, 0, 5.224, 8.73, 9.728, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.224, "last_real_feed_done": 4.313, "onset": 5.058, "gate_read_done": 5.058, "fire": 5.058, "candidate_first_pcm": 5.058, "stall_note": 5.059, "stall_first_pcm": 8.663, "local_first_pcm": null, "wait_start": 9.728, "expert_req": 5.059, "expert_resp": 16.191, "relay_synth_start": 16.192, "relay_first_pcm": 16.973, "relay_synth_end": 33.178, "first_any_pcm": 5.058, "first_answer_pcm": 16.973, "session_end": 33.42}, "ttfa_answer_s": 12.749, "ttfa_any_s": 0.834}
