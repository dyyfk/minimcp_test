{"id": "sdqa0146", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2855673765, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "When was the KHON-TV station established?", "input_path": "/data/sdqa_audio/sdqa0146.wav", "input_sha256": "a0fd3218d4204ef4c4524812b0c183bcb5842841039e554b8486159b2e8cd003", "input_samples": 64779, "input_s": 4.049, "n_real_chunks": 5, "score": 0.8843, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "KHON-TV was established — first signing on as KONA-TV — on November 16, 1952. It became KHON-TV in 1965. (worldradiohistory.com)", "expert_answer": "KHON-TV was established — first signing on as **KONA-TV** — on **November 16, 1952**. It became **KHON-TV** in **1965**. ([worldradiohistory.com](https://www.worldradiohistory.com/Archive-BC/BC-1952/BC-1952-11-24.pdf?utm_source=openai))", "transcript": "When was the KHON TV station established?\n", "asr_s": 0.61, "expert_s": 13.96, "expert_input_samples": 64779, "expert_input_s": 4.049, "expert_input_sha256": "a0fd3218d4204ef4c4524812b0c183bcb5842841039e554b8486159b2e8cd003", "expert_timed_out": false, "wait_s": 13.845, "relay_synth_ms": 9881, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 93, "feed_lag_sum_ms": 93, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0146_balanced_relay.wav", "sha256": "4c71f73c7de262037aa25a07080638ccb04a3f7b2862a095e2443a5f4ef2640e", "sr": 24000, "seconds": 15.8}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0146_balanced_candidate.wav", "sha256": "e016e07b022cf301c2508dd52b0669c2873af32528f6573b7ac4adea327aca66", "sr": 24000, "seconds": 1.0}, "