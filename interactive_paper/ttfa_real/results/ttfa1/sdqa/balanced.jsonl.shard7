{"id": "sdqa0060", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1889645093, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "What is an organophosphate?", "input_path": "/data/sdqa_audio/sdqa0060.wav", "input_sha256": "07aa64f2a741446b8992c0acdd72a5c041cdcd2242e064683f8ae29c41122ea9", "input_samples": 54949, "input_s": 3.434, "n_real_chunks": 4, "score": 0.2052, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "An organophos phate is a type of chemical compound that contains phosphorus, oxygen, and carbon. They' re commonly used as pesticides or in some industrial applications. However, many organo phosphate s can be toxic if they get into the body through inhalation, ingestion, or skin contact.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 18, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0060_balanced_local.wav", "sha256": "7685b3499802f2822f6b8539d186d98fdc6c5cc0959831da2c92d2eed79ce123", "sr": 24000, "seconds": 18.28}}, "chunks": [[0, 1, 1.0, 1.079, 1.144, 1, 0, 0], [1, 1, 2.0, 2.084, 2.149, 1, 0, 0], [2, 1, 3.0, 3.086, 3.155, 1, 0, 0], [3, 1, 3.434, 3.51, 4.288, 0, 24000, 0], [4, 0, 4.434, 4.521, 5.352, 0, 24000, 0], [5, 0, 5.434, 5.516, 6.253, 0, 24000, 0], [6, 0, 6.434, 6.519, 7.264, 0, 24000, 0], [7, 0, 7.434, 7.515, 8.328, 0, 24000, 0], [8, 0, 8.434, 8.518, 9.276, 0, 24000, 0], [9, 0, 9.434, 9.501, 10.108, 0,