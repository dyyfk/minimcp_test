{"id": "sdqa0110", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1042435797, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Who old is the Angel Oak in South Carolina?", "input_path": "/data/sdqa_audio/sdqa0110.wav", "input_sha256": "4a3ee421eedb191e0f116ff620dee77dd1904783059f19f30ca9850ccada11a6", "input_samples": 93520, "input_s": 5.845, "n_real_chunks": 6, "score": 0.7366, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "The Angel O ak is estimated to be about 1, 500 years old. It' s considered one of the oldest living things in North America and stands as a remarkable symbol of endurance in South Carolina' s Congaree National Park.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0110_balanced_local.wav", "sha256": "a9f1705b3c8ba71e19abc9645fa8b22c6ec091cdd23d1390d8a8680a93a69aa7", "sr": 24000, "seconds": 14.2}}, "chunks": [[0, 1, 1.0, 1.063, 1.117, 1, 0, 0], [1, 1, 2.0, 2.063, 2.113, 1, 0, 0], [2, 1, 3.0, 3.064, 3.116, 1, 0, 0], [3, 1, 4.0, 4.063, 4.114, 1, 0, 0], [4, 1, 5.0, 5.065, 5.117, 1, 0, 0], [5, 1, 5.845, 5.915, 6.309, 0, 24000, 0], [6, 0, 6.845, 6.918, 7.551, 0, 24000, 0], [7, 0, 7.845, 7.927, 8.641, 0, 24000, 0], [8, 0, 8.845, 8.913, 9.546, 0, 24000, 0], [9, 0, 9.845, 9.914, 10.528, 0, 24000, 0], [10, 0, 10.845, 10.914, 11.527, 0, 24000, 0], [11, 0, 11.8