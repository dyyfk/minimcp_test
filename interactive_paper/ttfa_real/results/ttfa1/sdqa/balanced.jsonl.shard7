{"id": "sdqa0136", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3849816418, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Who developed Recaptcha?", "input_path": "/data/sdqa_audio/sdqa0136.wav", "input_sha256": "2911894f24db315133e39095bb1bf1dad111be1564b4b3194f86d5406d9b3928", "input_samples": 47440, "input_s": 2.965, "n_real_chunks": 3, "score": 0.9379, "act": 0.9918, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "reCAPTCHA was developed by Luis von Ahn, Ben Maurer, Colin McMillen, David Abraham, and Manuel Blum at Carnegie Mellon University. Google acquired reCAPTCHA in 2009.", "expert_answer": "**reCAPTCHA was developed by Luis von Ahn, Ben Maurer, Colin McMillen, David Abraham, and Manuel Blum** at **Carnegie Mellon University**. Google acquired reCAPTCHA in 2009.", "transcript": "Who developed Recaptcha?\n", "asr_s": 0.57, "expert_s": 1.7, "expert_input_samples": 47440, "expert_input_s": 2.965, "expert_input_sha256": "2911894f24db315133e39095bb1bf1dad111be1564b4b3194f86d5406d9b3928", "expert_timed_out": false, "wait_s": 0.615, "relay_synth_ms": 6422, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 308, "feed_lag_sum_ms": 308, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0136_balanced_relay.wav", "sha256": "ead8239b90789944a1ae0ca299350ce00972d35f4627ef7428d280ac2af0218a", "sr": 24000, "seconds": 13.04}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0136_balanced_candidate.wav", "sha256": "2ffefad9ed6c810f12d18ddb06b70d55d7f28b847e5644006e20943bc793611f", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0136_