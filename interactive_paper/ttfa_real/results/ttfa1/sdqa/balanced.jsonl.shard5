{"id": "sdqa0189", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2520534328, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "How long has the Xeon processor been in use for?", "input_path": "/data/sdqa_audio/sdqa0189.wav", "input_sha256": "3d1b31fa094d9bd86172ec58c69ee6b62996b1f7e814089e9c4b302b0af31259", "input_samples": 54812, "input_s": 3.426, "n_real_chunks": 4, "score": 0.7785, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "The Xe on processor has been in use for over 20 years now. It was introduced by In tel back in the early 2000s, so it' s a long-standing product line that's widely used in data centers and server environments.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0189_balanced_local.wav", "sha256": "9fa45c84df573d55307cd5e22281e2f69384e8088778e6c1d39069ec4f393605", "sr": 24000, "seconds": 12.8}}, "chunks": [[0, 1, 1.0, 1.05, 1.092, 1, 0, 0], [1, 1, 2.0, 2.05, 2.092, 1, 0, 0], [2, 1, 3.0, 3.051, 3.092, 1, 0, 0], [3, 1, 3.426, 3.476, 3.634, 0, 0, 0], [4, 0, 4.426, 4.476, 4.972, 0, 24000, 0], [5, 0, 5.426, 5.477, 5.93, 0, 24000, 0], [6, 0, 6.426, 6.478, 7.022, 0, 24000, 0], [7, 0, 7.426, 7.478, 8.0, 0, 24000, 0], [8, 0, 8.426, 8.478, 8.931, 0, 24000, 0], [9, 0, 9.426, 9.478, 10.0, 0, 24000, 0], [10, 0, 10.426, 10.478, 11.111, 0, 24000, 0], [11, 0, 11.4