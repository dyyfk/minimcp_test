{"id": "sdqa0057", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3320345669, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What is the oldest grave at Arlington National Cemetery?", "input_path": "/data/sdqa_audio/sdqa0057.wav", "input_sha256": "0ca90695c445c67f6a4f7561f5aefb702e9e653bf91922080700daea38fac3cb", "input_samples": 66782, "input_s": 4.174, "n_real_chunks": 5, "score": 0.7729, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The oldest gravesite within what is now Arlington National Cemetery is generally the Custis family grave site, especially the grave of Mary Lee Fitzhugh Custis, who died in 1853—before Arlington became a national cemetery. (nps.gov) If you mean the first military burial after Arlington became a cemetery, that was Private William Henry Christman, buried on May 13, 1864, in Section 27, Grave 19. (arlingtoncemetery.mil)", "expert_answer": "The **oldest gravesite within what is now Arlington National Cemetery** is generally the **Custis family grave site**, especially the grave of **Mary Lee Fitzhugh Custis**, who died in **1853**—before Arlington became a national cemetery. ([nps.gov](https://www.nps.gov/arho/learn/historyculture/the-custis-graves.htm?utm_source=openai))\n\nIf you mean the **first military burial after Arlington became a cemetery**, that was **Private William Henry Christman**, buried on **May 13, 1864**, in **Section 27, Grave 19**. ([arlingtoncemetery.mil](https://www.arlingtoncemetery.mil/Explore/History-of-Arlington-National-Cemetery/Section-27?utm_source=openai))", "transcript": "What is the oldest grave at Arlington National Cemetery?\n", "asr_s": 0.89, "expert_s": 4.01, "expert_input_samples": 66782, "expert_input_s": 4.174, "expert_input_sha256": "0ca90695c445c67f6a4f7561f5aefb702e9e653bf91922080700daea38fac3cb", "expert_timed_out": false, "wait_s": 3.789, "relay_synth_ms": 18778, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 373, "feed_lag_sum_ms": 373, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0057_aggressive_relay.wav", "sha256": "ba34803c6febd13f04cc797491cf951fd2b5be5656aa69b418831557e44c2358", "sr": 24000, "seconds": 31.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0057_aggressive_candidate.wav", "sha256": "143e90788ed3acf9e27958bf9f98667f41f0332ad9d31b34f5883d062b766677", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0057_aggressive_stall.wav", "sha256": "19cbe673abca58a246c43b778e7ad5fd8b301fcf731342bb6083dd4a3dadab9e", "sr": 24000, "seconds": 1.52}}, "chunks": [[0, 1, 1.0, 1.072, 1.128, 1, 0, 0], [1, 1, 2.0, 2.083, 2.145, 1, 0, 0], [2, 1, 3.0, 3.073, 3.127, 1, 0, 0], [3, 1, 4.0, 4.073, 4.132, 1, 0, 0], [4, 1, 4.174, 4.245, 4.937, 0, 24000, 0], [5, 0, 5.174, 5.618, 6.052, 0, 12480, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.174, "last_real_feed_done": 4.245, "onset": 4.937, "gate_read_done": 4.937, "fire": 4.937, "candidate_first_pcm": 4.937, "stall_note": 4.939, "stall_first_pcm": 5.547, "local_first_pcm": null, "wait_start": 6.052, "expert_req": 4.939, "expert_resp": 9.841, "relay_synth_start": 9.842, "relay_first_pcm": 10.663, "relay_synth_end": 28.62, "first_any_pcm": 4.937, "first_answer_pcm": 10.663, "session_end": 29.52}, "ttfa_answer_s": 6.489, "ttfa_any_s": 0.763}
{"id": "sdqa0065", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 13321898, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "How large is Cougar Mountain Regional Wildland Park?", "input_path": "/data/sdqa_audio/sdqa0065.wav", "input_sha256": "1c426ff6907d5f33d630c74cdc5b7870686b1f33a9cc90497ca8cad068bd1269", "input_samples": 116048, "input_s": 7.253, "n_real_chunks": 8, "score": 0.7157, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Cougar Mountain Regional Wildland Park is over 3,000 acres — King County describes it as a 3,000+ acre park. (kingcounty.gov)", "expert_answer": "Cougar Mountain Regional Wildland Park is **over 3,000 acres** — King County describes it as a **3,000+ acre** park. ([kingcounty.gov](https://kingcounty.gov/en/dept/dnrp/nature-recreation/parks-recreation/king-county-parks/parks/cougar-mountain?utm_source=openai))", "transcript": "How large is Cougar Mountain Regional Wildland Park?\n", "asr_s": 0.82, "expert_s": 5.45, "expert_input_samples": 116048, "expert_input_s": 7.253, "expert_input_sha256": "1c426ff6907d5f33d630c74cdc5b7870686b1f33a9cc90497ca8cad068bd1269", "expert_timed_out": false, "wait_s": 5.688, "relay_synth_ms": 5158, "onset_chunk": 7, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0065_aggressive_relay.wav", "sha256": "a7587ebf92e5620870f4dd99fe2b5343798e5c24f7a411a5ebf6172d4c67e0ea", "sr": 24000, "seconds": 8.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0065_aggressive_candidate.wav", "sha256": "7b9eed8a20821afd629937e1fedf8bb9b012693dc66a822