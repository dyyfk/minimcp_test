 "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.06, 1.109, 1, 0, 0], [1, 1, 2.0, 2.063, 2.113, 1, 0, 0], [2, 1, 2.937, 3.008, 3.062, 1, 0, 0], [3, 0, 3.937, 4.006, 4.548, 0, 24000, 0], [4, 0, 4.937, 5.387, 6.018, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.937, "last_real_feed_done": 3.008, "onset": 4.548, "gate_read_done": 4.549, "fire": 4.549, "candidate_first_pcm": 4.548, "stall_note": 4.549, "stall_first_pcm": 5.324, "local_first_pcm": null, "wait_start": 6.018, "expert_req": 4.549, "expert_resp": 6.558, "relay_synth_start": 6.558, "relay_first_pcm": 7.252, "relay_synth_end": 10.08, "first_any_pcm": 4.548, "first_answer_pcm": 7.252, "session_end": 10.206}, "ttfa_answer_s": 4.315, "ttfa_any_s": 1.611}
{"id": "sdqa0177", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4129062128, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What other species belong to the Equidae?", "input_path": "/data/sdqa_audio/sdqa0177.wav", "input_sha256": "1465c46cc79aa39b0a22e13197afe51fa73aef173fc127fda74c83160552ec03", "input_samples": 55057, "input_s": 3.441, "n_real_chunks": 4, "score": 0.6524, "act": 0.9977, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Other living species in the Equidae family, besides the domestic horse, include: Donkeys / asses — e.g., the African wild ass and domestic donkey , Zebras — such as plains, mountain, and Grévy’s zebras , Wild horses — such as Przewalski’s horse So, Equidae includes horses, donkeys/asses, and zebras.", "expert_answer": "Other living species in the **Equidae** family, besides the domestic horse, include:\n\n- **Donkeys / asses** — e.g., the African wild ass and domestic donkey  \n- **Zebras** — such as plains, mountain, and Grévy’s zebras  \n- **Wild horses** — such as Przewalski’s horse  \n\nSo, Equidae includes **horses, donkeys/asses, and zebras**.", "transcript": "What other species belong to the Equidae?\n", "asr_s": 0.72, "expert_s": 3.33, "expert_input_samples": 55057, "expert_input_s": 3.441, "expert_input_sha256": "1465c46cc79aa39b0a22e13197afe51fa73aef173fc127fda74c83160552ec03", "expert_timed_out": false, "wait_s": 3.381, "relay_synth_ms": 11511, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0177_aggressive_relay.wav", "sha256": "f81a5c66eb215492a16987