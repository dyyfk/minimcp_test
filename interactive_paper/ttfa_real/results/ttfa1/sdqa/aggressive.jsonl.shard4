{"id": "sdqa0105", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1465092891, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When did Sardinia become part of Italy?", "input_path": "/data/sdqa_audio/sdqa0105.wav", "input_sha256": "4a6c31123fa0de32ab5403dc819aadac25e589d5a1f16d49007f577cf1698e44", "input_samples": 88058, "input_s": 5.504, "n_real_chunks": 6, "score": 0.6308, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Sardinia became part of Italy in 1861, when the Kingdom of Italy was proclaimed on March 17, 1861. Before that, Sardinia was part of the Kingdom of Sardinia, whose ruling House of Savoy led the unification of Italy.", "expert_answer": "**Sardinia became part of Italy in 1861**, when the **Kingdom of Italy was proclaimed on March 17, 1861**.\n\nBefore that, Sardinia was part of the **Kingdom of Sardinia**, whose ruling House of Savoy led the unification of Italy.", "transcript": "When did Sardinia become part of Italy?\n", "asr_s": 0.66, "expert_s": 1.75, "expert_input_samples": 88058, "expert_input_s": 5.504, "expert_input_sha256": "4a6c31123fa0de32ab5403dc819aadac25e589d5a1f16d49007f577cf1698e44", "expert_timed_out": false, "wait_s": 1.152, "relay_synth_ms": 9378, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 542, "feed_lag_sum_ms": 542, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0105_aggressive_relay.wav", "sha256": "33e2b768ee75c387218fcb0768cc1fd4f36fbaaa94d2099782432147e89a1de3", "sr": 24000, "seconds": 15.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0105_aggressive_candidate.wav", "sha256": "dfbad99f8d772