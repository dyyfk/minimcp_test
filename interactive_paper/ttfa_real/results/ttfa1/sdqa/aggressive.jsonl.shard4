{"id": "sdqa0151", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 759806791, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What is the largest type of mosquito?", "input_path": "/data/sdqa_audio/sdqa0151.wav", "input_sha256": "13017d775aea4dfd9b8649f54e4d6755afb6496268d35e9aa01f51ab565e4369", "input_samples": 49082, "input_s": 3.068, "n_real_chunks": 4, "score": 0.6864, "act": 0.9993, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The largest type of mosquito is the elephant mosquito — genus Toxorhynchites. Unlike most mosquitoes, adult elephant mosquitoes do not drink blood; they feed on nectar, and their larvae often eat other mosquito larvae.", "expert_answer": "The largest type of mosquito is the **elephant mosquito** — genus **Toxorhynchites**.\n\nUnlike most mosquitoes, adult elephant mosquitoes **do not drink blood**; they feed on nectar, and their larvae often eat other mosquito larvae.", "transcript": "What is the largest type of mosquito?\n", "asr_s": 0.56, "expert_s": 3.56, "expert_input_samples": 49082, "expert_input_s": 3.068, "expert_input_sha256": "13017d775aea4dfd9b8649f54e4d6755afb6496268d35e9aa01f51ab565e4369", "expert_timed_out": false, "wait_s": 2.781, "relay_synth_ms": 7330, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 341, "feed_lag_sum_ms": 382, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0151_aggressive_relay.wav", "sha256": "ba8f734403ed4ec2dcc450837fbfd06282e52738f2f531cf8aa83b0ee53f3254", "sr": 24000, "seconds": 15.2}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0151_aggressive_candidate.wav", "sha256": "501d0f6fc739