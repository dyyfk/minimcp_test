{"id": "sdqa0074", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1859602301, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When was the Royal Observer Corps established?", "input_path": "/data/sdqa_audio/sdqa0074.wav", "input_sha256": "f96106e2c8eece3196ec2f4c033db0ba4dc535573637ca1871e8927493be37fa", "input_samples": 88976, "input_s": 5.561, "n_real_chunks": 6, "score": 0.7108, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Royal Observer Corps was established as the Observer Corps on 29 October 1925. It was granted the title “Royal” by King George VI in April 1941.", "expert_answer": "The **Royal Observer Corps** was established as the **Observer Corps on 29 October 1925**. It was granted the title **“Royal”** by King George VI in **April 1941**.", "transcript": "When was the Royal Observer Corps established?\n", "asr_s": 0.59, "expert_s": 3.3, "expert_input_samples": 88976, "expert_input_s": 5.561, "expert_input_sha256": "f96106e2c8eece3196ec2f4c033db0ba4dc535573637ca1871e8927493be37fa", "expert_timed_out": false, "wait_s": 3.094, "relay_synth_ms": 6701, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0074_aggressive_relay.wav", "sha256": "d0ddb3e13128a63b818636a16f452a1a7352c2ce92154ba6630f12320f5dbcea", "sr": 24000, "seconds": 11.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0074_aggressive_candidate.wav", "sha256": "c595c6f28b47c9f2d9c26b37de188b64a7331672d3f7604ba6ad1357aa7beda0", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa