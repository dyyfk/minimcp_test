{"id": "sdqa0104", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 542423949, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What is a motor tic?", "input_path": "/data/sdqa_audio/sdqa0104.wav", "input_sha256": "7b3a62a04f0793fc567b2f80e5b918eeaa7453b7d88fd2a018d2a33fe8151311", "input_samples": 60752, "input_s": 3.797, "n_real_chunks": 4, "score": 0.5658, "act": 0.9969, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "A motor tic is a sudden, brief, repetitive, involuntary or hard-to-control movement of part of the body. Examples include: Eye blinking , Facial grimacing , Shoulder shrugging , Head jerking , Neck twitching Motor tics are often associated with tic disorders, including Tourette syndrome, and may worsen with stress, excitement, or fatigue.", "expert_answer": "A **motor tic** is a **sudden, brief, repetitive, involuntary or hard-to-control movement** of part of the body.\n\nExamples include:\n- Eye blinking\n- Facial grimacing\n- Shoulder shrugging\n- Head jerking\n- Neck twitching\n\nMotor tics are often associated with **tic disorders**, including **Tourette syndrome**, and may worsen with stress, excitement, or fatigue.", "transcript": "What is a motor tick?\n", "asr_s": 0.63, "expert_s": 5.04, "expert_input_samples": 60752, "expert_input_s": 3.797, "expert_input_sha256": "7b3a62a04f0793fc567b2f80e5b918eeaa7453b7d88fd2a018d2a33fe8151311", "expert_timed_out": false, "wait_s": 4.132, "relay_synth_ms": 12090, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0104_aggressive_relay.wav", "s