{"id": "sdqa0159", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 596783989, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What's the meaning of NBC?", "input_path": "/data/sdqa_audio/sdqa0159.wav", "input_sha256": "7bba607c9311a792238840a04b632d10d7814b0b532c9e82956adba988fde66a", "input_samples": 46416, "input_s": 2.901, "n_real_chunks": 3, "score": 0.8103, "act": 0.9942, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "NBC most commonly means National Broadcasting Company, a major U.S. television and radio network. Depending on context, it can also mean other things, such as Nuclear, Biological, and Chemical in military/emergency contexts.", "expert_answer": "**NBC** most commonly means **National Broadcasting Company**, a major U.S. television and radio network.\n\nDepending on context, it can also mean other things, such as **Nuclear, Biological, and Chemical** in military/emergency contexts.", "transcript": "What's the meaning of NBC?\n", "asr_s": 2.33, "expert_s": 1.65, "expert_input_samples": 46416, "expert_input_s": 2.901, "expert_input_sha256": "7bba607c9311a792238840a04b632d10d7814b0b532c9e82956adba988fde66a", "expert_timed_out": false, "wait_s": 3.223, "relay_synth_ms": 8904, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0159_always_relay.wav", "sha256": "a04484d28be997546644729edb682e1d8a7bf9ba7082ebeeca1192ced7003181", "sr": 24000, "seconds": 17.8}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0159_always_candidate.wav", "sha256": "1638a714a4e35ded74f48ddd4193c03ba81e2233bec88a8a66f8081e