{"id": "sdqa0197", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1755271550, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Where do box jellyfish live?", "input_path": "/data/sdqa_audio/sdqa0197.wav", "input_sha256": "7a4749b4645ea5df0e8fa450e341dc1eaf8458cb3c2fdd957cd061becec8361b", "input_samples": 42156, "input_s": 2.635, "n_real_chunks": 3, "score": 0.5673, "act": 0.9976, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Box jellyfish live mainly in warm coastal waters, especially in the Indo-Pacific region. They are commonly found around northern Australia, Southeast Asia, and parts of the Pacific and Indian Oceans. Some species also occur in waters near Hawaii, the Caribbean, and the Gulf of Mexico.", "expert_answer": "Box jellyfish live mainly in **warm coastal waters**, especially in the **Indo-Pacific region**. They are commonly found around **northern Australia**, **Southeast Asia**, and parts of the **Pacific and Indian Oceans**. Some species also occur in waters near **Hawaii, the Caribbean, and the Gulf of Mexico**.", "transcript": "Where do box jellyfish live?\n", "asr_s": 0.48, "expert_s": 2.02, "expert_input_samples": 42156, "expert_input_s": 2.635, "expert_input_sha256": "7a4749b4645ea5df0e8fa450e341dc1eaf8458cb3c2fdd957cd061becec8361b", "expert_timed_out": false, "wait_s": 0.963, "relay_synth_ms": 9953, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 398, "feed_lag_sum_ms": 398, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0197_always_relay.wav", "sha256": "80fa516b0972dad342d1f708b8cdedd21c0b04ff39d91a01b88736071e153d6e", "sr": 24000, "seconds": 19.76}, "candidate": {