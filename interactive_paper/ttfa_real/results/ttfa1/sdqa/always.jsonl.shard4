{"id": "sdqa0084", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3914292146, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What did Augustus become Roman Emperor?", "input_path": "/data/sdqa_audio/sdqa0084.wav", "input_sha256": "b0351a7cdae9d93d63e47eb070ad1f825d8dab1b3e220d1928480ce4633bca52", "input_samples": 93861, "input_s": 5.866, "n_real_chunks": 6, "score": 0.3162, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Augustus became the first Roman Emperor in 27 BCE, when the Roman Senate granted him the title “Augustus” on January 16, 27 BCE.", "expert_answer": "Augustus became the first Roman Emperor in **27 BCE**, when the Roman Senate granted him the title **“Augustus”** on **January 16, 27 BCE**.", "transcript": "When did Augustus become Roman Emperor?\n", "asr_s": 0.54, "expert_s": 1.8, "expert_input_samples": 93861, "expert_input_s": 5.866, "expert_input_sha256": "b0351a7cdae9d93d63e47eb070ad1f825d8dab1b3e220d1928480ce4633bca52", "expert_timed_out": false, "wait_s": 1.369, "relay_synth_ms": 6075, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0084_always_relay.wav", "sha256": "6ff769a03b46373655b6b7fa7dac583139c36641854de52ba04db8176f75ca7d", "sr": 24000, "seconds": 10.36}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0084_always_candidate.wav", "sha256": "20bd4dc0a69038232094cfaaeceae792f86fbb0b90ea87e04705140507aa09b4", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0084_always_stall.wav", "sha256": "b8e55f256b4961f97c52e7e5989d8605c957