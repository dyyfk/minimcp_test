{"id": "sdqa0105", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1465092891, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When did Sardinia become part of Italy?", "input_path": "/data/sdqa_audio/sdqa0105.wav", "input_sha256": "4a6c31123fa0de32ab5403dc819aadac25e589d5a1f16d49007f577cf1698e44", "input_samples": 88058, "input_s": 5.504, "n_real_chunks": 6, "score": 0.6308, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Sardinia became part of Italy in 1861, when the Kingdom of Italy was proclaimed on March 17, 1861. Before that, Sardinia was part of the Kingdom of Sardinia, which led the movement for Italian unification.", "expert_answer": "Sardinia became part of Italy in **1861**, when the **Kingdom of Italy was proclaimed on March 17, 1861**.\n\nBefore that, Sardinia was part of the **Kingdom of Sardinia**, which led the movement for Italian unification.", "transcript": "When did Sardinia become part of Italy?\n", "asr_s": 0.51, "expert_s": 1.85, "expert_input_samples": 88058, "expert_input_s": 5.504, "expert_input_sha256": "4a6c31123fa0de32ab5403dc819aadac25e589d5a1f16d49007f577cf1698e44", "expert_timed_out": false, "wait_s": 1.24, "relay_synth_ms": 8115, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 344, "feed_lag_sum_ms": 344, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0105_always_relay.wav", "sha256": "eb370fe976e92588d219b15c44605781331217db0e8ad549fd8d98bb4d068c6a", "sr": 24000, "seconds": 14.84}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0105_always_candidate.wav", "sha256": "abc31daceb8b944283035ec01f84a9795fe5345ebf609a2942090bb75375d9a