{"id": "sdqa0124", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 308467983, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What does sui generis mean?", "input_path": "/data/sdqa_audio/sdqa0124.wav", "input_sha256": "6babcc5e17228cde83aa93b9ddb20ebc4bc1b01fdfa9ddad974dc70a32a69686", "input_samples": 53925, "input_s": 3.37, "n_real_chunks": 4, "score": 0.6582, "act": 0.9985, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Sui generis means “of its own kind” or “unique.” It’s a Latin phrase used to describe something that is in a class by itself, unlike anything else. For example: Her writing style is sui generis means her style is distinctive and unique.", "expert_answer": "**Sui generis** means **“of its own kind”** or **“unique.”**\n\nIt’s a Latin phrase used to describe something that is in a class by itself, unlike anything else. For example: *Her writing style is sui generis* means her style is distinctive and unique.", "transcript": "What does sui generis mean?\n", "asr_s": 0.55, "expert_s": 2.03, "expert_input_samples": 53925, "expert_input_s": 3.37, "expert_input_sha256": "6babcc5e17228cde83aa93b9ddb20ebc4bc1b01fdfa9ddad974dc70a32a69686", "expert_timed_out": false, "wait_s": 1.529, "relay_synth_ms": 10335, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 337, "feed_lag_sum_ms": 337, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0124_always_relay.wav", "sha256": "76fed826fbd7875eaac6aa0faf29374091686a96017247db725f14583119fd72", "sr": 24000, "seconds": 19.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0124_always_candidate.wav", "sha256": "45a05bae99a6412c05d9c11a