{"id": "sdqa0074", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1859602301, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When was the Royal Observer Corps established?", "input_path": "/data/sdqa_audio/sdqa0074.wav", "input_sha256": "f96106e2c8eece3196ec2f4c033db0ba4dc535573637ca1871e8927493be37fa", "input_samples": 88976, "input_s": 5.561, "n_real_chunks": 6, "score": 0.7108, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Royal Observer Corps was established in 1925 (originally as the Observer Corps). It was granted the “Royal” title in 1941.", "expert_answer": "The **Royal Observer Corps** was established in **1925** (originally as the **Observer Corps**). It was granted the “Royal” title in **1941**.", "transcript": "When was the Royal Observer Corps established?\n", "asr_s": 0.63, "expert_s": 2.51, "expert_input_samples": 88976, "expert_input_s": 5.561, "expert_input_sha256": "f96106e2c8eece3196ec2f4c033db0ba4dc535573637ca1871e8927493be37fa", "expert_timed_out": false, "wait_s": 2.392, "relay_synth_ms": 4970, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0074_always_relay.wav", "sha256": "7013f625d825fd8aab686970be0665988120c00bd12e15b883c7e9f20d132fa7", "sr": 24000, "seconds": 9.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0074_always_candidate.wav", "sha256": "ad4e354c40a5abee04e592be6d3996281a39a84c77aec38c082226c07771105b", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0074_always_stall.wav", "sha256": "3724a47b5ea96a9956ec16