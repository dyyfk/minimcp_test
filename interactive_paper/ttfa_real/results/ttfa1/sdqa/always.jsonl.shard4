{"id": "sdqa0151", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 759806791, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "What is the largest type of mosquito?", "input_path": "/data/sdqa_audio/sdqa0151.wav", "input_sha256": "13017d775aea4dfd9b8649f54e4d6755afb6496268d35e9aa01f51ab565e4369", "input_samples": 49082, "input_s": 3.068, "n_real_chunks": 4, "score": 0.6864, "act": 0.9993, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The largest type of mosquito is generally considered to be the elephant mosquito, especially species in the genus Toxorhynchites. Answer: Elephant mosquito (Toxorhynchites).", "expert_answer": "The largest type of mosquito is generally considered to be the **elephant mosquito**, especially species in the genus **Toxorhynchites**.\n\n**Answer: Elephant mosquito (*Toxorhynchites*)**.", "transcript": "What is the largest type of mosquito?\n", "asr_s": 0.58, "expert_s": 2.08, "expert_input_samples": 49082, "expert_input_s": 3.068, "expert_input_sha256": "13017d775aea4dfd9b8649f54e4d6755afb6496268d35e9aa01f51ab565e4369", "expert_timed_out": false, "wait_s": 1.319, "relay_synth_ms": 6206, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 561, "feed_lag_sum_ms": 618, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0151_always_relay.wav", "sha256": "402695474a92d82e82e663f3f6ebd172f56175e4b0f37d468d71eafebaf242ee", "sr": 24000, "seconds": 12.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0151_always_candidate.wav", "sha256": "ef42ecd44a3bd0739c8d57553f0401e3777372c1b0966f9e371d7cc67430c304", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_re