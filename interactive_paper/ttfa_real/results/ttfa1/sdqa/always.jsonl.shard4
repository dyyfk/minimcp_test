{"id": "sdqa0115", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1313389146, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "When was the Roman Republic formed?", "input_path": "/data/sdqa_audio/sdqa0115.wav", "input_sha256": "d8d5c0f6f7be65951138bf657b524cef07d6fcea510543695534b2e9fd9cb5d3", "input_samples": 81348, "input_s": 5.084, "n_real_chunks": 6, "score": 0.2706, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Roman Republic was formed in 509 BCE, after the overthrow of the Roman monarchy and the expulsion of the last king, Lucius Tarquinius Superbus.", "expert_answer": "The **Roman Republic was formed in 509 BCE**, after the overthrow of the Roman monarchy and the expulsion of the last king, **Lucius Tarquinius Superbus**.", "transcript": "When was the Roman Republic formed?\n", "asr_s": 0.57, "expert_s": 1.89, "expert_input_samples": 80000, "expert_input_s": 5.0, "expert_input_sha256": "c534628a4f1370299ce481429d90ac001f78c96a7d2458d8c5b1df5217871c95", "expert_timed_out": false, "wait_s": 1.512, "relay_synth_ms": 5789, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0115_always_relay.wav", "sha256": "9f27e271582d3afe7bb1faa774f06b81f76d3bd02de54a7d95b73a43d905238c", "sr": 24000, "seconds": 10.76}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0115_always_candidate.wav", "sha256": "fc86fc6729b7569de2aa4831dcfacfc10308127c27c85d8203cff7c570e2e7d4", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0115_always_stall.wav", "sha256": "913c47abd47