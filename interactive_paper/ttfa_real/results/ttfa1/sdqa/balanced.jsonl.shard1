{"id": "sdqa0174", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1863658826, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "How large is Antarctica?", "input_path": "/data/sdqa_audio/sdqa0174.wav", "input_sha256": "2417720a457be70e6bb13341117a36feb8cc70288e258f0f0572653841909006", "input_samples": 40844, "input_s": 2.553, "n_real_chunks": 3, "score": 0.2929, "act": 0.9952, "is_info": true, "fired": false, "mode": "local", "answer": "Antarctica is the fifth largest continent on Earth, covering about 14 million square kilometers. It is roughly twice the size of Australia and almost two and a half times larger than Europe. Despite its vast area, it has no permanent residents, only scientists at research stations.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0174_balanced_local.wav", "sha256": "88134d777ef3546d443f30130876cd88e0e0381fccaaf2e9f8104713639db56f", "sr": 24000, "seconds": 15.28}}, "chunks": [[0, 1, 1.0, 1.059, 1.107, 1, 0, 0], [1, 1, 2.0, 2.06, 2.109, 1, 0, 0], [2, 1, 2.553, 2.611, 2.659, 1, 0, 0], [3, 0, 3.553, 3.611, 4.201, 0, 24000, 0], [4, 0, 4.553, 4.612, 5.127, 0, 24000, 0], [5, 0, 5.553, 5.612, 6.16, 0, 24000, 0], [6, 0, 6.553, 6.613, 7.187, 0, 24000, 0], [7, 0, 7.553, 7.614, 8.21, 0, 24000, 0], [8, 0, 8.553, 8.613, 9.138, 0, 24000, 0], [9, 0, 9.553, 9.61, 10.167, 0, 24000, 0],