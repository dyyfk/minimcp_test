{"id": "sdqa0154", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1562595272, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "When did the Brooklyn Nets move to Brooklyn?", "input_path": "/data/sdqa_audio/sdqa0154.wav", "input_sha256": "e90449aa409c6b7e9b801b7e3f9003220f0bbda127387fc3343ecf24bd2f5ee5", "input_samples": 47010, "input_s": 2.938, "n_real_chunks": 3, "score": 0.5591, "act": 0.9987, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Brooklyn Nets moved to Brooklyn in 2012. They were previously the New Jersey Nets and began playing in Brooklyn at the Barclays Center for the 2012–13 NBA season.", "expert_answer": "The **Brooklyn Nets moved to Brooklyn in 2012**.\n\nThey were previously the **New Jersey Nets** and began playing in Brooklyn at the **Barclays Center** for the **2012–13 NBA season**.", "transcript": "When did the Brooklyn Nets move to Brooklyn?\n", "asr_s": 0.6, "expert_s": 1.86, "expert_input_samples": 47010, "expert_input_s": 2.938, "expert_input_sha256": "e90449aa409c6b7e9b801b7e3f9003220f0bbda127387fc3343ecf24bd2f5ee5", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 6715, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 8, "feed_lag_max_ms": 616, "feed_lag_sum_ms": 1343, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0154_always_relay.wav", "sha256": "3f95e3d2f8df8c5ed4ed2f23ec8cc3ec1ed5df598e8dc78a57aca8ed52d9c1a1", "sr": 24000, "seconds": 11.12}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0154_always_candidate.wav", "sha256": "ec9ef38adf399a3932662032387cce0dbab2e1c821bf8cbf6a122e117ef1110d", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_r