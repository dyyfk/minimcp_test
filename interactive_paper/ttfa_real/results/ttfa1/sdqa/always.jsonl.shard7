{"id": "sdqa0146", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2855673765, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "When was the KHON-TV station established?", "input_path": "/data/sdqa_audio/sdqa0146.wav", "input_sha256": "a0fd3218d4204ef4c4524812b0c183bcb5842841039e554b8486159b2e8cd003", "input_samples": 64779, "input_s": 4.049, "n_real_chunks": 5, "score": 0.8843, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "KHON-TV was established when it first signed on the air on November 16, 1952. It originally operated as KONA-TV before becoming KHON-TV in 1965. (en.wikipedia.org)", "expert_answer": "KHON-TV was established when it first signed on the air on **November 16, 1952**. It originally operated as **KONA-TV** before becoming KHON-TV in 1965. ([en.wikipedia.org](https://en.wikipedia.org/wiki/KHON-TV?utm_source=openai))", "transcript": "When was the KHON TV station established?\n", "asr_s": 0.91, "expert_s": 5.17, "expert_input_samples": 64779, "expert_input_s": 4.049, "expert_input_sha256": "a0fd3218d4204ef4c4524812b0c183bcb5842841039e554b8486159b2e8cd003", "expert_timed_out": false, "wait_s": 5.234, "relay_synth_ms": 10302, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 105, "feed_lag_sum_ms": 105, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0146_always_relay.wav", "sha256": "7f30d5c51a85967721e0a86d11236cb3953971092ef99d62526823d0dbdfe4e4", "sr": 24000, "seconds": 17.36}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0146_always_candidate.wav", "sha256": "f225e33373928918278616ec342538892e22ef2bed7c6883e6334cb7f533836c", "sr": 24000, "seconds"