{"id": "sdqa0068", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2121939479, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "When did the cartoon DuckTales first air?", "input_path": "/data/sdqa_audio/sdqa0068.wav", "input_sha256": "070fc3b564155e1741954ab6c842c7c5dd079ec399440563cade215f7ed1a52e", "input_samples": 80208, "input_s": 5.013, "n_real_chunks": 6, "score": 0.6353, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "DuckTales first aired on September 18, 1987, debuting with the TV movie/pilot “Treasure of the Golden Suns.”", "expert_answer": "**DuckTales first aired on September 18, 1987**, debuting with the TV movie/pilot **“Treasure of the Golden Suns.”**", "transcript": "When did the cartoon DuckTales first air?\n", "asr_s": 0.53, "expert_s": 2.9, "expert_input_samples": 80208, "expert_input_s": 5.013, "expert_input_sha256": "070fc3b564155e1741954ab6c842c7c5dd079ec399440563cade215f7ed1a52e", "expert_timed_out": false, "wait_s": 0.843, "relay_synth_ms": 5042, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 3, "feed_lag_max_ms": 552, "feed_lag_sum_ms": 988, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0068_always_relay.wav", "sha256": "5f4659132a591d7bb27e5f40dcdbfd222d2203053b07eded2398de43e702b951", "sr": 24000, "seconds": 8.8}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0068_always_candidate.wav", "sha256": "9305697f5f103503142f79996bbc2f7edaa7289cc20986794d24b4850e2b0493", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0068_always_stall.wav", "sha256": "d8cefe73a7ab05891ff58ab62ceb2d2dccada39d3c89756a2651edff1e1c849b", "sr": 24