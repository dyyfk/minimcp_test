2.073, 2.13, 1, 0, 0], [2, 1, 3.0, 3.074, 3.131, 1, 0, 0], [3, 1, 4.0, 4.073, 4.128, 1, 0, 0], [4, 1, 5.0, 5.076, 5.135, 1, 0, 0], [5, 1, 6.0, 6.074, 6.133, 1, 0, 0], [6, 1, 7.0, 7.075, 7.135, 1, 0, 0], [7, 1, 8.0, 8.075, 8.136, 1, 0, 0], [8, 1, 8.298, 8.373, 9.126, 0, 24000, 0], [9, 0, 9.298, 9.91, 10.547, 0, 25920, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 8.298, "last_real_feed_done": 8.373, "onset": 9.126, "gate_read_done": 9.126, "fire": 9.126, "candidate_first_pcm": 9.126, "stall_note": 9.127, "stall_first_pcm": 9.834, "local_first_pcm": null, "wait_start": 10.547, "expert_req": 9.127, "expert_resp": 11.254, "relay_synth_start": 11.255, "relay_first_pcm": 12.078, "relay_synth_end": 15.288, "first_any_pcm": 9.126, "first_answer_pcm": 12.078, "session_end": 15.426}, "ttfa_answer_s": 3.78, "ttfa_any_s": 0.827}
{"id": "sdqa0088", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3774420889, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "What is the pink tax?", "input_path": "/data/sdqa_audio/sdqa0088.wav", "input_sha256": "ad620eaa41fe881723d5c9e86415e8d2b035cb0fc932e733dee933cc4bbd8d86", "input_samples": 66554, "input_s": 4.16, "n_real_chunks": 5, "score": 0.8019, "act": 0.9964, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The pink tax is the tendency for products or services marketed to women to cost more than substantially similar products or services marketed to men. Examples often cited include higher prices for women’s razors, deodorant, clothing, dry cleaning, haircuts, or personal care products—even when the underlying product or service is very similar. It is called a “tax,” but it is usually not an actual government tax; it refers to gender-based price differences in the marketplace.", "expert_answer": "The **pink tax** is the tendency for products or services marketed to women to cost more than substantially similar products or services marketed to men.\n\nExamples often cited include higher prices for women’s razors, deodorant, clothing, dry cleaning, haircuts, or personal care products—even when the underlying product or service is very similar. It is called a “tax,” but it is usually **not an actual government tax**; it refers to gender-based price differences in the marketplace.", "transcript": "What is the pink tax?\n", "asr_s": 0.57, "expert_s": 2.58, "expert_input_samples": 66554, "expert_input_s": 4.16, "expert_input_sha256": "ad620eaa41fe881723d5c9e86415e8d2b035cb0fc932e733dee933cc4bbd8d86", "expert_timed_out": false, "wait_s": 1.782, "relay_synth_ms": 16746, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 339, "feed_lag_sum_ms": 341, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_always_relay.wav", "sha256": "7b1b8d6f25b0988aa3c91040f70999a2f8a0e35e4bd262228a2782f5a298606a", "sr": 24000, "seconds": 30.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_always_candidate.wav", "sha256": "a3de2e4cd3d46001a0eefcf8be481f93656e2b111e9a99351906d79355e5846a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0088_always_stall.wav", "sha256": "9ec07e5a676f13b99b83607cad45ded3410140eca21eaa917af407b5ab32590f", "sr": 24000, "seconds": 2.08}}, "chunks": [[0, 1, 1.0, 1.077, 1.141, 1, 0, 0], [1, 1, 2.0, 2.103, 2.179, 1, 0, 0], [2, 1, 3.0, 3.117, 3.194, 1, 0, 0], [3, 1, 4.0, 4.088, 4.162, 1, 0, 0], [4, 1, 4.16, 4.244, 4.851, 0, 24000, 0], [5, 0, 5.16, 5.583, 6.227, 0, 25920, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.16, "last_real_feed_done": 4.244, "onset": 4.851, "gate_read_done": 4.851, "fire": 4.851, "candidate_first_pcm": 4.851, "stall_note": 4.852, "stall_first_pcm": 5.499, "local_first_pcm": null, "wait_start": 6.227, "expert_req": 4.852, "expert_resp": 8.008, "relay_synth_start": 8.009, "relay_first_pcm": 8.822, "relay_synth_end": 24.755, "first_any_pcm": 4.851, "first_answer_pcm": 8.822, "session_end": 24.952}, "ttfa_answer_s": 4.663, "ttfa_any_s": 0.691}
{"id": "sdqa0100", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 658079636, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "How do thermostats work?", "input_path": "/data/sdqa_audio/sdqa0100.wav", "input_sha256": "a4f34bb1b84a9a1627361fd8d508b452490a1ed118152546bff6e44738aef8df", "input_samples": 70381, "input_s": 4.399, "n_real_chunks": 5, "score": 0.2686, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Thermostats work by measuring temperature, comparing it to a set target temperature, and turning heating or cooling equipment on or off to keep the room near that target. In short: a thermostat is a control switch that uses temperature feedback to regulate heating and cooling systems.", "expert_answer": "Thermostats work by **measuring temperature**, comparing it to a **set target temperature**, and turning heating or cooling equipment **on or off** to keep the room near that target.\n\nBasic process:\n\n1. **You set a desired temperature**  \n   For example, 70°F.\n\n2. **A temperature sensor measures the current room temperature**  \n   Older thermostats may use a bimetal strip or mercury switch; modern ones use electronic sensors.\n\n3. **The thermostat compares actual vs. desired temperature**  \n   - If the room is colder than the set point, it signals the heater to turn on.\n   - If the room is warmer than the set point, it signals the air conditioner to turn on.\n   - If the temperature is close enough, it does nothing.\n\n4. **It uses a small tolerance range**  \n   Thermostats usually don’t switch exactly at one temperature, because that would cause rapid on/off cycling. Instead, they use a small buffer called **hysteresis**.  \n   Example: heat may turn on at 68°F and off at 70°F.\n\n5. **Modern thermostats can do more**  \n   Programmable and smart thermostats can follow schedules, learn habits, detect occupancy, connect to Wi‑Fi, and optimize energy use.\n\nIn short: a thermostat is a control switch that uses temperature feedback to regulate heating and cooling systems.", "transcript": "How do thermostats work?\n", "asr_s": 0.72, "expert_s": 4.42, "expert_input_samples": 70381, "expert_input_s": 4.399, "expert_input_sha256": "a4f34bb1b84a9a1627361fd8d508b452490a1ed118152546bff6e44738aef8df", "expert_timed_out": false, "wait_s": 4.006, "relay_synth_ms": 10029, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 195, "feed_lag_sum_ms": 195, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0100_always_relay.wav", "sha256": "7858782d8be390603327e5ec552a6d88fb9c3f31535be67254089f2c51d3f941", "sr": 24000, "seconds": 18.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0100_always_candidate.wav", "sha256": "d71ea16f6018b9d642d37b9dcdcfaa74d28bb419d0b0555c48ae35e25858e9b5", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0100_always_stall.wav", "sha256": "a4900ffcce1702d1c832b6e0cc680702ae693834f03615a6e308067c783d2277", "sr": 24000, "seconds": 1.84}}, "chunks": [[0, 1, 1.0, 1.071, 1.132, 1, 0, 0], [1, 1, 2.0, 2.071, 2.125, 1, 0, 0], [2, 1, 3.0, 3.073, 3.129, 1, 0, 0], [3, 1, 4.0, 4.073, 4.131, 1, 0, 0], [4, 1, 4.399, 4.475, 4.994, 0, 24000, 0], [5, 0, 5.399, 5.665, 6.13, 0, 20160, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.399, "last_real_feed_done": 4.475, "onset": 4.994, "gate_read_done": 4.994, "fire": 4.994, "candidate_first_pcm": 4.994, "stall_note": 4.996, "stall_first_pcm": 5.594, "local_first_pcm": null, "wait_start": 6.13, "expert_req": 4.995, "expert_resp": 10.137, "relay_synth_start": 10.137, "relay_first_pcm": 10.939, "relay_synth_