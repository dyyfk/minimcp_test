{"id": "sdqa0051", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 747360624, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Where is the Sanjay Gandhi National Park?", "input_path": "/data/sdqa_audio/sdqa0051.wav", "input_sha256": "32be8799d3eb42d625fc7b9504f0c66f7734437c88ea44a2827a343be08bed48", "input_samples": 59728, "input_s": 3.733, "n_real_chunks": 4, "score": 0.6337, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Sanjay Gandhi National Park is in Mumbai, Maharashtra, India. It lies in the northern part of Mumbai, with areas extending into Thane.", "expert_answer": "Sanjay Gandhi National Park is in **Mumbai, Maharashtra, India**. It lies in the northern part of Mumbai, with areas extending into **Thane**.", "transcript": "Where is the Sanjay Gandhi National Park?\n", "asr_s": 0.58, "expert_s": 1.94, "expert_input_samples": 59728, "expert_input_s": 3.733, "expert_input_sha256": "32be8799d3eb42d625fc7b9504f0c66f7734437c88ea44a2827a343be08bed48", "expert_timed_out": false, "wait_s": 1.762, "relay_synth_ms": 4931, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0051_always_relay.wav", "sha256": "161a7cd6ca82c9477af702d6ed753c3c29881db70a7dbb4d587d7edef949bf11", "sr": 24000, "seconds": 8.68}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0051_always_candidate.wav", "sha256": "ebb7bde5d1fb730136523eeda36e4aa41207f987f859d34553f2c2c40886253f", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0051_always_stall.wav", "sha256": "158c8c6a275dbbec5896309dd