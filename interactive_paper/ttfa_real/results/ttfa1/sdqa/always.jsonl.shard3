{"id": "sdqa0047", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3706930436, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "When did The Prizefighter series begin?", "input_path": "/data/sdqa_audio/sdqa0047.wav", "input_sha256": "8e03261cef70d7a2335ec7f377e32b95c7a299fb67cfcfe1015ed4753ed9e97d", "input_samples": 87034, "input_s": 5.44, "n_real_chunks": 6, "score": 0.8929, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Prizefighter boxing tournament series began in April 2008. Its first event, Prizefighter 1: The Heavyweights, took place at York Hall, Bethnal Green, London. (matchroomboxing.com)", "expert_answer": "The **Prizefighter boxing tournament series** began in **April 2008**. Its first event, **Prizefighter 1: The Heavyweights**, took place at **York Hall, Bethnal Green, London**. ([matchroomboxing.com](https://www.matchroomboxing.com/news/1million-prizefighter-is-back-new-eight-man-winner-takes-all-fight-series-will-launch-in-japan-on-march-31/?utm_source=openai))", "transcript": "When did the Prize Fighter series begin?\n", "asr_s": 0.49, "expert_s": 4.85, "expert_input_samples": 87034, "expert_input_s": 5.44, "expert_input_sha256": "8e03261cef70d7a2335ec7f377e32b95c7a299fb67cfcfe1015ed4753ed9e97d", "expert_timed_out": false, "wait_s": 4.353, "relay_synth_ms": 9939, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0047_always_relay.wav", "sha256": "5814dd545d7e90d00800102374296ee93a113f3474775cb071861f9994e25376", "sr": 24000, "seconds": 13.32}, "candidate": {"path": "/data/ttfa_real/ttfa1