{"id": "sdqa0003", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3220325401, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What do Grasshoppers eat?", "input_path": "/data/sdqa_audio/sdqa0003.wav", "input_sha256": "98aec32934a41042510608289a9f5141be493c5fc83a765df669d6006eb32fe6", "input_samples": 82938, "input_s": 5.184, "n_real_chunks": 6, "score": 0.146, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Grasshoppers are mostly herbivores. They eat plants such as: Grass , Leaves , Cereal crops like wheat, corn, rice, and barley , Flowers , Seeds , Stems Some grasshoppers may occasionally eat dead insects or decaying plant matter, but their main diet is green vegetation.", "expert_answer": "Grasshoppers are mostly **herbivores**. They eat plants such as:\n\n- **Grass**\n- **Leaves**\n- **Cereal crops** like wheat, corn, rice, and barley\n- **Flowers**\n- **Seeds**\n- **Stems**\n\nSome grasshoppers may occasionally eat **dead insects or decaying plant matter**, but their main diet is green vegetation.", "transcript": "What do grasshoppers eat?\n", "asr_s": 3.18, "expert_s": 3.04, "expert_input_samples": 82938, "expert_input_s": 5.184, "expert_input_sha256": "98aec32934a41042510608289a9f5141be493c5fc83a765df669d6006eb32fe6", "expert_timed_out": false, "wait_s": 2.858, "relay_synth_ms": 11739, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0003_always_relay.wav", "sha256": "297a465d401c9aa0a43ccc07c7eee0c793f2de020d2788f19c5b8c9cd62bc8f6", "sr": 24000, "seconds": 20.6}, "candidate": {"path": "/data/ttfa_