{"id": "sdqa0038", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 51236434, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Who invented air conditioning?", "input_path": "/data/sdqa_audio/sdqa0038.wav", "input_sha256": "69d033fe434b0f5c5d1e19bdc8a2d6ab0dc807838ef9d719bd6816b2113ca9ca", "input_samples": 56661, "input_s": 3.541, "n_real_chunks": 4, "score": 0.5432, "act": 0.9994, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Willis Haviland Carrier is generally credited with inventing modern air conditioning. He designed the first modern electrical air-conditioning system in 1902.", "expert_answer": "**Willis Haviland Carrier** is generally credited with inventing modern air conditioning. He designed the first modern electrical air-conditioning system in **1902**.", "transcript": "Who invented air conditioning?\n", "asr_s": 0.58, "expert_s": 1.8, "expert_input_samples": 56661, "expert_input_s": 3.541, "expert_input_sha256": "69d033fe434b0f5c5d1e19bdc8a2d6ab0dc807838ef9d719bd6816b2113ca9ca", "expert_timed_out": false, "wait_s": 0.959, "relay_synth_ms": 6474, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 354, "feed_lag_sum_ms": 354, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0038_always_relay.wav", "sha256": "45644aed55b6cf31934dc217ceb546e01406009bed4a20bd08292ce1dafaac70", "sr": 24000, "seconds": 9.76}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0038_always_candidate.wav", "sha256": "a4857e7ef3f71968f62e2aaa934971a5a1a84a8e7015d0d2456d97601ec7742b", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0038_always_stall.wav", "sha256"