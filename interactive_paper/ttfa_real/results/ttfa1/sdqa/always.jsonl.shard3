{"id": "sdqa0114", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 961514188, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Where was Albert Neisser born?", "input_path": "/data/sdqa_audio/sdqa0114.wav", "input_sha256": "5705ec9324dedac08bec03b4e2397ff571c4cf0ff7727fb5ab6f88a228caeb86", "input_samples": 74546, "input_s": 4.659, "n_real_chunks": 5, "score": 0.7533, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Albert Neisser was born in Schweidnitz, Prussia — now Świdnica, Poland.", "expert_answer": "Albert Neisser was born in **Schweidnitz, Prussia** — now **Świdnica, Poland**.", "transcript": "Where was Albert Neisser born?\n", "asr_s": 0.83, "expert_s": 1.57, "expert_input_samples": 74546, "expert_input_s": 4.659, "expert_input_sha256": "5705ec9324dedac08bec03b4e2397ff571c4cf0ff7727fb5ab6f88a228caeb86", "expert_timed_out": false, "wait_s": 0.882, "relay_synth_ms": 3205, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 278, "feed_lag_sum_ms": 278, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0114_always_relay.wav", "sha256": "b499d4a288bbca9526bafe643d5ea23eee5fbdc7a00b12d6b9afafab80f99c28", "sr": 24000, "seconds": 5.84}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0114_always_candidate.wav", "sha256": "5445d73be0e35f8d869240977864393d716b98950000dc600ec225d3195256d6", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0114_always_stall.wav", "sha256": "7d08a9f30fb82a9ec5cd75ce1e9f89d142da661e502173ad56f109266e69ffda", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.068, 1.122, 1, 0, 0], [1, 1, 2.0, 2.071, 2.123, 1, 0, 0], [2, 1, 3.0, 3.068, 3.123, 1, 0, 0], [3, 1, 4.0, 4.068, 4.123, 1, 0, 0], [4, 1, 4.659, 4.73, 5.32, 0, 24000, 0], [5, 0, 5.659, 6.003, 6.847, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.659, "last_real_feed_done": 4.73, "onset": 5.32, "gate_read_done": 5.321, "fire": 5.321, "candidate_first_pcm": 5.32, "stall_note": 5.321, "stall_first_pcm": 5.937, "local_first_pcm": null, "wait_start": 6.847, "expert_req": 5.321, "expert_resp": 7.729, "relay_synth_start": 7.729, "relay_first_pcm": 8.474, "relay_synth_end": 10.934, "first_any_pcm": 5.32, "first_answer_pcm": 8.474, "session_end": 11.449}, "ttfa_answer_s": 3.815, "ttfa_any_s": 0.661}
{"id": "sdqa0123", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2349223084, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "When did the British Empire end?", "input_path": "/data/sdqa_audio/sdqa0123.wav", "input_sha256": "8e235060d23aeab3018c6e6f3a48821e01a75ec96945dde8d1b991cc863c6dde", "input_samples": 47098, "input_s": 2.944, "n_real_chunks": 3, "score": 0.4107, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "There isn’t one exact end date, but the British Empire is usually considered to have ended after World War II during decolonization, especially between 1947 and the 1960s. Common symbolic endpoints include: 1947 — India and Pakistan gained independence, a major turning point. , 1997 — Britain handed Hong Kong back to China, often called the symbolic end of the British Empire. So the best concise answer is: the British Empire effectively ended in the decades after World War II, with 1997 as a common symbolic final date.", "expert_answer": "There isn’t one exact end date, but the **British Empire is usually considered to have ended after World War II during decolonization**, especially between **1947 and the 1960s**.\n\nCommon symbolic endpoints include:\n\n- **1947** — India and Pakistan gained independence, a major turning point.\n- **1997** — Britain handed Hong Kong back to China, often called the symbolic end of the British Empire.\n\nSo the best concise answer is: **the British Empire effectively ended in the decades after World War II, with 1997 as a common symbolic final date.**", "transcript": "When did the British Empire end?\n", "asr_s": 0.58, "expert_s": 2.71, "expert_input_samples": 47098, "expert_input_s": 2.944, "expert_input_sha256": "8e235060d23aeab3018c6e6f3a48821e01a75ec96945dde8d1b991cc863c6dde", "expert_timed_out": false, "wait_s": 2.489, "relay_synth_ms": 20968, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0123_always_relay.wav", "sha256": "379c67421ca0fe6096e9210313e3f5249bdf97f76e006eeab6e83a0c818468d9", "sr": 24000, "seconds": 40.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0123_always_candidate.wav", "sha256": "524eba21eeff0f94edd3a181bea5f4af1298e761b65afe0702d5cdfd95221b0e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0123_always_stall.wav", "sha256": "cb842dcd09a280d9a30ef8c65524883801015de8fe891ec5a5be9bf2ba33bf44", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.068, 1.124, 1, 0, 0], [1, 1, 2.0, 2.072, 2.132, 1, 0, 0], [2, 1, 2.944, 3.023, 3.085, 1, 0, 0], [3, 0, 3.944, 4.037, 4.794, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.944, "last_real_feed_done": 3.023, "onset": 4.794, "gate_read_done": 4.795, "fire": 4.795, "candidate_first_pcm": 4.794, "stall_note": 4.796, "stall_first_pcm": 5.591, "local_first_pcm": null, "wait_start": 5.591, "expert_req": 4.795, "expert_resp": 8.08, "relay_synth_start": 8.081, "relay_first_pcm": 8.866, "relay_synth_end": 29.049, "first_any_pcm": 4.794, "first_answer_pcm": 8.866, "session_end": 29.44}, "ttfa_answer_s": 5.923, "ttfa_any_s": 1.851}
{"id": "sdqa0131", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2064850113, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "How far does I75 go?", "input_path": "/data/sdqa_audio/sdqa0131.wav", "input_sha256": "9404e234de31e34e544c11886e6fdb732e59446763f4e2609266d0e77b5dac39", "input_samples": 58112, "input_s": 3.632, "n_real_chunks": 4, "score": 0.732, "act": 0.9995, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Interstate 75 (I-75) is about 1,786 miles long. It runs from Hialeah, Florida, near Miami, north to Sault Ste. Marie, Michigan, at the Canadian border.", "expert_answer": "**Interstate 75 (I-75) is about 1,786 miles long.**\n\nIt runs from **Hialeah, Florida**, near Miami, north to **Sault Ste. Marie, Michigan**, at the Canadian border.", "transcript": "How far does I-75 go?\n", "asr_s": 0.5, "expert_s": 3.56, "expert_input_samples": 58112, "expert_input_s": 3.632, "expert_input_sha256": "9404e234de31e34e544c11886e6fdb732e59446763f4e2609266d0e77b5dac39", "expert_timed_out": false, "wait_s": 3.322, "relay_synth_ms": 7376, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0131_always_relay.wav", "sha256": "19b36fb227d581647af0294eae64d4fa8350260b7a904709c94ab65b5049a179", "sr": 24000, "seconds": 14.2}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0131_always_candidate.wav", "sha256": "6af9c5d3a3e577f461d6d76c27badd838024b1bbc0b48157a6bf3f5e3e5c648a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0131_always_stall.wav", "sha256": "06fa7c4bcc1545b56aee977d83