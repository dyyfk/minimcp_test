{"id": "sdqa0083", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1999359505, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "When was the Iliad first written down?", "input_path": "/data/sdqa_audio/sdqa0083.wav", "input_sha256": "7c1b4a90fd3afded20afcaf3037ced9077b1ebcf928ee8649aac3ae826b7d237", "input_samples": 71674, "input_s": 4.48, "n_real_chunks": 5, "score": 0.5421, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Iliad was likely first written down in the late 8th century BCE or early 7th century BCE — roughly around 750–700 BCE. It had probably circulated orally for generations before being committed to writing.", "expert_answer": "The **Iliad** was likely first written down in the **late 8th century BCE or early 7th century BCE** — roughly **around 750–700 BCE**.\n\nIt had probably circulated orally for generations before being committed to writing.", "transcript": "When was the Iliad first written down?\n", "asr_s": 0.56, "expert_s": 2.77, "expert_input_samples": 71674, "expert_input_s": 4.48, "expert_input_sha256": "7c1b4a90fd3afded20afcaf3037ced9077b1ebcf928ee8649aac3ae826b7d237", "expert_timed_out": false, "wait_s": 2.883, "relay_synth_ms": 9803, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0083_always_relay.wav", "sha256": "12181d3eea4068bb7ecc09b5e5c7ee2b1d568c10f966d9fc9b2e493b979eb145", "sr": 24000, "seconds": 18.72}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0083_always_candidate.wav", "sha256": "6a2271529186c21135ea89ae5aa0960a8e7e564d19f2adab18cbb43ae1bf9d65",