{"id": "sdqa0077", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4158527175, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the difference between speed and velocity?", "input_path": "/data/sdqa_audio/sdqa0077.wav", "input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "input_samples": 86352, "input_s": 5.397, "n_real_chunks": 6, "score": 0.0734, "act": 0.9989, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Speed is a scalar quantity: it tells how fast something is moving, with magnitude only. Velocity is a vector quantity: it tells how fast something is moving and in what direction. Example: Speed: 60 km/h , Velocity: 60 km/h north", "expert_answer": "**Speed** is a **scalar** quantity: it tells how fast something is moving, with **magnitude only**.\n\n**Velocity** is a **vector** quantity: it tells how fast something is moving **and in what direction**.\n\nExample:  \n- **Speed:** 60 km/h  \n- **Velocity:** 60 km/h north", "transcript": "What is the difference between speed and velocity?\n", "asr_s": 0.73, "expert_s": 1.77, "expert_input_samples": 86352, "expert_input_s": 5.397, "expert_input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "expert_timed_out": false, "wait_s": 1.829, "relay_synth_ms": 8809, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077_always_relay.wav", "sha256": "7cb81e9663230be81a1c6d9919209e49870e3f70945eae15251257a8f0f56317", "sr": 24000, "seconds": 19.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077