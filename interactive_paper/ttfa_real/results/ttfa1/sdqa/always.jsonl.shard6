{"id": "sdqa0117", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2688998262, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "When were the North American time zones established?", "input_path": "/data/sdqa_audio/sdqa0117.wav", "input_sha256": "523c94df601a199fc95063dfe5f4a2ab4ffe25bcc115fca0c2fb3b95d6fe64dc", "input_samples": 104586, "input_s": 6.537, "n_real_chunks": 7, "score": 0.7539, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "North American standard time zones were established on November 18, 1883, when U.S. and Canadian railroads adopted a standardized time system. They were later made official in the United States by the Standard Time Act of 1918.", "expert_answer": "North American standard time zones were established on **November 18, 1883**, when U.S. and Canadian railroads adopted a standardized time system.\n\nThey were later made official in the United States by the **Standard Time Act of 1918**.", "transcript": "When were the North American time zones established?\n", "asr_s": 0.68, "expert_s": 2.44, "expert_input_samples": 104586, "expert_input_s": 6.537, "expert_input_sha256": "523c94df601a199fc95063dfe5f4a2ab4ffe25bcc115fca0c2fb3b95d6fe64dc", "expert_timed_out": false, "wait_s": 2.237, "relay_synth_ms": 7624, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 183, "feed_lag_sum_ms": 183, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0117_always_relay.wav", "sha256": "9ccd6d4b3facc2ce8bce2e63235d6469a86d69bc1df4ab700b8635ec68699754", "sr": 24000, "seconds": 15.68}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0117_always_candidate.wav", "sha2