{"id": "sdqa0098", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4192347864, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "When did Julia Child write her book Mastering the Art of French Cooking?", "input_path": "/data/sdqa_audio/sdqa0098.wav", "input_sha256": "39c44778418e7b7b6e5b3c0b2fba886decf9865efb6da23a8c96ae37c44ff2a0", "input_samples": 131749, "input_s": 8.234, "n_real_chunks": 9, "score": 0.7068, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Julia Child co-wrote Mastering the Art of French Cooking during the 1950s, working on it for nearly a decade with Simone Beck and Louisette Bertholle. It was first published in 1961.", "expert_answer": "Julia Child co-wrote **_Mastering the Art of French Cooking_** during the **1950s**, working on it for nearly a decade with **Simone Beck** and **Louisette Bertholle**. It was first **published in 1961**.", "transcript": "When did Julia Child write her book, Mastering the Art of French Cooking?\n", "asr_s": 0.78, "expert_s": 2.22, "expert_input_samples": 128000, "expert_input_s": 8.0, "expert_input_sha256": "6e851aa070969755acf03a69fefed042dd4c3e5967133ea1759f7ab8635b119f", "expert_timed_out": false, "wait_s": 2.352, "relay_synth_ms": 5284, "onset_chunk": 7, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0098_always_relay.wav", "sha256": "1f3463d50854ab33a6c335db093c851d3402e9611ee665e49c234f8f70ac419e", "sr": 24000, "seconds": 11.0}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0098_always_candidate.wav", "sha256": "ef79d9d5eb83d07e6e0903da543a94a5aa4a979