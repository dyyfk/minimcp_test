{"id": "sdqa0087", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1883638280, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How many lanes does the autobahn have?", "input_path": "/data/sdqa_audio/sdqa0087.wav", "input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "input_samples": 86693, "input_s": 5.418, "n_real_chunks": 6, "score": 0.7489, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Autobahn does not have a fixed number of lanes. Most German Autobahns have 2 lanes in each direction — 4 lanes total — but busier sections often have 3 or more lanes each way, and some stretches have 4+ lanes per direction.", "expert_answer": "The **Autobahn does not have a fixed number of lanes**.\n\nMost German Autobahns have **2 lanes in each direction** — **4 lanes total** — but busier sections often have **3 or more lanes each way**, and some stretches have **4+ lanes per direction**.", "transcript": "How many lanes does the Autobahn have?\n", "asr_s": 1.05, "expert_s": 2.92, "expert_input_samples": 86693, "expert_input_s": 5.418, "expert_input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "expert_timed_out": false, "wait_s": 2.799, "relay_synth_ms": 7677, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 29, "feed_lag_sum_ms": 29, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_always_relay.wav", "sha256": "4b803819cb81111a64af22757bc58ecca1c0d563cb4295188d36a1fc0a19967b", "sr": 24000, "seconds": 16.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_always_candidate.wav", "sha256": "4cf0ff6bbd39c4