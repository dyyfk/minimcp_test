{"id": "sdqa0134", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 192538702, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How did Joseph Stalin died?", "input_path": "/data/sdqa_audio/sdqa0134.wav", "input_sha256": "812f75a58f453b6b544b849fb39b5564a926b0ad0cdc94f1e020f634baf7ae99", "input_samples": 60088, "input_s": 3.756, "n_real_chunks": 4, "score": 0.5027, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Joseph Stalin died on March 5, 1953, after suffering a stroke—specifically a cerebral hemorrhage—at his dacha near Moscow. He was 74.", "expert_answer": "Joseph Stalin died on **March 5, 1953**, after suffering a **stroke**—specifically a cerebral hemorrhage—at his dacha near Moscow. He was 74.", "transcript": "How did Joseph Stalin die?\n", "asr_s": 0.65, "expert_s": 1.87, "expert_input_samples": 60088, "expert_input_s": 3.756, "expert_input_sha256": "812f75a58f453b6b544b849fb39b5564a926b0ad0cdc94f1e020f634baf7ae99", "expert_timed_out": false, "wait_s": 1.899, "relay_synth_ms": 5532, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0134_always_relay.wav", "sha256": "cec89054e4250f8968eaa8431611da1bea539eb013c04f627912e306e6a053a9", "sr": 24000, "seconds": 11.28}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0134_always_candidate.wav", "sha256": "db9e805f37e2dcba771209af86c440c6475390af71aa4f39f03df17cc7bc7d9e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0134_always_stall.wav", "sha256": "ba34dbe9b333d6f24d078d9f31b6162f2cbd24042fa9fae1fe4f395