{"id": "sdqa0033", "pool": "sdqa", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2497648602, "protocol": "ttfa-v3", "config_sha256": "9d39a2003e15ffbac1b46fe5b0a53c242ef024ed6b8b1e37a92e22d426213d95", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the oldest overseas U.S. military base?", "input_path": "/data/sdqa_audio/sdqa0033.wav", "input_sha256": "caa1454aaab920611ded1514642b843a84f01ebb933302b5f5ed63d4a45ab159", "input_samples": 82256, "input_s": 5.141, "n_real_chunks": 6, "score": 0.8323, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The oldest overseas U.S. military base is Naval Station Guantánamo Bay in Cuba. The U.S. has maintained it since 1903, after leasing the site from Cuba, making it the oldest continuously operated U.S. military installation outside the United States.", "expert_answer": "The **oldest overseas U.S. military base is Naval Station Guantánamo Bay in Cuba**.\n\nThe U.S. has maintained it since **1903**, after leasing the site from Cuba, making it the oldest continuously operated U.S. military installation outside the United States.", "transcript": "What is the oldest overseas U.S. military base?\n", "asr_s": 0.58, "expert_s": 3.99, "expert_input_samples": 80000, "expert_input_s": 5.0, "expert_input_sha256": "cc53b97bc4615bf5560ac8d720df4c74a6126c4580feb9be25895df9c476f1a8", "expert_timed_out": false, "wait_s": 2.233, "relay_synth_ms": 8329, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 3, "feed_lag_max_ms": 1012, "feed_lag_sum_ms": 2139, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0033_always_relay.wav", "sha256": "8041ae0ee1e153a1104a5864ff1066d0519f9e57f43ab7ae6f98a8c5dae0e57c", "sr": 24000, "seconds": 18.64}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0