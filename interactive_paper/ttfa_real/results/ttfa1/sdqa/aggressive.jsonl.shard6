{"id": "sdqa0077", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4158527175, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the difference between speed and velocity?", "input_path": "/data/sdqa_audio/sdqa0077.wav", "input_sha256": "65c2863857034037922d2307e8ecc1229faf183d4e9565167e3cfd183b7da8b9", "input_samples": 86352, "input_s": 5.397, "n_real_chunks": 6, "score": 0.0799, "act": 0.9979, "is_info": true, "fired": false, "mode": "local", "answer": "Speed is a measure of how fast something moves, while velocity includes both speed and direction. For example, if you drive 60 miles per hour east, your speed is 60 miles per hour, but your velocity is 6 0 miles per hour east. So, speed tells you how fast you're going, while velocity tells you how fast and in which direction.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 12, "feed_lag_max_ms": 45, "feed_lag_sum_ms": 45, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0077_aggressive_local.wav", "sha256": "6259bc1a7400f091553abfff3cec10fe4def6e2f4055c07e1e1a70745ba75392", "sr": 24000, "seconds": 12.28}}, "chunks": [[0, 1, 1.0, 1.064, 1.115, 1, 0, 0], [1, 1, 2.0, 2.065, 2.115, 1, 0, 0], [2, 1, 3.0, 3.066, 3.117, 1, 0, 0], [3, 1, 4.0, 4.065, 4.117, 1, 0, 0], [4, 1, 5.0, 5.066, 5.119, 1, 0, 0], [5, 1, 5.397, 5.462, 6.148, 0, 24000, 0], [6, 0, 6.397, 6.462, 7.106, 0, 24000, 0], [7, 0, 7.397, 7.465, 8.048, 0, 24000, 0], [8, 0, 8.397, 8.464, 9.049, 0, 24000, 0], [9, 0, 9.397, 9.462, 9.982, 0, 24000, 0], [10, 0, 10.397, 10.463, 11.076, 0, 24000, 0], [11, 0, 11.397, 11.466, 12.138, 0, 24000, 0], [12, 0, 12.397, 12.465, 13.108, 0, 24000, 0], [13, 0, 13.397, 13.465, 14.344, 0, 24000, 0], [14, 0, 14.397, 14.463, 15.293, 0, 24000, 0], [15, 0, 15.397, 15.466, 16.442, 0, 24000, 0], [16, 0, 16.397, 16.507, 17.168, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 5.397, "last_real_feed_done": 5.462, "onset": 6.148, "gate_read_done": 6.148, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 6.148, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 6.148, "first_answer_pcm": 6.148, "session_end": 17.168}, "ttfa_answer_s": 0.751, "ttfa_any_s": 0.751}
{"id": "sdqa0087", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1883638280, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How many lanes does the autobahn have?", "input_path": "/data/sdqa_audio/sdqa0087.wav", "input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "input_samples": 86693, "input_s": 5.418, "n_real_chunks": 6, "score": 0.7864, "act": 0.9995, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "There isn’t one fixed number. Autobahns typically have 2 lanes per direction, but many busy stretches have 3 or more lanes per direction, while some older or less busy sections may have fewer.", "expert_answer": "There isn’t one fixed number. **Autobahns typically have 2 lanes per direction**, but many busy stretches have **3 or more lanes per direction**, while some older or less busy sections may have fewer.", "transcript": "How many lanes does the Autobahn have?\n", "asr_s": 0.69, "expert_s": 4.04, "expert_input_samples": 86693, "expert_input_s": 5.418, "expert_input_sha256": "43b18c1be091d0400a725caa188d86a598d645f5005547ada7c20071c50b46a9", "expert_timed_out": false, "wait_s": 4.365, "relay_synth_ms": 6859, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_aggressive_relay.wav", "sha256": "2e03c96680a631b9f09dff5b80f37ee38f75407cbde3d4f07b243a111c2e357e", "sr": 24000, "seconds": 13.76}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0087_aggressive_candidate.wav", "sha256": "2ef019dbb5b4f7338ab2e1d761b52a042478a89e0b1fe503835bde140508916b", "sr"