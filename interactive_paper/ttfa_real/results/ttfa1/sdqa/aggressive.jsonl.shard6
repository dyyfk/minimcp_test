{"id": "sdqa0109", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1592117040, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is Emmanouil Pappas known for?", "input_path": "/data/sdqa_audio/sdqa0109.wav", "input_sha256": "cd86ad4118c5bc5c85121d73b0df2a3f4d73b9b9a95b6fe05126fbae83223506", "input_samples": 71959, "input_s": 4.497, "n_real_chunks": 5, "score": 0.9221, "act": 0.9992, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Immanuel/Emmanouil Pappas is known as a Greek revolutionary leader in the Greek War of Independence, especially for leading and organizing the 1821 uprising in Macedonia and Chalkidiki against Ottoman rule. He was also a wealthy merchant and member of the Filiki Eteria who used much of his fortune to support the revolution. (en.wikipedia.org)", "expert_answer": "Immanuel/Emmanouil Pappas is known as a **Greek revolutionary leader in the Greek War of Independence**, especially for leading and organizing the 1821 uprising in **Macedonia and Chalkidiki** against Ottoman rule. He was also a wealthy merchant and member of the **Filiki Eteria** who used much of his fortune to support the revolution. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Emmanouel_Pappas?utm_source=openai))", "transcript": "What is Immanuel Pappas known for?\n", "asr_s": 0.66, "expert_s": 7.47, "expert_input_samples": 71959, "expert_input_s": 4.497, "expert_input_sha256": "cd86ad4118c5bc5c85121d73b0df2a3f4d73b9b9a95b6fe05126fbae83223506", "expert_timed_out": false, "wait_s": 6.373, "relay_synth_ms": 11771, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 618, "feed_lag_sum_ms": 618, "audio_fil