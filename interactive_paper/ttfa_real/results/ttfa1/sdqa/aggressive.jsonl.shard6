{"id": "sdqa0117", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2688998262, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "When were the North American time zones established?", "input_path": "/data/sdqa_audio/sdqa0117.wav", "input_sha256": "523c94df601a199fc95063dfe5f4a2ab4ffe25bcc115fca0c2fb3b95d6fe64dc", "input_samples": 104586, "input_s": 6.537, "n_real_chunks": 7, "score": 0.7539, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "North American standard time zones were established on November 18, 1883, when U.S. and Canadian railroads adopted a coordinated system of time zones. They were later given federal legal status in the United States by the Standard Time Act of March 19, 1918.", "expert_answer": "**North American standard time zones were established on November 18, 1883**, when U.S. and Canadian railroads adopted a coordinated system of time zones.\n\nThey were later given federal legal status in the United States by the **Standard Time Act of March 19, 1918**.", "transcript": "When were the North American time zones established?\n", "asr_s": 0.72, "expert_s": 4.15, "expert_input_samples": 104586, "expert_input_s": 6.537, "expert_input_sha256": "523c94df601a199fc95063dfe5f4a2ab4ffe25bcc115fca0c2fb3b95d6fe64dc", "expert_timed_out": false, "wait_s": 4.09, "relay_synth_ms": 8252, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 147, "feed_lag_sum_ms": 147, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0117_aggressive_relay.wav", "sha256": "9fa72efcc768e81bf8c298230185c582f6530311f2eedc89ef26209a007619fd", "sr": 24000, "seconds": 18.12}, "candi