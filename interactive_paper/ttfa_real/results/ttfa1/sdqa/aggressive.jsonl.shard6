{"id": "sdqa0098", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4192347864, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "When did Julia Child write her book Mastering the Art of French Cooking?", "input_path": "/data/sdqa_audio/sdqa0098.wav", "input_sha256": "39c44778418e7b7b6e5b3c0b2fba886decf9865efb6da23a8c96ae37c44ff2a0", "input_samples": 131749, "input_s": 8.234, "n_real_chunks": 9, "score": 0.7068, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Julia Child wrote Mastering the Art of French Cooking during the 1950s, in collaboration with Simone Beck and Louisette Bertholle. It was first published in 1961.", "expert_answer": "Julia Child wrote **_Mastering the Art of French Cooking_** during the **1950s**, in collaboration with **Simone Beck** and **Louisette Bertholle**.  \n\nIt was first **published in 1961**.", "transcript": "When did Julia Child write her book, Mastering the Art of French Cooking?\n", "asr_s": 1.14, "expert_s": 3.9, "expert_input_samples": 128000, "expert_input_s": 8.0, "expert_input_sha256": "6e851aa070969755acf03a69fefed042dd4c3e5967133ea1759f7ab8635b119f", "expert_timed_out": false, "wait_s": 4.343, "relay_synth_ms": 5145, "onset_chunk": 7, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0098_aggressive_relay.wav", "sha256": "40460adb539f5f70a0e4b05701e3cca0651ccfded3d5d4c8fc0150268665055f", "sr": 24000, "seconds": 9.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0098_aggressive_candidate.wav", "sha256": "ec60a9e65d924cac0f0463d80c7e2014bbb66c3050f06