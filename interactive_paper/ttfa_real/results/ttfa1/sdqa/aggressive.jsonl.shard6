{"id": "sdqa0134", "pool": "sdqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 192538702, "protocol": "ttfa-v3", "config_sha256": "55d54790f4984a1399d890ed29cf337bf030dd977d2cbf354d2e7727784c1c44", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "How did Joseph Stalin died?", "input_path": "/data/sdqa_audio/sdqa0134.wav", "input_sha256": "812f75a58f453b6b544b849fb39b5564a926b0ad0cdc94f1e020f634baf7ae99", "input_samples": 60088, "input_s": 3.756, "n_real_chunks": 4, "score": 0.3505, "act": 0.9993, "is_info": true, "fired": false, "mode": "local", "answer": "Joseph Stal in died of a stroke. He had been suffering from poor health for some time, and on March 5, 1 95 3, he suffered a massive cerebral haem orrhage while attending a meeting at his residence. He never regained consciousness and passed away later that same day. His death marked the end of an era in Soviet history, as he had ruled with absolute power for nearly three decades.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0134_aggressive_local.wav", "sha256": "0493a6898ad64e36a7c95e3cd0d3a6b338aa465e99ea79c8a579907929ef792a", "sr": 24000, "seconds": 22.92}}, "chunks": [[0, 1, 1.0, 1.063, 1.112, 1, 0, 0], [1, 1, 2.0, 2.06, 2.108, 1, 0, 0], [2, 1, 3.0, 3.063, 3.112, 1, 0, 0], [3, 1, 3.756, 3.815, 4.211, 0, 24000, 0], [4, 0, 4.755, 4.816, 5.404, 0, 24000, 0], [5, 0, 5.755, 5.818, 6.431, 0, 24000, 0], [6, 0, 6.755, 6.818, 7.419, 0, 24000, 0], [7, 0, 7.755, 7.