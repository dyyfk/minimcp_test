{"id": "sdqa0083", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1999359505, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "When was the Iliad first written down?", "input_path": "/data/sdqa_audio/sdqa0083.wav", "input_sha256": "7c1b4a90fd3afded20afcaf3037ced9077b1ebcf928ee8649aac3ae826b7d237", "input_samples": 71674, "input_s": 4.48, "n_real_chunks": 5, "score": 0.5282, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The Iliad was likely composed orally in ancient Greece around the 8th century BCE, but it wasn t written down until much later. Many scholars believe the earliest written version s of the text appeared during the Archaic period, roughly between the 7th and 6th centuries BC E. However, the poem' s first known complete manuscript dates back to around the 3rd century BC E. So while the story itself is much older, the written record of it became available several hundred years after its initial composition.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 22, "feed_lag_max_ms": 427, "feed_lag_sum_ms": 902, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0083_balanced_local.wav", "sha256": "c7abe87ebcd069f075283d819a0b7540b3887afe55b82366745c11147cc5f18b", "sr": 24000, "seconds": 22.28}}, "chunks": [[0, 1, 1.0, 1.084, 1.154, 1, 0, 0], [1, 1, 2.0, 2.087, 2.156, 1, 0, 0], [2, 1, 3.0, 3.085, 3.151, 1, 0, 0], [3, 1, 4.0, 4.084, 4.153, 1, 0, 0], [4, 1, 4.48, 