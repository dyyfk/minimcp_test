{"id": "sdqa0104", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 542423949, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What is a motor tic?", "input_path": "/data/sdqa_audio/sdqa0104.wav", "input_sha256": "7b3a62a04f0793fc567b2f80e5b918eeaa7453b7d88fd2a018d2a33fe8151311", "input_samples": 60752, "input_s": 3.797, "n_real_chunks": 4, "score": 0.5658, "act": 0.9969, "is_info": true, "fired": false, "mode": "local", "answer": "A motor tick is a small, rhythmic sound that some people hear or feel when they have certain types of movement disorder s. It's often associated with conditions like Parkinson' s disease or other neuro logical issues where there are abnormal muscle contractions. The sound can be felt in the muscles, sometimes described as a clicking or twitch ing sensation, and it usually happens during specific movements.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 21, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0104_balanced_local.wav", "sha256": "3b3c86a11158bb469364cbd200cb36d434eef3b91d3e58fc99d434ae20e9bc72", "sr": 24000, "seconds": 20.24}}, "chunks": [[0, 1, 1.0, 1.072, 1.13, 1, 0, 0], [1, 1, 2.0, 2.072, 2.128, 1, 0, 0], [2, 1, 3.0, 3.071, 3.127, 1, 0, 0], [3, 1, 3.797, 3.866, 4.052, 0, 0, 0], [4, 0, 4.797, 4.87, 5.596, 0, 24000, 0], [5, 0, 5.797, 5.88, 6.637, 0, 24000, 0], [6, 0, 6.797, 6.873, 7.662, 0, 24000, 0], [7, 0, 7.