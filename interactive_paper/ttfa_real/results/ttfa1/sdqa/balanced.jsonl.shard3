{"id": "sdqa0073", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4038316766, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What language do they speak in Buenos Aires?", "input_path": "/data/sdqa_audio/sdqa0073.wav", "input_sha256": "b3bd315876a93642d44832654e280bf0eeeebe5bfac9ce57cb8379b9ba046944", "input_samples": 87717, "input_s": 5.482, "n_real_chunks": 6, "score": 0.4676, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "In Buenos Aires, they speak Spanish. It' s the main language used there.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 6, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0073_balanced_local.wav", "sha256": "118b8fa0411bfc564e11fdfc9ea23483e03cd5169b829c603ecb2e7bc11311f5", "sr": 24000, "seconds": 5.96}}, "chunks": [[0, 1, 1.0, 1.083, 1.154, 1, 0, 0], [1, 1, 2.0, 2.088, 2.158, 1, 0, 0], [2, 1, 3.0, 3.085, 3.151, 1, 0, 0], [3, 1, 4.0, 4.076, 4.14, 1, 0, 0], [4, 1, 5.0, 5.076, 5.14, 1, 0, 0], [5, 1, 5.482, 5.577, 6.421, 0, 24000, 0], [6, 0, 6.482, 6.57, 7.379, 0, 24000, 0], [7, 0, 7.482, 7.566, 8.301, 0, 24000, 0], [8, 0, 8.482, 8.559, 9.213, 0, 24000, 0], [9, 0, 9.482, 9.57, 10.424, 0, 24000, 0], [10, 0, 10.482, 10.556, 11.063, 0, 23040, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 5.482, "last_real_feed_done": 5.577, "onset": 6.421, "gate_read_done": 6.421, "fi