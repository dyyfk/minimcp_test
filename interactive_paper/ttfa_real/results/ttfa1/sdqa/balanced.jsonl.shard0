{"id": "sdqa0090", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4147752682, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is the hottest day on record in Adelaide?", "input_path": "/data/sdqa_audio/sdqa0090.wav", "input_sha256": "5a6fafea3a73567e1f2ced5ef1660528738d99e8ed7006b3fb487773b55aaf86", "input_samples": 82938, "input_s": 5.184, "n_real_chunks": 6, "score": 0.8956, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The hottest day on record in Adelaide’s official city observations was 24 January 2019, when Adelaide West Terrace / ngayirdapira reached 46.6 °C. If including the nearby Kent Town station, Adelaide recorded 47.7 °C on the same day. (bom.gov.au)", "expert_answer": "The hottest day on record **in Adelaide’s official city observations** was **24 January 2019**, when **Adelaide West Terrace / ngayirdapira reached 46.6 °C**.\n\nIf including the nearby **Kent Town** station, Adelaide recorded **47.7 °C** on the same day. ([bom.gov.au](https://www.bom.gov.au/climate/current/statements/scs68.pdf?utm_source=openai))", "transcript": "What is the hottest day on record in Adelaide?\n", "asr_s": 0.69, "expert_s": 5.45, "expert_input_samples": 80000, "expert_input_s": 5.0, "expert_input_sha256": "df088fe5421c16bbc5f4eb6059a864929b29b16cf9552c2991bdade624cf595f", "expert_timed_out": false, "wait_s": 5.08, "relay_synth_ms": 11047, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 855, "feed_lag_sum_ms": 855, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0090_balanced_relay.wav", "sha256": "0f118031c70869d01a8f363315fb114341f1091ca71627fd489552fabd0c