{"id": "sdqa0040", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1117245607, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "When was the Argentine Basketball Federation formed?", "input_path": "/data/sdqa_audio/sdqa0040.wav", "input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "input_samples": 92496, "input_s": 5.781, "n_real_chunks": 6, "score": 0.8291, "act": 0.9997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Argentine Basketball Federation — now the Argentine Basketball Confederation (CAB/CABB) — was formed on August 30, 1929. (argentina.basketball)", "expert_answer": "The Argentine Basketball Federation — now the **Argentine Basketball Confederation (CAB/CABB)** — was formed on **August 30, 1929**. ([argentina.basketball](https://www.argentina.basketball/mision-y-valores?utm_source=openai))", "transcript": "When was the Argentine Basketball Federation formed?\n", "asr_s": 11.76, "expert_s": 5.65, "expert_input_samples": 92496, "expert_input_s": 5.781, "expert_input_sha256": "08e1b73787e49e6b04ad7ed12edfffeba4e607cda752a3de220eb6c998cfb38e", "expert_timed_out": false, "wait_s": 7.953, "relay_synth_ms": 4526, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 3, "feed_lag_max_ms": 4453, "feed_lag_sum_ms": 9889, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_balanced_relay.wav", "sha256": "9ae6d70d62e290e0d94cabc942d364668cb6a29d9456d4ece68ffa714d99fa39", "sr": 24000, "seconds": 11.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0040_balanced_candidate.wav", "sha256": "b1647c3acf8ee47253075346418561af039893879d84575f8037c616e7f9c074