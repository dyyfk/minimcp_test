{"id": "sdqa0052", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3045228746, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is the biggest cricket competition?", "input_path": "/data/sdqa_audio/sdqa0052.wav", "input_sha256": "9bacbac5b824f405ad58e6cf57474605388a5ba5e9fd633c403436ddddc7ad13", "input_samples": 64891, "input_s": 4.056, "n_real_chunks": 5, "score": 0.3207, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The biggest cricket competition is the ICC Cricket World Cup. It happens every four years and brings together national teams from all over the world to compete for the title of world champion in One Day International cricket. It's a huge event with massive global attention and excitement.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 82, "feed_lag_sum_ms": 82, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0052_balanced_local.wav", "sha256": "79870f888364e62cf44bafd58b409d3ac40b225d8deb6f77eebbdec61227bafa", "sr": 24000, "seconds": 16.0}}, "chunks": [[0, 1, 1.0, 1.069, 1.127, 1, 0, 0], [1, 1, 2.0, 2.068, 2.123, 1, 0, 0], [2, 1, 3.0, 3.071, 3.127, 1, 0, 0], [3, 1, 4.0, 4.075, 4.138, 1, 0, 0], [4, 1, 4.056, 4.211, 4.909, 0, 24000, 0], [5, 0, 5.056, 5.126, 5.698, 0, 24000, 0], [6, 0, 6.056, 6.129, 6.788, 0, 24000, 0], [7, 0, 7.056, 7.13, 7.812, 0, 24000, 0], [8, 0, 8.056, 8.129, 8.783, 0, 24000, 0], [9, 0, 9.056, 9.131, 9.