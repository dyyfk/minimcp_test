{"id": "sdqa0111", "pool": "sdqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1227193923, "protocol": "ttfa-v3", "config_sha256": "f4bb2b6e6cb68bd1527d1ee0e21321345a1bb395842da8101a511dc9dc7ef77e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "When did the United States officially pull out of Vietnam?", "input_path": "/data/sdqa_audio/sdqa0111.wav", "input_sha256": "7840f4d95bcd004bea81f0f59b4d71186812fbe3dd94ad51d9ea04f41b808c18", "input_samples": 96353, "input_s": 6.022, "n_real_chunks": 7, "score": 0.4398, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The United States officially pulled out of Vietnam in 197 3. That year, the Paris Peace Accords were signed, which marked the end of direct U. S. military involvement in the Vietnam War. After that, most American troops left the country over the following years. So, the official pullout began around 19 73 and continued through the early 1970s.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 19, "feed_lag_max_ms": 686, "feed_lag_sum_ms": 1228, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0111_balanced_local.wav", "sha256": "b861a7d746f12398dffa35c712203940dbd6d4ec63c8935aecb2b3a8c8b2ea93", "sr": 24000, "seconds": 19.28}}, "chunks": [[0, 1, 1.0, 1.065, 1.116, 1, 0, 0], [1, 1, 2.0, 2.065, 2.118, 1, 0, 0], [2, 1, 3.0, 3.064, 3.116, 1, 0, 0], [3, 1, 4.0, 4.067, 4.121, 1, 0, 0], [4, 1, 5.0, 5.067, 5.121, 1, 0, 0], [5, 1, 6.0, 6.07, 6.709, 0, 24000, 0], [6, 1, 6.022, 6.78, 7.425, 0, 24000, 0], [7, 0, 7.022, 7.491, 8.162, 0, 24000, 