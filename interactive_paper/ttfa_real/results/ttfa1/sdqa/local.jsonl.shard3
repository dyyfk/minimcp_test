{"id": "sdqa0095", "pool": "sdqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2270386789, "protocol": "ttfa-v3", "config_sha256": "dc9d95c8617de77ddb5971c8746f5327f6cd47b10e39975e824f2c8f1acf9b9a", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Where is the Meyer lemon from?", "input_path": "/data/sdqa_audio/sdqa0095.wav", "input_sha256": "d76b8394e88822dd4fda0346b71047e52214a089a0786f3dfcd9e5770eb3b40b", "input_samples": 76112, "input_s": 4.757, "n_real_chunks": 5, "score": 0.8638, "act": 0.999, "is_info": true, "fired": false, "mode": "local", "answer": "The Meyer lemon is a variety of lemon that originated in California. It' s believed to have been developed in the early 20th century and named after an individual or family associated with its cultivation. So, it's from California.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sdqa/audio/sdqa0095_local_local.wav", "sha256": "ecbf9a012be4fe4eb3a3fe4bf641042648a2f1a4a02c4c687e260c8b05af0616", "sr": 24000, "seconds": 14.36}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.056, 2.101, 1, 0, 0], [2, 1, 3.0, 3.053, 3.095, 1, 0, 0], [3, 1, 4.0, 4.058, 4.105, 1, 0, 0], [4, 1, 4.757, 4.81, 4.963, 0, 0, 0], [5, 0, 5.757, 5.811, 6.286, 0, 24000, 0], [6, 0, 6.757, 6.811, 7.308, 0, 24000, 0], [7, 0, 7.757, 7.811, 8.312, 0, 24000, 0], [8, 0, 8.757, 8.812, 9.265, 0, 24000, 0], [9, 0, 9.757, 9.813, 10.356, 0, 24000, 0], [10, 0, 10.757, 10.816, 11.331, 0, 24000, 0], [11, 0, 11.757, 11.815, 12.424, 0