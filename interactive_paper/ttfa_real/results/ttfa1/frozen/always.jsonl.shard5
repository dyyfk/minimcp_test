{"id": "q0566", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 311194896, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "Who inaugurated the Khyber Hotel in Gulmarg?", "input_path": "/data/audio_pool/q0566.wav", "input_sha256": "541b2d9d47921ef3ccc42d23941f96f2d89c49ff42ac2320a61e1b237ed1b5ce", "input_samples": 43800, "input_s": 2.737, "n_real_chunks": 3, "score": 0.9052, "act": 0.9995, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Khyber Hotel — The Khyber Himalayan Resort & Spa in Gulmarg — was inaugurated by Omar Abdullah, then Chief Minister of Jammu & Kashmir. (kashmirobserver.net)", "expert_answer": "The Khyber Hotel — **The Khyber Himalayan Resort & Spa in Gulmarg** — was inaugurated by **Omar Abdullah**, then Chief Minister of Jammu & Kashmir. ([kashmirobserver.net](https://kashmirobserver.net/2012/12/20/the-khyber-himalayan-resort-spa-opens-in-gulmarg/?utm_source=openai))", "transcript": "Who inaugurated the Khyber Hotel in Gulmarg?\n", "asr_s": 0.69, "expert_s": 4.68, "expert_input_samples": 43800, "expert_input_s": 2.737, "expert_input_sha256": "541b2d9d47921ef3ccc42d23941f96f2d89c49ff42ac2320a61e1b237ed1b5ce", "expert_timed_out": false, "wait_s": 4.482, "relay_synth_ms": 6865, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0566_always_relay.wav", "sha256": "bde0edc33154af30d5b410961e3b3ecbcfc1b6a4e64e6b6f83d0afd94d951d14", "sr": 24000, "seconds": 11.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0566_always_candidate.wav", "sha256": "01fb9e7b994dbb247299d5b434c5cdad07d3d75b3c3b8a95