{"id": "q0506", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1154929302, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "为什么自我关怀很重要？", "input_path": "/data/audio_pool/q0506.wav", "input_sha256": "b912307b1293e17bbf9902865775747d8010463ba615a73311cde4c762198267", "input_samples": 37200, "input_s": 2.325, "n_real_chunks": 3, "score": 0.2089, "act": 0.9959, "is_info": true, "fired": false, "mode": "local", "answer": "Self-care is important because it helps us stay healthy and balanced. When we take care of ourselves physically, like eating well and getting enough sleep, our bodies work better. Mentally, self- care means managing stress and taking time to relax, which can improve our mood. E motionally, it allows us to process feelings without over whelming ourselves. Social ly, connecting with others or setting boundaries help s prevent burn out. Overall, self-ca re builds resil ience so we can handle life' s challenges more effectively.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 32, "feed_lag_max_ms": 16, "feed_lag_sum_ms": 16, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0506_aggressive_local.wav", "sha256": "1bfa86d5e5c8667b900d31667a80d112e798afb088649320cdd288f9fffd7d8d", "sr": 24000, "seconds": 31.4}}, "chunks": [[0, 1, 1.0, 1.08, 1.144, 1, 0, 0], [1, 1, 2.0, 2.083, 2.148, 1, 0, 0], [2, 1, 2.325, 2.408, 2.474, 1, 0, 0], [3, 0, 3.325, 3.407, 3.636, 0, 0, 0], [4, 0, 4.325, 4.