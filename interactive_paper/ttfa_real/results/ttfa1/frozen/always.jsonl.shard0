{"id": "q0424", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2569845519, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Give me some examples of metamorphic rocks.", "input_path": "/data/audio_pool/q0424.wav", "input_sha256": "482e535dd44784690b76f4dd08ef1c4c66ef13d887e6d4483bd0e73849b5fdc8", "input_samples": 38800, "input_s": 2.425, "n_real_chunks": 3, "score": 0.2076, "act": 0.9994, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Examples of metamorphic rocks include: Marble , Slate , Schist , Gneiss , Quartzite , Phyllite , Amphibolite , Hornfels", "expert_answer": "Examples of **metamorphic rocks** include:\n\n- **Marble**\n- **Slate**\n- **Schist**\n- **Gneiss**\n- **Quartzite**\n- **Phyllite**\n- **Amphibolite**\n- **Hornfels**", "transcript": "Give me some examples of metamorphic rocks.\n", "asr_s": 0.58, "expert_s": 1.88, "expert_input_samples": 38800, "expert_input_s": 2.425, "expert_input_sha256": "482e535dd44784690b76f4dd08ef1c4c66ef13d887e6d4483bd0e73849b5fdc8", "expert_timed_out": false, "wait_s": 1.456, "relay_synth_ms": 6511, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0424_always_relay.wav", "sha256": "e3e2eaddc2b72e10eab0950622d08434d71a4353e429012f16199eb3714f4680", "sr": 24000, "seconds": 11.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0424_always_candidate.wav", "sha256": "a3ddd2edd7f494e2d83f4fa0c20be1374c113f3edb224b74823488dac1f92f69", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0424_always_stall.wav", "sha256": "f11e06074bbf15069b66ccb1b9ce01665968034b256736a2b050f466552a98cd", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.074, 1.133, 1, 0, 0], [1, 1, 2.0, 2.072, 2.13, 1, 0, 0], [2, 1, 2.425, 2.497, 2.555, 1, 0, 0], [3, 0, 3.425, 3.501, 4.238, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.425, "last_real_feed_done": 2.497, "onset": 4.238, "gate_read_done": 4.238, "fire": 4.238, "candidate_first_pcm": 4.238, "stall_note": 4.239, "stall_first_pcm": 5.243, "local_first_pcm": null, "wait_start": 5.243, "expert_req": 4.239, "expert_resp": 6.699, "relay_synth_start": 6.699, "relay_first_pcm": 7.566, "relay_synth_end": 13.211, "first_any_pcm": 4.238, "first_answer_pcm": 7.566, "session_end": 13.366}, "ttfa_answer_s": 5.141, "ttfa_any_s": 1.813}
{"id": "q0447", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1451183411, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Can I run MacOS on a Windows PC?", "input_path": "/data/audio_pool/q0447.wav", "input_sha256": "8ad216470a8761efba1ff3e2f6144193f9bcdaa8d5a890f266b25e487ea3d434", "input_samples": 31000, "input_s": 1.938, "n_real_chunks": 2, "score": 0.5933, "act": 0.9972, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Yes, but not officially—and it’s complicated. Running macOS on a non-Apple Windows PC is commonly called building a Hackintosh.", "expert_answer": "**Yes, but not officially—and it’s complicated.**\n\nRunning macOS on a non-Apple Windows PC is commonly called building a **Hackintosh**. It can work on some PC hardware, but:\n\n- **Apple does not officially support it**\n- It likely **violates Apple’s macOS license agreement**, which restricts macOS to Apple-branded hardware\n- Hardware compatibility can be difficult, especially for Wi‑Fi, Bluetooth, GPUs, sleep/wake, and updates\n- macOS updates may break the installation\n- Newer Apple Silicon versions of macOS are especially difficult or impractical to run on standard Windows PCs\n\n**Legal/official options:**\n- Buy a **Mac**\n- Use macOS in a cloud Mac service, if you need remote access\n- Use Windows alternatives for your task, or dual-boot Linux if you want a Unix-like environment\n\n**Bottom line:** technically possible on some Intel/AMD PCs, but not supported or generally legal under Apple’s license.", "transcript": "Can I run macOS on a Windows PC?\n", "asr_s": 0.48, "expert_s": 4.26, "expert_input_samples": 31000, "expert_input_s": 1.938, "expert_input_sha256": "8ad216470a8761efba1ff3e2f6144193f9bcdaa8d5a890f266b25e487ea3d434", "expert_timed_out": false, "wait_s": 3.589, "relay_synth_ms": 5323, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 254, "feed_lag_sum_ms": 254, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0447_always_relay.wav", "sha256": "43e0af93d965da05f6194601505aa99aeb89a205c3e1cf1b394855e83844b0b5", "sr": 24000, "seconds": 9.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0447_always_candidate.wav", "sha256": "87b4e5c02b0d1e969cdd4f000b251564ac0b3c46f82f270f997ddb93da964bec", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0447_always_stall.wav", "sha256": "ffb80704ef8f3e26d7d71f686bc12ab1ca8405982f6e389b0994b69c119957de", "sr": 24000, "seconds": 1.76}}, "chunks": [[0, 1, 1.0, 1.071, 1.129, 1, 0, 0], [1, 1, 1.938, 2.01, 2.069, 1, 0, 0], [2, 0, 2.938, 3.011, 3.069, 1, 0, 0], [3, 0, 3.938, 4.013, 4.568, 0, 24000, 0], [4, 0, 4.938, 5.264, 5.718, 0, 18240, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.938, "last_real_feed_done": 2.01, "onset": 4.568, "gate_read_done": 4.568, "fire": 4.568, "candidate_first_pcm": 4.568, "stall_note": 4.569, "stall_first_pcm": 5.191, "local_first_pcm": null, "wait_start": 5.718, "expert_req": 4.569, "expert_resp": 9.307, "relay_synth_start": 9.307, "relay_first_pcm": 10.139, "relay_synth_end": 14.631, "first_any_pcm": 4.568, "first_answer_pcm": 10.139, "session_end": 15.735}, "ttfa_answer_s": 8.201, "ttfa_any_s": 2.63}
