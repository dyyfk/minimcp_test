{"id": "q0000", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2877207880, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "John is a carpenter. For his friend Ali, he manufactured 4 wooden tables for $20 each and 2 roof frames for $10 each. How much does Ali have to pay John?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0000.wav", "input_sha256": "4df914e6593a23a27d1e872de084839dde296334ac8c349a6ecb4e9810b6e4ab", "input_samples": 223400, "input_s": 13.963, "n_real_chunks": 14, "score": 0.4954, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Total cost: $100.", "expert_answer": "Total cost: **$100**.", "transcript": "John is a carpenter. For his friend Ali, he manufactured four wooden tables for $20 each and two roof frames for $10 each.\n", "asr_s": 3.68, "expert_s": 2.3, "expert_input_samples": 144000, "expert_input_s": 9.0, "expert_input_sha256": "fd7fb7c320ad3428bc07a13c55860087256a321ec10d96f60875884eb6e9bd59", "expert_timed_out": false, "wait_s": 1.91, "relay_synth_ms": 1626, "onset_chunk": 8, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 2976, "feed_lag_sum_ms": 2976, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0000_always_relay.wav", "sha256": "3308553c4756fef5f743f377db4aa3ac47f5af59129972db47e58df799e7ce1e", "sr": 24000, "seconds": 2.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0000_always_candidate.wav", "sha256": "3f66bc0230d5cee365317e80d47e3c4bd249f7dfad503054efc6fd8c02ca6fae", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0000_always_stall.wav", "sha256": "e8861cf5d046e