{"id": "q0405", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3692947739, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "How many months have 28 days?", "input_path": "/data/audio_pool/q0405.wav", "input_sha256": "ebdbc461dcb96873d4d4ada1964445b12b266fe3cc227a5e6790a975f57b2248", "input_samples": 32600, "input_s": 2.038, "n_real_chunks": 3, "score": 0.2063, "act": 0.9781, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "12 months — every month has at least 28 days.", "expert_answer": "**12 months** — every month has at least 28 days.", "transcript": "How many months have 28 days?\n", "asr_s": 0.43, "expert_s": 1.37, "expert_input_samples": 32600, "expert_input_s": 2.038, "expert_input_sha256": "ebdbc461dcb96873d4d4ada1964445b12b266fe3cc227a5e6790a975f57b2248", "expert_timed_out": false, "wait_s": 1.796, "relay_synth_ms": 2496, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 95, "feed_lag_sum_ms": 95, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0405_always_relay.wav", "sha256": "cc68313aa4842a1439ad1dc46c2d292a41fd6b5988b07ad65f07e820347e2683", "sr": 24000, "seconds": 3.52}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0405_always_candidate.wav", "sha256": "d74db52054931eb01270e64a36997b0148e5997a6315a112b8c6c0ff90399900", "sr": 24000, "seconds": 0.84}}, "chunks": [[0, 1, 1.0, 1.084, 1.151, 1, 0, 0], [1, 1, 2.0, 2.073, 2.133, 1, 0, 0], [2, 1, 2.038, 2.203, 2.261, 1, 0, 0], [3, 0, 3.038, 3.118, 3.937, 0, 20160, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.038, "last_real_feed_done": 2.203, "onset": 3.937, "gate_read_done": 3.938, "fir