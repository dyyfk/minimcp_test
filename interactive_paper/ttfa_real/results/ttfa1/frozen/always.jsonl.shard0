{"id": "q0536", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1878753621, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "当太阳落山并且夜晚来临，将其分解为独立的从句。", "input_path": "/data/audio_pool/q0536.wav", "input_sha256": "92c3d15c7171b9e9f14dbdac10f9f867b10877f1fdb0f65b0ab8b4ba0d995011", "input_samples": 78400, "input_s": 4.9, "n_real_chunks": 5, "score": 0.3702, "act": 0.9954, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "独立的从句可以分解为： , 太阳落山。 , 夜晚来临。", "expert_answer": "独立的从句可以分解为：\n\n1. **太阳落山。**\n2. **夜晚来临。**", "transcript": "当太阳落山并且夜晚来临，将其分解为独立的从句。\n", "asr_s": 0.53, "expert_s": 2.92, "expert_input_samples": 78400, "expert_input_s": 4.9, "expert_input_sha256": "92c3d15c7171b9e9f14dbdac10f9f867b10877f1fdb0f65b0ab8b4ba0d995011", "expert_timed_out": false, "wait_s": 2.372, "relay_synth_ms": 16472, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0536_always_relay.wav", "sha256": "c6b8a288d4a4d846b4e97f62ba5d9b7e0a7c4250699d82bcd3c3a8066306f37a", "sr": 24000, "seconds": 29.28}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0536_always_candidate.wav", "sha256": "72f29f1fab8f9e786f52fa98e4ef73ac769ded15c1764339bd0ddbda20bcf2fc", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0536_always_stall.wav", "sha256": "98addd616f37da9e96da1166284ebd370fb2e1d8681d8680e49588dcf47df01e", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.075, 1.137, 1, 0, 0], [1, 1, 2.0, 2.078, 2.141, 1, 0, 0], [2, 1, 3.0, 3.135, 3.237, 1, 0, 0], [3, 1, 4.0, 4.093, 4.17, 1, 0, 0], [4, 1, 4.9, 4.992, 5.068