{"id": "q0385", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 294352278, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is a Jacob's Ladder?", "input_path": "/data/audio_pool/q0385.wav", "input_sha256": "31316dd7f7568c93c3cf37ce0b3e558f6f198cb484caab2734b25447a4bc7d7f", "input_samples": 23200, "input_s": 1.45, "n_real_chunks": 2, "score": 0.3814, "act": 0.9965, "is_info": true, "fired": false, "mode": "local", "answer": "A Jacob's ladder is an electrical device that uses rising heat to create a visible column of plasma. It' s made up of two vertical metal rods connected at the bottom, and when electricity passes through them, the heat causes the air between the rods to ionize, forming a glowing, moving arc of light that travels upward like steps in a ladder.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 18, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0385_balanced_local.wav", "sha256": "9ff694e2bd118f577b2f0c13cd50cadf639366baf1c75f4a2b6d514543e7d7fa", "sr": 24000, "seconds": 18.04}}, "chunks": [[0, 1, 1.0, 1.057, 1.102, 1, 0, 0], [1, 1, 1.45, 1.509, 1.554, 1, 0, 0], [2, 0, 2.45, 2.508, 2.557, 1, 0, 0], [3, 0, 3.45, 3.505, 4.079, 0, 24000, 0], [4, 0, 4.45, 4.511, 5.086, 0, 24000, 0], [5, 0, 5.45, 5.51, 6.06, 0, 24000, 0], [6, 0, 6.45, 6.51, 7.043, 0, 24000, 0], [7, 0, 7.45, 7.508, 8.077, 0, 24000, 0], [8, 0, 8.45, 8.51, 9.139, 0, 2400