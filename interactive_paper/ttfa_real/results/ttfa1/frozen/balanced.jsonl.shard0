{"id": "q0241", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3146880180, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "According Carroll what four categories or aspects can corporate social responsibility be broken down into?\n\nA. Political, Legal, Ethical and Philanthropic\nB. Economic, Legal, Ethical and Moral\nC. Economic, Legal, Ethical and Environmental\nD. Economic, Legal, Ethical and Philanthropic\nE. Political, Legal, Cultural and Philanthropic\nF. Economic, Legal, Humanitarian and Philanthropic\nG. Economic, Legal, Cultural and Philanthropic\nH. Economic, Cultural, Ethical and Environmental\nI. Political, Legal, Economic and Environmental\nJ. Political, Legal, Ethical and Environmental\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0241.wav", "input_sha256": "5544565a20d5040fa49002d1b56121745e333be032238b3a64d71e2ca81f1913", "input_samples": 602600, "input_s": 37.663, "n_real_chunks": 38, "score": 0.4564, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "The correct answer is J. Po litical, legal, ethical and environmental.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 37, "eot_seen": true, "n_speak_chunks": 4, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0241_balanced_local.wav", "sha256": "55362c6e4e7c714b94799526523c6449df0ddc57b6c62fc9f0f784bd74eddfe6", "sr": 24000, "seconds": 4.24}}, "chunks