{"id": "q0463", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1663364008, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Does Las Vegas have a professional hockey team?", "input_path": "/data/audio_pool/q0463.wav", "input_sha256": "6c8e1e219e6c4fe3bc06c35e9c4b78fb50d50cc9260ad9670dae5783ea2dd886", "input_samples": 39800, "input_s": 2.487, "n_real_chunks": 3, "score": 0.6617, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "Yes, Las Vegas does have a professional hockey team. The team is called the Vegas Golden Knights, and they are part of the National Hockey League, or NHL. They began playing in 2 017 after reloc ating from the city of Manchester, New Hampshire.The Golden Knight s play their home games at T-Mobile A rena in downtown Las Vegas. Since joining the league, they have become known for their exciting style of play and loyal fan base. In fact, their debut season was historic as they won the Stanley Cup in 2018, making them the first expansion team to win the championship since 19 67. So yes, professional hockey is very much alive and well in Las Vegas.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 43, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0463_balanced_local.wav", "sha256": "4822fe56ef7056aca3e226778872e2d0c326db51dc9fd250fc076e1ed002939c", "sr": 24000, "seconds": 43.0}}, "chunks": [[0, 1, 1.0, 1.