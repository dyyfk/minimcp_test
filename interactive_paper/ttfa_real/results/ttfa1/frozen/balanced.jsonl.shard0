{"id": "q0255", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2783404524, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "A college student and a man got into a fight at a bar while playing pooi. The college student allegedly started the fight when he struck the man in the head with a pool cue after the man sank a game-winning shot. At the college student's trial for assault, the prosecution called one of the college student's classmates to testify. The classmate was not at the bar during the fight. The classmate offered to testify that the next day at class, he approached the college student and said, \"It was wrong of you to start a fight with the man over a game of pool,\" at which point, the college student bowed his head and walked away. The classmate's testimony is\n\nA. admissible as a statement of the declarant’s then-existing state of mind.\nB. inadmissible as a character evidence.\nC. inadmissible as hearsay not within any recognized exception.\nD. admissible as a prior consistent statement.\nE. inadmissible as a statement that is not in the defendant's favor.\nF. inadmissible because the classmate was not an eyewitness to the fight.\nG. inadmissible as self-serving.\nH. admissible as part of the res gestae.\nI. admissible as an admission.\nJ. admissible as a statement of personal or family history.\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0255.wav", "input_sha256": "288db74cf0fbf582d5df0186241dfb971f271b742d35f9b46748e81833d4d62f", "input_samples": 1238400, "input_s": 77.4, "n_real_chunks": 78, "score": 0.6523, "act": 0.9993, "is_info": true, "fired": false, "mode": "local", "answer": "A. Admiss ible as a statement of the declar ant's then-existing state of mind.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 77, "eot_seen": true, "n_speak_chunks": 6, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0255_balanced_local.wav", "sha256": "dd16dc37281ca28ef39577e857cb889c8b4d62f719dc2a5c7b02e3e841f8e467", "sr": 24000, "seconds": 5.6}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.057, 2.104, 1, 0, 0], [2, 1, 3.0, 3.057, 3.101, 1, 0, 0], [3, 1, 4.0, 4.058, 4.105, 1, 0, 0], [4, 1, 5.0, 5.057, 5.103, 1, 0, 0], [5, 1, 6.0, 6.058, 6.105, 1, 0, 0], [6, 1, 7.0, 7.059, 7.106, 1, 0, 0], [7, 1, 8.0, 8.057, 8.103, 1, 0, 0], [8, 1, 9.0, 9.057, 9.103, 1, 0, 0], [9, 1, 10.0, 10.058, 10.104, 1, 0, 0], [10, 1, 11.0, 11.06, 11.107, 1, 0, 0], [11, 1, 12.0, 12.058, 12.106, 1, 0, 0], [12, 1, 13.0, 13.059, 13.106, 1, 0, 0], [13, 1, 14.0, 14.062, 14.109, 1, 0, 0], [14, 1, 15.0, 15.061, 15.109, 1, 0, 0], [15, 1, 16.0, 16.067, 16.118, 1, 0, 0], [16, 1, 17.0, 17.062, 17.109, 1, 0, 0], [17, 1, 18.0, 18.061, 18.107, 1, 0, 0], [18, 1, 19.0, 19.062, 19.108, 1, 0, 0], [19, 1, 20.0, 20.061, 20.107, 1, 0, 0], [20, 1, 21.0, 21.062, 21.108, 1, 0, 0], [21, 1, 22.0, 22.062, 22.108, 1, 0, 0], [22, 1, 23.0, 23.063, 23.11, 1, 0, 0], [23, 1, 24.0, 24.063, 24.11, 1, 0, 0], [24, 1, 25.0, 25.061, 25.108, 1, 0, 0], [25, 1, 26.0, 26.065, 26.113, 1, 0, 0], [26, 1, 27.0, 27.063, 27.108, 1, 0, 0], [27, 1, 28.0, 28.063, 28.111, 1, 0, 0], [28, 1, 29.0, 29.062, 29.11, 1, 0, 0], [29, 1, 30.0, 30.06, 30.106, 1, 0, 0], [30, 1, 31.0, 31.061, 31.106, 1, 0, 0], [31, 1, 32.0, 32.06, 32.106, 1, 0, 0], [32, 1, 33.0, 33.061, 33.108, 1, 0, 0], [33, 1, 34.0, 34.062, 34.108, 1, 0, 0], [34, 1, 35.0, 35.067, 35.117, 1, 0, 0], [35, 1, 36.0