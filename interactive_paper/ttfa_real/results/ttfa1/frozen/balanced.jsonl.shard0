{"id": "q0484", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1673745285, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "电动汽车是智能交通的未来。", "input_path": "/data/audio_pool/q0484.wav", "input_sha256": "5a4727dc7720144a37c2f5dfbdfb9b36addffb26fffba5f4ccbc7c2de898316f", "input_samples": 44400, "input_s": 2.775, "n_real_chunks": 3, "score": 0.3977, "act": 0.9966, "is_info": true, "fired": false, "mode": "local", "answer": "电动汽车确实是智能交通的一个重要组成部分。它们不仅减少了对化石燃料的依赖，还通过连接技术与智能系统深度融合，提升了交通效率和安全性。", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0484_balanced_local.wav", "sha256": "3da21410a60d092fea4533c3f7d778a18cd5e94a22549e4b57d604727821adb5", "sr": 24000, "seconds": 12.44}}, "chunks": [[0, 1, 1.0, 1.057, 1.101, 1, 0, 0], [1, 1, 2.0, 2.055, 2.098, 1, 0, 0], [2, 1, 2.775, 2.831, 2.875, 1, 0, 0], [3, 0, 3.775, 3.832, 4.147, 0, 24000, 0], [4, 0, 4.775, 4.833, 5.371, 0, 24000, 0], [5, 0, 5.775, 5.833, 6.364, 0, 24000, 0], [6, 0, 6.775, 6.835, 7.354, 0, 24000, 0], [7, 0, 7.775, 7.834, 8.347, 0, 24000, 0], [8, 0, 8.775, 8.835, 9.413, 0, 24000, 0], [9, 0, 9.775, 9.835, 10.354, 0, 24000, 0], [10, 0, 10.775, 10.836, 11.378, 0, 24000, 0], [11, 0, 11.775, 11.835, 12.382, 0, 24000, 0], [12, 0, 12.775, 12.836, 13.339, 0, 24000, 0], [13, 0, 13.775, 13.839, 14.405, 0, 24000, 0], [14, 0, 14.775, 14.84, 15.383, 0, 24000, 0]