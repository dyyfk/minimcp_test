{"id": "q0410", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3043765461, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is fleece?", "input_path": "/data/audio_pool/q0410.wav", "input_sha256": "c3e1d38e3f1e617343fbabbc09619d7beb2916e430666ff8ea2f22d8ed38cea5", "input_samples": 14600, "input_s": 0.912, "n_real_chunks": 1, "score": 0.8144, "act": 0.9857, "is_info": true, "fired": false, "mode": "local", "answer": "Fleece is a type of fabric made from synthetic fibers, like poly ester or poly amide. It has a soft, smooth texture that feels warm and comfortable against the skin. F leece is often used in clothing such as sweat ers, jackets, hood ed sweatshirts, and blanket s because it provides good ins ulation while still being lightweight. It also tends to be durable and easy to care for, making it popular for casual wear year-round.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 25, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0410_local_local.wav", "sha256": "c38e1975f7a9b0d4872fa962053fdbf7fdca946856d3d7833112568d76e00832", "sr": 24000, "seconds": 25.28}}, "chunks": [[0, 1, 0.912, 0.981, 1.035, 1, 0, 0], [1, 0, 1.913, 1.983, 2.036, 1, 0, 0], [2, 0, 2.913, 2.983, 3.036, 1, 0, 0], [3, 0, 3.913, 3.982, 4.488, 0, 24000, 0], [4, 0, 4.912, 4.983, 5.627, 0, 24000, 0], [5, 0, 5.912, 5.984, 6.624, 0, 24000, 0], [6, 0, 6.912, 6.983, 7.569, 0, 24000, 0], [7, 0, 7.91