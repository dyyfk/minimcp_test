{"id": "q0489", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 494022456, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "我去了他们的房子，但是没有人在家。", "input_path": "/data/audio_pool/q0489.wav", "input_sha256": "31c084909b975d36ccce199c7fa0fd1a0600135a7bbe792b0284311557a57c09", "input_samples": 52600, "input_s": 3.288, "n_real_chunks": 4, "score": 0.7457, "act": 0.9896, "is_info": true, "fired": false, "mode": "local", "answer": "我去了他们家，但是没有人在家。", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 3, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0489_local_local.wav", "sha256": "6ec18a3dfd30fc7e3b030ef3bb57cfb630a64553bb9776018941bc9bc3bbc7b0", "sr": 24000, "seconds": 3.28}}, "chunks": [[0, 1, 1.0, 1.068, 1.122, 1, 0, 0], [1, 1, 2.0, 2.069, 2.122, 1, 0, 0], [2, 1, 3.0, 3.07, 3.123, 1, 0, 0], [3, 1, 3.288, 3.36, 4.067, 0, 24000, 0], [4, 0, 4.287, 4.358, 4.944, 0, 24000, 0], [5, 0, 5.287, 5.358, 6.137, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.288, "last_real_feed_done": 3.36, "onset": 4.067, "gate_read_done": 4.068, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.067, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.067, "first_answer_pcm": 4.067, "session_end": 