{"id": "q0506", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1154929302, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "为什么自我关怀很重要？", "input_path": "/data/audio_pool/q0506.wav", "input_sha256": "b912307b1293e17bbf9902865775747d8010463ba615a73311cde4c762198267", "input_samples": 37200, "input_s": 2.325, "n_real_chunks": 3, "score": 0.2099, "act": 0.9955, "is_info": true, "fired": false, "mode": "local", "answer": "It's important to take care of yourself because it helps you stay healthy, both physically and mentally. When you look after your body by eating well, getting enough sleep, and exercising, you have more energy and feel better overall. Also, taking time for yourself—like relaxing or doing things you enjoy—can reduce stress and help you handle life' s challenges more easily. So, self-care is like filling up your own tank so you can be there for others too.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 27, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0506_conservative_local.wav", "sha256": "dd9ce76c09ce40e5dea56c3580671727c7e8903ffdc51193f17947a5c18355f9", "sr": 24000, "seconds": 27.2}}, "chunks": [[0, 1, 1.0, 1.053, 1.095, 1, 0, 0], [1, 1, 2.0, 2.054, 2.097, 1, 0, 0], [2, 1, 2.325, 2.379, 2.422, 1, 0, 0], [3, 0, 3.325, 3.379, 3.803, 0, 24000, 0], [4, 0, 4.325, 4.379, 4.934, 0, 24000, 0], [5, 0, 5.325, 5.38, 5.884, 0, 24000, 