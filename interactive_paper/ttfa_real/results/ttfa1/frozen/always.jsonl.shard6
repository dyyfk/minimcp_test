{"id": "q0360", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4284656791, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "\"After stints backing Little Richard and the Isley Brothers, who was discovered leading \"\"Jimmy James and the Blue Flames\"\" at the Caf Wha? in New York and taken to London on 26 September 1966 to make hit records?\"", "input_path": "/data/audio_pool/q0360.wav", "input_sha256": "2a29be8bee34166697c3af7ae7d6e5c84573b0a55dbf7e1ed81bd902b1935224", "input_samples": 231800, "input_s": 14.488, "n_real_chunks": 15, "score": 0.8925, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Jimi Hendrix — performing then as Jimi James with Jimi James and the Blue Flames — was discovered at Café Wha? and taken to London on 26 September 1966.", "expert_answer": "**Jimi Hendrix** — performing then as **Jimi James** with **Jimi James and the Blue Flames** — was discovered at Café Wha? and taken to London on **26 September 1966**.", "transcript": "After stints backing Little Richard and the Isley Brothers, who was discovered leading Jimi James and the Blue Flames at the Café Wha? in New York and taken to London on 26 September 1966 to make hit records.\n", "asr_s": 0.87, "expert_s": 2.06, "expert_input_samples": 231800, "expert_input_s": 14.488, "expert_input_sha256": "2a29be8bee34166697c3af7ae7d6e5c84573b0a55dbf7e1ed81bd902b1935224", "expert_timed_out": false, "wait_s": 1.508, "relay_synth_ms": 7159, "onset_chunk": 14, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 110, "feed_lag_sum_ms": 110, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0360_always_relay.wav", "sha256": "64ca583a0a656d