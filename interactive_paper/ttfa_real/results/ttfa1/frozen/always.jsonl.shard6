{"id": "q0090", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2059144705, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "The girls are trying to raise money for a carnival. Kim raises $320 more than Alexandra, who raises $430, and Maryam raises $400 more than Sarah, who raises $300. How much money, in dollars, did they all raise in total?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0090.wav", "input_sha256": "5aab9dcd12c7d805dc41e808f3135fcd90f44f6e224ee628a0014dde98367d67", "input_samples": 302000, "input_s": 18.875, "n_real_chunks": 19, "score": 0.2246, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Alexandra raised: $430 Kim raised $320 more than Alexandra: \\[ 430 + 320 = 750 \\] Sarah raised: $300 Miriam raised $400 more than Sarah: \\[ 300 + 400 = 700 \\] Total raised: \\[ 430 + 750 + 300 + 700 = 2180 \\] Final answer: 2180", "expert_answer": "Alexandra raised: **$430**\n\nKim raised $320 more than Alexandra:\n\n\\[\n430 + 320 = 750\n\\]\n\nSarah raised: **$300**\n\nMiriam raised $400 more than Sarah:\n\n\\[\n300 + 400 = 700\n\\]\n\nTotal raised:\n\n\\[\n430 + 750 + 300 + 700 = 2180\n\\]\n\n**Final answer: 2180**", "transcript": "The girls are trying to raise money for a carnival. Kim raises $320 more than Alexandra, who raises $430, and Miriam raises $400 more than Sarah, who raises $300. How much money in dollars did they all raise in total? Show your work and end with the final numeric answer.\n", "asr_s": 1.45, "expert_s": 2.64, "expert_input_samples": 302000, "expert_input_s": 18.875, "expert_input_sha256": "5aab9dcd12c7d805dc41e808f3135fcd90f44f6e224ee628a0014dde98367d67", "expert_timed_out": false, "wait_s": 1.742, "relay_synth_ms": 22824, "onset_chunk": 19, "eot_seen": false, "n_speak_chunks": 2, "feed_lag_max_ms": 450, "feed_lag_sum_ms": 730, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0090_always_relay.wav", "sha256": "a98f3a677d5c13eb0534a9849223ad4aa46419835e4538bcbd1f4bbec572dae3", "sr": 24000, "seconds": 37.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0090_always_candidate.wav", "sha256": "841c2ddf2b4f26208084893d5cdba5e6356687afe755ed41a6eb3298729e525e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0090_always_stall.wav", "sha256": "27c70206198faffea4e200daefe5eaf3a8bf24a17e21b7a443a2c8d3156c3bff", "sr": 24000, "seconds": 3.28}}, "chunks": [[0, 1, 1.0, 1.067, 1.122, 1, 0, 0], [1, 1, 2.0, 2.08, 2.142, 1, 0, 0], [2, 1, 3.0, 3.072, 3.126, 1, 0, 0], [3, 1, 4.0, 4.083, 4.148, 1, 0, 0], [4, 1, 5.0, 5.071, 5.13, 1, 0, 0], [5, 1, 6.0, 6.081, 6.146, 1, 0, 0], [6, 1, 7.0, 7.076, 7.135, 1, 0, 0], [7, 1, 8.0, 8.079, 8.14, 1, 0, 0], [8, 1, 9.0, 9.077, 9.139, 1, 0, 0], [9, 1, 10.0, 10.072, 10.128, 1, 0, 0], [10, 1, 11.0, 11.071, 11.127, 1, 0, 0], [11, 1, 12.0, 12.08, 12.144, 1, 0, 0], [12, 1, 13.0, 13.077, 13.138, 1, 0, 0], [13, 1, 14.0, 14.081, 14.147, 1, 0, 0], [14, 1, 15.0, 15.07, 15.129, 1, 0, 0], [15, 1, 16.0, 16.086, 16.148, 1, 0, 0], [16, 1, 17.0, 17.079, 17.142, 1, 0, 0], [17, 1, 18.0, 18.081, 18.141, 1, 0, 0], [18, 1, 18.875, 18.951, 19.006, 1, 0, 0], [19, 0, 19.875, 19.957, 20.645, 0, 24000, 0], [20, 0, 20.875, 21.404, 22.155, 0, 24000, 0], [21, 0, 21.875, 22.231, 22.989, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 18.875, "last_real_feed_done": 18.951, "onset": 20.645, "gate_read_done": 20.645, "fire": 20.645, "candidate_first_pcm": 20.645, "stall_note": 20.647, "stall_first_pcm": 21.326, "local_first_pcm": null, "wait_start": 22.989, "expert_req": 20.647, "expert_resp": 24.73, "relay_sy