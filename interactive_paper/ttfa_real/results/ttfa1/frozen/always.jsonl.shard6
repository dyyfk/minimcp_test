{"id": "q0382", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2414862389, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "In the very first Boston Marathon, 15 runners competed. How many finished?", "input_path": "/data/audio_pool/q0382.wav", "input_sha256": "18870eefe6c2fb40a6644492175c05c29787af73df0f331bb3823dd86482df96", "input_samples": 78600, "input_s": 4.912, "n_real_chunks": 5, "score": 0.6942, "act": 0.9976, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "10 runners finished the very first Boston Marathon.", "expert_answer": "**10 runners finished** the very first Boston Marathon.", "transcript": "In the very first Boston Marathon, 15 runners competed. How many finished?\n", "asr_s": 0.59, "expert_s": 2.58, "expert_input_samples": 78600, "expert_input_s": 4.912, "expert_input_sha256": "18870eefe6c2fb40a6644492175c05c29787af73df0f331bb3823dd86482df96", "expert_timed_out": false, "wait_s": 2.815, "relay_synth_ms": 2166, "onset_chunk": 5, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0382_always_relay.wav", "sha256": "76de819644dca20e46aa1038c248284b33dcaf0b83f0544de2b765b60853923b", "sr": 24000, "seconds": 3.88}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0382_always_stall.wav", "sha256": "685f9ea64df5b7c62b2118bf8051619f21bab4e9f4cf531f305935378b323ae4", "sr": 24000, "seconds": 0.2}}, "chunks": [[0, 1, 1.0, 1.073, 1.133, 1, 0, 0], [1, 1, 2.0, 2.078, 2.14, 1, 0, 0], [2, 1, 3.0, 3.077, 3.138, 1, 0, 0], [3, 1, 4.0, 4.085, 4.155, 1, 0, 0], [4, 1, 4.912, 4.992, 5.061, 1, 0, 0], [5, 0, 5.912, 5.99, 6.198, 0, 0, 0]], "s