{"id": "q0485", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 348414739, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "为一个蛋糕烘焙业务创建一个使命宣言。", "input_path": "/data/audio_pool/q0485.wav", "input_sha256": "96872ba43093364f6661e62e870c5d9e3f443ebf800656642e4cb4ef3579a748", "input_samples": 63200, "input_s": 3.95, "n_real_chunks": 4, "score": 0.3003, "act": 0.9976, "is_info": true, "fired": false, "mode": "local", "answer": "我们的使命是为每个特殊时刻带来甜蜜的惊喜，让每个蛋糕都成为爱与欢乐的象征。", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0485_aggressive_local.wav", "sha256": "372f8764ec92bceef7b32722297e8a22b627f2b530c084fe079f91ef30930d2a", "sr": 24000, "seconds": 8.8}}, "chunks": [[0, 1, 1.0, 1.073, 1.133, 1, 0, 0], [1, 1, 2.0, 2.075, 2.132, 1, 0, 0], [2, 1, 3.0, 3.075, 3.134, 1, 0, 0], [3, 1, 3.95, 4.029, 4.091, 1, 0, 0], [4, 0, 4.95, 5.026, 5.22, 0, 0, 0], [5, 0, 5.95, 6.033, 6.774, 0, 24000, 0], [6, 0, 6.95, 7.03, 7.682, 0, 24000, 0], [7, 0, 7.95, 8.038, 8.696, 0, 24000, 0], [8, 0, 8.95, 9.029, 9.794, 0, 24000, 0], [9, 0, 9.95, 10.031, 10.661, 0, 24000, 0], [10, 0, 10.95, 11.032, 11.745, 0, 24000, 0], [11, 0, 11.95, 12.031, 12.677, 0, 24000, 0], [12, 0, 12.95, 13.037, 13.769, 0, 24000, 0], [13, 0, 13.95, 14.126, 14.585, 0, 19200, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.95, "la