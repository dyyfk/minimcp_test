, 24000, 0], [43, 0, 43.05, 43.131, 43.855, 0, 24000, 0], [44, 0, 44.05, 44.133, 44.873, 0, 24000, 0], [45, 0, 45.05, 45.133, 45.876, 0, 24000, 0], [46, 0, 46.05, 46.129, 46.864, 0, 24000, 0], [47, 0, 47.05, 47.134, 47.881, 0, 24000, 0], [48, 0, 48.05, 48.138, 48.863, 0, 24000, 0], [49, 0, 49.05, 49.132, 49.928, 0, 24000, 0], [50, 0, 50.05, 50.128, 50.88, 0, 24000, 0], [51, 0, 51.05, 51.132, 51.931, 0, 24000, 0], [52, 0, 52.05, 52.13, 53.004, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.05, "last_real_feed_done": 1.236, "onset": 4.672, "gate_read_done": 4.672, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.672, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.672, "first_answer_pcm": 4.672, "session_end": 53.004}, "ttfa_answer_s": 3.622, "ttfa_any_s": 3.622}
{"id": "q0425", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3995831193, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Provide a bulleted list of things to think about when buying a house", "input_path": "/data/audio_pool/q0425.wav", "input_sha256": "9e6324dca26b1ad3031b2273503cffcd44dcf8caad3c270cbc37b8ffa7bf4a9d", "input_samples": 62400, "input_s": 3.9, "n_real_chunks": 4, "score": 0.5647, "act": 0.9953, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Budget: Know how much you can afford, including mortgage, taxes, insurance, utilities, HOA fees, and maintenance. , Down payment and closing costs: Plan for upfront costs beyond the purchase price. , Mortgage options: Compare interest rates, loan types, terms, and lender fees. , Location: Consider commute, safety, schools, amenities, noise, and neighborhood trends. , Home condition: Look at the.", "expert_answer": "- **Budget:** Know how much you can afford, including mortgage, taxes, insurance, utilities, HOA fees, and maintenance.\n- **Down payment and closing costs:** Plan for upfront costs beyond the purchase price.\n- **Mortgage options:** Compare interest rates, loan types, terms, and lender fees.\n- **Location:** Consider commute, safety, schools, amenities, noise, and neighborhood trends.\n- **Home condition:** Look at the roof, foundation, plumbing, electrical systems, HVAC, windows, and appliances.\n- **Inspection:** Hire a qualified home inspector before finalizing the purchase.\n- **Resale value:** Think about how easy the home may be to sell later.\n- **Size and layout:** Make sure the bedrooms, bathrooms, storage, and floor plan fit your needs.\n- **Future needs:** Consider family changes, remote work, accessibility, or potential renovations.\n- **Property taxes:** Check current taxes and whether they may increase after purchase.\n- **Insurance:** Confirm costs and coverage, especially for flood, fire, earthquake, or storm risks.\n- **HOA rules and fees:** Review restrictions, dues, reserves, and community rules if applicable.\n- **Maintenance costs:** Budget for repairs, landscaping, pest control, and routine upkeep.\n- **Local market conditions:** Understand whether it’s a buyer’s or seller’s market.\n- **Comparable sales:** Review recent sales of similar homes nearby to judge pricing.\n- **Title and legal issues:** Check for liens, easements, boundary disputes, or zoning restrictions.\n- **Utilities and efficiency:** Look at heating/cooling costs, insulation, windows, and energy efficiency.\n- **Parking and transportation:** Consider garage space, street parking, public transit, and walkability.\n- **Neighborhood plans:** Research future construction, zoning changes, roads, or commercial development nearby.\n- **Personal fit:** Visit at different times of day and ask whether the home and area feel right.", "transcript": "Provide a bulleted list of things to think about when buying a house.\n", "asr_s": 0.52, "expert_s": 8.65, "expert_input_samples": 62400, "expert_input_s": 3.9, "expert_input_sha256": "9e6324dca26b1ad3031b2273503cffcd44dcf8caad3c270cbc37b8ffa7bf4a9d", "expert_timed_out": false, "wait_s": 6.225, "relay_synth_ms": 16334, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 2, "feed_lag_max_ms": 994, "feed_lag_sum_ms": 1783, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0425_aggressive_relay.wav", "sha256": "2332de9606e0b4329d20ced4d395d28d7a016fc179a54f22647db924a6a41a4d", "sr": 24000, "seconds": 25.72}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0425_aggressive_candidate.wav", "sha256": "8d587ea4ba2888a96f478cd50193761976ec688cb25c4064dc64575a846f6b5e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0425_aggressive_stall.wav", "sha256": "df48b3c1ba786a30ee4beba774d18fd5b8d472453ea9cb0bba920d2dafa5622a", "sr": 24000, "seconds": 3.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.134, 1, 0, 0], [1, 1, 2.0, 2.078, 2.14, 1, 0, 0], [2, 1, 3.0, 3.077, 3.14, 1, 0, 0], [3, 1, 3.9, 3.979, 4.045, 1, 0, 0], [4, 0, 4.9, 4.987, 5.603, 0, 24000, 0], [5, 0, 5.9, 6.972, 7.689, 0, 24000, 0], [6, 0, 6.9, 7.763, 8.559, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.9, "last_real_feed_done": 3.979, "onset": 5.603, "gate_read_done": 5.603, "fire": 5.603, "candidate_first_pcm": 5.603, "stall_note": 5.605, "stall_first_pcm": 6.894, "local_first_pcm": null, "wait_start": 8.559, "expert_req": 5.604, "expert_resp": 14.784, "relay_synth_start": 14.785, "relay_first_pcm": 15.805, "relay_synth_end": 31.119, "first_any_pcm": 5.603, "first_answer_pcm": 15.805, "session_end": 32.481}, "ttfa_answer_s": 11.905, "ttfa_any_s": 1.703}
