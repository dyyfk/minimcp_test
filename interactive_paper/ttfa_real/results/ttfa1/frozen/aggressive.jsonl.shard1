{"id": "q0406", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1158985889, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "What is Pickleball?", "input_path": "/data/audio_pool/q0406.wav", "input_sha256": "67a862b71bc40e0a6a206966690b7b8a9331d4abf19002edbce08979f182b8a5", "input_samples": 16800, "input_s": 1.05, "n_real_chunks": 2, "score": 0.197, "act": 0.9979, "is_info": true, "fired": false, "mode": "local", "answer": "Pickleball is a fun and popular sport that combine s elements of tennis, bad minton, and table tennis. It's played on a court similar to a doubles tennis court, but with shorter boundaries. Players use solid plastic or composite paddles and hit a lightweight ball over the net.The game starts with a serve from behind the baseline, and players must keep the ball in play by hitting it back before it bounces twice on their side. One unique feature is the non- volley zone, also known as the kitchen, which is seven feet behind the net. You can't strike the ball after it bounce s there unless you are standing inside the zone. P ickleball is known for being easy to learn but challenging to master, making it great for people of all ages and skill levels. It ’s often played social ly at community center s, parks, and resort s.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 49, "feed_lag_max_ms": 102, "feed_lag_sum_ms": 102, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0406_a