{"id": "q0062", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 321549282, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Dexter has five pigs. Each one eats 4 pounds of feed, twice a day. If Dexter ordered 300 pounds of feed, how many pounds of feed is left after a week?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0062.wav", "input_sha256": "5a3a06aa57496346a4242089421ae2f546556db35ea4f183e556151d4c41bf8f", "input_samples": 211400, "input_s": 13.213, "n_real_chunks": 14, "score": 0.0906, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Each pig eats: \\(4 \\text{ pounds} \\times 2 = 8\\) pounds per day Five pigs eat: \\(5 \\times 8 = 40\\) pounds per day In one week: \\(40 \\times 7 = 280\\) pounds Feed left: \\(300 - 280 = 20\\) Final answer: 20", "expert_answer": "Each pig eats:\n\n\\(4 \\text{ pounds} \\times 2 = 8\\) pounds per day\n\nFive pigs eat:\n\n\\(5 \\times 8 = 40\\) pounds per day\n\nIn one week:\n\n\\(40 \\times 7 = 280\\) pounds\n\nFeed left:\n\n\\(300 - 280 = 20\\)\n\n**Final answer: 20**", "transcript": "Dexter has five pigs. Each one eats four pounds of feed twice a day. If Dexter ordered 300 pounds of feed, how many pounds of feed is left after a week? Show your work and end with the final numeric answer.\n", "asr_s": 0.89, "expert_s": 1.92, "expert_input_samples": 211400, "expert_input_s": 13.213, "expert_input_sha256": "5a3a06aa57496346a4242089421ae2f546556db35ea4f183e556151d4c41bf8f", "expert_timed_out": false, "wait_s": 2.017, "relay_synth_ms": 63887, "onset_chunk": 13, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "aud