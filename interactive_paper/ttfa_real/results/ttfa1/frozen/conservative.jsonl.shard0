{"id": "q0484", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1673745285, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "电动汽车是智能交通的未来。", "input_path": "/data/audio_pool/q0484.wav", "input_sha256": "5a4727dc7720144a37c2f5dfbdfb9b36addffb26fffba5f4ccbc7c2de898316f", "input_samples": 44400, "input_s": 2.775, "n_real_chunks": 3, "score": 0.3941, "act": 0.9966, "is_info": true, "fired": false, "mode": "local", "answer": "电动汽车确实是智能交通的一个重要组成部分。它们不仅有助于减少碳排放，还能与智能网联技术结合，提升交通效率和安全性。随着技术不断进步，电动汽车在未来城市交通中的角色会越来越重要。", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 17, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0484_conservative_local.wav", "sha256": "211b9cf401582c53495dd5ffd9112e3b95b460066474d9c2f921a2fc7a2b80a5", "sr": 24000, "seconds": 17.28}}, "chunks": [[0, 1, 1.0, 1.076, 1.14, 1, 0, 0], [1, 1, 2.0, 2.077, 2.138, 1, 0, 0], [2, 1, 2.775, 2.853, 2.914, 1, 0, 0], [3, 0, 3.775, 3.853, 4.307, 0, 24000, 0], [4, 0, 4.775, 4.859, 5.6, 0, 24000, 0], [5, 0, 5.775, 5.857, 6.591, 0, 24000, 0], [6, 0, 6.775, 6.853, 7.553, 0, 24000, 0], [7, 0, 7.775, 7.854, 8.56, 0, 24000, 0], [8, 0, 8.775, 8.857, 9.644, 0, 24000, 0], [9, 0, 9.775, 9.852, 10.534, 0, 24000, 0], [10, 0, 10.775, 10.855, 11.596, 0, 24000, 0], [11, 0, 11.775, 11.853, 12.577, 0, 24000, 0], [12, 0, 12.775, 12.857, 13.551, 0, 24000, 0], [13, 0, 13.775, 13.858, 14.566, 0, 24000, 0], [14, 0, 14.77