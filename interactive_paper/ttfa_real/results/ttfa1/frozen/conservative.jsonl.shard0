{"id": "q0385", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 294352278, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is a Jacob's Ladder?", "input_path": "/data/audio_pool/q0385.wav", "input_sha256": "31316dd7f7568c93c3cf37ce0b3e558f6f198cb484caab2734b25447a4bc7d7f", "input_samples": 23200, "input_s": 1.45, "n_real_chunks": 2, "score": 0.4004, "act": 0.9971, "is_info": true, "fired": false, "mode": "local", "answer": "A Jacob's ladder is an electrical device that uses high voltage to create a visible arc between two wires. It looks like a pair of wires arranged in a zigzag or sta ir-step pattern, and when electricity flows through it, the arc jumps up the wires, creating a glowing, moving light effect. The name comes from its resemblance to the biblical Jacob' s ladder, which was described as a sta ircase connecting earth to heaven.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0385_conservative_local.wav", "sha256": "930d266fd2fbeaef2160dbaa93bc942765da90fd54817ff66e7e71d06b656147", "sr": 24000, "seconds": 22.52}}, "chunks": [[0, 1, 1.0, 1.079, 1.14, 1, 0, 0], [1, 1, 1.45, 1.532, 1.599, 1, 0, 0], [2, 0, 2.45, 2.53, 2.592, 1, 0, 0], [3, 0, 3.45, 3.532, 4.343, 0, 24000, 0], [4, 0, 4.45, 4.528, 5.276, 0, 24000, 0], [5, 0, 5.45, 5.529, 6.257, 0, 24000, 0], [6, 0, 6.45, 6.532, 7.3