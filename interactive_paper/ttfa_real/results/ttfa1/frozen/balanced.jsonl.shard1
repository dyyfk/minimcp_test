{"id": "q0406", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1158985889, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "What is Pickleball?", "input_path": "/data/audio_pool/q0406.wav", "input_sha256": "67a862b71bc40e0a6a206966690b7b8a9331d4abf19002edbce08979f182b8a5", "input_samples": 16800, "input_s": 1.05, "n_real_chunks": 2, "score": 0.1741, "act": 0.9932, "is_info": true, "fired": false, "mode": "local", "answer": "Pickleball is a fun, fast- paced sport played with a rubber ball and a plastic or composite paddle. It' s typically played on a court similar in size to a badminton court but with shorter net s. The game can be played doubles or singles, and players hit the ball over the net using their paddles. The objective is to make the ball land in your opponent's court without them returning it. It' s known for being easy to learn but challenging to master, making it popular across all ages. Plus, it ’s great exercise and a lot of fun!", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 31, "feed_lag_max_ms": 7320, "feed_lag_sum_ms": 119807, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0406_balanced_local.wav", "sha256": "d653d465f2d4d40c5cf2d1d4b4728b7e67294c6aeec94473d0209465d53a2300", "sr": 24000, "seconds": 30.28}}, "chunks": [[0, 1, 1.0, 1.116, 1.21, 1, 0, 0], [1, 1, 1.05, 1.324, 1.418, 1, 0, 0], [2, 0, 2.05, 2.174, 2.271, 1, 0, 0], [3, 0, 3.05, 3.168, 4.517, 0, 24000, 0], [4, 0