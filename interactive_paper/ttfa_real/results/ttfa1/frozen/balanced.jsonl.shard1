{"id": "q0062", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 321549282, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Dexter has five pigs. Each one eats 4 pounds of feed, twice a day. If Dexter ordered 300 pounds of feed, how many pounds of feed is left after a week?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0062.wav", "input_sha256": "5a3a06aa57496346a4242089421ae2f546556db35ea4f183e556151d4c41bf8f", "input_samples": 211400, "input_s": 13.213, "n_real_chunks": 14, "score": 0.0627, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "Each pig eats 4 pounds of feed twice a day, so each pig eat s 4 times 2 equals 8 pounds per day. D exter has 5 pigs, so they eat 5 times 8 equal s 40 pounds per day. In one week, there are 7 days, so they eat 4 0 times 7 equal s 280 pounds. Dexter ordered 300 pounds, so the amount left is 300 minus 2 80 equals 20 pounds. The answer is 20.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 13, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 6905, "feed_lag_sum_ms": 82799, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0062_balanced_local.wav", "sha256": "181d23c9d725633ec9ebfdb1ed688ca110be5a9162332af75b73d2f3fd3e066d", "sr": 24000, "seconds": 23.24}}, "chunks": [[0, 1, 1.0, 1.12, 1.218, 1, 0, 0], [1, 1, 2.0, 2.121, 2.217, 1, 0, 0], [2, 1, 3.0, 3.12, 3.218, 1, 0, 0], [3, 1, 4.0, 4.119, 4.219, 1, 0, 0], [4, 1, 5.0, 