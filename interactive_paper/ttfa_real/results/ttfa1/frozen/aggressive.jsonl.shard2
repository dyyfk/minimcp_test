{"id": "q0409", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3584795952, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is the Philly Special and when was it used ?", "input_path": "/data/audio_pool/q0409.wav", "input_sha256": "4626e109e8dab269e08cb50663c7d887ca150cd378990b93908b73a4c77749d2", "input_samples": 48200, "input_s": 3.013, "n_real_chunks": 4, "score": 0.7611, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Philly Special was a famous trick play run by the Philadelphia Eagles in Super Bowl LII. It was used on February 4, 2018, against the New England Patriots, near the end of the first half. The play helped the Eagles win 41–33, giving Philadelphia its first Super Bowl title.", "expert_answer": "The **Philly Special** was a famous trick play run by the **Philadelphia Eagles** in **Super Bowl LII**.\n\nIt was used on **February 4, 2018**, against the **New England Patriots**, near the end of the first half. On 4th-and-goal, quarterback **Nick Foles** lined up as if he were calling an audible, the ball was snapped directly to running back **Corey Clement**, then flipped to tight end **Trey Burton**, who threw a touchdown pass to Foles.\n\nThe play helped the Eagles win **41–33**, giving Philadelphia its first Super Bowl title.", "transcript": "What is the Philly Special and when was it used?\n", "asr_s": 0.77, "expert_s": 5.64, "expert_input_samples": 48200, "expert_input_s": 3.013, "expert_input_sha256": "4626e109e8dab269e08cb50663c7d887ca150cd378990b93908b73a4c77749d2", "expert_timed_out": false, "wait_s": 5.658, "relay_synth_ms": 10662, "onset_chunk": 3, "eot_seen": false, "n_spea