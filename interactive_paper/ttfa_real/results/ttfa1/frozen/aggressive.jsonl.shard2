33, 1, 34.0, 34.084, 34.145, 1, 0, 0], [34, 1, 34.038, 34.223, 34.926, 0, 24000, 0], [35, 0, 35.038, 35.657, 36.448, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 34.038, "last_real_feed_done": 34.223, "onset": 34.926, "gate_read_done": 34.926, "fire": 34.926, "candidate_first_pcm": 34.926, "stall_note": 34.929, "stall_first_pcm": 35.568, "local_first_pcm": null, "wait_start": 36.448, "expert_req": 34.929, "expert_resp": 38.334, "relay_synth_start": 38.334, "relay_first_pcm": 39.176, "relay_synth_end": 40.678, "first_any_pcm": 34.926, "first_answer_pcm": 39.176, "session_end": 40.839}, "ttfa_answer_s": 5.139, "ttfa_any_s": 0.889}
{"id": "q0243", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1436546456, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "You buy 100 shares in XYZ Corporation on the Internet and your broker charges you $29.95.\n\nA. This will increase GDP by the total cost of the shares plus $29.95.\nB. This will increase GDP by $29.95.\nC. This will increase GDP by the cost of the shares minus $29.95.\nD. This has no effect on GDP.\nE. This will increase the investment component of GDP and therefore overall GDP.\nF. This will increase GDP by the cost of the shares.\nG. This will decrease GDP by the cost of the shares plus $29.95.\nH. This will decrease the investment component of GDP and therefore overall GDP.\nI. This will have a variable effect on GDP depending on the current market value of the shares.\nJ. This will decrease GDP by $29.95.\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0243.wav", "input_sha256": "5fe3eb97d7fba375d01de8e4bb9c3829aa204ea22d27b154eb9505cb89c7e887", "input_samples": 829600, "input_s": 51.85, "n_real_chunks": 52, "score": 0.4071, "act": 0.9986, "is_info": true, "fired": false, "mode": "local", "answer": "Well, let's think about GDP. GDP measures the value of goods and services produced within a country over a period of time. So when you buy shares, it' s essentially an investment transaction. But does that count as production? No, because buying shares is more like a transfer of ownership. It doesn't create new goods or services. So the correct answer is D. This has no effect on GDP.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 21, "eot_seen": true, "n_speak_chunks": 19, "feed_lag_max_ms": 571, "feed_lag_sum_ms": 684, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0243_aggressive_local.wav", "sha256": "bd784588d4d532e4bc02075166ee2f193c1e16ee2324dd1865ffc389d33b4575", "sr": 24000, "seconds": 19.28}}, "chunks": [[0, 1, 1.0, 1.074, 1.133, 1, 0, 0], [1, 1, 2.0, 2.075, 2.133, 1, 0, 0], [2, 1, 3.0, 3.082, 3.143, 1, 0, 0], [3, 1, 4.0, 4.079, 4.142, 1, 0, 0], [4, 1, 5.0, 5.078, 5.142, 1, 0, 0], [5, 1, 6.0, 6.088, 6.157, 1, 0, 0], [6, 1, 7.0, 7.083, 7.149, 1, 0, 0], [7, 1, 8.0, 8.082, 8.146, 1, 0, 0], [8, 1, 9.0, 9.07, 9.126, 1, 0, 0], [9, 1, 10.0, 10.081, 10.142, 1, 0, 0], [10, 1, 11.0, 11.079, 11.139, 1, 0, 0], [11, 1, 12.0, 12.071, 12.127, 1, 0, 0], [12, 1, 13.0, 13.084, 13.154, 1, 0, 0], [13, 1, 14.0, 14.08, 14.14, 1, 0, 0], [14, 1, 15.0, 15.082, 15.144, 1, 0, 0], [15, 1, 16.0, 16.074, 16.131, 1, 0, 0], [16, 1, 17.0, 17.082, 17.147, 1, 0, 0], [17, 1, 18.0, 18.079, 18.139, 1, 0, 0], [18, 1, 19.0, 19.077, 19.137, 1, 0, 0], [19, 1, 20.0, 20.079, 20.137, 1, 0, 0], [20, 1, 21.0, 21.076, 21.134, 1, 0, 0], [21, 1, 22.0, 22.077, 22.814, 0, 24000, 0], [22, 1, 23.0, 23.081, 23.679, 0, 24000, 0], [23, 1, 24.0, 24.079, 24.706, 0, 24000, 0], [24, 1, 25.0, 25.081, 25.769, 0, 24000, 0], [25, 1, 26.0, 26.078, 26.725, 0, 24000, 0], [26, 1, 27.0, 27.08, 27.74, 0, 24000, 0], [27, 1, 28.0, 28.083, 28.813, 0, 24000, 0], [28, 1, 29.0, 29.081, 29.736, 0, 24000, 0], [29, 1, 30.0, 30.08, 30.804, 0, 24000, 0], [30, 1, 31.0, 31.077, 31.758, 0, 24000, 0], [31, 1, 32.0, 32.076, 32.661, 0, 24000, 0], [32, 1, 33.0, 33.08, 33.763, 0, 24000, 0], [33, 1, 34.0, 34.087, 34.781, 0, 24000, 0], [34, 1, 35.0, 35.085, 35.807, 0, 24000, 0], [35, 1, 36.0, 36.091, 36.813, 0, 24000, 0], [36, 1, 37.0, 37.088, 37.847, 0, 24000, 0], [37, 1, 38.0, 38.082, 39.114, 0, 240