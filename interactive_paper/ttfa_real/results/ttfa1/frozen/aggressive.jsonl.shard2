{"id": "q0388", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1866074411, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "Can you name the river that flows through Cardiff?", "input_path": "/data/audio_pool/q0388.wav", "input_sha256": "9f84ca1f560979275c6dc3e50fc372263c526c59dc919af73946855d78566471", "input_samples": 50000, "input_s": 3.125, "n_real_chunks": 4, "score": 0.3835, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "The river that flows through Cardiff is the River Taff. It runs through the city centre and provides a scenic waterway for residents and visitors alike.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 9, "feed_lag_max_ms": 3, "feed_lag_sum_ms": 3, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0388_aggressive_local.wav", "sha256": "c444761611c6bb2d9d2512cc2f7deeae4d7271c5f30a436f645b9cb0acb75b88", "sr": 24000, "seconds": 8.88}}, "chunks": [[0, 1, 1.0, 1.076, 1.133, 1, 0, 0], [1, 1, 2.0, 2.073, 2.132, 1, 0, 0], [2, 1, 3.0, 3.074, 3.128, 1, 0, 0], [3, 1, 3.125, 3.196, 3.838, 0, 24000, 0], [4, 0, 4.125, 4.196, 4.822, 0, 24000, 0], [5, 0, 5.125, 5.196, 5.87, 0, 24000, 0], [6, 0, 6.125, 6.197, 6.901, 0, 24000, 0], [7, 0, 7.125, 7.206, 7.89, 0, 24000, 0], [8, 0, 8.125, 8.198, 8.894, 0, 24000, 0], [9, 0, 9.125, 9.2, 9.913, 0, 24000, 0], [10, 0, 10.125, 10.197, 10.867, 0, 24000, 0], [11, 0, 11.125, 11.2, 11.724, 0, 21120, 1]], "status": "compl