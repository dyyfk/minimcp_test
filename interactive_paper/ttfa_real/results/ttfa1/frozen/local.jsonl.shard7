{"id": "q0255", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2783404524, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "A college student and a man got into a fight at a bar while playing pooi. The college student allegedly started the fight when he struck the man in the head with a pool cue after the man sank a game-winning shot. At the college student's trial for assault, the prosecution called one of the college student's classmates to testify. The classmate was not at the bar during the fight. The classmate offered to testify that the next day at class, he approached the college student and said, \"It was wrong of you to start a fight with the man over a game of pool,\" at which point, the college student bowed his head and walked away. The classmate's testimony is\n\nA. admissible as a statement of the declarant’s then-existing state of mind.\nB. inadmissible as a character evidence.\nC. inadmissible as hearsay not within any recognized exception.\nD. admissible as a prior consistent statement.\nE. inadmissible as a statement that is not in the defendant's favor.\nF. inadmissible because the classmate was not an eyewitness to the fight.\nG. inadmissible as self-serving.\nH. admissible as part of the res gestae.\nI. admissible as an admission.\nJ. admissible as a statement of personal or family history.\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0255.wav", "input_sha256": "288db74cf0fbf582d5df0186241dfb971f271b742d35f9b46748e81833d4d62f", "input_samples": 1238400, "input_s": 77.4, "n_real_chunks": 78, "score": 0.6317, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "A. Admiss ible as a statement of the declar ant's then-existing state of mind.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 77, "eot_seen": true, "n_speak_chunks": 5, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0255_local_local.wav", "sha256": "1630791ae61ff0822cbb3ed08cebec7718bc06ccd2987c28e5c709b66471c248", "sr": 24000, "seconds": 4.32}}, "chunks": [[0, 1, 1.0, 1.059, 1.106, 1, 0, 0], [1, 1, 2.0, 2.058, 2.104, 1, 0, 0], [2, 1, 3.0, 3.06, 3.107, 1, 0, 0], [3, 1, 4.0, 4.061, 4.109, 1, 0, 0], [4, 1, 5.0, 5.06, 5.108, 1, 0, 0], [5, 1, 6.0, 6.061, 6.109, 1, 0, 0], [6, 1, 7.0, 7.062, 7.111, 1, 0, 0], [7, 1, 8.0, 8.071, 8.127, 1, 0, 0], [8, 1, 9.0, 9.061, 9.109, 1, 0, 0], [9, 1, 10.0, 10.063, 10.111, 1, 0, 0], [10, 1, 11.0, 11.062, 11.109, 1, 0, 0], [11, 1, 12.0, 12.064, 12.112, 1, 0, 0], [12, 1, 13.0, 13.071, 13.125, 1, 0, 0], [13, 1, 14.0, 14.064, 14.11, 1, 0, 0], [14, 1, 15.0, 15.063, 15.111, 1, 0, 0], [15, 1, 16.0, 16.065, 16.112, 1, 0, 0], [16, 1, 17.0, 17.065, 17.114, 1, 0, 0], [17, 1, 18.0, 18.064, 18.114, 1, 0, 0], [18, 1, 19.0, 19.066, 19.115, 1, 0, 0], [19, 1, 20.0, 20.066, 20.114, 1, 0, 0], [20, 1, 21.0, 21.072, 21.125, 1, 0, 0], [21, 1, 22.0, 22.065, 22.112, 1, 0, 0], [22, 1, 23.0, 23.071, 23.124, 1, 0, 0], [23, 1, 24.0, 24.071, 24.123, 1, 0, 0], [24, 1, 25.0, 25.075, 25.127, 1, 0, 0], [25, 1, 26.0, 26.077, 26.126, 1, 0, 0], [26, 1, 27.0, 27.074, 27.127, 1, 0, 0], [27, 1, 28.0, 28.068, 28.115, 1, 0, 0], [28, 1, 29.0, 29.069, 29.117, 1, 0, 0], [29, 1, 30.0, 30.067, 30.115, 1, 0, 0], [30, 1, 31.0, 31.067, 31.116, 1, 0, 0], [31, 1, 32.0, 32.066, 32.115, 1, 0, 0], [32, 1, 33.0, 33.07, 33.122, 1, 0, 0], [33, 1, 34.0, 34.068, 34.117, 1, 0, 0], [34, 1, 35.0, 35.066, 35.114, 1, 0, 0], [35, 1, 36.0, 36.067, 36.115, 