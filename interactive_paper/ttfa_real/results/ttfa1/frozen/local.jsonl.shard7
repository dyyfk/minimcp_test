{"id": "q0424", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2569845519, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "Give me some examples of metamorphic rocks.", "input_path": "/data/audio_pool/q0424.wav", "input_sha256": "482e535dd44784690b76f4dd08ef1c4c66ef13d887e6d4483bd0e73849b5fdc8", "input_samples": 38800, "input_s": 2.425, "n_real_chunks": 3, "score": 0.2108, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "Some examples of metamorph ic rocks include marble, which forms from limestone; qua rtzite, created by the transformation of sandstone; and gneiss, which develops from igneous or sedimentary rocks under high heat and pressure.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0424_local_local.wav", "sha256": "65d0940b8a165b3705cbb49d745d3cf0afa354357e68b01f2638731dd558205f", "sr": 24000, "seconds": 11.28}}, "chunks": [[0, 1, 1.0, 1.059, 1.106, 1, 0, 0], [1, 1, 2.0, 2.058, 2.101, 1, 0, 0], [2, 1, 2.425, 2.484, 2.529, 1, 0, 0], [3, 0, 3.425, 3.482, 4.028, 0, 24000, 0], [4, 0, 4.425, 4.483, 5.026, 0, 24000, 0], [5, 0, 5.425, 5.479, 5.965, 0, 24000, 0], [6, 0, 6.425, 6.485, 7.001, 0, 24000, 0], [7, 0, 7.425, 7.482, 8.043, 0, 24000, 0], [8, 0, 8.425, 8.484, 8.984, 0, 24000, 0], [9, 0, 9.425, 9.484, 10.132, 0, 24000, 0], [10, 0, 10.425, 10.487, 11.062, 0, 24000, 0], [11, 0, 11.425