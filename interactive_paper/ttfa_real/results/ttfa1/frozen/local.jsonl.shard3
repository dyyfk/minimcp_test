{"id": "q0391", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 268271822, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Who invented the microwave oven in 1945?", "input_path": "/data/audio_pool/q0391.wav", "input_sha256": "61ba6af496ec55a519bef9c489ddd43dfed45996b461e902345cdd523aae83f9", "input_samples": 50400, "input_s": 3.15, "n_real_chunks": 4, "score": 0.6818, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The microwave oven was invented in 1 9 45 by Percy Spencer, an engineer at Ray theon. He discovered that microwaves could heat food when he noticed a candy bar in his pocket had melted while working near a magnetron, which is used to generate microwave s for radar systems. This led him to develop the first microwave oven, which he called the \" Radarange.\" It was originally designed for industrial use but eventually became popular in homes as well.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 39, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0391_local_local.wav", "sha256": "6a99f2ec3be9b61c65f9f185098f71dbdc49e56a3f0a33d69d1d53a256357e91", "sr": 24000, "seconds": 38.64}}, "chunks": [[0, 1, 1.0, 1.058, 1.102, 1, 0, 0], [1, 1, 2.0, 2.061, 2.108, 1, 0, 0], [2, 1, 3.0, 3.06, 3.105, 1, 0, 0], [3, 1, 3.15, 3.206, 3.588, 0, 24000, 0], [4, 0, 4.15, 4.211, 4.703, 0, 24000, 0], [5, 0, 5.15, 5.209, 5.679, 0, 24000, 0], [6, 0, 6.15, 