{"id": "q0356", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1026316897, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Who, more famous for his opera ‘Faust’, wrote the music used for the anthem of the Vatican City?", "input_path": "/data/audio_pool/q0356.wav", "input_sha256": "550fd8505e4407ae90167f6232970dc2a274315f52aabb9a2ffac88cdc8003e6", "input_samples": 90800, "input_s": 5.675, "n_real_chunks": 6, "score": 0.7428, "act": 1.0, "is_info": true, "fired": false, "mode": "local", "answer": "The anthem of the Vatican City is actually called the Angelus, and it was composed by Gioachino Rossin i. He' s famous for his opera Fa ust, but he also wrote this beautiful piece that's played during the an gulus prayer at St. Peter's Square.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0356_local_local.wav", "sha256": "60809ca0a5dfd7fbef9937d6f36221d565e16e72d5ddcc2bb47e17e4f4dd8ed9", "sr": 24000, "seconds": 15.92}}, "chunks": [[0, 1, 1.0, 1.058, 1.103, 1, 0, 0], [1, 1, 2.0, 2.062, 2.11, 1, 0, 0], [2, 1, 3.0, 3.06, 3.105, 1, 0, 0], [3, 1, 4.0, 4.061, 4.109, 1, 0, 0], [4, 1, 5.0, 5.061, 5.108, 1, 0, 0], [5, 1, 5.675, 5.739, 6.234, 0, 24000, 0], [6, 0, 6.675, 6.742, 7.324, 0, 24000, 0], [7, 0, 7.675, 7.738, 8.247, 0, 24000, 0], [8, 0, 8.675, 8.74, 9.323, 0, 24000, 0], [9, 0, 9.675, 9.741, 10.228, 0, 24000, 0], [10, 0, 10