{"id": "q0390", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2029695064, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "\"The 1902 guitar composition \"\"Gran Vals\"\" by the Spanish composer Francisco Tárrega would have remained obscure but for corporate executive Anssi Vanjoki selecting it for something in 1993. How do millions of people recognize it now?\"", "input_path": "/data/audio_pool/q0390.wav", "input_sha256": "67180d431d3f3d11e0d04375f7a36a7092489629b4b3acdc14de0c74524aa985", "input_samples": 257400, "input_s": 16.087, "n_real_chunks": 17, "score": 0.8823, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "It's the theme song for the television show Se rious Business by An si Van Wyk. And it' s a very catchy tune, so people know it now.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 16, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 17, "feed_lag_sum_ms": 17, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0390_conservative_local.wav", "sha256": "52e46b303e5980b349ce924a103082f107c17dc3dcd4dba07dbbbd724d59885d", "sr": 24000, "seconds": 9.56}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 2.0, 2.055, 2.099, 1, 0, 0], [2, 1, 3.0, 3.056, 3.1, 1, 0, 0], [3, 1, 4.0, 4.057, 4.103, 1, 0, 0], [4, 1, 5.0, 5.058, 5.105, 1, 0, 0], [5, 1, 6.0, 6.057, 6.103, 1, 0, 0], [6, 1, 7.0, 7.056, 7.102, 1, 0, 0], [7, 1, 8.0, 8.058, 8.104, 1, 0, 0], [8, 1, 9.0, 9.057, 9.104, 1, 0, 0],