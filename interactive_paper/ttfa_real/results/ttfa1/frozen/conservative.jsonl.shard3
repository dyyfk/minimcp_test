{"id": "q0430", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2270842455, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Why do people like to buy Apple products?", "input_path": "/data/audio_pool/q0430.wav", "input_sha256": "4c1ec7450720ff60c2e64c53b6e145928bf04b30f77ab3fe34356ee9ae7570a1", "input_samples": 38400, "input_s": 2.4, "n_real_chunks": 3, "score": 0.4108, "act": 0.9968, "is_info": true, "fired": false, "mode": "local", "answer": "Well, people like to buy Apple products because they' re easy to use and they're designed well. And I think that's what makes them so popular.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 9, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0430_conservative_local.wav", "sha256": "5f7679a0608225468f1c44aa5a9d7ec281940a2a4373343d2deb210a3b6b951b", "sr": 24000, "seconds": 8.4}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 2.0, 2.054, 2.095, 1, 0, 0], [2, 1, 2.4, 2.451, 2.492, 1, 0, 0], [3, 0, 3.4, 3.453, 3.854, 0, 24000, 0], [4, 0, 4.4, 4.454, 4.971, 0, 24000, 0], [5, 0, 5.4, 5.455, 5.927, 0, 24000, 0], [6, 0, 6.4, 6.458, 6.919, 0, 24000, 0], [7, 0, 7.4, 7.456, 7.912, 0, 24000, 0], [8, 0, 8.4, 8.456, 8.995, 0, 24000, 0], [9, 0, 9.4, 9.454, 10.014, 0, 24000, 0], [10, 0, 10.4, 10.453, 10.925, 0, 24000, 0], [11, 0, 11.4, 11.455, 11.701, 0, 9600, 1]], "status": "completed", "error": null, "ts": 