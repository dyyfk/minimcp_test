{"id": "q0366", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 369166754, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "Apart from a battle, what did Nelson lose at Tenerife in 1797?", "input_path": "/data/audio_pool/q0366.wav", "input_sha256": "8fe2fc5bf51b39e589f1facd8aabdc8893050925542c6fa73cfa43bf29a7ab07", "input_samples": 73600, "input_s": 4.6, "n_real_chunks": 5, "score": 0.7976, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "Nelson lost his sight in one eye at Tenerife.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 4, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0366_conservative_local.wav", "sha256": "a446d8e00a5dfb147f688b99ab49c3b2513caa67fcb2aea420889b5cabdf8d5c", "sr": 24000, "seconds": 3.64}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 2.0, 2.056, 2.1, 1, 0, 0], [2, 1, 3.0, 3.057, 3.102, 1, 0, 0], [3, 1, 4.0, 4.056, 4.102, 1, 0, 0], [4, 1, 4.6, 4.657, 5.019, 0, 24000, 0], [5, 0, 5.6, 5.657, 6.209, 0, 24000, 0], [6, 0, 6.6, 6.657, 7.192, 0, 24000, 0], [7, 0, 7.6, 7.658, 7.968, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.6, "last_real_feed_done": 4.657, "onset": 5.019, "gate_read_done": 5.019, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 5.019, "wait_start": null, "expert