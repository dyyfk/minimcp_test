{"id": "q0090", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2059144705, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "The girls are trying to raise money for a carnival. Kim raises $320 more than Alexandra, who raises $430, and Maryam raises $400 more than Sarah, who raises $300. How much money, in dollars, did they all raise in total?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0090.wav", "input_sha256": "5aab9dcd12c7d805dc41e808f3135fcd90f44f6e224ee628a0014dde98367d67", "input_samples": 302000, "input_s": 18.875, "n_real_chunks": 19, "score": 0.2105, "act": 0.9989, "is_info": true, "fired": false, "mode": "local", "answer": "Alexandra raised $ 43 0, so Kim raised $4 30 + $32 0 = $7 50. Sarah raised $3 00, so Mariam raised $30 0 + $400 = $70 0. So in total they raised $ 43 0 + $7 50 + $300 + $7 00 = $2 18 0. The answer is 2 18 0.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 19, "eot_seen": true, "n_speak_chunks": 29, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0090_balanced_local.wav", "sha256": "1fa0c7357ea0908056db8e5a57472bc81e30965683ab8c6205ba7c0ace1848ba", "sr": 24000, "seconds": 28.28}}, "chunks": [[0, 1, 1.0, 1.054, 1.098, 1, 0, 0], [1, 1, 2.0, 2.055, 2.099, 1, 0, 0], [2, 1, 3.0, 3.055, 3.097, 1, 0, 0], [3, 1, 4.0, 4.055, 4.098, 1, 0, 0], [4, 1, 5.0, 5.054, 5.098, 1, 0, 0], [5, 1, 6.0, 6.055, 6.098, 1, 0, 0], [6, 1, 7