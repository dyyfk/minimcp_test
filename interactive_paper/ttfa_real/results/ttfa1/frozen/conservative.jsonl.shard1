{"id": "q0406", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1158985889, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "What is Pickleball?", "input_path": "/data/audio_pool/q0406.wav", "input_sha256": "67a862b71bc40e0a6a206966690b7b8a9331d4abf19002edbce08979f182b8a5", "input_samples": 16800, "input_s": 1.05, "n_real_chunks": 2, "score": 0.1813, "act": 0.9975, "is_info": true, "fired": false, "mode": "local", "answer": "Pickleball is a fun and fast-paced sport that combine s elements of tennis, badminton, and table tennis. It's played on a court similar to a doubles tennis court but smaller, with a net in the middle. Players use a solid plastic paddle to hit a lightweight ball over the net. The goal is to make the ball land in your opponent ’s side without them being able to return it. You can play single s or double s, and the game starts with a serve from behind the baseline. It' s known for being easy to learn but challenging to master, making it popular among people of all ages. Plus, it’s great exercise and lots of fun!", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 36, "feed_lag_max_ms": 100, "feed_lag_sum_ms": 100, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0406_conservative_local.wav", "sha256": "61961f76485c2d6046380a0d500902bf076fd9880a32314e6fdc9cb2916bd7a0", "sr": 24000, "seconds": 35.76}}, "chunks": [[0, 1, 1.0, 1.083, 1.15, 1, 0, 0], [1, 1, 1.05, 1.231, 1.297,