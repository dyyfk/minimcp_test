{"id": "q0350", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3562012500, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "English economist and physician Nicholas Barbon helped to pioneer which type of insurance in 1666?", "input_path": "/data/audio_pool/q0350.wav", "input_sha256": "ee1077e74fce91a7c8ef7cfc532613d853c2d11f1585c0d029f87310a7b3c6e6", "input_samples": 111200, "input_s": 6.95, "n_real_chunks": 7, "score": 0.5684, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "Insurance was the first kind of insurance to be invented. It was a way for people who had lost their ships in the Great Fire of London, which happened in 1666, to get paid back for what they had lost. So it's called marine insurance because it was used on ships that were being transported across the ocean.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 7, "eot_seen": true, "n_speak_chunks": 17, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0350_conservative_local.wav", "sha256": "05bb59fcba021277271fc8aafb3039ff7d691b3a66db29b433c9b0c679453570", "sr": 24000, "seconds": 16.6}}, "chunks": [[0, 1, 1.0, 1.082, 1.146, 1, 0, 0], [1, 1, 2.0, 2.088, 2.155, 1, 0, 0], [2, 1, 3.0, 3.087, 3.148, 1, 0, 0], [3, 1, 4.0, 4.087, 4.156, 1, 0, 0], [4, 1, 5.0, 5.074, 5.135, 1, 0, 0], [5, 1, 6.0, 6.09, 6.16, 1, 0, 0], [6, 1, 6.95, 7.04, 7.11, 1, 0, 0], [7, 0, 7.95, 8.038, 8.861, 0, 24000, 0], [8, 0