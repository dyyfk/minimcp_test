{"id": "q0387", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4286911674, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Traditionally with what were the seams of wooden ships caulked?", "input_path": "/data/audio_pool/q0387.wav", "input_sha256": "5a89a80b69f1780a8f287866578a885d6d574f306f5c438aa1cf2aa3619e0648", "input_samples": 62800, "input_s": 3.925, "n_real_chunks": 4, "score": 0.3154, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "Traditionally, the seam s of wooden ships were caulked with a material known as caulking. This was typically made from strip s of oakum, which is waste left over from the process of spinning rope, mixed with tar or pitch. The ca ulkers would then stuff these strips into the seams between the planks of the ship and tap them down to seal any gaps.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 19, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0387_conservative_local.wav", "sha256": "8c7352767329168f1e45f7bc070e8cb51d329a4ba5285997aac0d06aa194278b", "sr": 24000, "seconds": 19.28}}, "chunks": [[0, 1, 1.0, 1.081, 1.143, 1, 0, 0], [1, 1, 2.0, 2.086, 2.151, 1, 0, 0], [2, 1, 3.0, 3.074, 3.131, 1, 0, 0], [3, 1, 3.925, 4.011, 4.079, 1, 0, 0], [4, 0, 4.925, 5.012, 5.72, 0, 24000, 0], [5, 0, 5.925, 6.012, 6.852, 0, 24000, 0], [6, 0, 6.925, 7.001, 7.782, 0, 24000, 0], [7, 0, 7.925, 8.01