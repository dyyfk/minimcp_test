{"id": "q0361", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2288360449, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "In Vermont, USA, there is an old law stating that it is illegal for women to wear what without their husbands written consent?", "input_path": "/data/audio_pool/q0361.wav", "input_sha256": "ae11f03ec671c33c90d952e1e0f113ede06155cc3b200b3a0f46eabf95e4ae90", "input_samples": 125800, "input_s": 7.862, "n_real_chunks": 8, "score": 0.8997, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "False teeth (dentures). This is a commonly repeated “weird old law” attributed to Vermont: women supposedly needed their husband’s written consent to wear false teeth. It does not appear to be a current Vermont law in the modern statutes.", "expert_answer": "**False teeth (dentures).**\n\nThis is a commonly repeated “weird old law” attributed to Vermont: women supposedly needed their husband’s written consent to wear false teeth. It does **not appear to be a current Vermont law** in the modern statutes.", "transcript": "In Vermont, USA, there is an old law stating that it is illegal for women to wear what without their husband's written consent?\n", "asr_s": 0.73, "expert_s": 13.39, "expert_input_samples": 125800, "expert_input_s": 7.862, "expert_input_sha256": "ae11f03ec671c33c90d952e1e0f113ede06155cc3b200b3a0f46eabf95e4ae90", "expert_timed_out": false, "wait_s": 13.422, "relay_synth_ms": 9624, "onset_chunk": 7, "eot_seen": true, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0361_always_relay.wav", "sha256": "d44f9371a6741d0b5fbfb709e8e6b