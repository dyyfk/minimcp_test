{"id": "q0090", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2059144705, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "The girls are trying to raise money for a carnival. Kim raises $320 more than Alexandra, who raises $430, and Maryam raises $400 more than Sarah, who raises $300. How much money, in dollars, did they all raise in total?\n\nShow your work and end with the final numeric answer.", "input_path": "/data/audio_pool/q0090.wav", "input_sha256": "5aab9dcd12c7d805dc41e808f3135fcd90f44f6e224ee628a0014dde98367d67", "input_samples": 302000, "input_s": 18.875, "n_real_chunks": 19, "score": 0.2105, "act": 0.9989, "is_info": true, "fired": false, "mode": "local", "answer": "Alexandra raised $ 43 0, so Kim raised $4 30 + $32 0 = $7 50. Sarah raised $3 00, so Mariam raised $30 0 + $400 = $70 0. So in total they raised $ 43 0 + $7 50 + $300 + $7 00 = $2 18 0. The answer is 2 18 0.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 19, "eot_seen": true, "n_speak_chunks": 29, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0090_aggressive_local.wav", "sha256": "23baca4db0a027dd164e741e18f9f802b2cbc9c8b78177c677a47b7ec36ed279", "sr": 24000, "seconds": 28.28}}, "chunks": [[0, 1, 1.0, 1.064, 1.115, 1, 0, 0], [1, 1, 2.0, 2.058, 2.105, 1, 0, 0], [2, 1, 3.0, 3.059, 3.103, 1, 0, 0], [3, 1, 4.0, 4.059, 4.108, 1, 0, 0], [4, 1, 5.0, 5.059, 5.107, 1, 0, 0], [5, 1, 6.0, 6.055, 6.101, 1, 0, 0], [6