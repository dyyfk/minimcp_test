{"id": "q0519", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3446865478, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "命名一本玛格丽特·阿特伍德写的书。", "input_path": "/data/audio_pool/q0519.wav", "input_sha256": "0e6fe8d747e051128bef67275aeb117c2710ea3a4893a88773361e008843b3ce", "input_samples": 57400, "input_s": 3.587, "n_real_chunks": 4, "score": 0.3618, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "玛格丽特·阿特伍德写过《使女的故事》。这本书非常有名，讲的是一个未来社会里女性失去权利的故事。她还写了《盲区》和《羚羊与蛇》，但最广为人知的应该是《使女的故事》。", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0519_conservative_local.wav", "sha256": "e3c1dc6465f25e38de8652b2957801e711555e4fbcac69385f39a042a2ab8f8d", "sr": 24000, "seconds": 12.92}}, "chunks": [[0, 1, 1.0, 1.067, 1.122, 1, 0, 0], [1, 1, 2.0, 2.074, 2.13, 1, 0, 0], [2, 1, 3.0, 3.074, 3.13, 1, 0, 0], [3, 1, 3.587, 3.667, 4.374, 0, 24000, 0], [4, 0, 4.588, 4.663, 5.44, 0, 24000, 0], [5, 0, 5.588, 5.661, 6.278, 0, 24000, 0], [6, 0, 6.588, 6.661, 7.359, 0, 24000, 0], [7, 0, 7.588, 7.662, 8.371, 0, 24000, 0], [8, 0, 8.588, 8.663, 9.391, 0, 24000, 0], [9, 0, 9.588, 9.651, 10.24, 0, 24000, 0], [10, 0, 10.588, 10.664, 11.421, 0, 24000, 0], [11, 0, 11.588, 11.659, 12.453, 0, 24000, 0], [12, 0, 12.588, 12.667, 13.444, 0, 24000, 0], [13, 0, 13.588, 13.671, 14.383, 0, 24000, 0], [14, 0, 14.588, 14