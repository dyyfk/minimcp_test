{"id": "q0258", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3679853905, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is a value-added tax?\n\nA. A tax applicable only to raw materials\nB. A tax imposed exclusively on luxury items at the point of sale\nC. A tax deducted from the total sales revenue of a company\nD. A progressive tax levied on the profits of a corporation\nE. A tax levied on the final selling price of a product\nF. A sales tax that is applied uniformly on all products at a single stage\nG. A tax only levied on imported goods to encourage domestic production\nH. A flat-rate tax imposed on individual income\nI. A tax collected at each stage of production based on the value added\nJ. A tax imposed on the total value of a product\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0258.wav", "input_sha256": "3953cc3854f94d9ccd38d9a51e09d263ae8e1eca4c2164f761048eb53bc894d8", "input_samples": 674600, "input_s": 42.163, "n_real_chunks": 43, "score": 0.5593, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "J. A tax imposed on the total value of a product.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 41, "eot_seen": true, "n_speak_chunks": 6, "feed_lag_max_ms": 302, "feed_lag_sum_ms": 302, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0258_conservative_local.wav", "sha256": "7251e0468a6b9ad00b6448ba17ceb6864d5ceb5468c3d4ae5e680a896b