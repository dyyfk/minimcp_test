{"id": "q0361", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2288360449, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "In Vermont, USA, there is an old law stating that it is illegal for women to wear what without their husbands written consent?", "input_path": "/data/audio_pool/q0361.wav", "input_sha256": "ae11f03ec671c33c90d952e1e0f113ede06155cc3b200b3a0f46eabf95e4ae90", "input_samples": 125800, "input_s": 7.862, "n_real_chunks": 8, "score": 0.9065, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The item is false teeth — the commonly cited “old Vermont law” says women could not wear false teeth without their husband’s written consent. This is usually repeated as a “weird old law,” though it’s hard to verify as an enforceable current statute.", "expert_answer": "The item is **false teeth** — the commonly cited “old Vermont law” says women could not wear **false teeth** without their husband’s written consent.\n\nThis is usually repeated as a “weird old law,” though it’s hard to verify as an enforceable current statute.", "transcript": "In Vermont, USA, there is an old law stating that it is illegal for women to wear what without their husband's written consent?\n", "asr_s": 0.59, "expert_s": 6.37, "expert_input_samples": 125800, "expert_input_s": 7.862, "expert_input_sha256": "ae11f03ec671c33c90d952e1e0f113ede06155cc3b200b3a0f46eabf95e4ae90", "expert_timed_out": false, "wait_s": 6.089, "relay_synth_ms": 10063, "onset_chunk": 7, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0361_conservat