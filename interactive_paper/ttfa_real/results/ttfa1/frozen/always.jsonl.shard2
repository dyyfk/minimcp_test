{"id": "q0409", "pool": "frozen", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3584795952, "protocol": "ttfa-v3", "config_sha256": "67ad139c11ad192120e00f1f4cc28f36ec4dc2a78471efa94476f5caf342cabc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "What is the Philly Special and when was it used ?", "input_path": "/data/audio_pool/q0409.wav", "input_sha256": "4626e109e8dab269e08cb50663c7d887ca150cd378990b93908b73a4c77749d2", "input_samples": 48200, "input_s": 3.013, "n_real_chunks": 4, "score": 0.759, "act": 0.9984, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Philly Special was a trick play used by the Philadelphia Eagles in Super Bowl LII against the New England Patriots on February 4, 2018. On the play, Eagles quarterback Nick Foles lined up as if he were calling signals, then moved to the right side of the formation. Philadelphia went on to win 41–33, earning its first Super Bowl title.", "expert_answer": "The **Philly Special** was a trick play used by the **Philadelphia Eagles** in **Super Bowl LII** against the **New England Patriots** on **February 4, 2018**.\n\nOn the play, Eagles quarterback **Nick Foles** lined up as if he were calling signals, then moved to the right side of the formation. The ball was snapped directly to running back **Corey Clement**, handed to tight end **Trey Burton**, who then threw a touchdown pass to **Nick Foles**.\n\nIt was used near the end of the **second quarter**, on **4th-and-goal**, and gave the Eagles a touchdown before halftime. Philadelphia went on to win **41–33**, earning its first Super Bowl title.", "transcript": "What is the Philly Special and when was it used?\n", "asr_s": 0.46, "expert_s": 5.03, "expert_input_samples": 48200, "expert_input_s": 3.013, "expert_input_sha256": "4626e109e8dab269e08cb50663c7d887ca150cd378990b93908b73a4c77749d2", "expert_timed_out": false, "wait_s": 3.966, "relay_synth_ms": 12424, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 438, "feed_lag_sum_ms": 551, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0409_always_relay.wav", "sha256": "8cdfa69e937d8994740153574ab1a43a71ad2c20d7b82195ba4ed17257b4a93c", "sr": 24000, "seconds": 20.28}, "candidate": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0409_always_candidate.wav", "sha256": "6e5a718b7901fe38b934cac1db7883a3d0eaec250c5a5d0bcd2e367cd2c14c1d", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0409_always_stall.wav", "sha256": "da7d115bfe39cff729d4a1f763dec12614d7f873b4732f658929fdbd1e4be072", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.067, 1.121, 1, 0, 0], [1, 1, 2.0, 2.073, 2.128, 1, 0, 0], [2, 1, 3.0, 3.071, 3.126, 1, 0, 0], [3, 1, 3.013, 3.192, 3.696, 0, 24000, 0], [4, 0, 4.013, 4.517, 5.219, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.013, "last_real_feed_done": 3.192, "onset": 3.696, "gate_read_done": 3.697, "fire": 3.697, "candidate_first_pcm": 3.696, "stall_note": 3.698, "stall_first_pcm": 4.451, "local_first_pcm": null, "wait_start": 5.219, "expert_req": 3.698, "expert_resp": 9.185, "relay_synth_start": 9.185, "relay_first_pcm": 10.054, "relay_synth_end": 21.61, "first_any_pcm": 3.696, "first_answer_pcm": 10.054, "session_end": 22.162}, "ttfa_answer_s": 7.041, "ttfa_any_s": 0.684}
