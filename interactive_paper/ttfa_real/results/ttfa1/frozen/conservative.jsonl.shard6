{"id": "q0293", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3761343445, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "Young Tina had never seen the space shuttle until her parents pointed out a picture of it ready to launch. When she next saw a picture of it flying, she had difficulty recognizing it. Which concept best explains this problem?\n\nA. dishabituation\nB. sensory adaptation\nC. perceptual adaptation\nD. summation\nE. perceptual set\nF. sensory interaction\nG. binocular cue\nH. depth perception\nI. shape constancy\nJ. autokinetic effect\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0293.wav", "input_sha256": "3f0b6dfc5443c09deafc7e08cc60232ed4d3ee806dd6f2945a7eafb0099ee5a3", "input_samples": 471200, "input_s": 29.45, "n_real_chunks": 30, "score": 0.3173, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "E. Percept ual set", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 29, "eot_seen": true, "n_speak_chunks": 2, "feed_lag_max_ms": 24, "feed_lag_sum_ms": 24, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0293_conservative_local.wav", "sha256": "6af18e1b496c8da40217e22938826056b04655703b9ffaf33f1892c1218648f9", "sr": 24000, "seconds": 2.12}}, "chunks": [[0, 1, 1.0, 1.097, 1.173, 1, 0, 0], [1, 1, 2.0, 2.088, 2.157, 1, 0, 0], [2, 1, 3.0, 3.094, 3.167, 1, 0, 0], [3, 1, 4.0, 4.089, 4.159, 1, 0, 0], [4, 1, 5.0, 5.093, 5.164, 1, 0, 0], [5, 1,