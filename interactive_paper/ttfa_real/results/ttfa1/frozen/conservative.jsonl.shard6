7, "gate_read_done": 120.227, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 120.227, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 120.227, "first_answer_pcm": 120.227, "session_end": 146.794}, "ttfa_answer_s": 0.615, "ttfa_any_s": 0.615}
{"id": "q0202", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1190395914, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "A shopkeeper is the owner of a vacant lot in fee simple absolute (the record title is also in the shopkeeper). In 1960, the shopkeeper conveyed the property by general warranty deed as follows: \"The grantor hereby conveys the vacant lot to my friend, but if the property shall ever be used for church purposes, then to the children of my sister who reach the age of 25. \" At the time of the conveyance, the sister was single. Thereafter, the sister married and had two sons. Subsequently, one son died in an automobile accident. Three years after that son's death, the sister had a daughter. In an appropriate action to determine the ownership rights to the vacant lot with all minors represented, title is in \n\nA. the friend, the surviving son, and the sister.\nB. the friend, the son, the daughter, and any additional children of the sister born within 21 years after the death of the deceased son.\nC. the friend and the surviving son only.\nD. the friend and the sister.\nE. the friend, the deceased son, and the daughter.\nF. the friend, the son, the daughter, and any additional children of the sister born during her lifetime.\nG. the friend, the son, and the daughter.\nH. the sister and her children only.\nI. the friend only.\nJ. the friend and any children of the sister reaching the age of 25.\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0202.wav", "input_sha256": "2d16c8cfdb2442060399e99220c445996810aa9c31b8896a63856f23692f0614", "input_samples": 1348400, "input_s": 84.275, "n_real_chunks": 85, "score": 0.8624, "act": 0.9996, "is_info": true, "fired": false, "mode": "local", "answer": "J. The friend and any children of the sister reaching the age of 2 5.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 84, "eot_seen": true, "n_speak_chunks": 7, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0202_conservative_local.wav", "sha256": "0949fc6711c44646f00946c7c4b4fbe3c9d324ca5144bd7383fa41c4f78c2dec", "sr": 24000, "seconds": 6.44}}, "chunks": [[0, 1, 1.0, 1.085, 1.153, 1, 0, 0], [1, 1, 2.0, 2.088, 2.156, 1, 0, 0], [2, 1, 3.0, 3.092, 3.166, 1, 0, 0], [3, 1, 4.0, 4.092, 4.167, 1, 0, 0], [4, 1, 5.0, 5.095, 5.172, 1, 0, 0], [5, 1, 6.0, 6.086, 6.16, 1, 0, 0], [6, 1, 7.0, 7.079, 7.143, 1, 0, 0], [7, 1, 8.0, 8.091, 8.163, 1, 0, 0], [8, 1, 9.0, 9.085, 9.155, 1, 0, 0], [9, 1, 10.0, 10.093, 10.166, 1, 0, 0], [10, 1, 11.0, 11.076, 11.136, 1, 0, 0], [11, 1, 12.0, 12.091, 12.161, 1, 0, 0], [12, 1, 13.0, 13.092, 13.162, 1, 0, 0], [13, 1, 14.0, 14.092, 14.162, 1, 0, 0], [14, 1, 15.0, 15.092, 15.163, 1, 0, 0], [15, 1, 16.0, 16.092, 16.162, 1, 0, 0], [16, 1, 17.0, 17.093, 17.165, 1, 0, 0], [17, 1, 18.0, 18.091, 18.162, 1, 0, 0], [18, 1, 19.0, 19.091, 19.159, 1, 0, 0], [19, 1, 20.0, 20.092, 20.162, 1, 0, 0], [20, 1, 21.0, 21.095, 21.164, 1, 0, 0], [21, 1, 22.0, 22.095, 22.169, 1, 0, 0], [22, 1, 23.0, 23.094, 23.164, 1, 0, 0], [23, 1, 24.0, 24.091, 24.159, 1, 0, 0], [24, 1, 25.0, 25.091, 25.161, 1, 0, 0], [25, 1, 26.0, 26.091, 26.159, 1, 0, 0], [26, 1, 27.0, 27.093, 27.162, 1, 0, 0], [27, 1, 28.0, 28.092, 28.16, 1, 0, 0], [28, 1, 29.0, 29.099, 29.17, 1, 0, 0], [29, 1, 30.0, 30.092, 30.162, 1, 0, 0], [30, 1, 31.0, 31.094, 31.169, 1, 0, 0], [31, 1, 32.0, 32.093, 32.164, 1, 0, 0], [32, 1, 33.0, 33.091