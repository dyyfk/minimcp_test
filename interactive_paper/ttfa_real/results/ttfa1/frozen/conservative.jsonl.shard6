{"id": "q0437", "pool": "frozen", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 423549940, "protocol": "ttfa-v3", "config_sha256": "1bd884090589f25ac8e99f9bb754f4b90b4c7a09d6887616d0aefbdba25a74d4", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "What is the GE Dash 8-32BWH", "input_path": "/data/audio_pool/q0437.wav", "input_sha256": "2dc2a840be5f0352a563cb1c42b5bd13d8f51dc774faad4c7fdec25a045c5a57", "input_samples": 34600, "input_s": 2.163, "n_real_chunks": 3, "score": 0.8722, "act": 0.9969, "is_info": true, "fired": false, "mode": "local", "answer": "The GE-832 BH is a type of jet engine made by General Electric. It's designed to be used in aircraft, especially for military and some commercial planes. This engine helps the plane fly by creating powerful thrust through its fan s and internal components.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0437_conservative_local.wav", "sha256": "16675a72dddf8523e184edee6bed61b0971bc8516e3d75d5acb0192309aa93c6", "sr": 24000, "seconds": 16.28}}, "chunks": [[0, 1, 1.0, 1.078, 1.141, 1, 0, 0], [1, 1, 2.0, 2.086, 2.152, 1, 0, 0], [2, 1, 2.163, 2.243, 2.31, 1, 0, 0], [3, 0, 3.163, 3.244, 4.115, 0, 24000, 0], [4, 0, 4.162, 4.236, 4.904, 0, 24000, 0], [5, 0, 5.162, 5.241, 5.911, 0, 24000, 0], [6, 0, 6.162, 6.237, 6.902, 0, 24000, 0], [7, 0, 7.162, 7.249, 7.987, 0, 24000, 0], [8, 0, 8.162, 8.238, 8.962, 0, 24000, 0], [9, 0, 9.162, 9.233, 9.856, 0, 24000, 0], [10, 0, 10.162