{"id": "q0235", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4089300586, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Which of the following is archaeological evidence of social stratification and inequality?\n\nA. Burials with exotic grave goods also contain bones indicating that they engaged in more strenuous labor.\nB. Burials all contain equal amounts of exotic grave goods, but some are more impressive than others.\nC. Burials without exotic grave goods also contain bones indicating that they engaged in strenuous labor.\nD. Burials all contain bones indicating that they engaged in same level of strenuous labor.\nE. Burials contain bones indicating that people were segregated based on gender, stature, and personal capabilities, including artistic abilities.\nF. All burials contain equal amounts of non-exotic grave goods.\nG. Burials with exotic grave goods also contain bones indicating that they engaged in less strenuous labor.\nH. Burials contain bones indicating that people were segregated based on their age and health.\nI. Burials without exotic grave goods also contain bones indicating that they engaged in less strenuous labor.\nJ. Burials contain only exotic grave goods with no indication of the deceased's labor.\n\nAnswer with the correct option letter and its content.", "input_path": "/data/audio_pool/q0235.wav", "input_sha256": "4de07dde2dcc818023dc7603eeb5f18a229373dee5b100465ccf4f502a8aa2cc", "input_samples": 1159000, "input_s": 72.438, "n_real_chunks": 73, "score": 0.5937, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "B. Bur ials all contain equal amounts of exotic grave goods, but some are more impressive than others.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 72, "eot_seen": true, "n_speak_chunks": 7, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0235_balanced_local.wav", "sha256": "467c02085e50ef6475b2733c76fc6588e8decdf1a1426e64a40d5c2eea3b0495", "sr": 24000, "seconds": 6.84}}, "chunks": [[0, 1, 1.0, 1.083, 1.149, 1, 0, 0], [1, 1, 2.0, 2.087, 2.155, 1, 0, 0], [2, 1, 3.0, 3.085, 3.154, 1, 0, 0], [3, 1, 4.0, 4.087, 4.157, 1, 0, 0], [4, 1, 5.0, 5.085, 5.154, 1, 0, 0], [5, 1, 6.0, 6.088, 6.162, 1, 0, 0], [6, 1, 7.0, 7.088, 7.157, 1, 0, 0], [7, 1, 8.0, 8.083, 8.156, 1, 0, 0], [8, 1, 9.0, 9.088, 9.158, 1, 0, 0], [9, 1, 10.0, 10.089, 10.159, 1, 0, 0], [10, 1, 11.0, 11.086, 11.151, 1, 0, 0], [11, 1, 12.0, 12.094, 12.163, 1, 0, 0], [12, 1, 13.0, 13.09, 13.161, 1, 0, 0], [13, 1, 14.0, 14.092, 14.166, 1, 0, 0], [14, 1, 15.0, 15.094, 15.168, 1, 0, 0], [15, 1, 16.0, 16.093, 16.165, 1, 0, 0], [16, 1, 17.0, 17.089, 17.157, 1, 0, 0], [17, 1, 18.0, 18.096, 18.169, 1, 0, 0], [18, 1, 19.0, 19.091, 19.161, 1, 0, 0], [19, 1, 20.0, 20.096, 20.167, 1, 0, 0], [20, 1, 21.0, 21.091, 21.158, 1, 0, 0], [21, 1, 22.0, 22.09, 22.158, 1, 0, 0], [22, 1, 23.0, 23.093, 23.163, 1, 0, 0], [23, 1, 24.0, 24.094, 24.163, 1, 0, 0], [24, 1, 25.0, 25.092, 25.161, 1, 0, 0], [25, 1, 26.0, 26.093, 26.163, 1, 0, 0], [26, 1, 27.0, 27.1, 27.175, 1, 0, 0], [27, 1, 28.0, 28.096, 28.166, 1, 0, 0], [28, 1, 29.0, 29.095, 29.166, 1, 0, 0], [29, 1, 30.0, 30.1, 30.174, 1, 0, 0], [30, 1, 31.0, 31.091, 31.161, 1, 0, 0], [31, 1, 32.0, 32.098, 32.168, 1, 0, 0], [32, 1, 33.0, 33.094, 33.169, 1, 0, 0], [33, 1, 34.0, 34.09, 34.158, 1, 0, 0], [34, 1, 35.0, 35.093, 35.162, 1, 0, 0], [35, 1, 36.0, 36.093, 36.162, 1, 0, 0], [36, 1, 37.0, 37.093, 37.165, 