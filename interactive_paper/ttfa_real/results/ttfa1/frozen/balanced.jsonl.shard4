{"id": "q0435", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4147165912, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Who are the top NFL Quarterbacks?", "input_path": "/data/audio_pool/q0435.wav", "input_sha256": "76e25f78573b3827ab9e1d37488f278a1702e8964fd422175326798024b26a18", "input_samples": 31600, "input_s": 1.975, "n_real_chunks": 2, "score": 0.6532, "act": 0.9988, "is_info": true, "fired": false, "mode": "local", "answer": "I would say Tom Brady, Patrick Mahomes, Joe Burrow, Lamar Jackson, and Aaron Rodgers are the top five.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 5, "feed_lag_max_ms": 40, "feed_lag_sum_ms": 40, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0435_balanced_local.wav", "sha256": "612516a9c7c5c960806481458341b9dc328ff0ebe33519b3d42cd2d82f75483d", "sr": 24000, "seconds": 5.16}}, "chunks": [[0, 1, 1.0, 1.084, 1.151, 1, 0, 0], [1, 1, 1.975, 2.057, 2.122, 1, 0, 0], [2, 0, 2.975, 3.055, 3.119, 1, 0, 0], [3, 0, 3.975, 4.061, 4.132, 1, 0, 0], [4, 0, 4.975, 5.061, 5.949, 0, 24000, 0], [5, 0, 5.975, 6.059, 6.832, 0, 24000, 0], [6, 0, 6.975, 7.062, 8.015, 0, 24000, 0], [7, 0, 7.975, 8.099, 8.955, 0, 24000, 0], [8, 0, 8.975, 9.062, 9.71, 0, 27840, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.975, "last_real_feed_done": 2.057, "onset": 5.949, "gate_read_done": 5.949, "fire": null, "candidate_first_pcm": null, "stall_note": null