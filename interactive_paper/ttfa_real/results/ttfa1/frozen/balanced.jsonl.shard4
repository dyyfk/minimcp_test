{"id": "q0310", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2955098704, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "The character 'James Bond' was created by Ian Fleming, but who wrote the book 'Zero Minus Ten' featuring 'James Bond'?", "input_path": "/data/audio_pool/q0310.wav", "input_sha256": "0e5ea49f4613168187fe780bd95d045ca1dc66cdfac8a46cc5d6bd7ca5dac1b2", "input_samples": 115000, "input_s": 7.188, "n_real_chunks": 8, "score": 0.7323, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The book 0 -10 featuring James Bond was actually written by Ian Flem ing himself. He is the creator of the character, so he wrote that novel too.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 6, "eot_seen": true, "n_speak_chunks": 9, "feed_lag_max_ms": 199, "feed_lag_sum_ms": 262, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0310_balanced_local.wav", "sha256": "5476e55438b460a100402c904b2ffc84fb946473bfaab9eb939ba8be3c4bca7f", "sr": 24000, "seconds": 8.04}}, "chunks": [[0, 1, 1.0, 1.078, 1.141, 1, 0, 0], [1, 1, 2.0, 2.079, 2.139, 1, 0, 0], [2, 1, 3.0, 3.077, 3.139, 1, 0, 0], [3, 1, 4.0, 4.086, 4.159, 1, 0, 0], [4, 1, 5.0, 5.087, 5.158, 1, 0, 0], [5, 1, 6.0, 6.081, 6.148, 1, 0, 0], [6, 1, 7.0, 7.086, 7.387, 0, 0, 0], [7, 1, 7.188, 7.467, 8.251, 0, 24000, 0], [8, 0, 8.188, 8.332, 9.078, 0, 24000, 0], [9, 0, 9.188, 9.277, 10.057, 0, 24000, 0], [10, 0, 10.188, 10.274, 10.959, 0, 24000, 0], [11, 0, 11.188, 11.2