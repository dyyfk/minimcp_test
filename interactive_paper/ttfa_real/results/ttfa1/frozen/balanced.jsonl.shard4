{"id": "q0391", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 268271822, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Who invented the microwave oven in 1945?", "input_path": "/data/audio_pool/q0391.wav", "input_sha256": "61ba6af496ec55a519bef9c489ddd43dfed45996b461e902345cdd523aae83f9", "input_samples": 50400, "input_s": 3.15, "n_real_chunks": 4, "score": 0.6679, "act": 0.9996, "is_info": true, "fired": false, "mode": "local", "answer": "The microwave oven was invented in 1 9 45 by Percy Spencer, an engineer at Ray theon. He discovered that a radar tube he was working with was heating up chocolate in his pocket. This led to the development of the first microwave oven, which revolutionized how we cook and heat food.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0391_balanced_local.wav", "sha256": "9ce75f2c3fdc3fc736a62452e2ef960d554239d60f3711fd2d1ae0c9a9a71042", "sr": 24000, "seconds": 22.48}}, "chunks": [[0, 1, 1.0, 1.078, 1.141, 1, 0, 0], [1, 1, 2.0, 2.083, 2.147, 1, 0, 0], [2, 1, 3.0, 3.083, 3.147, 1, 0, 0], [3, 1, 3.15, 3.23, 3.78, 0, 24000, 0], [4, 0, 4.15, 4.234, 4.938, 0, 24000, 0], [5, 0, 5.15, 5.236, 5.914, 0, 24000, 0], [6, 0, 6.15, 6.238, 6.966, 0, 24000, 0], [7, 0, 7.15, 7.235, 7.943, 0, 24000, 0], [8, 0, 8.15, 8.237, 8.992, 0, 24000, 0], [9, 0, 9.15, 9.234, 9.908, 0, 24000, 0], [10, 0, 10.15, 10.238, 10.902, 0, 24000, 0], [11, 0, 11.15, 11.237, 12.015, 0, 24000, 0], [12, 0, 12.15, 12.242, 13.008, 0, 24000, 0], [13, 0, 13.15, 13.237, 14.065, 0, 24000, 0], [14, 0, 14.15, 14.242, 15.014, 0, 24000, 0], [15, 0, 15.15, 15.241, 15.968, 0, 24000, 0], [16, 0, 16.15, 16.241, 17.107, 0, 24000, 0], [17, 0, 17.15, 17.244, 18.073, 0, 24000, 0], [18, 0, 18.15, 18.244, 19.079, 0, 24000, 0], [19, 0, 19.15, 19.245, 19.959, 0, 24000, 0], [20, 0, 20.15, 20.242, 21.062, 0, 24000, 0], [21, 0, 21.15, 21.241, 22.024, 0, 24000, 0], [22, 0, 22.15, 22.243, 23.039, 0, 24000, 0], [23, 0, 23.15, 23.242, 24.05, 0, 24000, 0], [24, 0, 24.15, 24.244, 24.958, 0, 24000, 0], [25, 0, 25.15, 25.242, 25.727, 0, 11520, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.15, "last_real_feed_done": 3.23, "onset": 3.78, "gate_read_done": 3.781, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 3.78, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 3.78, "first_answer_pcm": 3.78, "session_end": 25.727}, "ttfa_answer_s": 0.63, "ttfa_any_s": 0.63}
{"id": "q0414", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2986469580, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Imagine you are the last person on Earth. Write a diary entry describing your thoughts and feelings.", "input_path": "/data/audio_pool/q0414.wav", "input_sha256": "ba26eac91888d15cd14551685a410aca4829117e711530e0ddd9dd01070d5df9", "input_samples": 90800, "input_s": 5.675, "n_real_chunks": 6, "score": 0.7666, "act": 0.9857, "is_info": true, "fired": false, "mode": "local", "answer": "I can't believe it. The world is empty, and I' m the only one left. It's hard to wrap my head around that reality. Every sound feels so loud now, like a bird chirping or wind blowing through the trees—it' s all so intense. I keep thinking about everyone who was here before me— their laughter, their arguments, even just the way they walked down the street. Where did they go? What happened to them?I feel guilty sometimes, like maybe I should have done something more, but then again, what could I have really done? There are days when I feel numb, just wandering around without a purpose, while other times I find myself laughing at the absurdity of it all. But mostly there’s this deep sadness, a hollow feeling inside. I miss human connection, even if we were arguing or disagree ing—I missed being seen, heard, understood. Now, everything is still. The streets are silent, the buildings stand empty, and yet somehow, I’ m still here, breathing, trying to make sense of it. Maybe I’m not supposed", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null,