{"id": "q0410", "pool": "frozen", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3043765461, "protocol": "ttfa-v3", "config_sha256": "c1188d4ab398808355719c420f025bd920b27aba798f5596eb328457a751cc63", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What is fleece?", "input_path": "/data/audio_pool/q0410.wav", "input_sha256": "c3e1d38e3f1e617343fbabbc09619d7beb2916e430666ff8ea2f22d8ed38cea5", "input_samples": 14600, "input_s": 0.912, "n_real_chunks": 1, "score": 0.8154, "act": 0.9858, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Fleece is a soft, warm, fuzzy fabric, usually made from synthetic polyester. It is commonly used for jackets, blankets, hoodies, and outdoor clothing because it is lightweight, insulating, and dries quickly. The word can also mean the woolly coat of a sheep or similar animal, especially after it has been shorn.", "expert_answer": "**Fleece** is a soft, warm, fuzzy fabric, usually made from **synthetic polyester**. It is commonly used for **jackets, blankets, hoodies, and outdoor clothing** because it is lightweight, insulating, and dries quickly.\n\nThe word can also mean the **woolly coat of a sheep or similar animal**, especially after it has been shorn.", "transcript": "What is fleece?\n", "asr_s": 0.52, "expert_s": 2.36, "expert_input_samples": 14600, "expert_input_s": 0.912, "expert_input_sha256": "c3e1d38e3f1e617343fbabbc09619d7beb2916e430666ff8ea2f22d8ed38cea5", "expert_timed_out": false, "wait_s": 1.665, "relay_synth_ms": 10606, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 135, "feed_lag_sum_ms": 135, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0410_aggressive_relay.wav", "sha256": "188ed46eb4259a90069682e090c3df9d868f45ed66ae03fc572da4f2b1c0ca65", "