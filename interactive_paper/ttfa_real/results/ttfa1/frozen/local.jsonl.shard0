{"id": "q0387", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4286911674, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Traditionally with what were the seams of wooden ships caulked?", "input_path": "/data/audio_pool/q0387.wav", "input_sha256": "5a89a80b69f1780a8f287866578a885d6d574f306f5c438aa1cf2aa3619e0648", "input_samples": 62800, "input_s": 3.925, "n_real_chunks": 4, "score": 0.2846, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "Traditionally, the seam s of wooden ships were caulked with a mixture of pitch and fiber s like hemp or oakum. The process involved filling the joint between the planks with this fibrous material, then applying hot pitch to bind it in place. This created a waterproof seal that prevented water from getting inside the ship.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 18, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0387_local_local.wav", "sha256": "13fc573dba9324083cbdf10e8be84e1749a1749148df51d33266ffec1234d578", "sr": 24000, "seconds": 17.88}}, "chunks": [[0, 1, 1.0, 1.059, 1.107, 1, 0, 0], [1, 1, 2.0, 2.061, 2.105, 1, 0, 0], [2, 1, 3.0, 3.064, 3.112, 1, 0, 0], [3, 1, 3.925, 3.986, 4.033, 1, 0, 0], [4, 0, 4.925, 4.984, 5.543, 0, 24000, 0], [5, 0, 5.925, 5.986, 6.549, 0, 24000, 0], [6, 0, 6.925, 6.985, 7.608, 0, 24000, 0], [7, 0, 7.925, 7.986, 8.513, 0, 24000, 0], [8, 0, 8.925, 8.985, 9.502, 0, 24000, 0], [9, 0, 9.925, 9.989, 10.567, 0, 24000, 0], [10, 0, 10.925, 10.983, 11.479, 0, 24000, 0], [11, 0, 11.925, 11.989, 12.54, 0, 24000, 0], [12, 0, 12.925, 12.988, 13.585, 0, 24000, 0], [13, 0, 13.925, 13.988, 14.525, 0, 24000, 0], [14, 0, 14.925, 14.986, 15.502, 0, 24000, 0], [15, 0, 15.925, 15.987, 16.513, 0, 24000, 0], [16, 0, 16.925, 16.985, 17.557, 0, 24000, 0], [17, 0, 17.925, 17.99, 18.513, 0, 24000, 0], [18, 0, 18.925, 18.986, 19.49, 0, 24000, 0], [19, 0, 19.925, 19.991, 20.537, 0, 24000, 0], [20, 0, 20.925, 20.985, 21.525, 0, 24000, 0], [21, 0, 21.925, 21.989, 22.414, 0, 21120, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.925, "last_real_feed_done": 3.986, "onset": 5.543, "gate_read_done": 5.543, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 5.543, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 5.543, "first_answer_pcm": 5.543, "session_end": 22.414}, "ttfa_answer_s": 1.618, "ttfa_any_s": 1.618}
{"id": "q0406", "pool": "frozen", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1158985889, "protocol": "ttfa-v3", "config_sha256": "923cbbdfe3213927dfa36b1f8e0eb48a30d641d9b9bf7cf25d16765340d88836", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is Pickleball?", "input_path": "/data/audio_pool/q0406.wav", "input_sha256": "67a862b71bc40e0a6a206966690b7b8a9331d4abf19002edbce08979f182b8a5", "input_samples": 16800, "input_s": 1.05, "n_real_chunks": 2, "score": 0.2066, "act": 0.9973, "is_info": true, "fired": false, "mode": "local", "answer": "Pickleball is a fun and popular sport that combine s elements of tennis, bad minton, and table tennis. It's played on a court similar to a doubles bad minton court but with shorter boundaries. Players use solid paddles instead of rackets and hit a plastic ball over the net.The game starts with a serve diagonally across the court, and points are scored when the opponent cannot return the ball or hits it out of bounds. One unique rule is the non-volley zone, often called the kitchen, where players usually can' t make volleys unless the ball bounce s first.P ickleball is known for being easy to learn but challenging to master, making it great for all ages and skill levels. It's especially popular in communities because it can be played indoors or outdoors on a variety of surfaces.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 42, "feed_lag_max_ms": 56, "feed_lag_sum_ms": 56, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0406_local_local.wav", "sha256": "38e6730c6b964195f54254bfd2cdab24c628f