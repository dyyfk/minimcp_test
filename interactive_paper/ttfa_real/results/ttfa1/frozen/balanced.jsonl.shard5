{"id": "q0340", "pool": "frozen", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3444887061, "protocol": "ttfa-v3", "config_sha256": "0c0eb5f5089b4570f4b5f593318ef7c0c5f8ba06a58bdaf93a6686b9afa1d86e", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "Set up in 1954 as a merger of smaller groups, the Front de Libration Nationale fought a war for independence from France until 1962, when the French government signed a cease-fire agreement. The FLN became the only legal party in which country?", "input_path": "/data/audio_pool/q0340.wav", "input_sha256": "45524a8faf138b8bb30822f9a7f82f47266011bd7f40391a838554873ff168bb", "input_samples": 269600, "input_s": 16.85, "n_real_chunks": 17, "score": 0.5583, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The Front de Lib eration Nationale, or FLN, fought a war for independence from France in Algeria. After the cease fire agreement in 1962, the FLN became the only legal party in Algeria.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 17, "eot_seen": true, "n_speak_chunks": 12, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/frozen/audio/q0340_balanced_local.wav", "sha256": "330ea397dec76c12c18c0b8f31b47edf97a0d221855e58c6626a40fad6878357", "sr": 24000, "seconds": 12.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.054, 2.097, 1, 0, 0], [2, 1, 3.0, 3.055, 3.098, 1, 0, 0], [3, 1, 4.0, 4.058, 4.105, 1, 0, 0], [4, 1, 5.0, 5.057, 5.104, 1, 0, 0], [5, 1, 6.0, 6.06, 6.109, 1, 0, 0], [6, 1, 7.0, 7.058, 7.105, 1, 0, 0], [7, 1, 8.0, 8.06, 8.108, 1, 0,