{"id": "swebq0120", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 175395729, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what was the government like in virginia colony?", "input_path": "/data/bench_audio/swebq0120.wav", "input_sha256": "060ecaa64cfe54449fb230fd55960b38e3c1cb3cd21668ba2bd52bb99234a428", "input_samples": 56453, "input_s": 3.528, "n_real_chunks": 4, "score": 0.7714, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "Virginia's government was a lot like England's, but it had some important differences. It was ruled by the House of Burgesses, which was elected by the colon ists themselves. This meant that they had more say in how things were run compared to other colonies where decisions were made by appointed officials or even the king directly. So while Virginia still answered to the English crown, having their own representative body gave them a bit more control over local affairs.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_local_local.wav", "sha256": "8ff8f974f4ed95d0114ac564fa8bd518276d11424f4d99d11d99903a87155120", "sr": 24000, "seconds": 23.04}}, "chunks": [[0, 1, 1.0, 1.063, 1.114, 1, 0, 0], [1, 1, 2.0, 2.063, 2.111, 1, 0, 0], [2, 1, 3.0, 3.061, 3.107, 1, 0, 0], [3, 1, 3.528, 3.591, 4.168, 0, 24000, 0], [4, 0, 4.528, 4.593, 5.242, 0, 24000, 0], [5, 0, 5.