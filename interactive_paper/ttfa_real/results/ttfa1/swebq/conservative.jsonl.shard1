{"id": "swebq0221", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2134236510, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who was queen victoria's husband?", "input_path": "/data/bench_audio/swebq0221.wav", "input_sha256": "d730b270b3145d21f8760534fa365b2204da64cc7538ba5e4a0329d06fc60ed4", "input_samples": 31190, "input_s": 1.949, "n_real_chunks": 2, "score": 0.198, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "Queen Victoria's husband was Prince Albert of Saxe- Coburg and Gotha. He became the Prince Consort after their marriage in 1840, supporting her throughout her reign until his death in 186 1.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0221_conservative_local.wav", "sha256": "d2b9130044ec0b17e49c2f19ba05c494b2321c455d76884a34d9973fe0891ace", "sr": 24000, "seconds": 11.28}}, "chunks": [[0, 1, 1.0, 1.064, 1.115, 1, 0, 0], [1, 1, 1.949, 2.017, 2.07, 1, 0, 0], [2, 0, 2.949, 3.016, 3.067, 1, 0, 0], [3, 0, 3.949, 4.013, 4.627, 0, 24000, 0], [4, 0, 4.949, 5.015, 5.668, 0, 24000, 0], [5, 0, 5.949, 6.011, 6.677, 0, 24000, 0], [6, 0, 6.949, 7.014, 7.515, 0, 24000, 0], [7, 0, 7.949, 8.015, 8.622, 0, 24000, 0], [8, 0, 8.949, 9.014, 9.571, 0, 24000, 0], [9, 0, 9.949, 10.014, 10.677, 0, 24000, 0], [10, 0, 10.949, 11.016, 11.544, 0, 24000, 0], [11, 0, 11.94