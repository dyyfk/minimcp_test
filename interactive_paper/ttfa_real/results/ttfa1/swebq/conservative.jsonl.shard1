{"id": "swebq0194", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4008529475, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what countries does greece share borders with?", "input_path": "/data/bench_audio/swebq0194.wav", "input_sha256": "e55686ca113e34a77b02c6c7557de21cefa747c5a121c4a8b5cd464d75aba363", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.5316, "act": 0.9985, "is_info": true, "fired": false, "mode": "local", "answer": "Greece shares borders with four countries. It has a land border with Albania to the northwest, North Macedonia to the north, and Bulgaria to the north east. To the south, it is connected by sea to Turkey across the Aegean Sea.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 12, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0194_conservative_local.wav", "sha256": "0de29b65e765355cf3aad36ebfb59532179fac4ee2da11caa876146ce63e69ad", "sr": 24000, "seconds": 12.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.133, 1, 0, 0], [1, 1, 2.0, 2.07, 2.126, 1, 0, 0], [2, 1, 2.182, 2.26, 2.322, 1, 0, 0], [3, 0, 3.182, 3.265, 3.749, 0, 24000, 0], [4, 0, 4.182, 4.26, 5.04, 0, 24000, 0], [5, 0, 5.182, 5.26, 6.024, 0, 24000, 0], [6, 0, 6.182, 6.267, 6.984, 0, 24000, 0], [7, 0, 7.182, 7.252, 7.919, 0, 24000, 0], [8, 0, 8.182, 8.253, 8.932, 0, 24000, 0], [9, 0, 9.182, 9.261, 10.012, 0, 24000, 0], [10, 0, 10.182, 10.263, 11.095, 0, 24000, 0], [11, 0, 11.182, 11.253, 11.889, 0, 24000, 0], [12, 0, 12.182, 12.266, 13.022, 0, 24000, 0], [13, 0, 13.182, 13.267, 14.001, 0, 24000, 0], [14, 0, 14.182, 14.251, 14.991, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.182, "last_real_feed_done": 2.26, "onset": 3.749, "gate_read_done": 3.749, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 3.749, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 3.749, "first_answer_pcm": 3.749, "session_end": 14.991}, "ttfa_answer_s": 1.567, "ttfa_any_s": 1.567}
{"id": "swebq0202", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3557486182, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where are kohler sinks manufactured?", "input_path": "/data/bench_audio/swebq0202.wav", "input_sha256": "00a8559ac79e32d95401314b7e9eba5f0ddefe485419b77447bfd74899989b1f", "input_samples": 41592, "input_s": 2.599, "n_real_chunks": 3, "score": 0.9364, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Kohler sinks are manufactured in multiple countries, not just one place. Kohler is headquartered in Kohler, Wisconsin, USA, but it operates manufacturing facilities globally.", "expert_answer": "Kohler sinks are manufactured in **multiple countries**, not just one place. Kohler is headquartered in **Kohler, Wisconsin, USA**, but it operates manufacturing facilities globally.\n\nIn general:\n\n- **Some Kohler cast-iron and specialty/Artist Editions sinks** are made in **Kohler, Wisconsin**.\n- **Other Kohler sinks** may be manufactured in facilities in the **U.S., Mexico, China, India, Thailand, or other countries**, depending on the specific model and material.\n- Kohler states that it is a global company with manufacturing plants on multiple continents, and product origin varies by item. ([lowes.com](https://www.lowes.com/questions/kohler-2356-8-0-bathroom-sinks/999942774/c1c9ee87-f6a8-5a27-8c90-f6c99872bc23?utm_source=openai))\n\nFor a specific sink, check the **box label**, the **underside product label**, or the **spec sheet** for “Country of Origin.”", "transcript": "Where are Kohler sinks manufactured?\n", "asr_s": 4.36, "expert_s": 7.09, "expert_input_samples": 41592, "expert_input_s": 2.599, "expert_input_sha256": "00a8559ac79e32d95401314b7e9eba5f0ddefe485419b77447bfd74899989b1f", "expert_timed_out": false, "wait_s": 4.718, "relay_synth_ms": 6619, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 3, "feed_lag_max_ms": 3787, "feed_lag_sum_ms": 10834, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_conservative_relay.wav", "sha256": "9c6f826f0917f2bfe44366127d407eeae2be3df09b4ea8c2cab14f27d0a4132a", "sr": 24000, "seconds": 11.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_conservative_candidate.wav", "sha256": "1980abf30abbac2fdef5d9faf265e69c83c0421beb11c5946fccae785490da42", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_conservative_stall.wav", "sha256": "04a249d830913e7d928d1a9537eea2dd0b95ceec248f987c09a556f3e096658f", "sr": 24000, "seconds": 4.28}}, "chunks": [[0, 1, 1.0, 1.076, 1.139, 1, 0, 0], [1, 1, 2.0, 2.08, 2.143, 1, 0, 0], [2, 1, 2.599, 2.681, 2.744, 1, 0, 0], [3, 0, 3.599, 3.686, 4.475, 0, 24000, 0], [4, 0, 4.599, 8.456, 9.249, 0, 24000, 0], [5, 0, 5.599, 9.318, 9.998, 0, 24000, 0], [6, 0, 6.599, 10.08, 11.204, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.599, "last_real_feed_done": 2.681, "onset": 4.475, "gate_read_done": 4.475, "fire": 4.475, "candidate_first_pcm": 4.475, "stall_note": 4.477, "stall_first_pcm": 8.387, "local_first_pcm": null, "wait_start": 11.204, "expert_req": 4.477, "expert_resp": 15.921, "relay_synth_start": 15.923, "relay_first_pcm": 16.779, "relay_synth_end": 22.542, "first_any_pcm": 4.475, "first_answer_pcm": 16.779, "session_end": 22.95}, "ttfa_answer_s": 14.179, "ttfa_any_s": 1.875}
{"id": "swebq0212", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3440500519, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where did troy aikman play football?", "input_path": "/data/bench_audio/swebq0212.wav", "input_sha256": "59b25c5e8efeb6a4e17ca61cba3dae9d6caa38a7e4d427c6e4a70ac91d4d6581", "input_samples": 31933, "input_s": 1.996, "n_real_chunks": 2, "score": 0.6237, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "Troy Aikman played football for the University of Oklahoma. He was a quarterback there, and then he went on to play in the NFL for the Dallas Cowboys.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 8, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0212_conservative_local.wav", "sha256": "f9ae0ac89da8858ec879dc697c7e2872588a543126f23a5a698ebdf168e78b23", "sr": 24000, "seconds": 8.28}}, "chunks": [[0, 1, 1.0, 1.077, 1.139, 1, 0, 0], [1, 1, 1.996, 2.079, 2.147, 1, 0, 0], [2, 0, 2.996, 3.064, 3.118, 1, 0, 0], [3, 0, 3.996, 4.064, 4.657, 0, 24000, 0], [4, 0, 4.996, 5.067, 5.758, 0, 24000, 0], [5, 0, 5.996, 6.074, 6.73, 0, 24000, 0], [6, 0, 6.996, 7.072, 7.833, 0, 24000, 0], [7, 0, 7.996, 8.068, 8.744, 0, 24000, 0], [8, 0, 8.996, 9.078, 9.783, 0, 24000, 0], [9, 0, 9.996, 10.074, 10.763, 0, 24000, 0], [10, 0, 10.996, 11.083, 11.919, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed