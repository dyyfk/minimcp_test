{"id": "swebq0166", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2272998304, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who were wright brothers?", "input_path": "/data/bench_audio/swebq0166.wav", "input_sha256": "0673597bd3864240bcd266fefca8d8f3ce178ad9954a3f6361777f941d8a5f46", "input_samples": 23016, "input_s": 1.438, "n_real_chunks": 2, "score": 0.3097, "act": 0.9975, "is_info": true, "fired": false, "mode": "local", "answer": "The Wright brothers were two American inventors, Orville and Wilbur Wright. They are best known for designing, building, and flying the world' s first successful motor driven airplane. Their achievement marked a major milestone in aviation history. On December 17, 190 3, they made four short but significant flights at Kitty Hawk, North Carolina, proving that powered flight was possible. Before this, many people doubted whether human s could fly, so their work changed how we think about air travel.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 28, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0166_conservative_local.wav", "sha256": "0cbc24f647864d0024962fc4672b0d6f38f6155c9a7f93ef04362c192643aaf4", "sr": 24000, "seconds": 28.24}}, "chunks": [[0, 1, 1.0, 1.063, 1.112, 1, 0, 0], [1, 1, 1.438, 1.5, 1.548, 1, 0, 0], [2, 0, 2.438, 2.501, 2.55, 1, 0, 0], [3, 0, 3.438, 3.502, 3.953, 0, 24000, 0], [4, 0, 4.4