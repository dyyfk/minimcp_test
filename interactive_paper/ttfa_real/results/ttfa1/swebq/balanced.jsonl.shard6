{"id": "swebq0058", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1244407635, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "where did starbucks get their logo?", "input_path": "/data/bench_audio/swebq0058.wav", "input_sha256": "97984d2503e6a23dfeb1602d9f186b96a771ac4d7648068523b6f98056da8777", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.9063, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Starbucks’ logo came from a 16th-century Norse woodcut of a two-tailed mermaid, or siren. The founders chose the siren because Starbucks was named after Starbuck, a character in Moby-Dick, and they wanted a nautical, seafaring image that fit Seattle’s port-city identity and the romance of coffee trading by sea.", "expert_answer": "Starbucks’ logo came from a **16th-century Norse woodcut of a two-tailed mermaid, or siren**.\n\nThe founders chose the siren because Starbucks was named after **Starbuck**, a character in *Moby-Dick*, and they wanted a nautical, seafaring image that fit Seattle’s port-city identity and the romance of coffee trading by sea.", "transcript": "Where did Starbucks get their logo?\n", "asr_s": 2.68, "expert_s": 3.56, "expert_input_samples": 34162, "expert_input_s": 2.135, "expert_input_sha256": "97984d2503e6a23dfeb1602d9f186b96a771ac4d7648068523b6f98056da8777", "expert_timed_out": false, "wait_s": 3.761, "relay_synth_ms": 7881, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0058_balanced_relay.wav", "sha256": "4e6f2867081d36261134826bf983ae1f1c