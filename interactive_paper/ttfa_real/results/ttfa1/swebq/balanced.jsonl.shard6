{"id": "swebq0121", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2104713991, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what type of religion did massachusetts have?", "input_path": "/data/bench_audio/swebq0121.wav", "input_sha256": "371831f391fc193eabea55156e64d6a4054fec73cf9aed24af8cd650e1e3b7a7", "input_samples": 42335, "input_s": 2.646, "n_real_chunks": 3, "score": 0.8598, "act": 0.998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Massachusetts had a Puritan (Congregationalist) Christian religion in its early colonial period. The colony was founded largely by Puritans, and church and government were closely connected.", "expert_answer": "Massachusetts had a **Puritan (Congregationalist) Christian** religion in its early colonial period. The colony was founded largely by **Puritans**, and church and government were closely connected.", "transcript": "What type of religion did Massachusetts have?\n", "asr_s": 0.62, "expert_s": 2.05, "expert_input_samples": 42335, "expert_input_s": 2.646, "expert_input_sha256": "371831f391fc193eabea55156e64d6a4054fec73cf9aed24af8cd650e1e3b7a7", "expert_timed_out": false, "wait_s": 1.935, "relay_synth_ms": 5022, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 44, "feed_lag_sum_ms": 44, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0121_balanced_relay.wav", "sha256": "b277c45e6fda8d841df683e811a213432494be4788f18ba23a2df3a814a7c6c3", "sr": 24000, "seconds": 12.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0121_balanced_candidate.wav", "sha256": "b59b9579f1fbfa0b5b2ef22b4598c173d2ea20fd7937523238e3c3a0fa10