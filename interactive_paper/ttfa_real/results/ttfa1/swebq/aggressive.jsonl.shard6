], [2, 1, 2.321, 2.375, 2.415, 1, 0, 0], [3, 0, 3.321, 3.376, 3.677, 0, 24000, 0], [4, 0, 4.321, 4.382, 4.711, 0, 20160, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.321, "last_real_feed_done": 2.375, "onset": 3.677, "gate_read_done": 3.677, "fire": 3.677, "candidate_first_pcm": 3.677, "stall_note": 3.678, "stall_first_pcm": 4.139, "local_first_pcm": null, "wait_start": 4.711, "expert_req": 3.678, "expert_resp": 5.593, "relay_synth_start": 5.593, "relay_first_pcm": 6.155, "relay_synth_end": 6.765, "first_any_pcm": 3.677, "first_answer_pcm": 6.155, "session_end": 7.062}, "ttfa_answer_s": 3.834, "ttfa_any_s": 1.356}
{"id": "swebq0199", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2421961470, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "who influenced picasso art?", "input_path": "/data/bench_audio/swebq0199.wav", "input_sha256": "67dffb6f665be8c47457e1e8e095b887f5fe5f92d25064e1e918d1d6ea8f9928", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.7841, "act": 0.996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Picasso was influenced by many sources, especially: Paul Cézanne — strongly influenced Picasso’s move toward geometric simplification and Cubism. , African and Iberian art — masks and sculpture helped shape works like Les Demoiselles d’Avignon. , Henri Matisse — his rivalry and dialogue with Matisse pushed Picasso’s experimentation. , Georges Braque — collaborated with Picasso in developing Cubism. , El Greco — influenced Picasso’s dramatic figures and expressive distortion. , Classical and Spanish art, including Velázquez and Goya — shaped his use of tradition, portraiture, and political imagery.", "expert_answer": "Picasso was influenced by many sources, especially:\n\n- **Paul Cézanne** — strongly influenced Picasso’s move toward geometric simplification and Cubism.\n- **African and Iberian art** — masks and sculpture helped shape works like *Les Demoiselles d’Avignon*.\n- **Henri Matisse** — his rivalry and dialogue with Matisse pushed Picasso’s experimentation.\n- **Georges Braque** — collaborated with Picasso in developing **Cubism**.\n- **El Greco** — influenced Picasso’s dramatic figures and expressive distortion.\n- **Classical and Spanish art**, including **Velázquez** and **Goya** — shaped his use of tradition, portraiture, and political imagery.\n\nIn short, Picasso was influenced by earlier European masters, non-Western sculpture, Spanish art, and his modernist peers.", "transcript": "Who influenced Picasso?\n", "asr_s": 0.48, "expert_s": 5.02, "expert_input_samples": 28960, "expert_input_s": 1.81, "expert_input_sha256": "67dffb6f665be8c47457e1e8e095b887f5fe5f92d25064e1e918d1d6ea8f9928", "expert_timed_out": false, "wait_s": 4.729, "relay_synth_ms": 17906, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 84, "feed_lag_sum_ms": 84, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0199_aggressive_relay.wav", "sha256": "2e2c0288400093536107f7015417e79c3d0f669679fa59fe51814d120450c63e", "sr": 24000, "seconds": 44.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0199_aggressive_candidate.wav", "sha256": "af7ca06be7ef8a44d21f62bc70a401c5d4db99a4198b5735053a3ad79624b889", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0199_aggressive_stall.wav", "sha256": "4805d7d68827ef27647b22d5f438203dd1b71b39047a2c993c801a7e47947cc9", "sr": 24000, "seconds": 1.32}}, "chunks": [[0, 1, 1.0, 1.051, 1.09, 1, 0, 0], [1, 1, 1.81, 1.861, 1.901, 1, 0, 0], [2, 0, 2.81, 2.864, 2.906, 1, 0, 0], [3, 0, 3.81, 3.868, 4.42, 0, 24000, 0], [4, 0, 4.81, 4.957, 5.194, 0, 7680, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.81, "last_real_feed_done": 1.861, "onset": 4.42, "gate_read_done": 4.42, "fire": 4.42, "candidate_first_pcm": 4.42, "stall_note": 4.421, "stall_first_pcm": 4.895, "local_first_pcm": null, "wait_start": 5.194, "expert_req": 4.421, "expert_resp": 9.923, "relay_synth_start": 9.924, "relay_first_pcm": 10.505, "relay_synth_end": 27.831, "first_any_pcm": 4.42, "first_answer_pcm": 10.505, "session_end": 28.007}, "ttfa_answer_s": 8.695, "ttfa_any_s": 2.61}
