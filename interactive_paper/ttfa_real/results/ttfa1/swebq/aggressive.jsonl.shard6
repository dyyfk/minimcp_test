, "transcript": "What is the Oregon Ducks 2012 football schedule?\n", "asr_s": 0.73, "expert_s": 6.49, "expert_input_samples": 49022, "expert_input_s": 3.064, "expert_input_sha256": "bbbf981b7614aa7cafb7a7f17c9197226fccf1545cba79187e873f834166a08b", "expert_timed_out": false, "wait_s": 6.233, "relay_synth_ms": 3341, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 34, "feed_lag_sum_ms": 34, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0113_aggressive_relay.wav", "sha256": "3392c94f68feafbe71cee300e8598a08c9d3048cf1410c13e6fce01e7f2d6b45", "sr": 24000, "seconds": 7.96}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0113_aggressive_candidate.wav", "sha256": "bddda6d660689585d3231c2822573eb9eb5bf58a8d51df61964ed4f1829fa23c", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0113_aggressive_stall.wav", "sha256": "0eaefe2befe79db6b0d00f04bd135de9fa98fe3474f5eff9d66bc07c02221cf3", "sr": 24000, "seconds": 1.64}}, "chunks": [[0, 1, 1.0, 1.052, 1.093, 1, 0, 0], [1, 1, 2.0, 2.051, 2.091, 1, 0, 0], [2, 1, 3.0, 3.056, 3.099, 1, 0, 0], [3, 1, 3.064, 3.15, 3.476, 0, 24000, 0], [4, 0, 4.064, 4.116, 4.464, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.064, "last_real_feed_done": 3.15, "onset": 3.476, "gate_read_done": 3.476, "fire": 3.476, "candidate_first_pcm": 3.476, "stall_note": 3.477, "stall_first_pcm": 3.892, "local_first_pcm": null, "wait_start": 4.464, "expert_req": 3.477, "expert_resp": 10.697, "relay_synth_start": 10.697, "relay_first_pcm": 11.28, "relay_synth_end": 14.038, "first_any_pcm": 3.476, "first_answer_pcm": 11.28, "session_end": 14.995}, "ttfa_answer_s": 8.217, "ttfa_any_s": 0.412}
{"id": "swebq0121", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2104713991, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what type of religion did massachusetts have?", "input_path": "/data/bench_audio/swebq0121.wav", "input_sha256": "371831f391fc193eabea55156e64d6a4054fec73cf9aed24af8cd650e1e3b7a7", "input_samples": 42335, "input_s": 2.646, "n_real_chunks": 3, "score": 0.9316, "act": 0.9969, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Massachusetts had a Puritan religion—specifically Congregational Protestant Christianity—during the colonial period.", "expert_answer": "Massachusetts had a **Puritan** religion—specifically **Congregational Protestant Christianity**—during the colonial period.", "transcript": "What type of religion did Massachusetts have?\n", "asr_s": 0.81, "expert_s": 2.09, "expert_input_samples": 42335, "expert_input_s": 2.646, "expert_input_sha256": "371831f391fc193eabea55156e64d6a4054fec73cf9aed24af8cd650e1e3b7a7", "expert_timed_out": false, "wait_s": 2.106, "relay_synth_ms": 3350, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0121_aggressive_relay.wav", "sha256": "ef7b6254f41b5f6b651dd46b4b43f164351001f0b3ccd8a65e6b42112b6c8926", "sr": 24000, "seconds": 7.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0121_aggressive_candidate.wav", "sha256": "051cf96fa3d2307e92ebf5bbec67732fa0251531116c837951e0f5cdfc1bc6dd", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0121_aggressive_stall.wav", "sha256": "5e85ab801213acb76955fb1a4d5d2c46308003a74adab0b95f7ff8212f46e5d8", "sr": 24000, "seconds": 1.56}}, "chunks": [[0, 1, 1.0, 1.053, 1.098, 1, 0, 0], [1, 1, 2.0, 2.054, 2.097, 1, 0, 0], [2, 1, 2.646, 2.704, 2.75, 1, 0, 0], [3, 0, 3.646, 3.699, 4.172, 0, 24000, 0], [4, 0, 4.646, 4.699, 4.965, 0, 13440, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.646, "last_real_feed_done": 2.704, "onset": 4.172, "gate_read_done": 4.172, "fire": 4.172, "candidate_first_pcm": 4.172, "stall_note": 4.173, "stall_first_pcm": 4.633, "local_first_pcm": null, "wait_start": 4.965, "expert_req": 4.172, "expert_resp": 7.071, "relay_synth_start": 7.071, "relay_first_pcm": 7.712, "relay_synth_end": 10.422, "first_any_pcm": 4.172, "first_answer_pcm": 7.712, "session_end": 10.547}, "ttfa_answer_s": 5.066, "ttfa_any_s": 1.526}
{"id": "swebq0130", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 326066896, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what is jimi hendrix purple haze about?", "input_path": "/data/bench_audio/swebq0130.wav", "input_sha256": "0e91c91dbc19d305a2c1035c510f92aa3e84e4b9003c60b9b6e27fef6f19af6e", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.5984, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "“Purple Haze” is generally about a disorienting, overwhelming state of mind—confusion, desire, and altered perception—rather than one single literal story. Jimi Hendrix said the idea came from a dream in which he was walking under the sea and surrounded by a purple haze. So the best summary is: it’s about being overwhelmed by a strange, intoxicating feeling—possibly love, possibly psychedelia, and deliberately open to interpretation.", "expert_answer": "**“Purple Haze” is generally about a disorienting, overwhelming state of mind—confusion, desire, and altered perception—rather than one single literal story.**\n\nJimi Hendrix said the idea came from a **dream** in which he was walking under the sea and surrounded by a purple haze. Many listeners have interpreted the song as being about **psychedelic drugs**, partly because of its imagery and the 1960s context, but Hendrix also described it as a kind of **love song**, with the narrator feeling “out of his mind” because of a powerful romantic or sensual experience.\n\nSo the best summary is: **it’s about being overwhelmed by a strange, intoxicating feeling—possibly love, possibly psychedelia, and deliberately open to interpretation.**", "transcript": "What is Jimi Hendrix Purple Haze about?\n", "asr_s": 0.7, "expert_s": 4.3, "expert_input_samples": 34162, "expert_input_s": 2.135, "expert_input_sha256": "0e91c91dbc19d305a2c1035c510f92aa3e84e4b9003c60b9b6e27fef6f19af6e", "expert_timed_out": false, "wait_s": 4.43, "relay_synth_ms": 11182, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0130_aggressive_relay.wav", "sha256": "529116d4fbf85a9e4701eb0146371acaa48432970b9a1c2f269605ca5d0500e8", "sr": 24000, "seconds": 27.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0130_aggressive_candidate.wav", "sha256": "83213ab9097bde2a0a3018562aac3f6a5e60d6eee4870751172f9a419d19ea86", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0130_aggressive_stall.wav", "sha256": "ebed2e89eb5673a4238b2c2e1d3bf7bc3a5fc21ee9c07a643aa25198fb654aca", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.051, 1.092, 1, 0, 0], [1, 1, 2.0, 2.052, 2.093, 1, 0, 0], [2, 1, 2.135, 2.191, 2.235, 1, 0, 0], [3, 0, 3.135, 3.19, 3.752, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.135, "last_real_feed_done": 2.191, "onset": 3.752, "gate_read_done": 3.753, "fire": 3.753, "candidate_first_pcm": 3.752, "stall_note": 3.754, "stall_first_pcm": 4.319, "local_first_pcm": null, "wait_start": 4.319, "expert_req": 3.753, "expert_resp": 8.75, "relay_synth_start": 8.75, "relay_first_pcm": 9.333, "relay_synth_end": 19.933, "first_any_pcm": 3.752, "first_answer_pcm": 9.333, "session_end": 20.729}, "ttfa_answer_s": 7.198, "ttfa_any_s": 1.617}
