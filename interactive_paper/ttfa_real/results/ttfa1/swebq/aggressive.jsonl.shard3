{"id": "swebq0064", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1756838075, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "who is moira en x men?", "input_path": "/data/bench_audio/swebq0064.wav", "input_sha256": "8ea399c8a2b23c0b5cacc4c2e1e090d6c307e5655d7fb4c0804a4a691b75c952", "input_samples": 25245, "input_s": 1.578, "n_real_chunks": 2, "score": 0.5718, "act": 0.998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Moira MacTaggert is a major supporting character in X-Men stories. Traditionally, she is a Scottish geneticist and longtime ally of Professor Charles Xavier, known for her research on mutants and her connection to characters like Banshee and Proteus, her mutant son. In later Marvel Comics continuity, especially beginning with House of X / Powers of X, Moira is reimagined as Moira X, a mutant whose power is reincarnation: when she dies, her life resets to the moment of her birth, allowing her to live multiple timelines and reshape mutant history.", "expert_answer": "**Moira MacTaggert** is a major supporting character in **X-Men** stories. Traditionally, she is a **Scottish geneticist and longtime ally of Professor Charles Xavier**, known for her research on mutants and her connection to characters like **Banshee** and **Proteus**, her mutant son.\n\nIn later Marvel Comics continuity, especially beginning with **House of X / Powers of X**, Moira is reimagined as **Moira X**, a mutant whose power is **reincarnation**: when she dies, her life resets to the moment of her birth, allowing her to live multiple timelines and reshape mutant history.", "transcript": "Who is Moira in X-Men?\n", "asr_s": 0.63, "expert_s": 5.16, "expert_input_samples": 25245, "expert_input_s": 1.578, "expert_input_sha256": "8ea399c8a2b23c0b5cacc4c2e1e090d6c307e5655d7fb4c0804a4a691b75c952", "expert_timed_out": false, "wait_s": 5.108, "relay_synth_ms": 17285, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0064_aggressive_relay.wav", "sha256": "2a64b2e09467cc90fe6c70bb42cff47c7077b5d78c828e918e67e6ff7a19bb5b", "sr": 24000, "seconds": 35.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0064_aggressive_candidate.wav", "sha256": "267a8c3cd4d3d0cb261fb8d124beba8a8f7705caedddc285d4a02453362ec4d1", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0064_aggressive_stall.wav", "sha256": "42a04eaa6ee6fac6a5f342b37b888623d6266f79c2021f3ad1dc48404d814f4d", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.059, 1.109, 1, 0, 0], [1, 1, 1.578, 1.637, 1.687, 1, 0, 0], [2, 0, 2.578, 2.638, 2.687, 1, 0, 0], [3, 0, 3.578, 3.639, 4.328, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.578, "last_real_feed_done": 1.637, "onset": 4.328, "gate_read_done": 4.328, "fire": 4.328, "candidate_first_pcm": 4.328, "stall_note": 4.329, "stall_first_pcm": 5.011, "local_first_pcm": null, "wait_start": 5.011, "expert_req": 4.329, "expert_resp": 10.119, "relay_synth_start": 10.119, "relay_first_pcm": 10.821, "relay_synth_end": 27.404, "first_any_pcm": 4.328, "first_answer_pcm": 10.821, "session_end": 28.51}, "ttfa_answer_s": 9.243, "ttfa_any_s": 2.751}
