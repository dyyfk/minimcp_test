{"id": "swebq0149", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 636636339, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what kind of painter was wassily kandinsky?", "input_path": "/data/bench_audio/swebq0149.wav", "input_sha256": "55c1889d70befd7ccf9810567bab13529889131afd0780e8d172a98aa34e626b", "input_samples": 36391, "input_s": 2.274, "n_real_chunks": 3, "score": 0.3502, "act": 0.9988, "is_info": true, "fired": false, "mode": "local", "answer": "Wassily Kandinsky was a Russian painter who is considered one of the founders of abstract art. He moved away from realistic representation and focused on color s, shapes, and lines to express emotion s and ideas. His work often felt like music visual ized, using forms and hues to create rhythm and movement on canvas.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 20, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0149_balanced_local.wav", "sha256": "b85487fd83235f764daf53bdc0e545d7ca4e1e3c00f034d2b8683727dd3ac78b", "sr": 24000, "seconds": 19.24}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 2.0, 2.056, 2.1, 1, 0, 0], [2, 1, 2.274, 2.328, 2.372, 1, 0, 0], [3, 0, 3.274, 3.331, 3.485, 0, 0, 0], [4, 0, 4.274, 4.331, 4.904, 0, 24000, 0], [5, 0, 5.274, 5.331, 5.857, 0, 24000, 0], [6, 0, 6.274, 6.333, 6.912, 0, 24000, 0], [7, 0, 7.274, 7.33, 7.798, 0, 24000, 0], [8, 0, 8.274, 8.332, 8.788,