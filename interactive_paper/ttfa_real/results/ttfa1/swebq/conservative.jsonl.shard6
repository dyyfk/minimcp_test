{"id": "swebq0058", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1244407635, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "where did starbucks get their logo?", "input_path": "/data/bench_audio/swebq0058.wav", "input_sha256": "97984d2503e6a23dfeb1602d9f186b96a771ac4d7648068523b6f98056da8777", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.9063, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Starbucks got its logo from a 16th-century Norse woodcut of a two-tailed mermaid, or “siren.” The founders chose the siren because Starbucks began in Seattle, a port city, and the company wanted a maritime image that fit its coffee-trading roots.", "expert_answer": "Starbucks got its logo from a **16th-century Norse woodcut of a two-tailed mermaid, or “siren.”**  \n\nThe founders chose the siren because Starbucks began in **Seattle**, a port city, and the company wanted a maritime image that fit its coffee-trading roots.", "transcript": "Where did Starbucks get their logo?\n", "asr_s": 3.2, "expert_s": 5.32, "expert_input_samples": 34162, "expert_input_s": 2.135, "expert_input_sha256": "97984d2503e6a23dfeb1602d9f186b96a771ac4d7648068523b6f98056da8777", "expert_timed_out": false, "wait_s": 5.168, "relay_synth_ms": 8811, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0058_conservative_relay.wav", "sha256": "3dca9b46a97a65372b61e952e1ecec63cf0a134235a06a8fc9029736abd78518", "sr": 24000, "seconds": 15.0}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/