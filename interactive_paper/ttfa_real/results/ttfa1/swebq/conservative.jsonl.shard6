{"id": "swebq0069", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 369509382, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what led to stalin rise in power?", "input_path": "/data/bench_audio/swebq0069.wav", "input_sha256": "9c9d1bd1d6699469011b26fa32cfe99e82f98ea206b2a6b14cd906ac2ed335c2", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.5346, "act": 0.9949, "is_info": true, "fired": false, "mode": "local", "answer": "He was the general secretary of the Communist Party, and he had a lot of power in the government. But when the civil war broke out, Stalin became more powerful because he was able to lead the Red Army to victory against the White Army. This made him very popular with the people, and he used that popularity to take control of the country after the war ended.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 113, "feed_lag_sum_ms": 128, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0069_conservative_local.wav", "sha256": "ee7b1ba18fda90daa6edf204769a741c37c4bd2170275199913a4a88944c8640", "sr": 24000, "seconds": 13.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.134, 1, 0, 0], [1, 1, 2.0, 2.087, 2.156, 1, 0, 0], [2, 1, 2.321, 2.395, 2.453, 1, 0, 0], [3, 0, 3.321, 3.398, 3.966, 0, 24000, 0], [4, 0, 4.321, 4.396, 5.108, 0, 24000, 0], [5, 0, 5.321, 5.396, 6.336, 0, 24000, 0], [6, 0, 6.321, 6.409, 7.177, 0, 24000, 0], [7, 0, 7.321, 7