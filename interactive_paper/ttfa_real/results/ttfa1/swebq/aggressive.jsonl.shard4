{"id": "swebq0119", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1485158646, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "what system of government does guyana have?", "input_path": "/data/bench_audio/swebq0119.wav", "input_sha256": "aa4d1a20b049ae5485642489b17f2adb9e436e4ebc3942a0d54be50de541ce39", "input_samples": 41592, "input_s": 2.599, "n_real_chunks": 3, "score": 0.3729, "act": 0.9991, "is_info": true, "fired": false, "mode": "local", "answer": "Guyana is a parliamentary representative democracy. The country' s political system follows the Westminster model, with an executive branch led by a president who also serves as the head of state. However, the day- to-day governance is carried out by a prime minister and their cabinet, which is responsible for policy implementation. The parliament consists of two chambers: the National Assembly and the Senate. Law makers are elected through general elections, usually held every five years. This structure allows for legislative power to be shared between the executive and the legislative branches, ensuring checks and balance s in the government process.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 34, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0119_aggressive_local.wav", "sha256": "eb5de8f28c7d5e04a9f1ee1d8d88f142044bb40a238e7d05ac473bf2756c253e", "sr": 24000, "seconds": 34.28}}, "c