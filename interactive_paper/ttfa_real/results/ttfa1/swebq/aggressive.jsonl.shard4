{"id": "swebq0056", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2912160340, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "what there to do in salt lake city utah?", "input_path": "/data/bench_audio/swebq0056.wav", "input_sha256": "43c9ca952f78d6d7473860eaa71bbf8219b6ad81c9d28e2133e97734054d2e36", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.3051, "act": 0.997, "is_info": true, "fired": false, "mode": "local", "answer": "There are lots of things to do in Salt Lake City, U t ah. You can visit Temple Square, which is the headquarters of The Church of Jesus Christ of Latter- day Saints and a great place to learn about local history and culture. If you love nature, head out to one of the nearby national parks like Zion National Park or Arches National Park for hiking, rock climbing, and stunning scenery. For indoor activities, check out the Natural History Museum of Utah or catch a show at the Utah Symphony Orchestra. And don' t forget to try some local food, like green j ello or a slaw dog from one of the many food truck s around town.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 40, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0056_aggressive_local.wav", "sha256": "43cb3709da8b6ec34cf9f4fd6c02e1a682a9b3b7a4eba515952492116aa750e6", "sr": 24000, "seconds": 39.56}}, "chunks": [[0, 1, 1.0, 1.052, 1.094, 1, 0, 