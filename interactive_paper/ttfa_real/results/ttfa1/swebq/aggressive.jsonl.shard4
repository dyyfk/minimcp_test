* in 2011 as Iowa Farmer. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Taylor_Lautner?utm_source=openai))", "transcript": "What all movies has Taylor Lautner been in?\n", "asr_s": 1.01, "expert_s": 11.74, "expert_input_samples": 39363, "expert_input_s": 2.46, "expert_input_sha256": "c42349a515054b50c771cfd0d66dd10038f34863983e381dfa0fdfca4c0dd37b", "expert_timed_out": false, "wait_s": 11.642, "relay_synth_ms": 5378, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 101, "feed_lag_sum_ms": 101, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0161_aggressive_relay.wav", "sha256": "c4bc3ce7da4733921754071f8b50cd96d1ca0fc61d8bebc8bf3382f48e0a7a5a", "sr": 24000, "seconds": 12.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0161_aggressive_candidate.wav", "sha256": "009ac64c7e75b8aa775b965db8a6dbc1410c1f62af4a5801c46ab7170c9f6b0b", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0161_aggressive_stall.wav", "sha256": "740f2f9cd2c86466ccd339c0016586554215f6a88942859779f550cb7f6499ea", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.051, 1.092, 1, 0, 0], [1, 1, 2.0, 2.056, 2.097, 1, 0, 0], [2, 1, 2.46, 2.516, 2.561, 1, 0, 0], [3, 0, 3.46, 3.517, 4.092, 0, 24000, 0], [4, 0, 4.46, 4.619, 5.204, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.46, "last_real_feed_done": 2.516, "onset": 4.092, "gate_read_done": 4.093, "fire": 4.093, "candidate_first_pcm": 4.092, "stall_note": 4.093, "stall_first_pcm": 4.561, "local_first_pcm": null, "wait_start": 5.204, "expert_req": 4.093, "expert_resp": 16.846, "relay_synth_start": 16.846, "relay_first_pcm": 17.452, "relay_synth_end": 22.225, "first_any_pcm": 4.092, "first_answer_pcm": 17.452, "session_end": 22.337}, "ttfa_answer_s": 14.992, "ttfa_any_s": 1.632}
