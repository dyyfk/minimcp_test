{"id": "swebq0031", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1705654385, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "who helped eminem started his career?", "input_path": "/data/bench_audio/swebq0031.wav", "input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.8637, "act": 0.9971, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Dr. Dre helped Eminem start his mainstream career. He signed Eminem to Aftermath Entertainment and produced much of The Slim Shady LP, which made Eminem famous.", "expert_answer": "**Dr. Dre** helped Eminem start his mainstream career. He signed Eminem to Aftermath Entertainment and produced much of **_The Slim Shady LP_**, which made Eminem famous.", "transcript": "Who helped Eminem started his career?\n", "asr_s": 0.73, "expert_s": 1.88, "expert_input_samples": 37134, "expert_input_s": 2.321, "expert_input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "expert_timed_out": false, "wait_s": 1.56, "relay_synth_ms": 4132, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 27, "feed_lag_sum_ms": 27, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_aggressive_relay.wav", "sha256": "c7d72d050b79bc3bede641104fb277935a1ba15133de7a6c3f3b352a57627472", "sr": 24000, "seconds": 10.24}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_aggressive_candidate.wav", "sha256": "97fc875244469a76cf8e4cc5b19bcb999d6f2094470c687d9e3ae1c406eb5d5c", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa