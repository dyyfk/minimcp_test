{"id": "swebq0125", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2048829214, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "where does name pennsylvania come from?", "input_path": "/data/bench_audio/swebq0125.wav", "input_sha256": "a27fd23128bc10b86029ee64890c168dc0284f01524c188c50b938c8468bd126", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.4574, "act": 0.9978, "is_info": true, "fired": false, "mode": "local", "answer": "The name Pennsylvania comes from Penn, which is the last name of William Penn. He was a Quaker who founded the colony in 1681 and wanted to give it a name that meant 'Penn's land.' So, it' s named after him.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0125_local_local.wav", "sha256": "8688fafbe48ed299b7309a622c8153389fda36e8357f50927d9c56323ec4d718", "sr": 24000, "seconds": 9.96}}, "chunks": [[0, 1, 1.0, 1.06, 1.109, 1, 0, 0], [1, 1, 2.0, 2.062, 2.11, 1, 0, 0], [2, 1, 2.182, 2.24, 2.288, 1, 0, 0], [3, 0, 3.182, 3.251, 3.837, 0, 24000, 0], [4, 0, 4.182, 4.241, 4.825, 0, 24000, 0], [5, 0, 5.182, 5.237, 5.817, 0, 24000, 0], [6, 0, 6.182, 6.241, 6.759, 0, 24000, 0], [7, 0, 7.182, 7.243, 7.805, 0, 24000, 0], [8, 0, 8.182, 8.241, 8.807, 0, 24000, 0], [9, 0, 9.182, 9.236, 10.142, 0, 24000, 0], [10, 0, 10.182, 10.24, 10.847, 0, 24000, 0], [11, 0, 11.182, 11.246, 11.848,