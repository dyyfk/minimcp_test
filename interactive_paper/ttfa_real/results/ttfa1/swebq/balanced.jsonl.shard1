{"id": "swebq0107", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2787550384, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where english is spoken?", "input_path": "/data/bench_audio/swebq0107.wav", "input_sha256": "9ea5de70fdcda40125712dbffbe96b7d01f69f4be9a98b111cc7af1165a040ba", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.7728, "act": 0.9825, "is_info": true, "fired": false, "mode": "local", "answer": "English is spoken in many places around the world. Some of the main countries where it's widely used include the United States, the United Kingdom, Canada, Australia, New Zealand, India, and Nigeria. It is also an official language in many other countries like South Africa, Singapore, and several countries in the Caribbean and parts of Africa. Because English was a major language during the British Empire, it has become widespread in regions that were once colonized by Britain. Today, it's one of the most commonly taught languages globally and is often used as a second or third language for international communication.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 59, "eot_seen": true, "n_speak_chunks": 38, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0107_balanced_local.wav", "sha256": "fb3d56644b618ed446ac4760cbcbff5d918bb60ce0488c1823a93cbb1a3b6544", "sr": 24000, "seconds": 37.44}}, "chunks": [[0, 1, 1.0, 1.054, 1.098, 1, 0, 0], [1, 1, 1.81, 1