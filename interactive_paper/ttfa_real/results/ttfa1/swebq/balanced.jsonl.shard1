{"id": "swebq0166", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2272998304, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who were wright brothers?", "input_path": "/data/bench_audio/swebq0166.wav", "input_sha256": "0673597bd3864240bcd266fefca8d8f3ce178ad9954a3f6361777f941d8a5f46", "input_samples": 23016, "input_s": 1.438, "n_real_chunks": 2, "score": 0.38, "act": 0.9936, "is_info": true, "fired": false, "mode": "local", "answer": "The Wright brothers were Orville and Wilbur Wright, two American inventors who made history by building the world' s first successful airplane. On December 17, 1903, they achieved the first powered, controlled, and sustained flight of a heavier-than-air aircraft near Ki ttitake, North Carolina. Their plane, called the Flyer I, flew for about 1 2 seconds and covered around 1 20 feet during their first attempt. Over the next few days, they made several more flights, with the longest one lasting over 59 seconds and traveling 85 2 feet. The Wright brothers did not just build an airplane; they also developed control systems like wing war ping to steer the aircraft, which was a major breakthrough in aviation technology. Before them, many believed flight was impossible or that it would require enormous power. But the Wright brothers proved otherwise through years of research, testing, and innovation. They paved the way", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 60, "feed_lag_max_ms"