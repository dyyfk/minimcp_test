{"id": "swebq0194", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4008529475, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what countries does greece share borders with?", "input_path": "/data/bench_audio/swebq0194.wav", "input_sha256": "e55686ca113e34a77b02c6c7557de21cefa747c5a121c4a8b5cd464d75aba363", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.5072, "act": 0.9989, "is_info": true, "fired": false, "mode": "local", "answer": "Greece shares borders with four countries. It has a land border with Albania to the northwest, North Macedonia to the north, and Bulgaria to the north east. Greece also shares maritime boundaries with Turkey in the Aege an Sea.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0194_balanced_local.wav", "sha256": "c7331d12c039acbb2bcf73e22ff766864ca7dc72d1901c063e9f5fb2b5f0ea51", "sr": 24000, "seconds": 11.28}}, "chunks": [[0, 1, 1.0, 1.052, 1.093, 1, 0, 0], [1, 1, 2.0, 2.052, 2.092, 1, 0, 0], [2, 1, 2.182, 2.232, 2.271, 1, 0, 0], [3, 0, 3.182, 3.235, 3.58, 0, 24000, 0], [4, 0, 4.182, 4.238, 4.781, 0, 24000, 0], [5, 0, 5.182, 5.235, 5.746, 0, 24000, 0], [6, 0, 6.182, 6.239, 6.736, 0, 24000, 0], [7, 0, 7.182, 7.237, 7.72, 0, 24000, 0], [8, 0, 8.182, 8.236, 8.74, 0, 24000, 0], [9, 0, 9.182, 9.239, 9.765, 0, 24000, 0], [10, 0, 10.182, 10.24, 10.