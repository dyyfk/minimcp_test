{"id": "swebq0098", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3868813407, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what movies does matt dallas play in?", "input_path": "/data/bench_audio/swebq0098.wav", "input_sha256": "10a061b67e88bce8e49bb229e5d5deff894ba97002e5f4a1b55cf24c59cd72be", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.7528, "act": 0.9905, "is_info": true, "fired": false, "mode": "local", "answer": "Matt Dallas is best known for his role as Eric Matthews in the TV series 'B oy Meets World' and its spin-off, 'D gray's Anatomy.' However, he hasn't had major roles in widely released movies. He has appeared in some smaller film s like 'The Last Ride ' or 'The Last Stand,' but these are more of supporting or minor appearances rather than lead roles in big-budget films. So while he's active in acting, he hasn' t been part of many famous movies.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 25, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0098_balanced_local.wav", "sha256": "4b0b4f975a00fed421be7d00a257c6e9f071234256d775f84269af31d71f5728", "sr": 24000, "seconds": 23.72}}, "chunks": [[0, 1, 1.0, 1.054, 1.098, 1, 0, 0], [1, 1, 2.0, 2.056, 2.101, 1, 0, 0], [2, 1, 2.182, 2.238, 2.283, 1, 0, 0], [3, 0, 3.182, 3.238, 3.38, 0, 0, 0], [4, 0, 4.182, 4.234, 4.671, 0, 24000, 0], [5, 0, 5.182, 5.235, 5.768,