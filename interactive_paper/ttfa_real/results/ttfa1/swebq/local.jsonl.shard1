{"id": "swebq0168", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1623400103, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what did the islamic people believe in?", "input_path": "/data/bench_audio/swebq0168.wav", "input_sha256": "946036e3250af8cf5fa75907aa75b8865ff967089796a94b5e94ca7a6ab04933", "input_samples": 29703, "input_s": 1.856, "n_real_chunks": 2, "score": 0.6667, "act": 0.9987, "is_info": true, "fired": false, "mode": "local", "answer": "Well, the Islamic people believed in one God. They believed that Allah was their only god and they believed that he created everything. They also believed that there were prophets sent to guide people towards All ah, including prophet Muham mad, who was the last prophet sent by Allah.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0168_local_local.wav", "sha256": "ab0f14979fb3a245b377267b6a6ab58ff9c7e83cebde42359c12baf5313798a4", "sr": 24000, "seconds": 14.8}}, "chunks": [[0, 1, 1.0, 1.076, 1.137, 1, 0, 0], [1, 1, 1.856, 1.929, 1.987, 1, 0, 0], [2, 0, 2.856, 2.93, 2.982, 1, 0, 0], [3, 0, 3.856, 3.935, 4.645, 0, 24000, 0], [4, 0, 4.856, 4.941, 5.598, 0, 24000, 0], [5, 0, 5.856, 5.926, 6.559, 0, 24000, 0], [6, 0, 6.856, 6.928, 7.559, 0, 24000, 0], [7, 0, 7.856, 7.931, 8.827, 0, 24000, 0], [8, 0, 8.856, 8.928, 9.647, 0, 24000, 0], [9, 0, 9.856, 9.931, 10.521, 0, 24000