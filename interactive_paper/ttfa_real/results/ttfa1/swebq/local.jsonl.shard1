{"id": "swebq0019", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1497879233, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 NVL", "host": "modal", "shard": 1, "query": "what kind of language do egyptian speak?", "input_path": "/data/bench_audio/swebq0019.wav", "input_sha256": "303659d41d4a6d007efaca4f02e623cf17dab459ed9309457de92882900de37f", "input_samples": 33419, "input_s": 2.089, "n_real_chunks": 3, "score": 0.3586, "act": 0.9965, "is_info": true, "fired": false, "mode": "local", "answer": "The official language of Egypt is Egyptian Arabic. It's the main language spoken by most people there, and it has its own unique style that differs from other Arab ic dialects. So if you're visiting Egypt, knowing some basic Egyptian Arab ic phrases will definitely help with communication!", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 16, "feed_lag_max_ms": 34, "feed_lag_sum_ms": 34, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0019_local_local.wav", "sha256": "9cb6cc909e0b05a5801ab69dc1feae0e8234d14a3b316c7afdb566305f4a697f", "sr": 24000, "seconds": 15.36}}, "chunks": [[0, 1, 1.0, 1.067, 1.122, 1, 0, 0], [1, 1, 2.0, 2.068, 2.123, 1, 0, 0], [2, 1, 2.089, 2.189, 2.245, 1, 0, 0], [3, 0, 3.089, 3.158, 3.347, 0, 0, 0], [4, 0, 4.089, 4.158, 4.799, 0, 24000, 0], [5, 0, 5.089, 5.157, 5.765, 0, 24000, 0], [6, 0, 6.089, 6.158, 6.803, 0, 24000, 0], [7, 0, 7.089, 7.158, 7.774, 0, 24000, 0], [8, 0, 8.089, 8.159, 8.832, 0, 24000, 0], [9, 0, 9.089, 9.158, 9.83, 0, 24000, 0]