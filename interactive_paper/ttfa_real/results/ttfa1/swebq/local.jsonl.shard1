{"id": "swebq0044", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1518426681, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 NVL", "host": "modal", "shard": 1, "query": "where is chris rock from?", "input_path": "/data/bench_audio/swebq0044.wav", "input_sha256": "f01777afdec3d653890c10ee15ffe2b4bfe733773044b8b7e9d1491fddb74571", "input_samples": 24502, "input_s": 1.531, "n_real_chunks": 2, "score": 0.5878, "act": 0.9965, "is_info": true, "fired": false, "mode": "local", "answer": "Chris Rock is from the United States. He was born in Andrews, South Carolina, but grew up in Brooklyn, New York. So his background is definitely rooted in American culture.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0044_local_local.wav", "sha256": "046dfed630f9bb669e7ed7ca5270c1608e8858590136ad5e5d76a1019879ab39", "sr": 24000, "seconds": 10.28}}, "chunks": [[0, 1, 1.0, 1.066, 1.121, 1, 0, 0], [1, 1, 1.531, 1.599, 1.654, 1, 0, 0], [2, 0, 2.531, 2.598, 2.654, 1, 0, 0], [3, 0, 3.531, 3.599, 4.236, 0, 24000, 0], [4, 0, 4.531, 4.599, 5.266, 0, 24000, 0], [5, 0, 5.531, 5.6, 6.212, 0, 24000, 0], [6, 0, 6.531, 6.6, 7.273, 0, 24000, 0], [7, 0, 7.531, 7.6, 8.245, 0, 24000, 0], [8, 0, 8.531, 8.601, 9.301, 0, 24000, 0], [9, 0, 9.531, 9.601, 10.183, 0, 24000, 0], [10, 0, 10.531, 10.601, 11.215, 0, 24000, 0], [11, 0, 11.531, 11.602, 12.245, 0, 24000, 0], [12, 0, 12.531, 12.603, 13.353, 0, 3072