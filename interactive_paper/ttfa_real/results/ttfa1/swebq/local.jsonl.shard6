{"id": "swebq0113", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3092271592, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 NVL", "host": "modal", "shard": 6, "query": "what is the oregon ducks 2012 football schedule?", "input_path": "/data/bench_audio/swebq0113.wav", "input_sha256": "bbbf981b7614aa7cafb7a7f17c9197226fccf1545cba79187e873f834166a08b", "input_samples": 49022, "input_s": 3.064, "n_real_chunks": 4, "score": 0.9428, "act": 0.9996, "is_info": true, "fired": false, "mode": "local", "answer": "Oregon Ducks football schedule for 2012. It' s a pretty big one, so let me see if I can get it right here. So they start off with their home opener against the Eastern Washington Eagles on September 1st. Then they have a road game against the Arizona Wildcats on September 8th. They come back home to face the Tennessee Volunteers on September 15th. And then they travel to take on the Cal ifornia Golden Bears on September 22nd. They play another home game against the Utah U tes on October 6 th. They go on the road to face the Colorado Buffal oes on October 13th. The y return home to face the Arizona State Sun Devils on October 2 0th. Then they travel to take on the Washington Huskies on October 27th. They host the USC Tro jans on November 3rd. They travel to face the Stanford Cardinal s on November 1 0th. They host the Oregon State Be avers on November 17th. And finally, they end the season at home against the UCLA Bruins on November 2 4th.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunk