: "9d116049dd5378973993eb6deb2a9cc44bba0fd48dc8898ae241fe7d189c8834", "sr": 24000, "seconds": 1.64}}, "chunks": [[0, 1, 1.0, 1.071, 1.127, 1, 0, 0], [1, 1, 2.0, 2.075, 2.132, 1, 0, 0], [2, 1, 2.274, 2.343, 2.398, 1, 0, 0], [3, 0, 3.274, 3.347, 4.03, 0, 24000, 0], [4, 0, 4.274, 4.694, 5.082, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.274, "last_real_feed_done": 2.343, "onset": 4.03, "gate_read_done": 4.03, "fire": 4.03, "candidate_first_pcm": 4.03, "stall_note": 4.032, "stall_first_pcm": 4.621, "local_first_pcm": null, "wait_start": 5.082, "expert_req": 4.031, "expert_resp": 7.989, "relay_synth_start": 7.99, "relay_first_pcm": 8.786, "relay_synth_end": 15.14, "first_any_pcm": 4.03, "first_answer_pcm": 8.786, "session_end": 15.363}, "ttfa_answer_s": 6.511, "ttfa_any_s": 1.755}
{"id": "swebq0195", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2582281941, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what do christians believe about heaven hell and purgatory?", "input_path": "/data/bench_audio/swebq0195.wav", "input_sha256": "6c3b79595e4677348f44e7a71a3b3a407f816aac0f8a3dca9371983e5ba53704", "input_samples": 44564, "input_s": 2.785, "n_real_chunks": 3, "score": 0.6291, "act": 0.9994, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Christians generally believe: Heaven is eternal life with God — a state of perfect joy, peace, holiness, and communion with God after death. , Hell is eternal separation from God, associated with judgment, suffering, and the consequence of rejecting God’s grace. , Purgatory is believed by Roman Catholics and some other Christians to be a temporary state of purification after death for those who die in God’s grace but still need cleansing before entering heaven.", "expert_answer": "Christians generally believe:\n\n- **Heaven** is eternal life with God — a state of perfect joy, peace, holiness, and communion with God after death.\n- **Hell** is eternal separation from God, associated with judgment, suffering, and the consequence of rejecting God’s grace.\n- **Purgatory** is believed by **Roman Catholics** and some other Christians to be a temporary state of purification after death for those who die in God’s grace but still need cleansing before entering heaven.\n\nViews differ by tradition:\n\n- **Catholic Christians** affirm heaven, hell, and purgatory.\n- **Eastern Orthodox Christians** believe in heaven and hell but usually do not define purgatory in the same formal way as Catholicism.\n- **Most Protestants** believe in heaven and hell but reject purgatory, teaching that believers are made fully righteous through Christ and go directly to be with God after death.\n\nSo, the shared Christian belief is that human beings face judgment after death, with heaven as union with God and hell as separation from God; purgatory is mainly a Catholic doctrine.", "transcript": "What do Christians believe about heaven, hell, and purgatory?\n", "asr_s": 0.63, "expert_s": 5.1, "expert_input_samples": 44564, "expert_input_s": 2.785, "expert_input_sha256": "6c3b79595e4677348f44e7a71a3b3a407f816aac0f8a3dca9371983e5ba53704", "expert_timed_out": false, "wait_s": 4.49, "relay_synth_ms": 19836, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 371, "feed_lag_sum_ms": 371, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0195_always_relay.wav", "sha256": "becc412b855c26e4de4aefbe9edaa13ed3536586cdb4ff68543f83a9b25ef75f", "sr": 24000, "seconds": 36.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0195_always_candidate.wav", "sha256": "151bef10e7e7be506a42b753f7e4e6198bbcd11714591de16704f54750b9be10", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0195_always_stall.wav", "sha256": "15c00bf4fcb1661daf6020fb29d7c5c0134946818b492b40d829f55b84d23257", "sr": 24000, "seconds": 2.08}}, "chunks": [[0, 1, 1.0, 1.069, 1.124, 1, 0, 0], [1, 1, 2.0, 2.072, 2.127, 1, 0, 0], [2, 1, 2.785, 2.858, 2.916, 1, 0, 0], [3, 0, 3.785, 3.862, 4.542, 0, 24000, 0], [4, 0, 4.785, 5.244, 5.79, 0, 25920, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.785, "last_real_feed_done": 2.858, "onset": 4.542, "gate_read_done": 4.543, "fire": 4.543, "candidate_first_pcm": 4.542, "stall_note": 4.544, "stall_first_pcm": 5.156, "local_first_pcm": null, "wait_start": 5.79, "expert_req": 4.544, "expert_resp": 10.28, "relay_synth_start": 10.281, "relay_first_pcm": 11.14, "relay_synth_end": 30.117, "first_any_pcm": 4.542, "first_answer_pcm": 11.14, "session_end": 30.725}, "ttfa_answer_s": 8.354, "ttfa_any_s": 1.757}
{"id": "swebq0203", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2735595248, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what to visit in atlanta?", "input_path": "/data/bench_audio/swebq0203.wav", "input_sha256": "c5f6cf22d4be07cb880b61d7f51af730f15797e8f6353ddd4be069304a550b02", "input_samples": 26731, "input_s": 1.671, "n_real_chunks": 2, "score": 0.3696, "act": 0.9897, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Here are the best places to visit in Atlanta, especially for a first trip: Must-see attractions , Georgia Aquarium – One of Atlanta’s biggest attractions; great for families or a rainy day. , World of Coca-Cola – Fun, touristy, and right by the aquarium and Centennial Olympic Park. , National Center for Civil and Human Rights – Powerful museum connecting the U.S. civil rights movement with global human rights issues. (civilandhumanrights.org) , Martin Luther King Jr.", "expert_answer": "Here are the **best places to visit in Atlanta**, especially for a first trip:\n\n## Must-see attractions\n1. **Georgia Aquarium** – One of Atlanta’s biggest attractions; great for families or a rainy day.\n2. **World of Coca-Cola** – Fun, touristy, and right by the aquarium and Centennial Olympic Park.\n3. **National Center for Civil and Human Rights** – Powerful museum connecting the U.S. civil rights movement with global human rights issues. ([civilandhumanrights.org](https://www.civilandhumanrights.org/?utm_source=openai))\n4. **Martin Luther King Jr. National Historical Park** – Visit Ebenezer Baptist Church, MLK’s birth home area, and key civil-rights landmarks.\n5. **Atlanta Botanical Garden + Piedmont Park** – Beautiful outdoor stop in Midtown; the garden is open Tuesday–Sunday. ([atlantabg.org](https://atlantabg.org/?utm_source=openai))\n\n## Best neighborhoods / areas to explore\n6. **Atlanta BeltLine Eastside Trail** – Walk, bike, eat, and people-watch. It connects places like **Ponce City Market** and **Krog Street Market**; the BeltLine is a 22-mile loop connecting many neighborhoods. ([beltline.org](https://beltline.org/visit/?utm_source=openai))\n7. **Ponce City Market** – Food hall, shops, rooftop games/views, and easy BeltLine access.\n8. **Krog Street Market + Inman Park** – Great food, bars, street art, and historic homes.\n9. **Little Five Points** – Quirky shops, vintage stores, music, murals, and alternative culture.\n10. **Virginia-Highland** – Walkable area with restaurants, bars, boutiques, and a relaxed local feel.\n\n## If you have extra time\n- **High Museum of Art** – Atlanta’s major art museum.\n- **Fernbank Museum** – Dinosaurs, science exhibits, and outdoor forest trails.\n- **College Football Hall of Fame** – Best if you like sports.\n- **Stone Mountain Park** – Popular day trip outside the city, though you’ll likely want a car.\n- **Chattahoochee River National Recreation Area** – Good for hiking, kayaking, or nature.\n\n## Simple 2-day Atlanta itinerary\n**Day 1:** Georgia Aquarium → World of Coca-Cola → Civil and Human Rights Center → Centennial Olympic Park → dinner downtown or Midtown.  \n**Day 2:** Piedmont Park → Atlanta Botanical Garden → BeltLine Eastside Trail → Ponce City Market → Krog Street Market/Inman Park.\n\nIf you only do **three things**, I’d pick: **MLK National Historical Park**, **the BeltLine/Ponce City Market**, and **Georgia Aquarium or the Botanical Garden** depending on your interests.", "transcript": "What to visit in Atlanta.\n", "asr_s": 0.63, "expert_s": 11.82, "expert_input_samples": 26731, "expert_input_s": 1.671, "expert_input_sha256": "c5f6cf22d4be07cb880b61d7f51af730f15797e8f6353ddd4be069304a550b02", "expert_timed_out": false, "wait_s": 11.204, "relay_synth_ms": 14564, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0203_always_relay.wav", "sha256": "20881f327f759654f89623494dcee9526c64c6c69a11ddac9548d2607bcaa95b", "sr": 24000, "seconds": 26.12}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0203_always_candidate.wav", "sha256": "641ccb0ac5afdfe34dc8a2412e5513a127781f4eb6d8912a6ef132149f9ae0fa", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0203_always_stall.wav", "sha256": "a2700b1e91518aac3cf9d362a20d52ec9da79c84f27bc2508d2600544cd8b1bd", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.135, 1, 0, 0], [1, 1, 1.671, 1.745, 1.803, 1, 0, 0], [2, 0, 2.671, 2.744, 2.801, 1, 0, 0], [3, 0, 3.671, 3.745, 4.45, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.671, "last_real_feed_done": 1.745, "onset": 4.45, "gate_read_done": 4.451, "fire": 4.451, "candidate_first_pcm": 4.45, "stall_note": 4.452, "stall_first_pcm": 5.693, "local_first_pcm": null, "wait_start": 5.693, "expert_req": 4.452, "expert_resp": 16.897, "relay_synth_start": 16.898, "relay_first_pcm": 17.697, "relay_synth_end": 31.463, "first_any_pcm": 4.45, "first_answer_pcm": 17.697, "session_end": 31.81}, "ttfa_answer_s": 16.027, "ttfa_any_s": 2.78}
