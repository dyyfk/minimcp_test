 1.071, 1.126, 1, 0, 0], [1, 1, 1.996, 2.067, 2.123, 1, 0, 0], [2, 0, 2.996, 3.072, 3.138, 1, 0, 0], [3, 0, 3.996, 4.068, 4.575, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.996, "last_real_feed_done": 2.067, "onset": 4.575, "gate_read_done": 4.575, "fire": 4.575, "candidate_first_pcm": 4.575, "stall_note": 4.576, "stall_first_pcm": 5.342, "local_first_pcm": null, "wait_start": 5.342, "expert_req": 4.576, "expert_resp": 7.226, "relay_synth_start": 7.226, "relay_first_pcm": 8.058, "relay_synth_end": 10.858, "first_any_pcm": 4.575, "first_answer_pcm": 8.058, "session_end": 11.03}, "ttfa_answer_s": 6.062, "ttfa_any_s": 2.579}
{"id": "swebq0222", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3862727908, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what is the national flower of hawaii?", "input_path": "/data/bench_audio/swebq0222.wav", "input_sha256": "52d3853ea51d69e29d62f81c63b5e693cda7bae3b4b2ee1bf246b9f746d2e233", "input_samples": 51995, "input_s": 3.25, "n_real_chunks": 4, "score": 0.4319, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The national flower of Hawaii is the yellow hibiscus (Hibiscus brackenridgei), also called pua aloalo.", "expert_answer": "The national flower of **Hawaii** is the **yellow hibiscus** (*Hibiscus brackenridgei*), also called **pua aloalo**.", "transcript": "What is the national flower of Hawaii?\n", "asr_s": 0.84, "expert_s": 1.95, "expert_input_samples": 51995, "expert_input_s": 3.25, "expert_input_sha256": "52d3853ea51d69e29d62f81c63b5e693cda7bae3b4b2ee1bf246b9f746d2e233", "expert_timed_out": false, "wait_s": 2.05, "relay_synth_ms": 4819, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0222_always_relay.wav", "sha256": "af9f931b03e34fae3bac246840fc20580a867dd11b074c41f624ce941af4b637", "sr": 24000, "seconds": 8.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0222_always_candidate.wav", "sha256": "12cab97854eed437b5a08a4ada52d950e2be80690d19ef9050f8e198cc6d895c", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0222_always_stall.wav", "sha256": "742b09723afeb8610f798ff144cd18921955248a007bbe867c661cddf1a3c8b6", "sr": 24000, "