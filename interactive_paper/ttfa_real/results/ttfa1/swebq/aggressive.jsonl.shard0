{"id": "swebq0236", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4165630396, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "who founded the afl?", "input_path": "/data/bench_audio/swebq0236.wav", "input_sha256": "02f39c73dbb55f22645df4e7bc7ebaae46a1a9a0490bff07ca5b6cf8ed2a7e89", "input_samples": 24502, "input_s": 1.531, "n_real_chunks": 2, "score": 0.8292, "act": 0.9982, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "If you mean the American Federation of Labor (AFL), it was founded in 1886 by Samuel Gompers and other labor leaders. If you mean the American Football League (AFL), it was founded in 1959 by Lamar Hunt.", "expert_answer": "If you mean the **American Federation of Labor (AFL)**, it was founded in **1886 by Samuel Gompers** and other labor leaders.\n\nIf you mean the **American Football League (AFL)**, it was founded in **1959 by Lamar Hunt**.", "transcript": "Who founded the AFL?\n", "asr_s": 0.56, "expert_s": 4.11, "expert_input_samples": 24502, "expert_input_s": 1.531, "expert_input_sha256": "02f39c73dbb55f22645df4e7bc7ebaae46a1a9a0490bff07ca5b6cf8ed2a7e89", "expert_timed_out": false, "wait_s": 3.679, "relay_synth_ms": 8633, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0236_aggressive_relay.wav", "sha256": "a31eb81daaf04d0733ee8df03bf600f9d9159b979f6a07667b515e4884a82004", "sr": 24000, "seconds": 14.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0236_aggressive_candidate.wav", "sha256": "a9e0893f650f6054d67fb3370458d3e40c78d5c277fba00743de4a0a17c08cac",