{"id": "swebq0018", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 776004183, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what drugs lindsay lohan abuse?", "input_path": "/data/bench_audio/swebq0018.wav", "input_sha256": "993b3d531681888957305179b2f1a806050b71c3debbf3c40142ed11deb4bdf4", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.7346, "act": 0.9984, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Lindsay Lohan has publicly struggled with alcohol and substance abuse, and her widely reported/legal issues have included cocaine use. She has also spoken about using prescription medications, including Adderall and Ambien. So the commonly reported substances are: alcohol, cocaine, and some prescription drugs.", "expert_answer": "Lindsay Lohan has publicly struggled with **alcohol and substance abuse**, and her widely reported/legal issues have included **cocaine use**. She has also spoken about using **prescription medications**, including **Adderall** and **Ambien**.\n\nSo the commonly reported substances are: **alcohol, cocaine, and some prescription drugs**.", "transcript": "What drugs Lindsay Lohan abuse?\n", "asr_s": 3.19, "expert_s": 2.77, "expert_input_samples": 34905, "expert_input_s": 2.182, "expert_input_sha256": "993b3d531681888957305179b2f1a806050b71c3debbf3c40142ed11deb4bdf4", "expert_timed_out": false, "wait_s": 3.071, "relay_synth_ms": 8237, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 2170, "feed_lag_sum_ms": 2170, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0018_aggressive_relay.wav", "sha256": "fa52eaa8716648b3a34