{"id": "swebq0007", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2816790151, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what country did gregor mendel live in?", "input_path": "/data/bench_audio/swebq0007.wav", "input_sha256": "de79baebafe044d7e803dd1323ef5bc27fe1c0cd6151034e36dbdc78aa0cc3fa", "input_samples": 32676, "input_s": 2.042, "n_real_chunks": 3, "score": 0.1951, "act": 0.9986, "is_info": true, "fired": false, "mode": "local", "answer": "Gregor Mendel lived in the Austrian Empire, which was part of Austria- Hungary at that time.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 6, "feed_lag_max_ms": 94, "feed_lag_sum_ms": 94, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0007_aggressive_local.wav", "sha256": "ec46a125e16a6112bddb83c4db8ce930283ba5d54ea9f5342e462ffa7308986e", "sr": 24000, "seconds": 5.32}}, "chunks": [[0, 1, 1.0, 1.071, 1.129, 1, 0, 0], [1, 1, 2.0, 2.075, 2.136, 1, 0, 0], [2, 1, 2.042, 2.209, 2.269, 1, 0, 0], [3, 0, 3.042, 3.115, 3.927, 0, 24000, 0], [4, 0, 4.042, 4.123, 4.925, 0, 24000, 0], [5, 0, 5.042, 5.126, 5.918, 0, 24000, 0], [6, 0, 6.042, 6.134, 6.772, 0, 24000, 0], [7, 0, 7.042, 7.132, 7.802, 0, 24000, 0], [8, 0, 8.042, 8.132, 8.508, 0, 7680, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.042, "last_real_feed_done": 2.209, "onset": 3.927, "gate_read_done": 3.927, "fire": null, "candidate_first_pcm": null, "st