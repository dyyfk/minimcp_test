 0, 0], [1, 1, 2.0, 2.076, 2.136, 1, 0, 0], [2, 1, 2.367, 2.443, 2.503, 1, 0, 0], [3, 0, 3.367, 3.444, 4.113, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.367, "last_real_feed_done": 2.443, "onset": 4.113, "gate_read_done": 4.114, "fire": 4.114, "candidate_first_pcm": 4.113, "stall_note": 4.115, "stall_first_pcm": 5.144, "local_first_pcm": null, "wait_start": 5.144, "expert_req": 4.114, "expert_resp": 5.792, "relay_synth_start": 5.793, "relay_first_pcm": 6.657, "relay_synth_end": 8.276, "first_any_pcm": 4.113, "first_answer_pcm": 6.657, "session_end": 8.424}, "ttfa_answer_s": 4.289, "ttfa_any_s": 1.746}
{"id": "swebq0120", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 175395729, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what was the government like in virginia colony?", "input_path": "/data/bench_audio/swebq0120.wav", "input_sha256": "060ecaa64cfe54449fb230fd55960b38e3c1cb3cd21668ba2bd52bb99234a428", "input_samples": 56453, "input_s": 3.528, "n_real_chunks": 4, "score": 0.7635, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Virginia Colony was governed as an English royal colony for much of its history. Its government included: A governor appointed by the English king , A Governor’s Council of wealthy colonial leaders , The House of Burgesses, an elected assembly created in 1619 The House of Burgesses was important because it was one of the first representative lawmaking bodies in English America. However, voting and officeholding were mostly limited to white male landowners, and the colony’s government was dominated by wealthy plantation owners.", "expert_answer": "The **Virginia Colony** was governed as an **English royal colony** for much of its history.\n\nIts government included:\n\n- A **governor** appointed by the English king\n- A **Governor’s Council** of wealthy colonial leaders\n- The **House of Burgesses**, an elected assembly created in **1619**\n\nThe House of Burgesses was important because it was one of the first representative lawmaking bodies in English America. However, voting and officeholding were mostly limited to **white male landowners**, and the colony’s government was dominated by wealthy plantation owners.", "transcript": "What was the government like in Virginia Colony?\n", "asr_s": 0.49, "expert_s": 3.4, "expert_input_samples": 56453, "expert_input_s": 3.528, "expert_input_sha256": "060ecaa64cfe54449fb230fd55960b38e3c1cb3cd21668ba2bd52bb99234a428", "expert_timed_out": false, "wait_s": 3.05, "relay_synth_ms": 20413, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_aggressive_relay.wav", "sha256": "f44a91a8511450874ed05528b3d1d06a17a801a48ceb920384898b3944187f57", "sr": 24000, "seconds": 35.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_aggressive_candidate.wav", "sha256": "fd516c7ffd38f5483c6269cdeb6d1de80b53f77a780bbd20e39704bd8ac021a3", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_aggressive_stall.wav", "sha256": "5c1b64f955234efabb8ffc726634de38369324d0bcba3e77d879814812d6b9af", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.132, 1, 0, 0], [1, 1, 2.0, 2.08, 2.145, 1, 0, 0], [2, 1, 3.0, 3.073, 3.131, 1, 0, 0], [3, 1, 3.528, 3.601, 4.243, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.528, "last_real_feed_done": 3.601, "onset": 4.243, "gate_read_done": 4.243, "fire": 4.243, "candidate_first_pcm": 4.243, "stall_note": 4.244, "stall_first_pcm": 5.078, "local_first_pcm": null, "wait_start": 5.078, "expert_req": 4.244, "expert_resp": 8.128, "relay_synth_start": 8.129, "relay_first_pcm": 8.968, "relay_synth_end": 28.542, "first_any_pcm": 4.243, "first_answer_pcm": 8.968, "session_end": 28.766}, "ttfa_answer_s": 5.44, "ttfa_any_s": 0.715}
{"id": "swebq0129", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1940450101, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "who is the arizona cardinals backup quarterback?", "input_path": "/data/bench_audio/swebq0129.wav", "input_sha256": "59a4e5b526e53de955771925c9b8f460065925925fa8c98029e1f8a61e277935", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.9199, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Arizona Cardinals’ backup quarterback is Gardner Minshew II. He’s listed second behind Jacoby Brissett on the team’s official depth chart. (azcardinals.com)", "expert_answer": "The Arizona Cardinals’ backup quarterback is **Gardner Minshew II**. He’s listed second behind **Jacoby Brissett** on the team’s official depth chart. ([azcardinals.com](https://www.azcardinals.com/team/depth-chart))", "transcript": "Who is the Arizona Cardinals backup quarterback?\n", "asr_s": 0.61, "expert_s": 5.78, "expert_input_samples": 45307, "expert_input_s": 2.832, "expert_input_sha256": "59a4e5b526e53de955771925c9b8f460065925925fa8c98029e1f8a61e277935", "expert_timed_out": false, "wait_s": 5.363, "relay_synth_ms": 5873, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0129_aggressive_relay.wav", "sha256": "11676bd069ea7fd6257817ea214ea81665ce810311a3a4a15ad02eb86162bccb", "sr": 24000, "seconds": 9.96}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0129_aggressive_candidate.wav", "sha256": "a16203e492c2256136bede59ce0640fc201685abb2972264c5acac1245fd