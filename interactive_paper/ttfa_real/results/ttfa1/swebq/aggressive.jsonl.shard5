2.0, 2.077, 2.137, 1, 0, 0], [2, 1, 2.182, 2.257, 2.318, 1, 0, 0], [3, 0, 3.182, 3.259, 3.948, 0, 24000, 0], [4, 0, 4.182, 5.17, 5.89, 0, 24000, 0], [5, 0, 5.182, 5.962, 6.601, 0, 24000, 0], [6, 0, 6.182, 6.682, 7.405, 0, 24000, 0], [7, 0, 7.182, 7.481, 8.238, 0, 24000, 0], [8, 0, 8.182, 8.315, 9.109, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.182, "last_real_feed_done": 2.257, "onset": 3.948, "gate_read_done": 3.948, "fire": 3.948, "candidate_first_pcm": 3.948, "stall_note": 3.949, "stall_first_pcm": 5.086, "local_first_pcm": null, "wait_start": 9.109, "expert_req": 3.949, "expert_resp": 6.392, "relay_synth_start": 9.109, "relay_first_pcm": 9.961, "relay_synth_end": 12.739, "first_any_pcm": 3.948, "first_answer_pcm": 9.961, "session_end": 12.891}, "ttfa_answer_s": 7.779, "ttfa_any_s": 1.766}
{"id": "swebq0048", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1396119058, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "where does greek language come from?", "input_path": "/data/bench_audio/swebq0048.wav", "input_sha256": "0bec9aa61b7853b1972a1a3a3633f38420cff33a6dfa29fb623b001cfbfe47b7", "input_samples": 37877, "input_s": 2.367, "n_real_chunks": 3, "score": 0.6264, "act": 0.997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Greek language comes from the Indo-European language family. More specifically, it developed from Proto-Greek, which likely emerged in the southern Balkans/Greece region after Indo-European-speaking peoples moved into the area around the late 3rd to early 2nd millennium BCE. The earliest written form is Mycenaean Greek, recorded in Linear B tablets from about 1450–1200 BCE. So, in short: Greek is an Indo-European language that developed in ancient Greece from Proto-Greek.", "expert_answer": "The **Greek language** comes from the **Indo-European language family**.\n\nMore specifically, it developed from **Proto-Greek**, which likely emerged in the **southern Balkans/Greece region** after Indo-European-speaking peoples moved into the area around the **late 3rd to early 2nd millennium BCE**. The earliest written form is **Mycenaean Greek**, recorded in **Linear B** tablets from about **1450–1200 BCE**.\n\nSo, in short: **Greek is an Indo-European language that developed in ancient Greece from Proto-Greek.**", "transcript": "Where does Greek language come from?\n", "asr_s": 0.37, "expert_s": 3.49, "expert_input_samples": 37877, "expert_input_s": 2.367, "expert_input_sha256": "0bec9aa61b7853b1972a1a3a3633f38420cff33a6dfa29fb623b001cfbfe47b7", "expert_timed_out": false, "wait_s": 2.56, "relay_synth_ms": 17555, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 375, "feed_lag_sum_ms": 375, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_aggressive_relay.wav", "sha256": "b1007c72e2bf422da53d7a73d4acc1e02e91c0003f0008d5af8bbb5da49a71dc", "sr": 24000, "seconds": 30.24}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_aggressive_candidate.wav", "sha256": "d7de7e9f07e45d1ef0fc163a7b4b824edbba2e319708c82c03a12c95acab57cf", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_aggressive_stall.wav", "sha256": "ecfe3156fac6947c65db4a83bba670642825e7d16cf5ac74d4deeb4ff86b88c9", "sr": 24000, "seconds": 2.24}}, "chunks": [[0, 1, 1.0, 1.071, 1.129, 1, 0, 0], [1, 1, 2.0, 2.073, 2.131, 1, 0, 0], [2, 1, 2.367, 2.44, 2.497, 1, 0, 0], [3, 0, 3.367, 3.442, 4.116, 0, 24000, 0], [4, 0, 4.367, 4.815, 5.416, 0, 29760, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.367, "last_real_feed_done": 2.44, "onset": 4.116, "gate_read_done": 4.117, "fire": 4.117, "candidate_first_pcm": 4.116, "stall_note": 4.118, "stall_first_pcm": 4.742, "local_first_pcm": null, "wait_start": 5.416, "expert_req": 4.117, "expert_resp": 7.976, "relay_synth_start": 7.977, "relay_first_pcm": 8.826, "relay_synth_end": 25.533, "first_any_pcm": 4.116, "first_answer_pcm": 8.826, "session_end": 25.929}, "ttfa_answer_s": 6.458, "ttfa_any_s": 1.749}
{"id": "swebq0057", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3667081922, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what channel is the usa pageant on?", "input_path": "/data/bench_audio/swebq0057.wav", "input_sha256": "1e389adaee4eb8c060654b9f93519531c7910e69e1042c954ce54da4d4a55815", "input_samples": 49765, "input_s": 3.11, "n_real_chunks": 4, "score": 0.9183, "act": 0.9988, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The 2026 Miss USA pageant is not on a TV channel. It was dropped by The CW and is streaming on QBN — The Queen Beauty Network instead. (justjared.com)", "expert_answer": "The **2026 Miss USA pageant is not on a TV channel**. It was dropped by **The CW** and is streaming on **QBN — The Queen Beauty Network** instead. ([justjared.com](https://www.justjared.com/2026/08/21/miss-usa-dropped-by-the-cw-just-one-week-before-pageant-new-streaming-details-revealed/?utm_source=openai))", "transcript": "What channel is the USA pageant on?\n", "asr_s": 0.5, "expert_s": 4.68, "expert_input_samples": 49765, "expert_input_s": 3.11, "expert_input_sha256": "1e389adaee4eb8c060654b9f93519531c7910e69e1042c954ce54da4d4a55815", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 7057, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 22, "feed_lag_max_ms": 688, "feed_lag_sum_ms": 1567, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0057_aggressive_relay.wav", "sha256": "8ed9188b2b3ad451441e38db269c9d7420108003ebc84669a37730d10547bfbb", "sr": 24000, "seconds": 12.04}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0057_aggressive_candidate.wav", "sha256": "ced