{"id": "swebq0102", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3595325503, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "who was king after leonidas died?", "input_path": "/data/bench_audio/swebq0102.wav", "input_sha256": "52b2f17e5888906d09a582ffd3497c93fb4748ca4b679f71fa7cae4963c44525", "input_samples": 33419, "input_s": 2.089, "n_real_chunks": 3, "score": 0.7056, "act": 0.9981, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "After King Leonidas I died at Thermopylae in 480 BCE, his son Pleistarchus became king of Sparta. Because Pleistarchus was still a child, Pausanias, Leonidas’s nephew, served as regent.", "expert_answer": "After **King Leonidas I** died at Thermopylae in **480 BCE**, his son **Pleistarchus** became king of Sparta.\n\nBecause Pleistarchus was still a child, **Pausanias**, Leonidas’s nephew, served as regent.", "transcript": "Who was king after Leonidas died?\n", "asr_s": 0.48, "expert_s": 3.34, "expert_input_samples": 33419, "expert_input_s": 2.089, "expert_input_sha256": "52b2f17e5888906d09a582ffd3497c93fb4748ca4b679f71fa7cae4963c44525", "expert_timed_out": false, "wait_s": 2.321, "relay_synth_ms": 8661, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 464, "feed_lag_sum_ms": 513, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0102_aggressive_relay.wav", "sha256": "384f0101de705f49299c7efc93a9579eec9029144162905f82431e8e1515f825", "sr": 24000, "seconds": 14.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0102_aggressive_candidate.wav", "sha256": "bea7c937573294d68886eba04711089b9d7989f714ec81d47ca658a877b857a1", "sr":