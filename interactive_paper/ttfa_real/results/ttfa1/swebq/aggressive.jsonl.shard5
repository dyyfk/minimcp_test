{"id": "swebq0015", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1358012138, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "where is the scottish house in skyfall?", "input_path": "/data/bench_audio/swebq0015.wav", "input_sha256": "87c6d6a42d1d1599945b15271f17f9c1f9f618c02ee684f4e666f5b176f2d835", "input_samples": 31190, "input_s": 1.949, "n_real_chunks": 2, "score": 0.7618, "act": 0.9988, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Scottish house in Skyfall is Skyfall Lodge, James Bond’s fictional family estate in the Scottish Highlands, near Glen Coe/Glen Etive in the story. In real life, the house itself was not in Scotland: the exterior was a temporary set built on Hankley Common, near Elstead in Surrey, England, and then destroyed for the film.", "expert_answer": "The Scottish house in **_Skyfall_** is **Skyfall Lodge**, James Bond’s fictional family estate in the **Scottish Highlands**, near **Glen Coe/Glen Etive** in the story.\n\nIn real life, the house itself **was not in Scotland**: the exterior was a temporary set built on **Hankley Common, near Elstead in Surrey, England**, and then destroyed for the film.", "transcript": "Where is the Scottish House in Skyfall?\n", "asr_s": 3.14, "expert_s": 5.62, "expert_input_samples": 31190, "expert_input_s": 1.949, "expert_input_sha256": "87c6d6a42d1d1599945b15271f17f9c1f9f618c02ee684f4e666f5b176f2d835", "expert_timed_out": false, "wait_s": 5.442, "relay_synth_ms": 13408, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0015_aggressiv