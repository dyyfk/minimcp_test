{"id": "swebq0227", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2522249323, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what languages do people speak in spain?", "input_path": "/data/bench_audio/swebq0227.wav", "input_sha256": "880f853a00dd17af87026cbaff186c5234fc694f6bf5b0ac1cd8408c42a1c5c8", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.436, "act": 0.9967, "is_info": true, "fired": false, "mode": "local", "answer": "In Spain, people mainly speak Spanish. It is called Cast iliano in Spain. But there are also many other languages spoken, especially in different regions. For example, in the north, you might hear Bas que or Galician. In some areas near France, they speak Catalan. So while Spanish is the main language used everywhere, there are lots of regional languages too.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 15, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0227_local_local.wav", "sha256": "439abddc3b1ef2232b1ed78e8919df6ecf602fbb3c06e31ecb7d9335be59ac98", "sr": 24000, "seconds": 14.36}}, "chunks": [[0, 1, 1.0, 1.055, 1.098, 1, 0, 0], [1, 1, 2.0, 2.055, 2.098, 1, 0, 0], [2, 1, 2.832, 2.89, 2.938, 1, 0, 0], [3, 0, 3.832, 3.895, 4.024, 0, 0, 0], [4, 0, 4.832, 4.894, 5.422, 0, 24000, 0], [5, 0, 5.832, 5.894, 6.472, 0, 24000, 0], [6, 0, 6.832, 6.895, 7.427, 0, 24000, 0], [7, 0, 7.832, 7.895, 8.495, 0, 24000, 0], [8, 0, 8.832, 8.894, 9.481, 0, 24000, 0], [9, 0, 9.832, 9.894, 10.455, 0, 24000, 0], [10, 0, 10.832, 10.894, 11.397, 0, 24000, 0], [11, 0, 11.832, 11.898, 12.427, 0, 24000, 0], [12, 0, 12.832, 12.895, 13.452, 0, 24000, 0], [13, 0, 13.832, 13.899, 14.508, 0, 24000, 0], [14, 0, 14.832, 14.896, 15.511, 0, 24000, 0], [15, 0, 15.832, 15.893, 16.551, 0, 24000, 0], [16, 0, 16.832, 16.895, 17.626, 0, 24000, 0], [17, 0, 17.832, 17.896, 18.674, 0, 32640, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.832, "last_real_feed_done": 2.89, "onset": 4.024, "gate_read_done": 4.024, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 5.422, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 5.422, "first_answer_pcm": 5.422, "session_end": 18.674}, "ttfa_answer_s": 2.591, "ttfa_any_s": 2.591}
{"id": "swebq0237", "pool": "swebq", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2404206890, "protocol": "ttfa-v3", "config_sha256": "3d4d39fcc4a346fd8580c0316523f086cfbea87a1efa8a46667c283f61f94b66", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where did russians originate?", "input_path": "/data/bench_audio/swebq0237.wav", "input_sha256": "d2754fccde65bb6b545dfa2e1c70c2b53d9919b0d3b957e71fc0562014755c1f", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.7397, "act": 0.9964, "is_info": true, "fired": false, "mode": "local", "answer": "So the origins of Russians is actually a bit complex. It's not just one single origin, but rather a mix of different groups that have come together over time. The Russian people today are primarily descended from various Slavic tribes who lived in what is now Russia, Ukraine, and Belar us. These tribes include things like the Rus' people, who were among the first to form a unified state called K yivan Rus'. Over centuries, these groups inter married with other peoples such as Finno- Ugric communities, Tatar s, and even some Norse settlers during the Viking age. So while there isn't a single ancestral group, it's more of a blend of Slavic roots combined with influences from neighboring culture s shaped by history and migration.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 41, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0237_local_local.wav", "sha256": "fe04d5e8762c81bd3be482719001f7cab8d99632c67be72b1e68ef70a8155418", "sr