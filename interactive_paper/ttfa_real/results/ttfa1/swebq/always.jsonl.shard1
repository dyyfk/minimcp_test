{"id": "swebq0221", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2134236510, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who was queen victoria's husband?", "input_path": "/data/bench_audio/swebq0221.wav", "input_sha256": "d730b270b3145d21f8760534fa365b2204da64cc7538ba5e4a0329d06fc60ed4", "input_samples": 31190, "input_s": 1.949, "n_real_chunks": 2, "score": 0.1995, "act": 0.9994, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Queen Victoria’s husband was Prince Albert of Saxe-Coburg and Gotha.", "expert_answer": "Queen Victoria’s husband was **Prince Albert of Saxe-Coburg and Gotha**.", "transcript": "Who was Queen Victoria's husband?\n", "asr_s": 0.84, "expert_s": 1.42, "expert_input_samples": 31190, "expert_input_s": 1.949, "expert_input_sha256": "d730b270b3145d21f8760534fa365b2204da64cc7538ba5e4a0329d06fc60ed4", "expert_timed_out": false, "wait_s": 1.074, "relay_synth_ms": 2290, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 202, "feed_lag_sum_ms": 202, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0221_always_relay.wav", "sha256": "63eed55cf6f0a554d4212723cb0d4a78e070980ed404460a6076c6e9b01ccc16", "sr": 24000, "seconds": 4.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0221_always_candidate.wav", "sha256": "e4759bfc2c13453c2efc4e7b7f921ac5e0ba12c729012bbc87f12c899d86ff5a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0221_always_stall.wav", "sha256": "03949a171a77e886d6a65cdb06397877fce7b3fb2aca9678ecc9487d3db23074", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.058, 1.103, 1, 0, 0], [1, 1, 1.949, 2.