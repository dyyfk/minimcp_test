{"id": "swebq0107", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2787550384, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where english is spoken?", "input_path": "/data/bench_audio/swebq0107.wav", "input_sha256": "9ea5de70fdcda40125712dbffbe96b7d01f69f4be9a98b111cc7af1165a040ba", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.7582, "act": 0.9884, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "English is spoken worldwide, especially in countries such as: United States , United Kingdom , Canada , Australia , New Zealand , Ireland It is also widely used as an official or second language in countries like India, Singapore, Nigeria, South Africa, and the Philippines.", "expert_answer": "English is spoken **worldwide**, especially in countries such as:\n\n- **United States**\n- **United Kingdom**\n- **Canada**\n- **Australia**\n- **New Zealand**\n- **Ireland**\n\nIt is also widely used as an official or second language in countries like **India, Singapore, Nigeria, South Africa, and the Philippines**.", "transcript": "Where English is spoken.\n", "asr_s": 0.87, "expert_s": 3.09, "expert_input_samples": 28960, "expert_input_s": 1.81, "expert_input_sha256": "9ea5de70fdcda40125712dbffbe96b7d01f69f4be9a98b111cc7af1165a040ba", "expert_timed_out": false, "wait_s": 3.372, "relay_synth_ms": 11005, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0107_always_relay.wav", "sha256": "d6f784d438e72889d847d4e3c467ee90e54add1fbe5c27566466b174b9ce5d58", "sr": 24000, "seconds": 28.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0107_always_candidate.wav", "sha256": "491bc04b06819fe56f0f236a2fd6cf6836d5d3e435ef08b849991b890293a3b5", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0107_always_stall.wav", "sha256": "4c9cd3fbffc027e56ff5d95ae992ec05419de2027bc519b6b1d5140ef8e36706", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.053, 1.095, 1, 0, 0], [1, 1, 1.81, 1.864, 1.907, 1, 0, 0], [2, 0, 2.81, 2.865, 2.908, 1, 0, 0], [3, 0, 3.81, 3.865, 4.391, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.81, "last_real_feed_done": 1.864, "onset": 4.391, "gate_read_done": 4.392, "fire": 4.392, "candidate_first_pcm": 4.391, "stall_note": 4.392, "stall_first_pcm": 4.985, "local_first_pcm": null, "wait_start": 4.985, "expert_req": 4.392, "expert_resp": 8.357, "relay_synth_start": 8.357, "relay_first_pcm": 8.956, "relay_synth_end": 19.363, "first_any_pcm": 4.391, "first_answer_pcm": 8.956, "session_end": 19.508}, "ttfa_answer_s": 7.146, "ttfa_any_s": 2.581}
{"id": "swebq0116", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3359286631, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who did john kennedy have affairs with?", "input_path": "/data/bench_audio/swebq0116.wav", "input_sha256": "48392299c64addfa189daf9323aabe784f7a1f1912dac6fa43063282212cc62d", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.7738, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "John F. Kennedy was widely reported to have had extramarital affairs with several women. Many claims about Kennedy’s affairs vary in reliability, ranging from firsthand memoirs to rumor and later biographical reporting.", "expert_answer": "John F. Kennedy was widely reported to have had extramarital affairs with several women. The best-known alleged or documented partners include:\n\n- **Marilyn Monroe** — actress; alleged affair, much discussed but not definitively documented.\n- **Judith Campbell Exner** — claimed she had an affair with Kennedy while also linked to Mafia figures.\n- **Mimi Alford** — former White House intern who later wrote that she had an affair with Kennedy.\n- **Mary Pinchot Meyer** — socialite and artist; often reported as one of Kennedy’s lovers.\n- **Gunilla von Post** — Swedish aristocrat who said she had a romantic relationship with him.\n- **Inga Arvad** — Danish journalist linked romantically to Kennedy before his presidency.\n- **Ellen Rometsch** — alleged affair; became politically sensitive because of security concerns.\n- **Pamela Turnure** — Jackie Kennedy’s press secretary; alleged by some accounts.\n\nMany claims about Kennedy’s affairs vary in reliability, ranging from firsthand memoirs to rumor and later biographical reporting.", "transcript": "Who did John Kennedy have affairs with?\n", "asr_s": 0.6, "expert_s": 6.16, "expert_input_samples": 40106, "expert_input_s": 2.507, "expert_input_sha256": "48392299c64addfa189daf9323aabe784f7a1f1912dac6fa43063282212cc62d", "expert_timed_out": false, "wait_s": 5.811, "relay_synth_ms": 5849, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_always_relay.wav", "sha256": "8130c4979e34e48685f714a8ddac495c898e696e4b951f7f9684b64cd2fd5868", "sr": 24000, "seconds": 13.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_always_candidate.wav", "sha256": "13d7b86ab7a28d5a9c5886ec04c75c899f3c01175c10714b37cf5aef7dd717ff", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_always_stall.wav", "sha256": "bbb240fcdb5786dd1f99f4029b17eb619eb626b3ec55c1247826bf4385331991", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.054, 1.097, 1, 0, 0], [1, 1, 2.0, 2.057, 2.102, 1, 0, 0], [2, 1, 2.507, 2.564, 2.609, 1, 0, 0], [3, 0, 3.507, 3.562, 4.061, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.507, "last_real_feed_done": 2.564, "onset": 4.061, "gate_read_done": 4.062, "fire": 4.062, "candidate_first_pcm": 4.061, "stall_note": 4.062, "stall_first_pcm": 5.019, "local_first_pcm": null, "wait_start": 5.019, "expert_req": 4.062, "expert_resp": 10.83, "relay_synth_start": 10.83, "relay_first_pcm": 11.455, "relay_synth_end": 16.68, "first_any_pcm": 4.061, "first_answer_pcm": 11.455, "session_end": 16.798}, "ttfa_answer_s": 8.948, "ttfa_any_s": 1.555}
{"id": "swebq0124", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 219781000, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what countries have territories in oceania?", "input_path": "/data/bench_audio/swebq0124.wav", "input_sha256": "f9263489e6686f682d6d2a0d877b455e8e3919ed1f3b6bd213a70e960198a638", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.7006, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Countries with territory in Oceania include both sovereign Oceanian states and non-Oceanian countries that administer territories there.", "expert_answer": "Countries with **territory in Oceania** include both **sovereign Oceanian states** and **non-Oceanian countries that administer territories there**.\n\n### Sovereign countries in Oceania\n- Australia\n- New Zealand\n- Papua New Guinea\n- Fiji\n- Solomon Islands\n- Vanuatu\n- Samoa\n- Tonga\n- Kiribati\n- Tuvalu\n- Nauru\n- Palau\n- Marshall Islands\n- Federated States of Micronesia\n\n### Countries partly in Oceania or with Oceanian regions\n- **Indonesia** — western New Guinea is commonly considered part of Oceania\n- **United States** — Hawaii, Guam, American Samoa, Northern Mariana Islands, etc.\n- **France** — French Polynesia, New Caledonia, Wallis and Futuna\n- **United Kingdom** — Pitcairn Islands\n- **Chile** — Easter Island / Rapa Nui, often grouped with Polynesia\n- **Japan** — sometimes included via the Bonin/Ogasawara Islands, depending on definition\n\nSo, under a broad geographic definition, the countries are:\n\n**Australia, New Zealand, Papua New Guinea, Fiji, Solomon Islands, Vanuatu, Samoa, Tonga, Kiribati, Tuvalu, Nauru, Palau, Marshall Islands, Federated States of Micronesia, Indonesia, United States, France, United Kingdom, Chile, and sometimes Japan.**", "transcript": "What countries have territories in Oceania?\n", "asr_s": 0.55, "expert_s": 7.74, "expert_input_samples": 37134, "expert_input_s": 2.321, "expert_input_sha256": "f9263489e6686f682d6d2a0d877b455e8e3919ed1f3b6bd213a70e960198a638", "expert_timed_out": false, "wait_s": 7.396, "relay_synth_ms": 3598, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_always_relay.wav", "sha256": "ffc66bc4ef0f7daee86fe64038c5904587d991feb380fdd4ecbb07d0605b3e68", "sr": 24000, "seconds": 8.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_always_candidate.wav", "sha256": "a64e4eafc3bfdde4e20546eed9cb8fb2eaa2133e4fece1c630847a438a604497", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_always_stall.wav", "sha256": "446f73a45f1f2036b2235aa249380bd64eafc1f8d67387d4e4e6a9ba9e917a48", "sr": 24000, "seconds": 1.32}}, "chunks": [[0, 1, 1.0, 1.053, 1.095, 1, 0, 0], [1, 1, 2.0, 2.055, 2.097, 1, 0, 0], [2, 1, 2.321, 2.375, 2.417, 1, 0, 0], [3, 0, 3.321, 3.375, 3.699, 0, 24000, 0], [4, 0, 4.321, 4.376, 4.597, 0, 7680, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.321, "last_real_feed_done": 2.375, "onset": 3.699, "gate_read_done": 3.7, "fire": 3.7, "candidate_first_pcm": 3.699, "stall_note": 3.7, "stall_first_pcm": 4.164, "local_first_pcm": null, "wait_start": 4.597, "expert_req": 3.7, "expert_resp": 11.993, "relay_synth_start": 11.994, "relay_first_pcm": 12.615, "relay_synth_end": 15.593, "first_any_pcm": 3.699, "first_answer_pcm": 12.615, "session_end": 16.306}, "ttfa_answer_s": 10.294, "ttfa_any_s": 1.379}
{"id": "swebq0133", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2321953642, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where was st peter killed?", "input_path": "/data/bench_audio/swebq0133.wav", "input_sha256": "ed9f4705a7ad9244baf8f351e95915dec1843e3665ebc0896e3f715c225cb500", "input_samples": 24502, "input_s": 1.531, "n_real_chunks": 2, "score": 0.6642, "act": 0.9963, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "St. Peter was traditionally killed in Rome, specifically by crucifixion in the area of Nero’s Circus on the Vatican Hill.", "expert_answer": "St. Peter was traditionally killed in **Rome**, specifically by crucifixion in the area of **Nero’s Circus** on the Vatican Hill.", "transcript": "Where was St Peter killed?\n", "asr_s": 0.62, "expert_s": 1.86, "expert_input_samples": 24502, "expert_input_s": 1.531, "expert_input_sha256": "ed9f4705a7ad9244baf8f351e95915dec1843e3665ebc0896e3f715c225cb500", "expert_timed_out": false, "wait_s": 1.225, "relay_synth_ms": 3647, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 98, "feed_lag_sum_ms": 98, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0133_always_relay.wav", "sha256": "a7b01de860a6af18ef9297bf60ef9b0ac9b477fb1907f3a1a9bf31f78a0da919", "sr": 24000, "seconds": 8.96}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0133_always_candidate.wav", "sha256": "8c14df8cba41e4767d56f7a4812de1e42ee872f68d0390e4cd5ec6234dd83837", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0133_always_stall.wav", "sha256": "30a9d9a190ac2144d8cbee8a469aeb9833130f76b99ae90bbf9ba07ca096ffdc", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.056, 1.101, 1, 0, 0], [1, 1, 1.531, 1.586, 1.629, 1, 0, 0], [2, 0, 2.531, 2.589, 2.633, 1, 0, 0], [3, 0, 3.531, 3.589, 4.042, 0, 24000, 0], [4, 0, 4.531, 4.691, 5.298, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.531, "last_real_feed_done": 1.586, "onset": 4.042, "gate_read_done": 4.042, "fire": 4.042, "candidate_first_pcm": 4.042, "stall_note": 4.042, "stall_first_pcm": 4.63, "local_first_pcm": null, "wait_start": 5.298, "expert_req": 4.042, "expert_resp": 6.523, "relay_synth_start": 6.523, "relay_first_pcm": 7.124, "relay_synth_end": 10.171, "first_any_pcm": 4.042, "first_answer_pcm": 7.124, "session_end": 10.28}, "ttfa_answer_s": 5.592, "ttfa_any_s": 2.51}
{"id": "swebq0142", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2988479803, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what inspired michelangelo buonarroti?", "input_path": "/data/bench_audio/swebq0142.wav", "input_sha256": "5693a5d60e7e0d5059f19754a1e8b025fb308b19db977d11950dc95477a2f08f", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.483, "act": 0.9988, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Michelangelo Buonarroti was inspired by several major influences: Classical Greek and Roman art — especially ancient sculpture, anatomy, idealized bodies, and heroic forms. , The human body — he studied anatomy closely and saw the body as a powerful expression of beauty, emotion, and spirit. , Christian faith and the Bible — many of his greatest works, such as the Sistine Chapel ceiling and The.", "expert_answer": "Michelangelo Buonarroti was inspired by several major influences:\n\n- **Classical Greek and Roman art** — especially ancient sculpture, anatomy, idealized bodies, and heroic forms.\n- **The human body** — he studied anatomy closely and saw the body as a powerful expression of beauty, emotion, and spirit.\n- **Christian faith and the Bible** — many of his greatest works, such as the *Sistine Chapel ceiling* and *The Last Judgment*, were inspired by biblical themes.\n- **Renaissance humanism** — the idea that human beings had dignity, creative power, and intellectual potential.\n- **Earlier artists**, especially **Donatello, Giotto, Masaccio**, and classical sculptors.\n- **Neoplatonism** — the belief that physical beauty could reflect divine beauty.\n\nIn short, Michelangelo was inspired by **ancient classical art, Christian spirituality, and the Renaissance belief in the greatness of humanity**.", "transcript": "What inspired Michelangelo Buonarroti?\n", "asr_s": 0.56, "expert_s": 4.36, "expert_input_samples": 34162, "expert_input_s": 2.135, "expert_input_sha256": "5693a5d60e7e0d5059f19754a1e8b025fb308b19db977d11950dc95477a2f08f", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 11097, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 18, "feed_lag_max_ms": 148, "feed_lag_sum_ms": 148, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0142_always_relay.wav", "sha256": "a517fcfe0a4f061bcfd36d7d50c1a4356237bfc0a4431eac92218f7a76448ff7", "sr": 24000, "seconds": 26.64}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0142_always_candidate.wav", "sha256": "c1532881fdd9fa05bcd0121a673d9ac94dd168e8cc3235168a3c36b76c1c5f44", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0142_always_stall.wav", "sha256": "c128613e7f97d7159ac3ed01096fd7ea814048ebc6aefee153a328907a3dd577", "sr": 24000, "seconds": 19.28}}, "chunks": [[0, 1, 1.0, 1.053, 1.097, 1, 0, 0], [1, 1, 2.0, 2.054, 2.097, 1, 0, 0], [2, 1, 2.135, 2.187, 2.23, 1, 0, 0], [3, 0, 3.135, 3.19, 3.719, 0, 24000, 0], [4, 0, 4.135, 4.341, 4.808, 0, 24000, 0], [5, 0, 5.135, 5.189, 5.701, 0, 24000, 0], [6, 0, 6.135, 6.19, 6.651, 0, 24000, 0], [7, 0, 7.135, 7.194, 7.697, 0, 24000, 0], [8, 0, 8.135, 8.194, 8.753, 0, 24000, 0], [9, 0, 9.135, 9.199, 9.709, 0, 24000, 0], [10, 0, 10.135, 10.194, 10.703, 0, 24000, 0], [11, 0, 11.135, 11.194, 11.724, 0, 24000, 0], [12, 0, 12.135, 12.192, 12.71, 0, 24000, 0], [13, 0, 13.135, 13.193, 13.736, 0, 24000, 0], [14, 0, 14.135, 14.193, 14.78, 0, 24000, 0], [15, 0, 15.135, 15.196, 15.726, 0, 24000, 0], [16, 0, 16.135, 16.195, 16.726, 0, 24000, 0], [17, 0, 17.135, 17.195, 17.676, 0, 24000, 0], [18, 0, 18.135, 18.193, 18.874, 0, 24000, 0], [19, 0, 19.135, 19.194, 19.947, 0, 24000, 0], [20, 0, 20.135,