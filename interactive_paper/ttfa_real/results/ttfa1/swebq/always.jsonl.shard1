22)\n\nHe’s also well known for TV roles, especially **Dr. Eric Foreman on _House_**.", "transcript": "What movies is Omar Epps in?\n", "asr_s": 2.82, "expert_s": 5.83, "expert_input_samples": 31190, "expert_input_s": 1.949, "expert_input_sha256": "bff9d88af3865850a90810116df0b104495a1c54d7d21bb01c93931ed9d0c690", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 35826, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 20, "feed_lag_max_ms": 1989, "feed_lag_sum_ms": 6204, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0001_always_relay.wav", "sha256": "b028cb60868d49e057329352d28f843fa6b6173372776b3666bdda76d51a2fea", "sr": 24000, "seconds": 85.72}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0001_always_candidate.wav", "sha256": "acc1d40077b7de3a22a993a068b55e76203a4b6b2bb58630283aba9e97ed3aeb", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0001_always_stall.wav", "sha256": "2aa7e1c36ce1807fa9ee591bd69024d924ab851beff7f1b32b0a252a6c1197e6", "sr": 24000, "seconds": 21.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 1.949, 2.004, 2.046, 1, 0, 0], [2, 0, 2.949, 3.004, 3.047, 1, 0, 0], [3, 0, 3.949, 4.004, 4.571, 0, 24000, 0], [4, 0, 4.949, 7.018, 7.615, 0, 24000, 0], [5, 0, 5.949, 7.679, 8.221, 0, 24000, 0], [6, 0, 6.949, 8.277, 8.767, 0, 24000, 0], [7, 0, 7.949, 8.83, 9.359, 0, 24000, 0], [8, 0, 8.949, 9.429, 10.002, 0, 24000, 0], [9, 0, 9.949, 10.062, 10.566, 0, 24000, 0], [10, 0, 10.949, 11.009, 11.545, 0, 24000, 0], [11, 0, 11.949, 12.01, 12.528, 0, 24000, 0], [12, 0, 12.949, 13.01, 13.725, 0, 24000, 0], [13, 0, 13.949, 14.006, 14.454, 0, 24000, 0], [14, 0, 14.949, 15.012, 15.455, 0, 24000, 0], [15, 0, 15.949, 16.009, 16.519, 0, 24000, 0], [16, 0, 16.949, 17.008, 17.499, 0, 24000, 0], [17, 0, 17.949, 18.008, 18.528, 0, 24000, 0], [18, 0, 18.949, 19.009, 19.599, 0, 24000, 0], [19, 0, 19.949, 20.014, 20.694, 0, 24000, 0], [20, 0, 20.949, 21.014, 21.508, 