{"id": "swebq0019", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1497879233, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what kind of language do egyptian speak?", "input_path": "/data/bench_audio/swebq0019.wav", "input_sha256": "303659d41d4a6d007efaca4f02e623cf17dab459ed9309457de92882900de37f", "input_samples": 33419, "input_s": 2.089, "n_real_chunks": 3, "score": 0.4714, "act": 0.9979, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Egyptians mainly speak Egyptian Arabic (a dialect of Arabic). In formal settings—like news, education, and government—they also use Modern Standard Arabic. Historically, ancient Egyptians spoke the Egyptian language, whose last stage was Coptic, still used liturgically by the Coptic Orthodox Church.", "expert_answer": "Egyptians mainly speak **Egyptian Arabic** (a dialect of Arabic).  \n\nIn formal settings—like news, education, and government—they also use **Modern Standard Arabic**. Historically, ancient Egyptians spoke the **Egyptian language**, whose last stage was **Coptic**, still used liturgically by the Coptic Orthodox Church.", "transcript": "What kind of language do Egyptians speak?\n", "asr_s": 0.59, "expert_s": 2.0, "expert_input_samples": 33419, "expert_input_s": 2.089, "expert_input_sha256": "303659d41d4a6d007efaca4f02e623cf17dab459ed9309457de92882900de37f", "expert_timed_out": false, "wait_s": 1.119, "relay_synth_ms": 10118, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 332, "feed_lag_sum_ms": 343, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0019_always_relay.wav", "sha256": "4eff9dfba8ab87d5265ba7b074ae9b77396ffbc5119456248692e2e