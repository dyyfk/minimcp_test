swebq0150_always_stall.wav", "sha256": "1aa986a0ef7e54dc1e25198046e84fb24f2063abe9bdb9e8621a1e003f9dfed3", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.057, 1.104, 1, 0, 0], [1, 1, 1.903, 1.962, 2.01, 1, 0, 0], [2, 0, 2.903, 2.965, 3.014, 1, 0, 0], [3, 0, 3.903, 3.968, 4.402, 0, 24000, 0], [4, 0, 4.903, 4.964, 5.615, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.903, "last_real_feed_done": 1.962, "onset": 4.402, "gate_read_done": 4.403, "fire": 4.403, "candidate_first_pcm": 4.402, "stall_note": 4.403, "stall_first_pcm": 4.901, "local_first_pcm": null, "wait_start": 5.615, "expert_req": 4.403, "expert_resp": 9.791, "relay_synth_start": 9.791, "relay_first_pcm": 10.428, "relay_synth_end": 13.774, "first_any_pcm": 4.402, "first_answer_pcm": 10.428, "session_end": 13.881}, "ttfa_answer_s": 8.525, "ttfa_any_s": 2.499}
{"id": "swebq0158", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1273908580, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what form of government do we have in the philippines?", "input_path": "/data/bench_audio/swebq0158.wav", "input_sha256": "cf00efdcf63d4e5ef8fe8216d03b00e3845e61e6d7f9a31dfd182d294e86eaa6", "input_samples": 40849, "input_s": 2.553, "n_real_chunks": 3, "score": 0.5514, "act": 0.9977, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Philippines has a democratic and republican form of government. More specifically, it is a presidential republic, where: the President is both head of state and head of government, leaders are chosen through elections, and , government power is divided among the executive, legislative, and judicial branches.", "expert_answer": "The Philippines has a **democratic and republican form of government**.\n\nMore specifically, it is a **presidential republic**, where:\n- the **President** is both head of state and head of government,\n- leaders are chosen through **elections**, and\n- government power is divided among the **executive, legislative, and judicial** branches.", "transcript": "What form of government do we have in the Philippines?\n", "asr_s": 0.54, "expert_s": 2.01, "expert_input_samples": 40849, "expert_input_s": 2.553, "expert_input_sha256": "cf00efdcf63d4e5ef8fe8216d03b00e3845e61e6d7f9a31dfd182d294e86eaa6", "expert_timed_out": false, "wait_s": 1.927, "relay_synth_ms": 7611, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0158_always_relay.wav", "sha256": "4219ef350270a22d82530ca743c47ce8c4276b06d486924ddf8fd35030a10367", "sr": 24000, "seconds": 17.92}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0158_always_candidate.wav", "sha256": "1e8594f8e77724e133f741ffc171dd43161d692b2a809b84b08ee031fcf81a1c", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0158_always_stall.wav", "sha256": "a64d4afab63cafaafe769a361182d245bcfb67d3ff7bf70d59eb7deaf4f9173f", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.055, 2.099, 1, 0, 0], [2, 1, 2.553, 2.609, 2.654, 1, 0, 0], [3, 0, 3.553, 3.61, 4.025, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.553, "last_real_feed_done": 2.609, "onset": 4.025, "gate_read_done": 4.025, "fire": 4.025, "candidate_first_pcm": 4.025, "stall_note": 4.026, "stall_first_pcm": 4.64, "local_first_pcm": null, "wait_start": 4.64, "expert_req": 4.026, "expert_resp": 6.568, "relay_synth_start": 6.568, "relay_first_pcm": 7.197, "relay_synth_end": 14.18, "first_any_pcm": 4.025, "first_answer_pcm": 7.197, "session_end": 14.307}, "ttfa_answer_s": 4.643, "ttfa_any_s": 1.472}
{"id": "swebq0166", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2272998304, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who were wright brothers?", "input_path": "/data/bench_audio/swebq0166.wav", "input_sha256": "0673597bd3864240bcd266fefca8d8f3ce178ad9954a3f6361777f941d8a5f46", "input_samples": 23016, "input_s": 1.438, "n_real_chunks": 2, "score": 0.3555, "act": 0.9964, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Wright brothers were Orville Wright and Wilbur Wright, two American aviation pioneers. They are best known for inventing, building, and flying the first successful powered, controlled, sustained airplane. Their historic flight took place on December 17, 1903, near Kitty Hawk, North Carolina.", "expert_answer": "The **Wright brothers** were **Orville Wright** and **Wilbur Wright**, two American aviation pioneers.\n\nThey are best known for inventing, building, and flying the **first successful powered, controlled, sustained airplane**. Their historic flight took place on **December 17, 1903**, near **Kitty Hawk, North Carolina**.", "transcript": "Who were Wright brothers?\n", "asr_s": 0.65, "expert_s": 2.5, "expert_input_samples": 23016, "expert_input_s": 1.438, "expert_input_sha256": "0673597bd3864240bcd266fefca8d8f3ce178ad9954a3f6361777f941d8a5f46", "expert_timed_out": false, "wait_s": 2.634, "relay_synth_ms": 8054, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0166_always_relay.wav", "sha256": "bb10bbc5f91d973c1ceb835e4711a29115f947ea1cea4d2b09ebb40cc5b79336", "sr": 24000, "seconds": 18