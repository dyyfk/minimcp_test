{"id": "swebq0180", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4036737819, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what are bigos?", "input_path": "/data/bench_audio/swebq0180.wav", "input_sha256": "a10fd49460b73f155be4c6c3c5642d2c393dfd37f9b07b7df120c5bb95344605", "input_samples": 16329, "input_s": 1.021, "n_real_chunks": 2, "score": 0.6488, "act": 0.9853, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Bagels are ring-shaped bread rolls, traditionally made from yeasted wheat dough that is boiled briefly in water before baking. This gives them their characteristic chewy interior, dense texture, and shiny crust. They’re often sliced and eaten with toppings or fillings such as cream cheese, butter, smoked salmon, eggs, or deli meats.", "expert_answer": "**Bagels** are ring-shaped bread rolls, traditionally made from yeasted wheat dough that is **boiled briefly in water before baking**. This gives them their characteristic **chewy interior, dense texture, and shiny crust**.\n\nThey’re often sliced and eaten with toppings or fillings such as **cream cheese, butter, smoked salmon, eggs, or deli meats**.", "transcript": "What are bagels?\n", "asr_s": 0.51, "expert_s": 2.81, "expert_input_samples": 16329, "expert_input_s": 1.021, "expert_input_sha256": "a10fd49460b73f155be4c6c3c5642d2c393dfd37f9b07b7df120c5bb95344605", "expert_timed_out": false, "wait_s": 2.374, "relay_synth_ms": 7599, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 70, "feed_lag_sum_ms": 70, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0180_always_relay.wav", "sha256": "3ddc271577b9e14015fef0a40908baf5de99d01732