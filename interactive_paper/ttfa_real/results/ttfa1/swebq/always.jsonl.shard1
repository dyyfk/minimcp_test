{"id": "swebq0071", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 29818229, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "when was the printing press invented by gutenberg?", "input_path": "/data/bench_audio/swebq0071.wav", "input_sha256": "1d321387e8a455848b29d13a2ad99d3163a022097ab567f7e297f2721f204dc1", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.4067, "act": 0.9985, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Gutenberg invented the movable-type printing press around 1440 in Mainz, Germany.", "expert_answer": "Gutenberg invented the movable-type printing press **around 1440** in **Mainz, Germany**.", "transcript": "When was the printing press invented by Gutenberg?\n", "asr_s": 0.52, "expert_s": 1.56, "expert_input_samples": 45307, "expert_input_s": 2.832, "expert_input_sha256": "1d321387e8a455848b29d13a2ad99d3163a022097ab567f7e297f2721f204dc1", "expert_timed_out": false, "wait_s": 1.433, "relay_synth_ms": 2118, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0071_always_relay.wav", "sha256": "bb062a0d96194693454770080f90e66f0292c4b1bc5bf6edef9b88b06d664696", "sr": 24000, "seconds": 4.8}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0071_always_stall.wav", "sha256": "e3552c1515c787d96961dce5d96dd169191f0398c7e5577894845de1785d37f3", "sr": 24000, "seconds": 1.44}}, "chunks": [[0, 1, 1.0, 1.051, 1.093, 1, 0, 0], [1, 1, 2.0, 2.052, 2.093, 1, 0, 0], [2, 1, 2.832, 2.885, 2.927, 1, 0, 0], [3, 0, 3.832, 3.888, 4.066, 0, 0, 0]], "status": "completed", "error": null, "ts": 