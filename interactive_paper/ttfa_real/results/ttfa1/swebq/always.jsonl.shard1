{"id": "swebq0230", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 287956105, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where are the new orleans hornets moving to?", "input_path": "/data/bench_audio/swebq0230.wav", "input_sha256": "d241827388d4b2640662a2681a5845d1e163ee06b409ab94876ffdc4c19128c5", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.7857, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The New Orleans Hornets moved to Oklahoma City temporarily after Hurricane Katrina, playing as the New Orleans/Oklahoma City Hornets before returning to New Orleans. Later, in 2013, the team was renamed the New Orleans Pelicans.", "expert_answer": "The **New Orleans Hornets moved to Oklahoma City temporarily** after Hurricane Katrina, playing as the **New Orleans/Oklahoma City Hornets** before returning to New Orleans.\n\nLater, in 2013, the team was renamed the **New Orleans Pelicans**.", "transcript": "Where are the New Orleans Hornets moving to?\n", "asr_s": 0.64, "expert_s": 4.21, "expert_input_samples": 40106, "expert_input_s": 2.507, "expert_input_sha256": "d241827388d4b2640662a2681a5845d1e163ee06b409ab94876ffdc4c19128c5", "expert_timed_out": false, "wait_s": 3.821, "relay_synth_ms": 6752, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0230_always_relay.wav", "sha256": "1f54ed805bce4e0eced93c5361852d9db9066aaf17358f4acc04d775810d2425", "sr": 24000, "seconds": 14.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0230_always_candidate.wav", "sha256": "0a8