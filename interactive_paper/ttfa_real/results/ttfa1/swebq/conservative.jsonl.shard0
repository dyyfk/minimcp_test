{"id": "swebq0157", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3679539445, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "where did flemish people come from?", "input_path": "/data/bench_audio/swebq0157.wav", "input_sha256": "0df62984cf0229de611e96e99de366118d5ad8f6503d6a410593afcb3b546898", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.5998, "act": 0.9987, "is_info": true, "fired": false, "mode": "local", "answer": "Flemish people are the inhabitants of the Flanders region, which is located in northern Belgium and extends into parts of the Netherlands. They came from a long history that dates back to the Middle Ages when this area was part of the County of Flanders, which later became an important duchy within the Holy Roman Empire. The Flemish language developed as a blend of local dialect s influenced by Latin and Frankish during the early centuries AD. Over time, trade flourished here, especially with England and other regions, leading to economic growth and cultural exchange. So Flemish people have deep roots in this region, shaped by centuries of settlement, language development, and commerce.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 42, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0157_conservative_local.wav", "sha256": "2aadc70930c0265109724ee0d1d661698777866f92a805996e7ce72eacf87334", "sr