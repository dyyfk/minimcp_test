{"id": "swebq0114", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 640992331, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what movies gerard butler has been in?", "input_path": "/data/bench_audio/swebq0114.wav", "input_sha256": "9ffd8c461d2dda233fc3acfd0f5c44cec5073d253a6b505534864c06e47539cb", "input_samples": 42335, "input_s": 2.646, "n_real_chunks": 3, "score": 0.6626, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Gerard Butler has been in many movies, including: 300 (2006) , P.S.", "expert_answer": "Gerard Butler has been in many movies, including:\n\n- **300** (2006)\n- **P.S. I Love You** (2007)\n- **The Ugly Truth** (2009)\n- **Law Abiding Citizen** (2009)\n- **Gamer** (2009)\n- **The Bounty Hunter** (2010)\n- **How to Train Your Dragon** (2010, voice)\n- **Machine Gun Preacher** (2011)\n- **Coriolanus** (2011)\n- **Olympus Has Fallen** (2013)\n- **How to Train Your Dragon 2** (2014, voice)\n- **Gods of Egypt** (2016)\n- **London Has Fallen** (2016)\n- **Geostorm** (2017)\n- **Den of Thieves** (2018)\n- **Hunter Killer** (2018)\n- **How to Train Your Dragon: The Hidden World** (2019, voice)\n- **Angel Has Fallen** (2019)\n- **Greenland** (2020)\n- **Copshop** (2021)\n- **Plane** (2023)\n- **Kandahar** (2023)\n- **Den of Thieves 2: Pantera** (2025)\n\nEarlier films include **Tomorrow Never Dies** (1997), **Dracula 2000** (2000), **Reign of Fire** (2002), **Lara Croft Tomb Raider: The Cradle of Life** (2003), **Timeline** (2003), **The Phantom of the Opera** (2004), **Dear Frankie** (2004), and **Beowulf & Grendel** (2005). ([en.wikipedia.org](https://en.wikipedia.org/wiki/Gerard_Butler_filmography?utm_source=openai))", "transcript": "What movies Gerard Butler has been in?\n", "asr_s": 0.59, "expert_s": 5.59, "expert_input_samples": 42335, "expert_input_s": 2.646, "expert_input_sha256": "9ffd8c461d2dda233fc3acfd0f5c44cec5073d253a6b505534864c06e47539cb", "expert_timed_out": false, "wait_s": 5.035, "relay_synth_ms": 3369, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 319, "feed_lag_sum_ms": 319, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0114_always_relay.wav", "sha256": "67e274ab1f15b93615512cb438798e2a8fb14d5032ebce6bc2a91f3a1edc523f", "sr": 24000, "seconds": 5.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0114_always_candidate.wav", "sha256": "733b8f2ba5aa5d2190f825d9118007bbf98c08babdf6a65d66598e00dd90af80", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0114_always_stall.wav", "sha256": "c6f0c1dcf90a5f91f98631ec399e5b890d65c85b919509c67cddf6a5717820cb", "sr": 24000, "seconds": 1.64}}, "chunks": [[0, 1, 1.0, 1.071, 1.128, 1, 0, 0], [1, 1, 2.0, 2.076, 2.134, 1, 0, 0], [2, 1, 2.646, 2.719, 2.778, 1, 0, 0], [3, 0, 3.646, 3.721, 4.297, 0, 24000, 0], [4, 0, 4.646, 5.036, 5.439, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.646, "last_real_feed_done": 2.719, "onset": 4.297, "gate_read_done": 4.297, "fire": 4.297, "candidate_first_pcm": 4.297, "stall_note": 4.298, "stall_first_pcm": 4.965, "local_first_pcm": null, "wait_start": 5.439, "expert_req": 4.298, "expert_resp": 10.475, "relay_synth_start": 10.475, "relay_first_pcm": 11.317, "relay_synth_end": 13.845, "first_any_pcm": 4.297, "first_answer_pcm": 11.317, "session_end": 13.984}, "ttfa_answer_s": 8.671, "ttfa_any_s": 1.651}
