 1, 0, 0], [2, 1, 2.135, 2.218, 2.283, 1, 0, 0], [3, 0, 3.135, 3.21, 3.79, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.135, "last_real_feed_done": 2.218, "onset": 3.79, "gate_read_done": 3.79, "fire": 3.79, "candidate_first_pcm": 3.79, "stall_note": 3.791, "stall_first_pcm": 4.496, "local_first_pcm": null, "wait_start": 4.496, "expert_req": 3.791, "expert_resp": 5.632, "relay_synth_start": 5.633, "relay_first_pcm": 6.51, "relay_synth_end": 8.553, "first_any_pcm": 3.79, "first_answer_pcm": 6.51, "session_end": 8.713}, "ttfa_answer_s": 4.375, "ttfa_any_s": 1.655}
{"id": "swebq0059", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1026234309, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where are ike and tina turner's children?", "input_path": "/data/bench_audio/swebq0059.wav", "input_sha256": "3f2c321fd4d50394ef1c1f9f236fe4a4fe4f42473fb57510c96cac57cfced225", "input_samples": 32676, "input_s": 2.042, "n_real_chunks": 3, "score": 0.847, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "If you mean the four sons Tina Turner raised with Ike Turner: Craig Raymond Turner — Tina’s son with Raymond Hill, later adopted by Ike. He died by suicide in Studio City, Los Angeles, in 2018. (abcnews.com) , Ronnie Turner — Ike and Tina’s only biological child together. He has lived a very private life; reports have said he was in a Southern California convalescent home and needed medical support. (en.wikipedia.org) So, as of now, Michael Turner is the only one of Tina Turner’s four sons believed to still be living.", "expert_answer": "If you mean the **four sons Tina Turner raised with Ike Turner**:\n\n- **Craig Raymond Turner** — Tina’s son with Raymond Hill, later adopted by Ike. He died by suicide in **Studio City, Los Angeles, in 2018**. ([abcnews.com](https://abcnews.com/news/story/tina-turners-son-craig-turner-dies-59-56351164?utm_source=openai))  \n- **Ronnie Turner** — Ike and Tina’s only biological child together. He died in **Los Angeles in December 2022** from complications of metastatic colon cancer. ([latimes.com](https://www.latimes.com/entertainment-arts/music/story/2022-12-13/ronnie-turner-autopsy-cause-of-death?utm_source=openai))  \n- **Ike Turner Jr.** — Ike’s son, adopted by Tina. He died in **Los Angeles on October 4, 2025**, at age 67. ([latimes.com](https://www.latimes.com/entertainment-arts/music/story/2025-10-06/ike-turner-jr-dead-son-ike-tina-tuner?utm_source=openai))  \n- **Michael Turner** — Ike’s son, adopted by Tina. He has lived a very private life; reports have said he was in a **Southern California convalescent home** and needed medical support. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Ike_Turner?utm_source=openai))  \n\nSo, as of now, **Michael Turner is the only one of Tina Turner’s four sons believed to still be living**.", "transcript": "Where are Ike and Tina Turner's children?\n", "asr_s": 0.64, "expert_s": 13.16, "expert_input_samples": 32676, "expert_input_s": 2.042, "expert_input_sha256": "3f2c321fd4d50394ef1c1f9f236fe4a4fe4f42473fb57510c96cac57cfced225", "expert_timed_out": false, "wait_s": 12.714, "relay_synth_ms": 20718, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 0, "feed_lag_max_ms": 107, "feed_lag_sum_ms": 107, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0059_always_relay.wav", "sha256": "b8ecde187a2ef6060cd4cd8342d866376f33f0b131e27134fefdcd59d342f745", "sr": 24000, "seconds": 35.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0059_always_candidate.wav", "sha256": "71a97a9eb47df7441a61f40f94cf31b2bd0fac3b12125e75423e3d188654d94a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0059_always_stall.wav", "sha256": "0bafd353db787697405bc4721a11e2e1d94e5bde99c500db7d8e428cdc34a1e0", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.074, 1.138, 1, 0, 0], [1, 1, 2.0, 2.084, 2.15, 1, 0, 0], [2, 1, 2.042, 2.229, 2.294, 1, 0, 0], [3, 0, 3.042, 3.118, 3.89, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.042, "last_real_feed_done": 2.229, "onset": 3.89, "gate_read_done": 3.89, "fire": 3.89, "candidate_first_pcm": 3.89, "stall_note": 3.891, "stall_first_pcm": 4.975, "lo