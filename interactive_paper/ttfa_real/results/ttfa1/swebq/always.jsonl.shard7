 3.042, 3.118, 3.858, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.042, "last_real_feed_done": 2.205, "onset": 3.858, "gate_read_done": 3.858, "fire": 3.858, "candidate_first_pcm": 3.858, "stall_note": 3.859, "stall_first_pcm": 4.668, "local_first_pcm": null, "wait_start": 4.668, "expert_req": 3.858, "expert_resp": 7.249, "relay_synth_start": 7.249, "relay_first_pcm": 8.074, "relay_synth_end": 9.273, "first_any_pcm": 3.858, "first_answer_pcm": 8.074, "session_end": 9.415}, "ttfa_answer_s": 6.032, "ttfa_any_s": 1.815}
{"id": "swebq0227", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2522249323, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what languages do people speak in spain?", "input_path": "/data/bench_audio/swebq0227.wav", "input_sha256": "880f853a00dd17af87026cbaff186c5234fc694f6bf5b0ac1cd8408c42a1c5c8", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.389, "act": 0.9947, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "People in Spain mainly speak Spanish (Castilian). Spain also has several widely spoken regional languages, including: Catalan — in Catalonia, Valencia, and the Balearic Islands , Valencian — often considered a variety/name of Catalan in Valencia , Galician — in Galicia , Basque — in the Basque Country and parts of Navarre , Aranese — a variety of Occitan spoken in the Aran Valley, Catalonia Many people also speak English as a second language, especially in tourist areas and among younger people.", "expert_answer": "People in Spain mainly speak **Spanish (Castilian)**.\n\nSpain also has several widely spoken regional languages, including:\n\n- **Catalan** — in Catalonia, Valencia, and the Balearic Islands  \n- **Valencian** — often considered a variety/name of Catalan in Valencia  \n- **Galician** — in Galicia  \n- **Basque** — in the Basque Country and parts of Navarre  \n- **Aranese** — a variety of Occitan spoken in the Aran Valley, Catalonia  \n\nMany people also speak **English** as a second language, especially in tourist areas and among younger people.", "transcript": "What languages do people speak in Spain?\n", "asr_s": 0.63, "expert_s": 2.62, "expert_input_samples": 45307, "expert_input_s": 2.832, "expert_input_sha256": "880f853a00dd17af87026cbaff186c5234fc694f6bf5b0ac1cd8408c42a1c5c8", "expert_timed_out": false, "wait_s": 2.852, "relay_synth_ms": 22087, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0227_always_relay.wav", "sha256": "b312b23845da2208a1ebae080bc05563e0d3ea827f73634c575c078dfddbd987", "sr": 24000, "seconds": 39.44}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0227_always_stall.wav", "sha256": "9657386300d6b3e27b62fb798148816c3b7523309eeb761f0f36556c16a65a73", "sr": 24000, "seconds": 0.2}}, "chunks": [[0, 1, 1.0, 1.071, 1.128, 1, 0, 0], [1, 1, 2.0, 2.073, 2.131, 1, 0, 0], [2, 1, 2.832, 2.903, 2.961, 1, 0, 0], [3, 0, 3.832, 3.906, 4.076, 0, 0, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.832, "last_real_feed_done": 2.903, "onset": 4.076, "gate_read_done": 4.076, "fire": 4.076, "candidate_first_pcm": null, "stall_note": 4.077, "stall_first_pcm": 4.475, "local_first_pcm": null, "wait_start": 4.475, "expert_req": 4.077, "expert_resp": 7.327, "relay_synth_start": 7.327, "relay_first_pcm": 8.17, "relay_synth_end": 29.415, "first_any_pcm": 4.475, "first_answer_pcm": 8.17, "session_end": 29.626}, "ttfa_answer_s": 5.338, "ttfa_any_s": 1.643}
{"id": "swebq0237", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2404206890, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where did russians originate?", "input_path": "/data/bench_audio/swebq0237.wav", "input_sha256": "d2754fccde65bb6b545dfa2e1c70c2b53d9919b0d3b957e71fc0562014755c1f", "input_samples": 28960, "input_s": 1.81, "n_real_chunks": 2, "score": 0.6652, "act": 0.9968, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Russians originated primarily from the East Slavic peoples of Eastern Europe. Historically, their roots are usually traced to the East Slavs who lived in the forest and forest-steppe zones of what are now western Russia, Ukraine, and Belarus. In the early medieval period, these groups became part of Kievan Rus’ — a polity centered around Kyiv from the 9th century onward. Russians also absorbed influences and ancestry from neighboring peoples, including Finnic, Baltic, Turkic, and Norse/Varangian groups, but their core linguistic and cultural origin is East Slavic.", "expert_answer": "Russians originated primarily from the **East Slavic peoples** of Eastern Europe.\n\nHistorically, their roots are usually traced to the **East Slavs** who lived in the forest and forest-steppe zones of what are now **western Russia, Ukraine, and Belarus**. In the early medieval period, these groups became part of **Kievan Rus’** — a polity centered around Kyiv from the 9th century onward. Over time, the northeastern East Slavic populations around cities such as **Novgorod, Vladimir, Suzdal, and Moscow** developed into what became the **Russian people**.\n\nRussians also absorbed influences and ancestry from neighboring peoples, including **Finnic, Baltic, Turkic, and Norse/Varangian** groups, but their core linguistic and cultural origin is **East Slavic**.", "transcript": "Where did Russians originate?\n", "asr_s": 0.42, "expert_s": 4.63, "expert_input_samples": 28960, "expert_input_s": 1.81, "expert_input_sha256": "d2754fccde65bb6b545dfa2e1c70c2b53d9919b0d3b957e71fc0562014755c1f", "expert_timed_out": false, "wait_s": 4.234, "relay_synth_ms": 23267, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0237_always_relay.wav", "sha256": "4e39531ba82b25602ecfa79352b725308c2106086db4bfec5d96cb35436adacc", "sr": 24000, "seconds": 40.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0237_always_candidate.wav", "sha256": "e6bf580043c0d743da9fc9ad80af93d284e0141410a3a36e4495a432c16a48ac", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0237_always_stall.wav", "sha256": "0d5a00ef3d00717956cebfa36465eacdb14002f65d12bcb2e24336b2197159be", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.073, 1.132, 1, 0, 0], [1, 1, 1.81, 1.883, 1.941, 1, 0, 0], [2, 0, 2.81, 2.884, 2.942, 1, 0, 0], [3, 0, 3.81, 3.882, 4.44, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.81, "last_real_feed_done": 1.883, "onset": 4.44, "gate_read_done": 4.441, "fire": 4.441, "candidate_first_pcm": 4.44, "stall_note": 4.442, "stall_first_pcm": 5.25, "local_first_pcm": null, "wait_start": 5.25, "expert_req": 4.442, "expert_resp": 9.483, "relay_synth_start": 9.484, "relay_first_pcm": 10.332, "relay_synth_end": 32.751, "first_any_pcm": 4.44, "first_answer_pcm": 10.332, "session_end": 32.962}, "ttfa_answer_s": 8.522, "ttfa_any_s": 2.63}
{"id": "swebq0247", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3222069229, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where does marta play soccer?", "input_path": "/data/bench_audio/swebq0247.wav", "input_sha256": "bd55c73101a07c71686788142031f64d385e306f15434d4f9ce2cad5f05d8acb", "input_samples": 23016, "input_s": 1.438, "n_real_chunks": 2, "score": 0.9418, "act": 0.9975, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Marta plays for Orlando Pride in the National Women’s Soccer League (NWSL), and she also represents Brazil internationally. (orlandocitysc.com)", "expert_answer": "Marta plays for **Orlando Pride** in the **National Women’s Soccer League (NWSL)**, and she also represents **Brazil** internationally. ([orlandocitysc.com](https://www.orlandocitysc.com/pride/players/marta/?utm_source=openai))", "transcript": "Where does Marta play soccer?\n", "asr_s": 0.55, "expert_s": 5.31, "expert_input_samples": 23016, "expert_input_s": 1.438, "expert_input_sha256": "bd55c73101a07c71686788142031f64d385e306f15434d4f9ce2cad5f05d8acb", "expert_timed_out": false, "wait_s": 4.346, "relay_synth_ms": 5745, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 519, "feed_lag_sum_ms": 519, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0247_always_relay.wav", "sha256": "f19c1cd61ca2fb5f07c905959b165a6eb0c1d0fbb2c5140765d928f956f8a377", "sr": 24000, "seconds": 9.68}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0247_always_candidate.wav", "sha256": "78384d481ba4454a930f75acf18e3faf986d34e94436d636ba1d468c66d54c5b", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_rea