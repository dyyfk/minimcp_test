{"id": "swebq0200", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 973377354, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where is the ufc headquarters?", "input_path": "/data/bench_audio/swebq0200.wav", "input_sha256": "a6fb56d19306827f9d259fe885529f4d48d54efc61ee1c1cb6420d0b133f7ae8", "input_samples": 25988, "input_s": 1.624, "n_real_chunks": 2, "score": 0.7082, "act": 0.997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The UFC headquarters is in Las Vegas, Nevada, at: 6650 S. Torrey Pines Drive, Las Vegas, NV 89118. (sec.gov)", "expert_answer": "The **UFC headquarters is in Las Vegas, Nevada**, at:\n\n**6650 S. Torrey Pines Drive, Las Vegas, NV 89118**. ([sec.gov](https://www.sec.gov/Archives/edgar/data/1973266/000119312526173856/d908037dars.pdf?utm_source=openai))", "transcript": "Where is the UFC headquarters?\n", "asr_s": 0.54, "expert_s": 4.9, "expert_input_samples": 25988, "expert_input_s": 1.624, "expert_input_sha256": "a6fb56d19306827f9d259fe885529f4d48d54efc61ee1c1cb6420d0b133f7ae8", "expert_timed_out": false, "wait_s": 3.712, "relay_synth_ms": 6336, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 368, "feed_lag_sum_ms": 368, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0200_always_relay.wav", "sha256": "387281d26ffa79049e61070581932a3fed34e173e947a12b8a6f7e300d2caec3", "sr": 24000, "seconds": 10.76}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0200_always_candidate.wav", "sha256": "0c9a0a1162cbe13a486944c8fd1ddb5a436f58c5b8363e6fcbdb0248553204f8", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0200_always_st