{"id": "swebq0026", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3805650067, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "who did jackie robinson first play for?", "input_path": "/data/bench_audio/swebq0026.wav", "input_sha256": "a2147b8da175e1b18e085242de158f99ac621c3f4a165791fdc00afe458cc511", "input_samples": 36391, "input_s": 2.274, "n_real_chunks": 3, "score": 0.3308, "act": 0.9966, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Jackie Robinson first played Major League Baseball for the Brooklyn Dodgers in 1947. Before MLB, he played professionally for the Kansas City Monarchs in the Negro Leagues in 1945.", "expert_answer": "Jackie Robinson first played **Major League Baseball for the Brooklyn Dodgers** in 1947.\n\nBefore MLB, he played professionally for the **Kansas City Monarchs** in the Negro Leagues in 1945.", "transcript": "Who did Jackie Robinson first play for?\n", "asr_s": 0.53, "expert_s": 3.88, "expert_input_samples": 36391, "expert_input_s": 2.274, "expert_input_sha256": "a2147b8da175e1b18e085242de158f99ac621c3f4a165791fdc00afe458cc511", "expert_timed_out": false, "wait_s": 4.031, "relay_synth_ms": 7388, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0026_always_relay.wav", "sha256": "470abfb50cd439cd5ecff6ee744fb900d44ded56020f657bd8afdf3c5e317ea2", "sr": 24000, "seconds": 14.52}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0026_always_stall.wav", "sha256": "3ed1cce6522aae258a40b8d571dedacd85850f266561c24b94e8e6806e2e9f7c", "sr": 24000, "seconds": 0.36}}, "chunks": [[0, 1, 1.0