{"id": "swebq0165", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 510812698, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "where did jay moriarty die?", "input_path": "/data/bench_audio/swebq0165.wav", "input_sha256": "fa5d6eb2e89e2e00339a71391111404ca489be4d56563462c03a2a9013fef644", "input_samples": 30446, "input_s": 1.903, "n_real_chunks": 2, "score": 0.8165, "act": 0.9929, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Jay Moriarity died in the Indian Ocean, off Lohifushi Island in the Maldives, in a freediving accident on June 15, 2001. (latimes.com)", "expert_answer": "Jay **Moriarity** died in the **Indian Ocean, off Lohifushi Island in the Maldives**, in a freediving accident on June 15, 2001. ([latimes.com](https://www.latimes.com/archives/la-xpm-2001-jun-22-sp-13388-story.html?utm_source=openai))", "transcript": "Where did Jay Moriarty die?\n", "asr_s": 0.71, "expert_s": 4.7, "expert_input_samples": 30446, "expert_input_s": 1.903, "expert_input_sha256": "fa5d6eb2e89e2e00339a71391111404ca489be4d56563462c03a2a9013fef644", "expert_timed_out": false, "wait_s": 4.162, "relay_synth_ms": 4701, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 46, "feed_lag_sum_ms": 46, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0165_always_relay.wav", "sha256": "1bc9315c331ca03774182f2460dfe8e1269cb14bffb3905e75814b18757fc133", "sr": 24000, "seconds": 9.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0165_always_candidate.wav", "sha256": "3434b0d70673118b8cccf1a06d7a104c81cf91400493982f322eb1223dfb6f4d", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0165_always_stall.wav", "sha256": "fc39a13fe9c5f85ba8ac7b91386626ee01d0ef70de475ac93e0f6bf7ad1a7703", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.062, 1.113, 1, 0, 0], [1, 1, 1.903, 1.967, 2.019, 1, 0, 0], [2, 0, 2.903, 2.968, 3.019, 1, 0, 0], [3, 0, 3.903, 3.967, 4.423, 0, 24000, 0], [4, 0, 4.903, 5.012, 5.677, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.903, "last_real_feed_done": 1.967, "onset": 4.423, "gate_read_done": 4.423, "fire": 4.423, "candidate_first_pcm": 4.423, "stall_note": 4.424, "stall_first_pcm": 4.949, "local_first_pcm": null, "wait_start": 5.677, "expert_req": 4.424, "expert_resp": 9.838, "relay_synth_start": 9.839, "relay_first_pcm": 10.549, "relay_synth_end": 14.54, "first_any_pcm": 4.423, "first_answer_pcm": 10.549, "session_end": 14.671}, "ttfa_answer_s": 8.646, "ttfa_any_s": 2.52}
{"id": "swebq0174", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1886282701, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what are physical features of egypt?", "input_path": "/data/bench_audio/swebq0174.wav", "input_sha256": "240191402be9567efac601e62e35df1830452f264a7cf4ff5e8b80f8447f8398", "input_samples": 38620, "input_s": 2.414, "n_real_chunks": 3, "score": 0.3255, "act": 0.9974, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Egypt’s main physical features include: Nile River — Egypt’s most important river, flowing south to north into the Mediterranean Sea. , Nile Delta — a fertile, fan-shaped area in northern Egypt where the Nile spreads out before reaching the sea. , Western Desert — part of the Sahara Desert, covering much of western Egypt. , Eastern Desert — desert region between the Nile Valley and the Red Sea. ,.", "expert_answer": "Egypt’s main physical features include:\n\n- **Nile River** — Egypt’s most important river, flowing south to north into the Mediterranean Sea.\n- **Nile Delta** — a fertile, fan-shaped area in northern Egypt where the Nile spreads out before reaching the sea.\n- **Western Desert** — part of the Sahara Desert, covering much of western Egypt.\n- **Eastern Desert** — desert region between the Nile Valley and the Red Sea.\n- **Sinai Peninsula** — a triangular peninsula in northeastern Egypt, linking Africa and Asia.\n- **Red Sea coast** — along eastern Egypt, with mountains and coral reefs.\n- **Mediterranean coast** — along northern Egypt.\n- **Nile Valley** — a narrow strip of fertile land along the Nile.\n- **Oases** — fertile areas in the desert, such as Siwa, Bahariya, Farafra, Dakhla, and Kharga.\n- **Mountains** — especially in the Sinai Peninsula and along the Red Sea; Mount Catherine is Egypt’s highest point.", "transcript": "What are physical features of Egypt?\n", "asr_s": 0.63, "expert_s": 4.95, "expert_input_samples": 38620, "expert_input_s": 2.414, "expert_input_sha256": "240191402be9567efac601e62e35df1830452f264a7cf4ff5e8b80f8447f8398", "expert_timed_out": false, "wait_s": 4.89, "relay_synth_ms": 13537, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0174_always_relay.wav", "sha256": "e2e5b37fe72655a1c85a24dfb1a25dd29852aa7dd0b19ef4fe6e48da624a9318", "sr": 24000, "seconds": 28.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0174_always_candidate.wav", "sha256": "8cd0bb9af889e102d2248c4d25b4b7ce22be8659a1ee50ad0b4a3ba35798c097", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0174_always_stall.wav", "sha256": "49106b1910a250a8634e7f4ff7f7892cc1d8a8f24ec90f68b1b0587701e92871", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.062, 1.112, 1, 0, 0], [1, 1, 2.0, 2.064, 2.114, 1, 0, 0], [2, 1, 2.414, 2.477, 2.528, 1, 0, 0], [3, 0, 3.414, 3.478, 4.084, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.414, "last_real_feed_done": 2.477, "onset": 4.084, "gate_read_done": 4.084, "fire": 4.084, "candidate_first_pcm": 4.084, "stall_note": 4.085, "stall_first_pcm": 4.779, "local_first_pcm": null, "wait_start": 4.779, "expert_req": 4.085, "expert_resp": 9.669, "relay_synth_start": 9.67, "relay_first_pcm": 10.39, "relay_synth_end": 23.208, "first_any_pcm": 4.084, "first_answer_pcm": 10.39, "session_end": 23.372}, "ttfa_answer_s": 7.977, "ttfa_any_s": 1.67}
