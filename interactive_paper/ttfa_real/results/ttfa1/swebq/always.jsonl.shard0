{"id": "swebq0104", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1060107530, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what is st anthony patron saint of?", "input_path": "/data/bench_audio/swebq0104.wav", "input_sha256": "6e8047090f5d76bbe9234798f1ad5c70152e713e7c088898369b3959785dfbe1", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.6612, "act": 0.9984, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Saint Anthony of Padua is best known as the patron saint of lost things—people often ask for his help in finding misplaced items. He is also considered a patron saint of lost people, the poor, travelers, fishermen, sailors, pregnant women, and seekers of marriage/spouses.", "expert_answer": "Saint Anthony of Padua is best known as the **patron saint of lost things**—people often ask for his help in finding misplaced items.\n\nHe is also considered a patron saint of **lost people, the poor, travelers, fishermen, sailors, pregnant women, and seekers of marriage/spouses**.", "transcript": "Why is Saint Anthony patron saint of?\n", "asr_s": 0.52, "expert_s": 2.6, "expert_input_samples": 34905, "expert_input_s": 2.182, "expert_input_sha256": "6e8047090f5d76bbe9234798f1ad5c70152e713e7c088898369b3959785dfbe1", "expert_timed_out": false, "wait_s": 2.416, "relay_synth_ms": 7862, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0104_always_relay.wav", "sha256": "a14e7e8e6a79a2ffb939ea45f80c402ee98296f6f879449e3a940f0ea9188e61", "sr": 24000, "seconds": 17.36}, "stall": {"path": "/data/ttfa_real/t