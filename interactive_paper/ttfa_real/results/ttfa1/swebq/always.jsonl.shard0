{"id": "swebq0010", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 547056229, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what form of government does the united states use?", "input_path": "/data/bench_audio/swebq0010.wav", "input_sha256": "6beff06a43560ce56d8b4b26dd700229138688a33248c79d069760531ff607a2", "input_samples": 48279, "input_s": 3.017, "n_real_chunks": 4, "score": 0.2476, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The United States uses a constitutional federal republic with a representative democracy. Citizens elect representatives, and power is divided between the national and state governments under the U.S. Constitution.", "expert_answer": "The United States uses a **constitutional federal republic** with a **representative democracy**.\n\nCitizens elect representatives, and power is divided between the national and state governments under the U.S. Constitution.", "transcript": "What form of government does the United States use?\n", "asr_s": 0.57, "expert_s": 1.91, "expert_input_samples": 48279, "expert_input_s": 3.017, "expert_input_sha256": "6beff06a43560ce56d8b4b26dd700229138688a33248c79d069760531ff607a2", "expert_timed_out": false, "wait_s": 1.718, "relay_synth_ms": 6225, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 104, "feed_lag_sum_ms": 104, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0010_always_relay.wav", "sha256": "7b8504cb3ebff3a34dacb327e60011a5eb187c146caeb8463baacd3373476e23", "sr": 24000, "seconds": 13.04}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0010_always_candidate.wav", "sha256": "1d65fa5adfb8a527b