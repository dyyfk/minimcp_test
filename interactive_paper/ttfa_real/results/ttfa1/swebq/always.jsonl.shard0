{"id": "swebq0211", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1410895517, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what is newcastle metro?", "input_path": "/data/bench_audio/swebq0211.wav", "input_sha256": "d0630a47082555ccb56f6e79c48984570ad1028d271b1789932ab5ab2a0735f1", "input_samples": 23759, "input_s": 1.485, "n_real_chunks": 2, "score": 0.7274, "act": 0.9939, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Newcastle Metro usually refers to the Tyne and Wear Metro: a light rail/rapid transit system serving Newcastle upon Tyne, Gateshead, Sunderland, North Tyneside, and South Tyneside in northeast England. It is operated by Nexus and connects key places such as Newcastle city centre, Newcastle Airport, Sunderland, South Shields, Whitley Bay, and Tynemouth.", "expert_answer": "**Newcastle Metro** usually refers to the **Tyne and Wear Metro**: a light rail/rapid transit system serving **Newcastle upon Tyne**, Gateshead, Sunderland, North Tyneside, and South Tyneside in northeast England.\n\nIt is operated by **Nexus** and connects key places such as **Newcastle city centre, Newcastle Airport, Sunderland, South Shields, Whitley Bay, and Tynemouth**.", "transcript": "What is Newcastle Metro?\n", "asr_s": 0.63, "expert_s": 2.79, "expert_input_samples": 23759, "expert_input_s": 1.485, "expert_input_sha256": "d0630a47082555ccb56f6e79c48984570ad1028d271b1789932ab5ab2a0735f1", "expert_timed_out": false, "wait_s": 2.73, "relay_synth_ms": 11712, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0211_always_relay