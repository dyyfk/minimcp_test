{"id": "swebq0018", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 776004183, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what drugs lindsay lohan abuse?", "input_path": "/data/bench_audio/swebq0018.wav", "input_sha256": "993b3d531681888957305179b2f1a806050b71c3debbf3c40142ed11deb4bdf4", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.7675, "act": 0.9984, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Lindsay Lohan has publicly been associated with substance abuse involving alcohol and cocaine. She has also had legal/probation issues involving positive tests or allegations related to controlled substances, but the most consistently reported substances were alcohol and cocaine.", "expert_answer": "Lindsay Lohan has publicly been associated with substance abuse involving **alcohol** and **cocaine**. She has also had legal/probation issues involving positive tests or allegations related to **controlled substances**, but the most consistently reported substances were **alcohol and cocaine**.", "transcript": "What drugs Lindsay Lohan abuse?\n", "asr_s": 0.61, "expert_s": 2.17, "expert_input_samples": 34905, "expert_input_s": 2.182, "expert_input_sha256": "993b3d531681888957305179b2f1a806050b71c3debbf3c40142ed11deb4bdf4", "expert_timed_out": false, "wait_s": 1.765, "relay_synth_ms": 7820, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 295, "feed_lag_sum_ms": 295, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0018_always_relay.wav", "sha256": "ff8f6d79b370b548f885cac52828fd7822cdac90e8b54834986741903f677b7e", "sr": 24000, "seconds": 16.12}, "candidate": {"path":