{"id": "swebq0132", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4250993660, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "what airport do you fly into in paris?", "input_path": "/data/bench_audio/swebq0132.wav", "input_sha256": "cd00fb9d6144e4d2c94905a99d1d2a817ecbc821fd66fe5ce2dea7b631b11dbb", "input_samples": 36391, "input_s": 2.274, "n_real_chunks": 3, "score": 0.5067, "act": 0.9965, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "For Paris, you’ll usually fly into Paris Charles de Gaulle Airport (CDG) — the main international airport. Other Paris-area options are: Paris Orly Airport (ORY) — closer to the city, many European/domestic flights , Beauvais–Tillé Airport (BVA) — farther away, often used by budget airlines", "expert_answer": "For Paris, you’ll usually fly into **Paris Charles de Gaulle Airport (CDG)** — the main international airport.\n\nOther Paris-area options are:\n- **Paris Orly Airport (ORY)** — closer to the city, many European/domestic flights\n- **Beauvais–Tillé Airport (BVA)** — farther away, often used by budget airlines", "transcript": "What airport do you fly into in Paris?\n", "asr_s": 0.6, "expert_s": 2.46, "expert_input_samples": 36391, "expert_input_s": 2.274, "expert_input_sha256": "cd00fb9d6144e4d2c94905a99d1d2a817ecbc821fd66fe5ce2dea7b631b11dbb", "expert_timed_out": false, "wait_s": 1.177, "relay_synth_ms": 10305, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 2, "feed_lag_max_ms": 76, "feed_lag_sum_ms": 76, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0132_always_relay.wav", "sha256": "92dcae71743c28682df0f3f7f4e4a004c26bf4afa84df13b6f2a92557d1c59bf", "sr": 24000, "s