{"id": "swebq0196", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 14888815, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "when do they change the time in california?", "input_path": "/data/bench_audio/swebq0196.wav", "input_sha256": "47dfb1fcddb36de471c568edd74285c50342863eec78e2c3a492d8d22045b375", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.7707, "act": 0.9982, "is_info": true, "fired": false, "mode": "local", "answer": "The time changes in California are done twice a year. In the spring, it happens around the second Sunday of March when we move our clocks forward an hour for Daylight S aving Time. And then in the fall around the first Sunday of November, we move them back again to Standard Time.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0196_balanced_local.wav", "sha256": "2576fa1ab279842a83674117067a5902e872ee8d0450a1e0d3ce082aac5dfbe3", "sr": 24000, "seconds": 13.28}}, "chunks": [[0, 1, 1.0, 1.056, 1.1, 1, 0, 0], [1, 1, 2.0, 2.057, 2.103, 1, 0, 0], [2, 1, 2.182, 2.24, 2.286, 1, 0, 0], [3, 0, 3.182, 3.239, 3.646, 0, 24000, 0], [4, 0, 4.182, 4.238, 4.815, 0, 24000, 0], [5, 0, 5.182, 5.239, 5.832, 0, 24000, 0], [6, 0, 6.182, 6.24, 6.741, 0, 24000, 0], [7, 0, 7.182, 7.239, 7.786, 0, 24000, 0], [8, 0, 8.182, 8.24, 8.816, 0, 24000, 0], [9, 0, 9.182, 9.241, 9