{"id": "swebq0125", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2048829214, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "where does name pennsylvania come from?", "input_path": "/data/bench_audio/swebq0125.wav", "input_sha256": "a27fd23128bc10b86029ee64890c168dc0284f01524c188c50b938c8468bd126", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.6174, "act": 0.997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Pennsylvania comes from the Latin phrase meaning “Penn’s Woods” or “Penn’s Woodland.” It was named in 1681 when King Charles II of England granted the land to William Penn. Penn wanted to call it “Sylvania” (“woods”), but the king added “Penn” in honor of William Penn’s father, Admiral Sir William Penn.", "expert_answer": "**Pennsylvania** comes from the Latin phrase meaning **“Penn’s Woods”** or **“Penn’s Woodland.”**\n\nIt was named in 1681 when King Charles II of England granted the land to **William Penn**. Penn wanted to call it **“Sylvania”** (“woods”), but the king added **“Penn”** in honor of William Penn’s father, **Admiral Sir William Penn**.", "transcript": "Where does name Pennsylvania come from?\n", "asr_s": 1.08, "expert_s": 2.96, "expert_input_samples": 34905, "expert_input_s": 2.182, "expert_input_sha256": "a27fd23128bc10b86029ee64890c168dc0284f01524c188c50b938c8468bd126", "expert_timed_out": false, "wait_s": 3.378, "relay_synth_ms": 11928, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0125_aggressive_relay.wav", "sha256": "239407d16f26bd2a3b