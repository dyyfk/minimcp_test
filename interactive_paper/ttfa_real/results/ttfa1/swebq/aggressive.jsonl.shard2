e**, and **Chi-Raq**. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Nick_Cannon?utm_source=openai))", "transcript": "What movies does Nick Cannon play in?\n", "asr_s": 10.92, "expert_s": 6.0, "expert_input_samples": 47536, "expert_input_s": 2.971, "expert_input_sha256": "8b8702c3f2aed1699507a70d7fcca6652bbc67ab5d47a2af287412eb5eee6f4c", "expert_timed_out": false, "wait_s": 15.666, "relay_synth_ms": 26625, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 566, "feed_lag_sum_ms": 566, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0054_aggressive_relay.wav", "sha256": "39fa514b6da07e46aa47cdf0c1a7f6ed5e10bdd8f6fc420042f5385f740ff2d2", "sr": 24000, "seconds": 43.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0054_aggressive_candidate.wav", "sha256": "94f048aae35977d1fbda1abc0c97c6fa0f28c258379acc053dfe185dc979fd89", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0054_aggressive_stall.wav", "sha256": "a4071d4667676dabead26472ddcfa85c3e3e971f166c0e4c25524e439cc4e771", "sr": 24000, "seconds": 1.64}}, "chunks": [[0, 1, 1.0, 1.069, 1.123, 1, 0, 0], [1, 1, 2.0, 2.072, 2.127, 1, 0, 0], [2, 1, 2.971, 3.051, 3.115, 1, 0, 0], [3, 0, 3.971, 4.053, 4.849, 0, 24000, 0], [4, 0, 4.971, 5.617, 6.108, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.971, "last_real_feed_done": 3.051, "onset": 4.849, "gate_read_done": 4.849, "fire": 4.849, "candidate_first_pcm": 4.849, "stall_note": 4.85, "stall_first_pcm": 5.537, "local_first_pcm": null, "wait_start": 6.109, "expert_req": 4.85, "expert_resp": 21.774, "relay_synth_start": 21.774, "relay_first_pcm": 22.652, "relay_synth_end": 48.4, "first_any_pcm": 4.849, "first_answer_pcm": 22.652, "session_end": 48.643}, "ttfa_answer_s": 19.681, "ttfa_any_s": 1.878}
