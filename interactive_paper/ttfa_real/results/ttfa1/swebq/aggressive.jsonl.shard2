{"id": "swebq0187", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1862217400, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "who did reese witherspoon get married to?", "input_path": "/data/bench_audio/swebq0187.wav", "input_sha256": "eee4f721533d1c4b6be7beb8971e97990c9577e900b6dae2a2c7c87588574d10", "input_samples": 36391, "input_s": 2.274, "n_real_chunks": 3, "score": 0.5978, "act": 0.9985, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Reese Witherspoon has been married twice: Ryan Phillippe — married in 1999, divorced in 2008 , Jim Toth — married in 2011, divorced in 2023 She is not currently married. (latimes.com)", "expert_answer": "Reese Witherspoon has been married twice:\n\n- **Ryan Phillippe** — married in **1999**, divorced in **2008**\n- **Jim Toth** — married in **2011**, divorced in **2023**\n\nShe is **not currently married**. ([latimes.com](https://www.latimes.com/archives/blogs/ministry-of-gossip/story/2011-03-27/reese-witherspoon-marries-jim-toth-at-her-ojai-ranch?utm_source=openai))", "transcript": "Who did Reese Witherspoon get married to?\n", "asr_s": 1.31, "expert_s": 5.06, "expert_input_samples": 36391, "expert_input_s": 2.274, "expert_input_sha256": "eee4f721533d1c4b6be7beb8971e97990c9577e900b6dae2a2c7c87588574d10", "expert_timed_out": false, "wait_s": 5.182, "relay_synth_ms": 7181, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 170, "feed_lag_sum_ms": 170, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0187_aggressive_relay.wav", "sha256": "b0145d3f24516c2062d8ea7b17a6e64fc7094ce490487652c52d5b362b382bf2", "sr": 24000, "seconds": 14.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0187_aggressive_candidate.wav", "sha256": "1fcb8d1f5102e91ccad7341dd88d7bf0ad18a471ea2b1be9e0532820e1008cb5", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0187_aggressive_stall.wav", "sha256": "84a6ed1e88aa2b479e94ad717ed61efc49d1fb2e9260cc1b16248cf889e971eb", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.058, 1.106, 1, 0, 0], [1, 1, 2.0, 2.058, 2.105, 1, 0, 0], [2, 1, 2.274, 2.333, 2.381, 1, 0, 0], [3, 0, 3.274, 3.335, 3.942, 0, 24000, 0], [4, 0, 4.274, 4.504, 5.13, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.274, "last_real_feed_done": 2.333, "onset": 3.942, "gate_read_done": 3.942, "fire": 3.942, "candidate_first_pcm": 3.942, "stall_note": 3.943, "stall_first_pcm": 4.445, "local_first_pcm": null, "wait_start": 5.13, "expert_req": 3.943, "expert_resp": 10.311, "relay_synth_start": 10.312, "relay_first_pcm": 11.001, "relay_synth_end": 17.493, "first_any_pcm": 3.942, "first_answer_pcm": 11.001, "session_end": 17.633}, "ttfa_answer_s": 8.727, "ttfa_any_s": 1.667}
{"id": "swebq0195", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2582281941, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what do christians believe about heaven hell and purgatory?", "input_path": "/data/bench_audio/swebq0195.wav", "input_sha256": "6c3b79595e4677348f44e7a71a3b3a407f816aac0f8a3dca9371983e5ba53704", "input_samples": 44564, "input_s": 2.785, "n_real_chunks": 3, "score": 0.5036, "act": 0.9989, "is_info": true, "fired": false, "mode": "local", "answer": "I mean, the idea of heaven and hell is very much part of Christian belief. And there are different ways that people talk about it in different churches or denominations, but generally speaking, the idea is that we have a life on earth and then when we die, our souls go to one place or another based on how well we lived our lives here on Earth. Now, some people believe that there' s only two places you can go after death either heaven or hell. Other people believe that there's also a third place called purgatory where your soul goes if you've done good things but not enough good things to get into heaven right away.And so you need to kind of work out your sins before you can get into heaven. So those are kind of the main ideas around heaven and hell and pur gatory.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 39, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0195_aggres