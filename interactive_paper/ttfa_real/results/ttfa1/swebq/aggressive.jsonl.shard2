{"id": "swebq0203", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2735595248, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what to visit in atlanta?", "input_path": "/data/bench_audio/swebq0203.wav", "input_sha256": "c5f6cf22d4be07cb880b61d7f51af730f15797e8f6353ddd4be069304a550b02", "input_samples": 26731, "input_s": 1.671, "n_real_chunks": 2, "score": 0.2503, "act": 0.997, "is_info": true, "fired": false, "mode": "local", "answer": "There are many things to visit in Atlanta, depending on your interests. If you love history and culture, the Martin Luther King Jr. National Historic Site is a must-see, as it includes his birthplace home and the Ebenezer B oulder Baptist Church. For art and architecture, the High Museum of Art offers an impressive collection from around the world. The Georgia State Capitol building is also worth visiting for its stunning design and historical significance. Nature lovers can enjoy Piedmont Park, which features walking trails, picnic areas, and even a small zoo. And if you're into sports or entertainment, check out Philips Arena or Mercedes-Benz Stadium, especially during major events like the Super Bowl or concert s. Also, don't miss the World of Coca-Cola, where you can learn about the brand's history and taste different flavors from around the globe. With so much to explore, there’s something for everyone in Atlanta!", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 50, "feed_