{"id": "swebq0006", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3504602641, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where to get a marriage license in long island?", "input_path": "/data/bench_audio/swebq0006.wav", "input_sha256": "0208d8cb59334feca8f4e118906df839c958574c74f4ae5cfe3ede2791f1ee24", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.7191, "act": 0.9983, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "In Long Island, NY, you get a marriage license from a Town Clerk or City Clerk, not from the county clerk. Call ahead or check that office’s website for appointments, ID requirements, fees, and hours.", "expert_answer": "In **Long Island, NY**, you get a marriage license from a **Town Clerk or City Clerk**, not from the county clerk.\n\n**Nassau County:** licenses are issued by the **3 towns and 2 cities**—Hempstead, North Hempstead, Oyster Bay, Glen Cove, or Long Beach. ([nassaucountyny.gov](https://www.nassaucountyny.gov/479/Vital-Records?utm_source=openai))\n\n**Suffolk County:** go to a **Town Clerk/Registrar**—Babylon, Brookhaven, East Hampton, Huntington, Islip, Riverhead, Shelter Island, Smithtown, Southampton, or Southold. ([suffolkcountyny.gov](https://suffolkcountyny.gov/Elected-Officials/County-Clerk/Birth-Marriage-and-Death-Certificates?utm_source=openai))\n\n**Key tip:** In New York State, you can generally obtain a marriage license from **any town or city clerk in the state**, and use it anywhere in New York State—so pick the clerk’s office most convenient for you. Call ahead or check that office’s website for appointments, ID requirements, fees, and hours.", "transcript": "Where to get a marriage license in Long Island.\n", "asr_s": 3.0, "expert_s": 7.06, "expert_input_samples": 40106, "expert_input_s": 2.507, "expert_input_sha256": "0208d8cb59334feca8f4e118906df839c958574c74f4ae5cfe3ede2791f1ee24", "expert_timed_out": false, "wait_s": 7.331, "relay_synth_ms": 5466, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0006_aggressive_relay.wav", "sha256": "101fded61544492db03f07a715da871da0d8db1ed42c4e0bfdc66554cfddc366", "sr": 24000, "seconds": 12.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0006_aggressive_candidate.wav", "sha256": "d5126518fcc18d14f8cee94b8edc5dae9deb667bdf8a32d6f8c4dde152eed745", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0006_aggressive_stall.wav", "sha256": "a8cbcc2e0b7bc8783b0c8693778592c5b72b722b5a3a8bdb9382ab5d5d5d424d", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.052, 1.094, 1, 0, 0], [1, 1, 2.0, 2.054, 2.096, 1, 0, 0], [2, 1, 2.507, 2.559, 2.601, 1, 0, 0], [3, 0, 3.507, 3.561, 4.165, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.507, "last_real_feed_done": 2.559, "onset": 4.165, "gate_read_done": 4.165, "fire": 4.165, "candidate_first_pcm": 4.165, "stall_note": 4.166, "stall_first_pcm": 6.892, "local_first_pcm": null, "wait_start": 6.892, "expert_req": 4.166, "expert_resp": 14.222, "relay_synth_start": 14.223, "relay_first_pcm": 14.85, "relay_synth_end": 19.69, "first_any_pcm": 4.165, "first_answer_pcm": 14.85, "session_end": 19.815}, "ttfa_answer_s": 12.343, "ttfa_any_s": 1.659}
{"id": "swebq0063", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4141067544, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what county is west st paul in?", "input_path": "/data/bench_audio/swebq0063.wav", "input_sha256": "20fb37ff230ad388edbf4953519f6a7ab7df019f03ba4740a859fea22320ea60", "input_samples": 33419, "input_s": 2.089, "n_real_chunks": 3, "score": 0.6795, "act": 0.9974, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "West St. Paul is in Dakota County, Minnesota.", "expert_answer": "West St. Paul is in **Dakota County, Minnesota**.", "transcript": "What county is West St. Paul in?\n", "asr_s": 0.66, "expert_s": 1.98, "expert_input_samples": 33419, "expert_input_s": 2.089, "expert_input_sha256": "20fb37ff230ad388edbf4953519f6a7ab7df019f03ba4740a859fea22320ea60", "expert_timed_out": false, "wait_s": 2.05, "relay_synth_ms": 1523, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 10, "feed_lag_sum_ms": 10, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0063_aggressive_relay.wav", "sha256": "7aa678ab10e97b05ccbd8680f47aa002becdeaf2b8fbf2b4fac92d8625a2e1a6", "sr": 24000, "seconds": 3.4}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0063_aggressive_candidate.wav", "sha256": "452a16b983117adf6020f8aea111e68b1bdd60473e3e336ac24d5fce37c2a6fd", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0063_aggressive_stall.wav", "sha256": "c2c467cf957d3fa51d3b14af935ec17e002bd6497c8118531654c8699a7b9a30", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.056, 2.099, 1, 0, 0], [