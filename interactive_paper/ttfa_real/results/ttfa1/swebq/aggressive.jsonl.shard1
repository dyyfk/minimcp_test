{"id": "swebq0213", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3122065329, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what football team is michael vick on?", "input_path": "/data/bench_audio/swebq0213.wav", "input_sha256": "c4c864272b954a7234c351ae0334af8dd9eeeb1e4a9d19d7269e782a036b2d7c", "input_samples": 30446, "input_s": 1.903, "n_real_chunks": 2, "score": 0.68, "act": 0.9987, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Michael Vick is not currently on an NFL team as a player—he’s retired. As of now, he is the head football coach at Norfolk State University. (nsuspartans.com)", "expert_answer": "Michael Vick is **not currently on an NFL team as a player**—he’s retired.\n\nAs of now, he is the **head football coach at Norfolk State University**. ([nsuspartans.com](https://nsuspartans.com/staff-directory/michael-vick/1407?utm_source=openai))", "transcript": "What football team is Michael Vick on?\n", "asr_s": 0.57, "expert_s": 4.66, "expert_input_samples": 30446, "expert_input_s": 1.903, "expert_input_sha256": "c4c864272b954a7234c351ae0334af8dd9eeeb1e4a9d19d7269e782a036b2d7c", "expert_timed_out": false, "wait_s": 4.598, "relay_synth_ms": 5008, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0213_aggressive_relay.wav", "sha256": "f24d46d294bc682964b9b8dd1ed8811dae5be20c74e5b65b1f761afbc0b10e66", "sr": 24000, "seconds": 12.16}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0213_aggressive_stall.wav", "sha256": "7d364f7cca55d0f587b7b5b951f19751299405ea47373e184405a9146ac