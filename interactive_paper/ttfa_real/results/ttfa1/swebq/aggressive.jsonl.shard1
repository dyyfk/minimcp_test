{"id": "swebq0186", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 435691054, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "which dawkins book to read first?", "input_path": "/data/bench_audio/swebq0186.wav", "input_sha256": "2882b59aeb5daecf267f8ab7a831dee93f3f5b653b624fa693ae5d229e5bb4ca", "input_samples": 39363, "input_s": 2.46, "n_real_chunks": 3, "score": 0.7071, "act": 0.9921, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Start with The Selfish Gene. It’s Richard Dawkins’s most influential and accessible core book: it introduces his gene-centered view of evolution and the idea of “memes.” If you’re mainly interested in atheism/religion rather than evolutionary biology, then start with The God Delusion instead. Suggested order: The Selfish Gene — best overall starting point , The Blind Watchmaker — evolution and design arguments , The God Delusion — religion/atheism , The Ancestor’s Tale — broader evolutionary history", "expert_answer": "Start with **_The Selfish Gene_**.\n\nIt’s Richard Dawkins’s most influential and accessible core book: it introduces his gene-centered view of evolution and the idea of “memes.” If you’re mainly interested in atheism/religion rather than evolutionary biology, then start with **_The God Delusion_** instead.\n\nSuggested order:\n\n1. **_The Selfish Gene_** — best overall starting point  \n2. **_The Blind Watchmaker_** — evolution and design arguments  \n3. **_The God Delusion_** — religion/atheism  \n4. **_The Ancestor’s Tale_** — broader evolutionary history", "transcript": "Which Dawkins book to read first?\n", "asr_s": 0.67, "expert_s": 3.18, "expert_input_samples": 39363, "expert_input_s": 2.46, "expert_input_sha256": "2882b59aeb5daecf267f8ab7a831dee93f3f5b653b624fa693ae5d229e5bb4ca", "expert_timed_out": false, "wait_s": 2.103, "relay_synth_ms": 13983, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 2, "feed_lag_max_ms": 122, "feed_lag_sum_ms": 122, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0186_aggressive_relay.wav", "sha256": "cb9013f8bc5822fcd6219bc46a86ae48b9bafd799016600880727a2ec2f831fb", "sr": 24000, "seconds": 33.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0186_aggressive_candidate.wav", "sha256": "c16b810fac44e2e0895eb1de53f7273ae9257d8737c538c8d837c7e014bca07b", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0186_aggressive_stall.wav", "sha256": "93ca6da074fcc84509ad67f55f0c5854fdea0b70ea14c1b1c1881b382500d5a5", "sr": 24000, "seconds": 2.64}}, "chunks": [[0, 1, 1.0, 1.051, 1.093, 1, 0, 0], [1, 1, 2.0, 2.056, 2.1, 1, 0, 0], [2, 1, 2.46, 2.516, 2.56, 1, 0, 0], [3, 0, 3.46, 3.513, 4.069, 0, 24000, 0], [4, 0, 4.46, 4.637, 5.149, 0, 24000, 0], [5, 0, 5.46, 5.516, 5.824, 0, 15360, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.46, "last_real_feed_done": 2.516, "onset": 4.069, "gate_read_done": 4.069, "fire": 4.07, "candidate_first_pcm": 4.069, "stall_note": 4.07, "stall_first_pcm": 4.583, "local_first_pcm": null, "wait_start": 5.824, "expert_req": 4.07, "expert_resp": 7.927, "relay_synth_start": 7.927, "relay_first_pcm": 8.551, "relay_synth_end": 21.91, "first_any_pcm": 4.069, "first_answer_pcm": 8.551, "session_end": 22.323}, "ttfa_answer_s": 6.091, "ttfa_any_s": 1.609}
{"id": "swebq0194", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4008529475, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what countries does greece share borders with?", "input_path": "/data/bench_audio/swebq0194.wav", "input_sha256": "e55686ca113e34a77b02c6c7557de21cefa747c5a121c4a8b5cd464d75aba363", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.4875, "act": 0.9984, "is_info": true, "fired": false, "mode": "local", "answer": "Greece shares borders with four countries. It has a land border with Albania to the north, North Macedon ia to the northwest, and Bulgaria to the northeast. The fourth country is Turkey, but that's across the Aegean Sea, so it's not a land border.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0194_aggressive_local.wav", "sha256": "d01d96e89a2bacdf57561798875a18ca51430c6074f96f94d714c6a8dee297ee", "sr": 24000, "seconds": 14.16}}, "chunks": [[0, 1, 1.0, 1.051, 1.093, 1, 0, 0], [1, 1, 2.0, 2.058, 2.103, 1, 0, 0], [2, 1, 2.182, 2.238, 2.282, 1, 0, 0], [3, 0, 3.182, 3.235, 3.588, 0, 24000, 0], [4, 0, 4.182, 4.235, 4.761, 0, 24000, 0], [5, 0, 5.182, 5.239, 5.79, 0, 24000, 0], [6, 0, 6.182, 6.239, 6.743, 0, 24000, 0], [7, 0, 7.182, 7.241, 7.797, 0, 24000, 0], [8, 0, 8.182, 8.24, 8.82, 0, 24000, 0], [9, 0, 9.182, 9.241, 9.702, 0, 24000, 0], [10, 0, 10.182, 10.241, 10.795, 0, 24000, 0], [11, 0, 11.182, 11.241, 11.797, 0, 24000, 0], [12, 0, 12.182, 12.242, 12.774, 0, 24000, 0], [13, 0, 13.182, 13.242, 13.771, 0, 24000, 0], [14, 0, 14.182, 14.242, 14.82, 0, 24000, 0], [15, 0, 15.182, 15.241, 15.774, 0, 24000, 0], [16, 0, 16.182, 16.242, 16.671, 0, 27840, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.182, "last_real_feed_done": 2.238, "onset": 3.588, "gate_read_done": 3.588, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 3.588, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 3.588, "first_answer_pcm": 3.588, "session_end": 16.671}, "ttfa_answer_s": 1.407, "ttfa_any_s": 1.407}
{"id": "swebq0202", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3557486182, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "where are kohler sinks manufactured?", "input_path": "/data/bench_audio/swebq0202.wav", "input_sha256": "00a8559ac79e32d95401314b7e9eba5f0ddefe485419b77447bfd74899989b1f", "input_samples": 41592, "input_s": 2.599, "n_real_chunks": 3, "score": 0.9125, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Kohler sinks are manufactured in multiple countries, not just one location. Kohler is a global company with manufacturing facilities around the world, and the country of origin varies by sink model and material.", "expert_answer": "Kohler sinks are manufactured in **multiple countries**, not just one location. Kohler is a global company with manufacturing facilities around the world, and the **country of origin varies by sink model and material**.\n\nNotably:\n\n- Some Kohler **enameled cast iron sinks** and specialty/artisan sinks are made in **Kohler, Wisconsin, USA**.\n- Other Kohler sinks may be made in other countries, depending on the product line and model.\n- Kohler says the carton label usually indicates the origin as **“Crafted in [country]”** near the UPC/barcode. ([lowes.com](https://www.lowes.com/questions/kohler-13463-cp-bathroom-sink-faucets/5002129855/2eb023da-bc90-556a-800b-c8e9e041b359?utm_source=openai))\n- Kohler also states it operates manufacturing facilities globally and builds products to the same quality standards regardless of facility location. ([lowes.com](https://www.lowes.com/questions/kohler-2356-8-0-bathroom-sinks/999942774/c1c9ee87-f6a8-5a27-8c90-f6c99872bc23?utm_source=openai))\n\nIf you have a specific model number, check the box label or product documentation—or send me the model number and I can help look it up.", "transcript": "Where are Kohler sinks manufactured?\n", "asr_s": 0.66, "expert_s": 5.02, "expert_input_samples": 41592, "expert_input_s": 2.599, "expert_input_sha256": "00a8559ac79e32d95401314b7e9eba5f0ddefe485419b77447bfd74899989b1f", "expert_timed_out": false, "wait_s": 5.076, "relay_synth_ms": 5390, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_aggressive_relay.wav", "sha256": "81976b192780ce66616568154bd5e3e58ed3af126540e498d5674d3b2739a89b", "sr": 24000, "seconds": 12.36}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_aggressive_candidate.wav", "sha256": "a5c0c94bbcb9c2bc0e883522aee3d630a0dcea3b89ff00b51eb8e38955574d7a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0202_aggressive_stall.wav", "sha256": "e4842f54e0e0c1c80b2f2a791e326eb032c0c4f46fa5f0a4110528ba5095b031", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.056, 1.101, 1, 0, 0], [1, 1, 2.0, 2.057, 2.101, 1, 0, 0], [2, 1, 2.599, 2.656, 2.7, 1, 0, 0], [3, 0, 3.599, 3.656, 4.182, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.599, "last_real_feed_done": 2.656, "onset": 4.182, "gate_read_done": 4.183, "fire": 4.183, "candidate_first_pcm": 4.182, "stall_note": 4.183, "stall_first_pcm": 4.78, "local_first_pcm": null, "wait_start": 4.78, "expert_req": 4.183, "expert_resp": 9.857, "relay_synth_start": 9.857, "relay_first_pcm": 10.484, "relay_synth_end": 15.248, "first_any_pcm": 4.182, "first_answer_pcm": 10.484, "session_end": 15.365}, "ttfa_answer_s": 7.885, "ttfa_any_s": 1.583}
