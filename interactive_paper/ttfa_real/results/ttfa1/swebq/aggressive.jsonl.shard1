{"id": "swebq0221", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2134236510, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who was queen victoria's husband?", "input_path": "/data/bench_audio/swebq0221.wav", "input_sha256": "d730b270b3145d21f8760534fa365b2204da64cc7538ba5e4a0329d06fc60ed4", "input_samples": 31190, "input_s": 1.949, "n_real_chunks": 2, "score": 0.1972, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "Queen Victoria's husband was Prince Albert of Saxe- Coburg and Gotha. He became the Prince Consort after they married in 1840. He played a significant role in shaping British culture and politics during her reign.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0221_aggressive_local.wav", "sha256": "7f52b50adbeb7ecadb1d94a75b8e8ec380cc42f559710d084ac1966e881ff380", "sr": 24000, "seconds": 11.04}}, "chunks": [[0, 1, 1.0, 1.054, 1.098, 1, 0, 0], [1, 1, 1.949, 2.003, 2.045, 1, 0, 0], [2, 0, 2.949, 3.006, 3.05, 1, 0, 0], [3, 0, 3.949, 4.002, 4.525, 0, 24000, 0], [4, 0, 4.949, 5.007, 5.577, 0, 24000, 0], [5, 0, 5.949, 6.007, 6.605, 0, 24000, 0], [6, 0, 6.949, 7.004, 7.509, 0, 24000, 0], [7, 0, 7.949, 8.007, 8.536, 0, 24000, 0], [8, 0, 8.949, 9.005, 9.581, 0, 24000, 0], [9, 0, 9.949, 10.003, 10.487, 0, 24000, 0], [10, 0, 10.949, 11.007, 11.531, 0, 24000,