1.81, 1.867, 1.91, 1, 0, 0], [2, 0, 2.81, 2.867, 2.911, 1, 0, 0], [3, 0, 3.81, 3.867, 4.412, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.81, "last_real_feed_done": 1.867, "onset": 4.412, "gate_read_done": 4.412, "fire": 4.412, "candidate_first_pcm": 4.412, "stall_note": 4.413, "stall_first_pcm": 5.006, "local_first_pcm": null, "wait_start": 5.006, "expert_req": 4.412, "expert_resp": 7.703, "relay_synth_start": 7.704, "relay_first_pcm": 8.33, "relay_synth_end": 9.449, "first_any_pcm": 4.412, "first_answer_pcm": 8.33, "session_end": 9.55}, "ttfa_answer_s": 6.52, "ttfa_any_s": 2.602}
{"id": "swebq0116", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3359286631, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "who did john kennedy have affairs with?", "input_path": "/data/bench_audio/swebq0116.wav", "input_sha256": "48392299c64addfa189daf9323aabe784f7a1f1912dac6fa43063282212cc62d", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.8108, "act": 0.9967, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "John F. Kennedy is widely reported by historians and journalists to have had extramarital affairs, but the evidence varies from well-attested to disputed.", "expert_answer": "John F. Kennedy is widely reported by historians and journalists to have had extramarital affairs, but the evidence varies from well-attested to disputed. Commonly named women include:\n\n- **Mimi Alford** — a White House intern who later wrote a memoir describing an 18-month affair with JFK. ([abcnews.com](https://abcnews.com/blogs/politics/2012/02/jfks-innocent-ex-intern-writes-a-book-about-alleged-affair?utm_source=openai))\n- **Judith Campbell Exner** — a socialite whose relationship with JFK was corroborated in part by government records and later public accounts. ([latimes.com](https://www.latimes.com/archives/la-xpm-1999-sep-26-mn-14342-story.html?utm_source=openai))\n- **Mary Pinchot Meyer** — a Washington socialite and friend of Jackie Kennedy; often cited as one of JFK’s more credible affairs. ([history.com](https://www.history.com/articles/presidential-affairs-jfk-lbj-fdr-harding-clinton-trump?utm_source=openai))\n- **Pamela Turnure** — Jackie Kennedy’s press secretary; frequently reported by biographers as having had an affair with JFK. ([en.wikipedia.org](https://en.wikipedia.org/wiki/John_F._Kennedy?utm_source=openai))\n- **Marilyn Monroe** — often alleged, but the evidence is much more disputed; some historians treat it as unproven or possibly limited to a brief encounter. ([latimes.com](https://www.latimes.com/archives/la-xpm-1993-06-02-me-42303-story.html?utm_source=openai))\n- **Marlene Dietrich** — alleged in several accounts, though less central and less firmly documented than Alford, Exner, or Meyer. ([en.wikipedia.org](https://en.wikipedia.org/wiki/John_F._Kennedy?utm_source=openai))\n- **Ellen Rometsch** — alleged by some sources to have had a relationship with JFK; her case became controversial because she was suspected of possible East German intelligence ties. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Ellen_Rometsch?utm_source=openai))\n- **Inga Arvad** — a Danish journalist linked romantically with Kennedy before his presidency; the FBI monitored her because of suspected Nazi connections. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Judith_Exner?utm_source=openai))\n\nSo, the **most credibly documented** names are usually considered **Mimi Alford, Judith Campbell Exner, and Mary Pinchot Meyer**, while names like **Marilyn Monroe** remain famous but more disputed.", "transcript": "Who did John Kennedy have affairs with?\n", "asr_s": 0.54, "expert_s": 10.4, "expert_input_samples": 40106, "expert_input_s": 2.507, "expert_input_sha256": "48392299c64addfa189daf9323aabe784f7a1f1912dac6fa43063282212cc62d", "expert_timed_out": false, "wait_s": 10.131, "relay_synth_ms": 3836, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 42, "feed_lag_sum_ms": 42, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_aggressive_relay.wav", "sha256": "b5547af9bec7befb55d44a84115d8acd9d3225a6c4f9a0d2f50473e016afdbd6", "sr": 24000, "seconds": 8.8}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_aggressive_candidate.wav", "sha256": "92237756df9fb1b90198c38b0f1ed12ddbbc09f1454f81c909287f31d9a2143e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0116_aggressive_stall.wav", "sha256": "8225faf506cdc4e7bddb8148fab8a41480748b0954f018acd56ab85cb228293a", "sr": 24000, "seconds": 1.32}}, "chunks": [[0, 1, 1.0, 1.056, 1.1, 1, 0, 0], [1, 1, 2.0, 2.058, 2.102, 1, 0, 0], [2, 1, 2.507, 2.565, 2.611, 1, 0, 0], [3, 0, 3.507, 3.563, 4.089, 0, 24000, 0], [4, 0, 4.507, 4.605, 4.895, 0, 7680, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.507, "last_real_feed_done": 2.565, "onset": 4.089, "gate_read_done": 4.089, "fire": 4.089, "candidate_first_pcm": 4.089, "stall_note": 4.09, "stall_first_pcm": 4.549, "local_first_pcm": null, "wait_start": 4.895, "expert_req": 4.09, "expert_resp": 15.026, "relay_synth_start": 15.027, "relay_first_pcm": 15.656, "relay_synth_end": 18.864, "first_any_pcm": 4.089, "first_answer_pcm": 15.656, "session_end": 19.481}, "ttfa_answer_s": 13.15, "ttfa_any_s": 1.583}
{"id": "swebq0124", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 219781000, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "what countries have territories in oceania?", "input_path": "/data/bench_audio/swebq0124.wav", "input_sha256": "f9263489e6686f682d6d2a0d877b455e8e3919ed1f3b6bd213a70e960198a638", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.6458, "act": 0.9986, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Depending on how Oceania is defined, the countries with territory in Oceania include: Independent countries generally considered part of Oceania: Australia , New Zealand , Papua New Guinea , Fiji , Solomon Islands , Vanuatu , Samoa , Tonga , Kiribati , Tuvalu , Nauru , Palau , Marshall Islands , Federated States of Micronesia Countries outside Oceania that have territories or possessions in.", "expert_answer": "Depending on how **Oceania** is defined, the countries with territory in Oceania include:\n\n**Independent countries generally considered part of Oceania:**\n- Australia\n- New Zealand\n- Papua New Guinea\n- Fiji\n- Solomon Islands\n- Vanuatu\n- Samoa\n- Tonga\n- Kiribati\n- Tuvalu\n- Nauru\n- Palau\n- Marshall Islands\n- Federated States of Micronesia\n\n**Countries outside Oceania that have territories or possessions in Oceania:**\n- **United States** — Guam, American Samoa, Northern Mariana Islands, Hawaii, etc.\n- **France** — French Polynesia, New Caledonia, Wallis and Futuna\n- **United Kingdom** — Pitcairn Islands\n- **Chile** — Easter Island / Rapa Nui\n- **Indonesia** — Western New Guinea, often included in Oceania geographically\n- **New Zealand** — Cook Islands, Niue, Tokelau, Ross Dependency\n- **Australia** — Norfolk Island, Christmas Island, Cocos Islands, Australian Antarctic Territory\n\nSo, in a broad geographic sense, the main countries with territory in Oceania are: **Australia, New Zealand, Papua New Guinea, Fiji, Solomon Islands, Vanuatu, Samoa, Tonga, Kiribati, Tuvalu, Nauru, Palau, Marshall Islands, Micronesia, United States, France, United Kingdom, Chile, and Indonesia.**", "transcript": "What countries have territories in Oceania?\n", "asr_s": 0.65, "expert_s": 9.47, "expert_input_samples": 37134, "expert_input_s": 2.321, "expert_input_sha256": "f9263489e6686f682d6d2a0d877b455e8e3919ed1f3b6bd213a70e960198a638", "expert_timed_out": false, "wait_s": 8.894, "relay_synth_ms": 14722, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_aggressive_relay.wav", "sha256": "89a789a772e01e64e568484c4b923d9fd06fbab0c0deab5a774eec70ecdc30c5", "sr": 24000, "seconds": 36.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_aggressive_candidate.wav", "sha256": "d730a2e46949163758c2af95b5b6378ecb30f740b36ea183777c3e75e3e5bd90", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0124_aggressive_stall.wav", "sha256": "727db59fefd5cc91f7cbcf3c6863b7d362327916b90ed04bd23ae264310f976b", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.056, 1.101, 1, 0, 0], [1, 1, 2.0, 2.057, 2.101, 1, 0, 0], [2, 1, 2.321, 2.377, 2.421, 1, 0, 0], [3, 0, 3.321, 3.378, 3.722, 0, 24000, 0], [4, 0, 4.321, 4.381, 4.956, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.321, "last_real_feed_done": 2.377, "onset": 3.722, "gate_read_done": 3.722, "fire": 3.722, "candidate_first_pcm": 3.722, "stall_note": 3.723, "stall_first_pcm": 4.181, "local_first_pcm": null, "wait_start": 4.956, "expert_req": 3.722, "expert_resp": 13.85, "re