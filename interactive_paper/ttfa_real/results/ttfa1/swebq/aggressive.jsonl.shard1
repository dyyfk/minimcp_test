\nHe’s also well known for playing **Kyle Trager in the TV series _Kyle XY_**, but that’s a show, not a movie. ([en.wikipedia.org](https://en.wikipedia.org/wiki/Matt_Dallas?utm_source=openai))", "transcript": "What movies does Matt Dallas play in?\n", "asr_s": 0.65, "expert_s": 6.06, "expert_input_samples": 34905, "expert_input_s": 2.182, "expert_input_sha256": "10a061b67e88bce8e49bb229e5d5deff894ba97002e5f4a1b55cf24c59cd72be", "expert_timed_out": false, "wait_s": 5.606, "relay_synth_ms": 4909, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 55, "feed_lag_sum_ms": 55, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0098_aggressive_relay.wav", "sha256": "f2cb92dc88acdf49daf4ba47384ea0355d7028b9c91669c849f225521db0980f", "sr": 24000, "seconds": 11.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0098_aggressive_candidate.wav", "sha256": "080620242b2585c1816ba07c70d8d52a7a6721526c29f7399f665dc55c99f3cb", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0098_aggressive_stall.wav", "sha256": "368286fef53e29c05e0d6cd20ad7c97641c67c4c1208f629aa066a8e1e3966be", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.052, 1.094, 1, 0, 0], [1, 1, 2.0, 2.053, 2.095, 1, 0, 0], [2, 1, 2.182, 2.233, 2.275, 1, 0, 0], [3, 0, 3.182, 3.238, 3.772, 0, 24000, 0], [4, 0, 4.182, 4.292, 4.873, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.182, "last_real_feed_done": 2.233, "onset": 3.772, "gate_read_done": 3.772, "fire": 3.772, "candidate_first_pcm": 3.772, "stall_note": 3.773, "stall_first_pcm": 4.237, "local_first_pcm": null, "wait_start": 4.873, "expert_req": 3.773, "expert_resp": 10.479, "relay_synth_start": 10.479, "relay_first_pcm": 11.107, "relay_synth_end": 15.389, "first_any_pcm": 3.772, "first_answer_pcm": 11.107, "session_end": 15.508}, "ttfa_answer_s": 8.926, "ttfa_any_s": 1.59}
