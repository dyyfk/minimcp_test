{"id": "swebq0216", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3397131070, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "what was the ancient chinese writing system?", "input_path": "/data/bench_audio/swebq0216.wav", "input_sha256": "a529dcfbef3cbb93807c9f9ebf6fd41e875b1340541c29a141e3170f2dc94e41", "input_samples": 43821, "input_s": 2.739, "n_real_chunks": 3, "score": 0.4618, "act": 0.9981, "is_info": true, "fired": false, "mode": "local", "answer": "The ancient Chinese writing system was logographic, meaning each character represented a word or concept rather than sounds. These characters were used for thousands of years and evolved from simple pictographs to more complex forms. Over time, the script became standardized, especially after reforms during the Han Dynasty, making it easier to read and write across different regions of China.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 23, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0216_balanced_local.wav", "sha256": "8355a1196ab4b11ba3986a33519a44cb8bd9d7e702677532f296b555f0b93554", "sr": 24000, "seconds": 22.52}}, "chunks": [[0, 1, 1.0, 1.054, 1.097, 1, 0, 0], [1, 1, 2.0, 2.054, 2.096, 1, 0, 0], [2, 1, 2.739, 2.793, 2.835, 1, 0, 0], [3, 0, 3.739, 3.794, 4.223, 0, 24000, 0], [4, 0, 4.739, 4.797, 5.279, 0, 24000, 0], [5, 0, 5.739, 5.794, 6.332, 0, 24000, 0], [6, 0, 6.739, 6.795, 7.27