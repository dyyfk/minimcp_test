{"id": "swebq0207", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2757761769, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "where did george michael go to school?", "input_path": "/data/bench_audio/swebq0207.wav", "input_sha256": "93271712eef546ad36585f0a09a4ee09e681091f66822e6181ddb6878e615379", "input_samples": 32676, "input_s": 2.042, "n_real_chunks": 3, "score": 0.8581, "act": 0.9965, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "George Michael, the British singer, attended Roe Green Junior School and later Kingsbury High School in London. He also attended Bushey Meads School in Hertfordshire, where he met Andrew Ridgeley, his future Wham! bandmate.", "expert_answer": "George Michael, the British singer, attended **Roe Green Junior School** and later **Kingsbury High School** in London. He also attended **Bushey Meads School** in Hertfordshire, where he met Andrew Ridgeley, his future Wham! bandmate.", "transcript": "Where did George Michael go to school?\n", "asr_s": 0.53, "expert_s": 3.45, "expert_input_samples": 32676, "expert_input_s": 2.042, "expert_input_sha256": "93271712eef546ad36585f0a09a4ee09e681091f66822e6181ddb6878e615379", "expert_timed_out": false, "wait_s": 2.873, "relay_synth_ms": 5371, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 58, "feed_lag_sum_ms": 103, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0207_balanced_relay.wav", "sha256": "5386fa64104cae90678a10119277c483a8ac9cc997732d8f91b5e39c6cbc748f", "sr": 24000, "seconds": 12.44}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0207_balanced_candidate.wav", "sha256": "da