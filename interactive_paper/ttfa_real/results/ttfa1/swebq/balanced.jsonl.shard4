{"id": "swebq0031", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1705654385, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "who helped eminem started his career?", "input_path": "/data/bench_audio/swebq0031.wav", "input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.8637, "act": 0.9971, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Dr. Dre helped Eminem start his mainstream career. He discovered Eminem after hearing The Slim Shady EP, signed him to Aftermath Entertainment, and produced much of The Slim Shady LP.", "expert_answer": "**Dr. Dre** helped Eminem start his mainstream career. He discovered Eminem after hearing *The Slim Shady EP*, signed him to Aftermath Entertainment, and produced much of *The Slim Shady LP*.", "transcript": "Who helped Eminem started his career?\n", "asr_s": 0.79, "expert_s": 2.15, "expert_input_samples": 37134, "expert_input_s": 2.321, "expert_input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "expert_timed_out": false, "wait_s": 1.877, "relay_synth_ms": 5093, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 61, "feed_lag_sum_ms": 61, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_balanced_relay.wav", "sha256": "2678292b594a72535a7335757cb49628b8d026a89666867fb6b7a61f9f231399", "sr": 24000, "seconds": 11.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_balanced_candidate.wav", "sha256": "62f38d064f88ee9e7a757ecab573b082cd676a3cb7d7ce217486a4374b77e3f8", "sr": 24000, "seconds"