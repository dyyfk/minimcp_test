{"id": "swebq0125", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2048829214, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "where does name pennsylvania come from?", "input_path": "/data/bench_audio/swebq0125.wav", "input_sha256": "a27fd23128bc10b86029ee64890c168dc0284f01524c188c50b938c8468bd126", "input_samples": 34905, "input_s": 2.182, "n_real_chunks": 3, "score": 0.4574, "act": 0.9978, "is_info": true, "fired": false, "mode": "local", "answer": "The name Pennsylvania comes from Penn, which is the last name of William Penn. He was a Quaker who founded the colony in 1681 and wanted to give it a name that meant 'Penn's land.' So, it' s named after him.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 120, "feed_lag_sum_ms": 120, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0125_conservative_local.wav", "sha256": "9cf1318f57a43c0866b9299b4e8afb22adb5c77371d40a686477a09d1be1dd57", "sr": 24000, "seconds": 9.96}}, "chunks": [[0, 1, 1.0, 1.07, 1.124, 1, 0, 0], [1, 1, 2.0, 2.067, 2.12, 1, 0, 0], [2, 1, 2.182, 2.249, 2.304, 1, 0, 0], [3, 0, 3.182, 3.254, 3.898, 0, 24000, 0], [4, 0, 4.182, 4.248, 4.913, 0, 24000, 0], [5, 0, 5.182, 5.248, 5.917, 0, 24000, 0], [6, 0, 6.182, 6.252, 6.885, 0, 24000, 0], [7, 0, 7.182, 7.252, 7.916, 0, 24000, 0], [8, 0, 8.182, 8.252, 8.925, 0, 24000, 0], [9, 0, 9.182, 9.254, 10.302, 0, 24000, 0], [10, 0, 10.182, 10.369, 11.085, 0, 2