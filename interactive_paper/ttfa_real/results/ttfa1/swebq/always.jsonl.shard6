{"id": "swebq0155", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 895431129, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "who fought the battle of gettysburg?", "input_path": "/data/bench_audio/swebq0155.wav", "input_sha256": "d8163e792dc764c7a5f467d223982cad805b70c262fcc0881763b9a6d9ac47a9", "input_samples": 31190, "input_s": 1.949, "n_real_chunks": 2, "score": 0.1988, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Battle of Gettysburg was fought between the Union Army and the Confederate Army during the American Civil War. Specifically: Union: Army of the Potomac, led by Maj. Gen. George G. Meade , Confederacy: Army of Northern Virginia, led by Gen. Robert E. Lee", "expert_answer": "The **Battle of Gettysburg** was fought between the **Union Army** and the **Confederate Army** during the American Civil War.\n\nSpecifically:\n- **Union:** Army of the Potomac, led by **Maj. Gen. George G. Meade**\n- **Confederacy:** Army of Northern Virginia, led by **Gen. Robert E. Lee**", "transcript": "Who fought the Battle of Gettysburg?\n", "asr_s": 0.48, "expert_s": 2.05, "expert_input_samples": 31190, "expert_input_s": 1.949, "expert_input_sha256": "d8163e792dc764c7a5f467d223982cad805b70c262fcc0881763b9a6d9ac47a9", "expert_timed_out": false, "wait_s": 1.922, "relay_synth_ms": 7778, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0155_always_relay.wav", "sha256": "99c98cb6d8433f012ee5c74e5fa429723265731ee00cf943f15be2d877fa8f9b", "sr": 24000, "seconds": 18.0}, "candidate": {"path": "/data/ttfa_real/ttfa