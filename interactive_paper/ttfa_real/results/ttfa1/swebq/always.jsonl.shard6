{"id": "swebq0218", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 767833657, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what kind of government did the united states have after the revolution?", "input_path": "/data/bench_audio/swebq0218.wav", "input_sha256": "24b89e899458e62c3ac9d6645b0b42896f40a87c00d58eb0ccdfa5d3819653bc", "input_samples": 62397, "input_s": 3.9, "n_real_chunks": 4, "score": 0.4127, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "After the American Revolution, the United States first had a confederation government under the Articles of Confederation—a weak central government with most power held by the states.", "expert_answer": "After the American Revolution, the United States first had a **confederation government** under the **Articles of Confederation**—a weak central government with most power held by the states.", "transcript": "What kind of government did the United States have after the Revolution?\n", "asr_s": 0.51, "expert_s": 1.6, "expert_input_samples": 62397, "expert_input_s": 3.9, "expert_input_sha256": "24b89e899458e62c3ac9d6645b0b42896f40a87c00d58eb0ccdfa5d3819653bc", "expert_timed_out": false, "wait_s": 0.064, "relay_synth_ms": 4617, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 2, "feed_lag_max_ms": 100, "feed_lag_sum_ms": 100, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0218_always_relay.wav", "sha256": "78df7cd32f7da6e88b8c98d22d3ca8949d6db28cd2b9a66bbce9cd2ad7ace902", "sr": 24000, "seconds": 11.12}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0218_always_candidate.wav", "sha256": "0a9af448a3c9e27401a06e40abee1f9037dfc6f3285b3b8704f0989729145e1a", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0218_always_stall.wav", "sha256": "0920e1b202a54de30d12c92c51c3bad45430f98ea05278711d95f604fccd272f", "sr": 24000, "seconds": 3.28}}, "chunks": [[0, 1, 1.0, 1.056, 1.1, 1, 0, 0], [1, 1, 2.0, 2.057, 2.101, 1, 0, 0], [2, 1, 3.0, 3.058, 3.102, 1, 0, 0], [3, 1, 3.9, 3.956, 4.002, 1, 0, 0], [4, 0, 4.9, 4.958, 5.483, 0, 24000, 0], [5, 0, 5.9, 6.057, 6.61, 0, 24000, 0], [6, 0, 6.9, 6.957, 7.528, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.9, "last_real_feed_done": 3.956, "onset": 5.483, "gate_read_done": 5.483, "fire": 5.483, "candidate_first_pcm": 5.483, "stall_note": 5.484, "stall_first_pcm": 5.999, "local_first_pcm": null, "wait_start": 7.528, "expert_req": 5.484, "expert_resp": 7.591, "relay_synth_start": 7.592, "relay_first_pcm": 8.217, "relay_synth_end": 12.209, "first_any_pcm": 5.483, "first_answer_pcm": 8.217, "session_end": 12.323}, "ttfa_answer_s": 4.317, "ttfa_any_s": 1.583}
{"id": "swebq0226", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3780200701, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what was sir isaac newton's inventions?", "input_path": "/data/bench_audio/swebq0226.wav", "input_sha256": "606bce8ec43b6a23851e9cb5ded7c9b18665be2d0019d9e1ca0c98b2f2caabc3", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.3723, "act": 0.9989, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Sir Isaac Newton is best known for discoveries and scientific theories, but he also invented or developed several important things: Reflecting telescope — Newton built the first practical reflecting telescope in 1668, using mirrors instead of lenses. , Calculus — He independently developed a form of calculus, which he called the “method of fluxions.” , Laws of motion — He formulated the three.", "expert_answer": "Sir Isaac Newton is best known for **discoveries and scientific theories**, but he also invented or developed several important things:\n\n- **Reflecting telescope** — Newton built the first practical reflecting telescope in 1668, using mirrors instead of lenses.\n- **Calculus** — He independently developed a form of calculus, which he called the “method of fluxions.”\n- **Laws of motion** — He formulated the three laws of motion.\n- **Law of universal gravitation** — He described how gravity acts between masses.\n- **Theory of light and color** — He showed that white light is made of different colors using prisms.\n- **Newton’s method** — A mathematical method for approximating roots of equations.\n- **Generalized binomial theorem** — An extension of the binomial theorem to non-integer powers.\n\nIf you mean **physical inventions**, his main invention was the **reflecting telescope**.", "transcript": "What was Sir Isaac Newton's inventions?\n", "asr_s": 0.64, "expert_s": 4.06, "expert_input_samples": 40106, "expert_input_s": 2.507, "expert_input_sha256": "606bce8ec43b6a23851e9cb5ded7c9b18665be2d0019d9e1ca0c98b2f2caabc3", "expert_timed_out": false, "wait_s": 4.096, "relay_synth_ms": 11254, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0226_always_relay.wav", "sha256": "3faa17be0f1e31ce3207beae33faff4ec54f321ecfa731ea4d25630436213563", "sr": 24000, "seconds": 27.48}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0226_always_candidate.wav", "sha256": "5621901464b971440725b9c368680cb38de3eb8197279aaddc2778287952d3dc", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0226_always_stall.wav", "sha256": "f200f60665448f276faf938b6b7f0e24d7436c1e7eee723eaef0f423c72630c9", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.099, 1, 0, 0], [1, 1, 2.0, 2.056, 2.101, 1, 0, 0], [2, 1, 2.507, 2.562, 2.605, 1, 0, 0], [3, 0, 3.507, 3.561, 3.998, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.507, "last_real_feed_done": 2.562, "onset": 3.998, "gate_read_done": 3.999, "fire": 3.999, "candidate_first_pcm": 3.998, "stall_note": 3.999, "stall_first_pcm": 4.602, "local_first_pcm": null, "wait_start": 4.602, "expert_req": 3.999, "expert_resp": 8.698, "relay_synth_start": 8.698, "relay_first_pcm": 9.296, "relay_synth_end": 19.952, "first_any_pcm": 3.998, "first_answer_pcm": 9.296, "session_end": 20.094}, "ttfa_answer_s": 6.79, "ttfa_any_s": 1.492}
{"id": "swebq0235", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1631791110, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what team did brandon roy go to?", "input_path": "/data/bench_audio/swebq0235.wav", "input_sha256": "fada3c4e53eba602e6a6306995146ca834ac945746d32f44da2b1c80b4a621eb", "input_samples": 29703, "input_s": 1.856, "n_real_chunks": 2, "score": 0.6937, "act": 0.9965, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Brandon Roy went to the Portland Trail Blazers in the NBA — he was drafted by the Minnesota Timberwolves in 2006 but was traded to Portland on draft night.", "expert_answer": "Brandon Roy went to the **Portland Trail Blazers** in the NBA — he was drafted by the Minnesota Timberwolves in 2006 but was traded to Portland on draft night.", "transcript": "What team did Brandon Roy go to?\n", "asr_s": 0.71, "expert_s": 3.12, "expert_input_samples": 29703, "expert_input_s": 1.856, "expert_input_sha256": "fada3c4e53eba602e6a6306995146ca834ac945746d32f44da2b1c80b4a621eb", "expert_timed_out": false, "wait_s": 2.945, "relay_synth_ms": 3818, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0235_always_relay.wav", "sha256": "bd1d9474cb830ccebdf4af5861c1bfffc90adde240e18ff9ccdc375cf9f680a5", "sr": 24000, "seconds": 8.56}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0235_always_candidate.wav", "sha256": "d4da9aa10f46a4da7ab2898829abdb50e6f1bbc3be05bd74ad76077d76c2db1d", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0235_always_stall.wav", "sha2