{"id": "swebq0246", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3071012731, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what type government does mexico have?", "input_path": "/data/bench_audio/swebq0246.wav", "input_sha256": "7f0e0c4fe22b30e17b3100f3aa4ec6ac060d572cdb2f31d182ae80c6d3016e57", "input_samples": 38620, "input_s": 2.414, "n_real_chunks": 3, "score": 0.2824, "act": 0.9989, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Mexico has a federal presidential constitutional republic. That means it has: a president as head of state and government, a federal system with national and state governments, a constitution, elected representatives in a republican democratic system.", "expert_answer": "Mexico has a **federal presidential constitutional republic**.\n\nThat means it has:\n- a **president** as head of state and government,\n- a **federal system** with national and state governments,\n- a **constitution**,\n- elected representatives in a **republican democratic** system.", "transcript": "What type government does Mexico have?\n", "asr_s": 0.59, "expert_s": 2.82, "expert_input_samples": 38620, "expert_input_s": 2.414, "expert_input_sha256": "7f0e0c4fe22b30e17b3100f3aa4ec6ac060d572cdb2f31d182ae80c6d3016e57", "expert_timed_out": false, "wait_s": 2.833, "relay_synth_ms": 6188, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0246_always_relay.wav", "sha256": "e1e942cfd6bfd098ed0db5b5b5e76d9f90cb9990a396b49334ebced6c992526b", "sr": 24000, "seconds": 15.28}, "candidate": {"path": "/data/ttfa_real/ttfa1/sweb