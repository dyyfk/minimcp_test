{"id": "swebq0041", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 720088758, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "what kind of government does peru?", "input_path": "/data/bench_audio/swebq0041.wav", "input_sha256": "098aa48436ab7be2fb8dc02aefcf76dc009bce4648c145583d8a1370c41554b4", "input_samples": 44564, "input_s": 2.785, "n_real_chunks": 3, "score": 0.3598, "act": 0.996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Peru has a presidential representative democratic republic. That means Peru has: a president as head of state and government, elected representatives, a multi-party system, separate executive, legislative, and judicial branches.", "expert_answer": "Peru has a **presidential representative democratic republic**.\n\nThat means Peru has:\n- a **president** as head of state and government,\n- elected representatives,\n- a **multi-party system**,\n- separate executive, legislative, and judicial branches.", "transcript": "What kind of government does Peru?\n", "asr_s": 0.59, "expert_s": 2.36, "expert_input_samples": 44564, "expert_input_s": 2.785, "expert_input_sha256": "098aa48436ab7be2fb8dc02aefcf76dc009bce4648c145583d8a1370c41554b4", "expert_timed_out": false, "wait_s": 1.857, "relay_synth_ms": 5834, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0041_always_relay.wav", "sha256": "3b5b07d4cec81973a8938fd07e176c63d0d7b4c4a419d273c06c464d6844e892", "sr": 24000, "seconds": 14.08}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0041_always_candidate.wav", "sha256": "e86bed867679