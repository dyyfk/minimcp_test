{"id": "swebq0140", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1546581015, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what are the beliefs of the roman catholic?", "input_path": "/data/bench_audio/swebq0140.wav", "input_sha256": "857f11c6e4abba72b05b68dbcedb9eefbf8b65cf5ddfc25577871fdd27569698", "input_samples": 43821, "input_s": 2.739, "n_real_chunks": 3, "score": 0.5207, "act": 0.9994, "is_info": true, "fired": false, "mode": "local", "answer": "The Roman Catholic Church believes that God created the universe and all things in it, including man. They believe that humans are made in the image of God and have a soul which will live on after death .They also believe in a tri nity of one God who exists as three persons: Father, Son, and Holy Spirit. They believe that Jesus Christ is both fully human and fully divine, and that he died for our sins and rose again from the dead. They believe that the sacraments are important ways to receive grace and grow closer to God.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 29, "feed_lag_max_ms": 8371, "feed_lag_sum_ms": 120358, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0140_aggressive_local.wav", "sha256": "de05b0579fed949c44a9a0388b5550760eafc2c2c1432881adb5754cceaec210", "sr": 24000, "seconds": 28.96}}, "chunks": [[0, 1, 1.0, 1.126, 1.226, 1, 0, 0], [1, 1, 2.0, 2.127, 2.231, 1, 0, 0], [2, 1, 2.739, 2.863, 2.962, 1, 0, 0], [3, 0,