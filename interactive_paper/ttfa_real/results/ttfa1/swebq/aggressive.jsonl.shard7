{"id": "swebq0184", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4160126722, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "when did carolina panthers go to superbowl?", "input_path": "/data/bench_audio/swebq0184.wav", "input_sha256": "64a09023cc804aef253261909ed74fa38bf5687657b930b91df5ff1ad4ea112c", "input_samples": 35648, "input_s": 2.228, "n_real_chunks": 3, "score": 0.757, "act": 0.998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Carolina Panthers have been to the Super Bowl twice: Super Bowl XXXVIII — February 1, 2004 vs. New England Patriots , Super Bowl 50 — February 7, 2016 vs. Denver Broncos They lost both games.", "expert_answer": "The **Carolina Panthers have been to the Super Bowl twice**:\n\n- **Super Bowl XXXVIII** — **February 1, 2004** vs. New England Patriots  \n- **Super Bowl 50** — **February 7, 2016** vs. Denver Broncos  \n\nThey lost both games.", "transcript": "When did Carolina Panthers go to Super Bowl?\n", "asr_s": 0.81, "expert_s": 3.45, "expert_input_samples": 35648, "expert_input_s": 2.228, "expert_input_sha256": "64a09023cc804aef253261909ed74fa38bf5687657b930b91df5ff1ad4ea112c", "expert_timed_out": false, "wait_s": 2.961, "relay_synth_ms": 16426, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0184_aggressive_relay.wav", "sha256": "14dbedd684ef2e1d2ca6f5b74ef5c2077ae2d8e5116499f85689509ad1cb54ed", "sr": 24000, "seconds": 16.68}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0184_aggressive_candidate.wav", "sha256": "317c9b8d6c6b447b075362