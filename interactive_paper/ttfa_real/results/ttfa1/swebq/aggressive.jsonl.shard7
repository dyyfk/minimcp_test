{"id": "swebq0219", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1522730671, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what is the currency of germany now?", "input_path": "/data/bench_audio/swebq0219.wav", "input_sha256": "cd40311e35b842dea5ec9d9a615ee47a8a0d7e32ed2d94f0839678c5ea259fa9", "input_samples": 32676, "input_s": 2.042, "n_real_chunks": 3, "score": 0.3021, "act": 0.9993, "is_info": true, "fired": false, "mode": "local", "answer": "The currency of Germany is the Euro. It' s been used since 1 999, replacing the Deuts chmark. So if you go to Germany now, everything will be in Euros.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 9, "feed_lag_max_ms": 2730, "feed_lag_sum_ms": 12159, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0219_aggressive_local.wav", "sha256": "db376682d4f78a430417a4a990f5b192c681b0048be3189e0d566199f705a6ac", "sr": 24000, "seconds": 9.2}}, "chunks": [[0, 1, 1.0, 1.119, 1.218, 1, 0, 0], [1, 1, 2.0, 2.125, 2.224, 1, 0, 0], [2, 1, 2.042, 2.342, 2.442, 1, 0, 0], [3, 0, 3.042, 3.163, 4.36, 0, 24000, 0], [4, 0, 4.042, 4.483, 5.695, 0, 24000, 0], [5, 0, 5.042, 5.818, 7.065, 0, 24000, 0], [6, 0, 6.042, 7.186, 8.386, 0, 24000, 0], [7, 0, 7.042, 8.509, 9.648, 0, 24000, 0], [8, 0, 8.042, 9.769, 11.008, 0, 24000, 0], [9, 0, 9.042, 11.128, 12.382, 0, 24000, 0], [10, 0, 10.042, 12.508, 13.772, 0, 24000, 0], [11, 0, 11.042, 13.907, 14.905, 0, 28800, 1]], "sta