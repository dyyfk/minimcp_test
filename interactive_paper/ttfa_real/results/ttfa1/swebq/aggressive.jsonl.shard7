, 1.624, 1.762, 1.866, 1, 0, 0], [2, 0, 2.624, 2.745, 2.843, 1, 0, 0], [3, 0, 3.624, 3.748, 4.825, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 1.624, "last_real_feed_done": 1.762, "onset": 4.825, "gate_read_done": 4.825, "fire": 4.825, "candidate_first_pcm": 4.825, "stall_note": 4.826, "stall_first_pcm": 6.198, "local_first_pcm": null, "wait_start": 6.198, "expert_req": 4.826, "expert_resp": 7.149, "relay_synth_start": 7.15, "relay_first_pcm": 8.652, "relay_synth_end": 11.207, "first_any_pcm": 4.825, "first_answer_pcm": 8.652, "session_end": 11.449}, "ttfa_answer_s": 7.027, "ttfa_any_s": 3.201}
{"id": "swebq0210", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 589282827, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what political party does julia gillard belong to?", "input_path": "/data/bench_audio/swebq0210.wav", "input_sha256": "fb8c5df2fe6f26d2316f2ff6b9cade0e7d08f77811dc177e8b193d0fe8e52fd6", "input_samples": 55710, "input_s": 3.482, "n_real_chunks": 4, "score": 0.33, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "Julia Gillard is a member of the Australian Labor Party. She was elected as leader of that party in 201 0 and served as Australia' s prime minister until 2013.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 14, "feed_lag_max_ms": 3162, "feed_lag_sum_ms": 17227, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0210_aggressive_local.wav", "sha256": "2ecfebd02188d7fa07d19555b58c8485d6aa261f27fe2089c3116320105826e6", "sr": 24000, "seconds": 13.44}}, "chunks": [[0, 1, 1.0, 1.121, 1.218, 1, 0, 0], [1, 1, 2.0, 2.121, 2.219, 1, 0, 0], [2, 1, 3.0, 3.127, 3.23, 1, 0, 0], [3, 1, 3.482, 3.6, 3.996, 0, 0, 0], [4, 0, 4.482, 4.609, 5.615, 0, 24000, 0], [5, 0, 5.482, 5.735, 6.901, 0, 24000, 0], [6, 0, 6.482, 7.024, 8.023, 0, 24000, 0], [7, 0, 7.482, 8.142, 9.125, 0, 24000, 0], [8, 0, 8.482, 9.247, 10.386, 0, 24000, 0], [9, 0, 9.482, 10.509, 11.65, 0, 24000, 0], [10, 0, 10.482, 11.772, 12.865, 0, 24000, 0], [11, 0, 11.482, 12.991, 14.185, 0, 240