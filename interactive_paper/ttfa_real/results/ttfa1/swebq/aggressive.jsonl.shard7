{"id": "swebq0227", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2522249323, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what languages do people speak in spain?", "input_path": "/data/bench_audio/swebq0227.wav", "input_sha256": "880f853a00dd17af87026cbaff186c5234fc694f6bf5b0ac1cd8408c42a1c5c8", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.4743, "act": 0.9932, "is_info": true, "fired": false, "mode": "local", "answer": "In Spain, people speak Spanish, which is also called Cast ilian. But actually, there are many different languages spoken in the regions of Spain because it' s a big country with lots of culture and history. Some areas have their own language like Catal an in Catalonia, Basque in the Basque Country, and Gal legan in Galicia. So while Spanish is the main one everyone knows, there are others too depending on where you go!", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 20, "feed_lag_max_ms": 6786, "feed_lag_sum_ms": 64816, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0227_aggressive_local.wav", "sha256": "10fb178570cfe294c3569b185e8bc8449ece706dbac1b98aae3b6c53fbbdb42f", "sr": 24000, "seconds": 19.24}}, "chunks": [[0, 1, 1.0, 1.125, 1.229, 1, 0, 0], [1, 1, 2.0, 2.127, 2.231, 1, 0, 0], [2, 1, 2.832, 2.961, 3.064, 1, 0, 0], [3, 0, 3.832, 3.962, 4.244, 0, 0, 0], [4, 0, 4.832, 4.961, 6.158, 0, 24000, 0], [5, 0, 5.832, 6.288, 7.478, 0, 2400