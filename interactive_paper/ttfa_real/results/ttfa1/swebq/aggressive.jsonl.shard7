{"id": "swebq0051", "pool": "swebq", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 871407607, "protocol": "ttfa-v3", "config_sha256": "8c3af78f4533df26d66383d6216ec5cacb9faa8bb324f3d6a6d51641beeea3a9", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "where is audrey hepburn from?", "input_path": "/data/bench_audio/swebq0051.wav", "input_sha256": "8ec9f41312a92bdfc4f979eea572b5a27b2dd9e65d44e60ecf53b7d5b4fe264b", "input_samples": 34162, "input_s": 2.135, "n_real_chunks": 3, "score": 0.3003, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "Audrey Hepburn was born in Brussels, which is now part of Belgium.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 5, "feed_lag_max_ms": 983, "feed_lag_sum_ms": 2635, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0051_aggressive_local.wav", "sha256": "1461fea23547ebc769a36448f0f143a6c5cbe952f5d886bc685abd9b5c552398", "sr": 24000, "seconds": 4.56}}, "chunks": [[0, 1, 1.0, 1.121, 1.219, 1, 0, 0], [1, 1, 2.0, 2.123, 2.221, 1, 0, 0], [2, 1, 2.135, 2.338, 2.435, 1, 0, 0], [3, 0, 3.135, 3.257, 4.407, 0, 24000, 0], [4, 0, 4.135, 4.53, 5.677, 0, 24000, 0], [5, 0, 5.135, 5.8, 6.888, 0, 24000, 0], [6, 0, 6.135, 7.01, 8.119, 0, 24000, 0], [7, 0, 7.135, 8.242, 8.96, 0, 13440, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.135, "last_real_feed_done": 2.338, "onset": 4.407, "gate_read_done": 4.408, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.407, "wait_start"