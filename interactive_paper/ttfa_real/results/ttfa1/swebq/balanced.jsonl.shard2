00, 0], [12, 0, 12.274, 12.334, 12.87, 0, 24000, 0], [13, 0, 13.274, 13.332, 13.9, 0, 24000, 0], [14, 0, 14.274, 14.333, 14.837, 0, 24000, 0], [15, 0, 15.274, 15.332, 15.883, 0, 24000, 0], [16, 0, 16.274, 16.333, 16.849, 0, 24000, 0], [17, 0, 17.274, 17.333, 17.545, 0, 6720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.274, "last_real_feed_done": 2.329, "onset": 3.901, "gate_read_done": 3.901, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 3.901, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 3.901, "first_answer_pcm": 3.901, "session_end": 17.545}, "ttfa_answer_s": 1.626, "ttfa_any_s": 1.626}
{"id": "swebq0195", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2582281941, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what do christians believe about heaven hell and purgatory?", "input_path": "/data/bench_audio/swebq0195.wav", "input_sha256": "6c3b79595e4677348f44e7a71a3b3a407f816aac0f8a3dca9371983e5ba53704", "input_samples": 44564, "input_s": 2.785, "n_real_chunks": 3, "score": 0.5242, "act": 0.9996, "is_info": true, "fired": false, "mode": "local", "answer": "Well, the Christian s believe that heaven is a place where you will be with God forever. And hell is a place where you will not be with God forever. And pur gatory is a place where people go to get ready for heaven.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0195_balanced_local.wav", "sha256": "5fd755e046e94a04b7ad71cb35b9697ad580b6e9e38ee20c67ed2d97bc812820", "sr": 24000, "seconds": 12.68}}, "chunks": [[0, 1, 1.0, 1.057, 1.102, 1, 0, 0], [1, 1, 2.0, 2.054, 2.097, 1, 0, 0], [2, 1, 2.785, 2.843, 2.888, 1, 0, 0], [3, 0, 3.785, 3.843, 4.248, 0, 24000, 0], [4, 0, 4.785, 4.844, 5.351, 0, 24000, 0], [5, 0, 5.785, 5.844, 6.351, 0, 24000, 0], [6, 0, 6.785, 6.845, 7.424, 0, 24000, 0], [7, 0, 7.785, 7.841, 8.327, 0, 24000, 0], [8, 0, 8.785, 8.844, 9.304, 0, 24000, 0], [9, 0, 9.785, 9.842, 10.371, 0, 24000, 0], [10, 0, 10.785, 10.842, 11.394, 0, 24000, 0], [11, 0, 11.785, 11.843, 12.35, 0, 24000, 0], [12, 0, 12.785, 12.842, 13.351, 0, 24000, 0], [13, 0, 13.785, 13.843, 14.373, 0, 24000, 0], [14, 0, 14.785, 14.843, 15.373, 0, 24000, 0], [15, 0, 15.785, 15.843, 16.15, 0, 16320, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.785, "last_real_feed_done": 2.843, "onset": 4.248, "gate_read_done": 4.249, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 4.248, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 4.248, "first_answer_pcm": 4.248, "session_end": 16.15}, "ttfa_answer_s": 1.463, "ttfa_any_s": 1.463}
{"id": "swebq0203", "pool": "swebq", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2735595248, "protocol": "ttfa-v3", "config_sha256": "452ae3d391103874253b2612ca88a459fb34e3c2c0d46a5f0ea415086d584f74", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "what to visit in atlanta?", "input_path": "/data/bench_audio/swebq0203.wav", "input_sha256": "c5f6cf22d4be07cb880b61d7f51af730f15797e8f6353ddd4be069304a550b02", "input_samples": 26731, "input_s": 1.671, "n_real_chunks": 2, "score": 0.4685, "act": 0.9963, "is_info": true, "fired": false, "mode": "local", "answer": "Atlanta is a city with so much to offer. There are plenty of things you can do in the city, but here are some of my favorite spots that I think you should check out if you're ever visiting Atlanta. First off, you have to visit Cent er Stage Park. It' s a beautiful park right in the heart of downtown and it's perfect for relax ing on a nice day. You can also take a stroll along the Beltline trail, which is an old railroad track turned into a walking path that goes around the entire city. If you're looking for something more historical, be sure to visit the Martin Luther King Jr. National Historic Site. It' s a must-see for anyone interested in civil rights history. And don't forget about the Georgia Aquarium either! It' s one of the largest aquarium s in the world and has tons of marine life to see. There's also plenty of great restaurants throughout the city serving everything from Southern cuisine to international dishes. Overall, there' s something for everyone in Atlanta, whether you're looking for outdoor activities or cultural experiences.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "exper