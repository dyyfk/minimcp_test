{"id": "swebq0122", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3833213629, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what countries does england border?", "input_path": "/data/bench_audio/swebq0122.wav", "input_sha256": "807f0776d1cf03509d61e935e91c4fb0b1a4fe260379a206a2211290656744a7", "input_samples": 40106, "input_s": 2.507, "n_real_chunks": 3, "score": 0.4302, "act": 0.9992, "is_info": true, "fired": false, "mode": "local", "answer": "England is bordered by Scotland to the north, Wales to the west, and Northern Ireland to the northeast across the Irish Sea. It' s also surrounded by water on its other sides.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0122_conservative_local.wav", "sha256": "081c13ce41f9b2749c6bc5ca60ca36e62a7f77e1c5ded89d97ee24673f212b99", "sr": 24000, "seconds": 10.88}}, "chunks": [[0, 1, 1.0, 1.07, 1.129, 1, 0, 0], [1, 1, 2.0, 2.073, 2.13, 1, 0, 0], [2, 1, 2.507, 2.577, 2.632, 1, 0, 0], [3, 0, 3.507, 3.582, 4.308, 0, 24000, 0], [4, 0, 4.507, 4.581, 5.171, 0, 24000, 0], [5, 0, 5.507, 5.582, 6.261, 0, 24000, 0], [6, 0, 6.507, 6.581, 7.334, 0, 24000, 0], [7, 0, 7.507, 7.584, 8.233, 0, 24000, 0], [8, 0, 8.507, 8.581, 9.249, 0, 24000, 0], [9, 0, 9.507, 9.583, 10.332, 0, 24000, 0], [10, 0, 10.507, 10.597, 11.351, 0, 24000, 0], [11, 0, 11.507, 11.585, 12.31