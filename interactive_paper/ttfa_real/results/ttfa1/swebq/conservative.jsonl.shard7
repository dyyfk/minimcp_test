{"id": "swebq0219", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1522730671, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what is the currency of germany now?", "input_path": "/data/bench_audio/swebq0219.wav", "input_sha256": "cd40311e35b842dea5ec9d9a615ee47a8a0d7e32ed2d94f0839678c5ea259fa9", "input_samples": 32676, "input_s": 2.042, "n_real_chunks": 3, "score": 0.4059, "act": 0.9986, "is_info": true, "fired": false, "mode": "local", "answer": "The currency of Germany is the Euro. It' s been used since 1 999, replacing the Deuts chmark. So if you visit or do business there, Euros are the money to use.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 79, "feed_lag_sum_ms": 79, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0219_conservative_local.wav", "sha256": "1232a69329a8e02be1bafa0992e4fcb87c5384e2803da6676b9cce8aafb8862d", "sr": 24000, "seconds": 10.16}}, "chunks": [[0, 1, 1.0, 1.067, 1.12, 1, 0, 0], [1, 1, 2.0, 2.069, 2.122, 1, 0, 0], [2, 1, 2.042, 2.187, 2.24, 1, 0, 0], [3, 0, 3.042, 3.117, 3.811, 0, 24000, 0], [4, 0, 4.042, 4.113, 4.808, 0, 24000, 0], [5, 0, 5.042, 5.111, 5.838, 0, 24000, 0], [6, 0, 6.042, 6.111, 6.804, 0, 24000, 0], [7, 0, 7.042, 7.113, 7.784, 0, 24000, 0], [8, 0, 8.042, 8.116, 8.847, 0, 24000, 0], [9, 0, 9.042, 9.111, 9.749, 0, 24000, 0], [10, 0, 10.042, 10.115, 10.726, 0, 24000, 0], [11, 0, 11.042, 11.111, 11.758, 0, 24000, 0], [12, 0, 12.042, 12.116, 12.743, 0, 27840, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.042, "last_real_feed_done": 2.187, "onset": 3.811, "gate_read_done": 3.812, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 3.811, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 3.811, "first_answer_pcm": 3.811, "session_end": 12.743}, "ttfa_answer_s": 1.769, "ttfa_any_s": 1.769}
{"id": "swebq0227", "pool": "swebq", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2522249323, "protocol": "ttfa-v3", "config_sha256": "d28a92eeac3dc1cbcfb19cc353ba8ef8348c2bf330132cd121259381cddc0589", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "what languages do people speak in spain?", "input_path": "/data/bench_audio/swebq0227.wav", "input_sha256": "880f853a00dd17af87026cbaff186c5234fc694f6bf5b0ac1cd8408c42a1c5c8", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.3437, "act": 0.9972, "is_info": true, "fired": false, "mode": "local", "answer": "In Spain, people mainly speak Spanish. It is called Cast ilian Spanish in the country. But there are also many other language s spoken because Spain has a lot of regions with their own cultures. For example, you can hear Basque in the north, Catalan in places like Barcelo na and Valencia, Gal lego in the northwest, and Aran au in the Pyrenees. So while Spanish is the most common, lots of different languages are used depending on where you go.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 24, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0227_conservative_local.wav", "sha256": "93dadc1f2165845c823cf4ab319aa6d2e9ff2fa2acc0eb2f748a4fef1a865bd7", "sr": 24000, "seconds": 23.36}}, "chunks": [[0, 1, 1.0, 1.067, 1.123, 1, 0, 0], [1, 1, 2.0, 2.071, 2.127, 1, 0, 0], [2, 1, 2.832, 2.904, 2.961, 1, 0, 0], [3, 0, 3.832, 3.903, 4.061, 0, 0, 0], [4, 0, 4.832, 4.902, 5.544, 0, 24000, 0], [5, 0, 5.832