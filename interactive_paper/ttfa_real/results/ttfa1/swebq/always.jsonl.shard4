{"id": "swebq0031", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1705654385, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "who helped eminem started his career?", "input_path": "/data/bench_audio/swebq0031.wav", "input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "input_samples": 37134, "input_s": 2.321, "n_real_chunks": 3, "score": 0.8701, "act": 0.9963, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Dr. Dre helped Eminem start his mainstream career. He signed Eminem to Aftermath Entertainment after hearing The Slim Shady EP and produced much of The Slim Shady LP, which made Eminem famous.", "expert_answer": "**Dr. Dre** helped Eminem start his mainstream career. He signed Eminem to Aftermath Entertainment after hearing *The Slim Shady EP* and produced much of *The Slim Shady LP*, which made Eminem famous.", "transcript": "Who helped Eminem started his career?\n", "asr_s": 0.76, "expert_s": 2.08, "expert_input_samples": 37134, "expert_input_s": 2.321, "expert_input_sha256": "027773891d93a7de85975d6e21966ca9ef83fbf9441be206c1ca9cb18e9643bb", "expert_timed_out": false, "wait_s": 2.003, "relay_synth_ms": 7904, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_always_relay.wav", "sha256": "ae07fed7123b6da0a8882b8b413186697b9ffc80b46977f64b18ed4cfb680adc", "sr": 24000, "seconds": 13.6}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0031_always_candidate.wav", "sha256": "d6cb2cfa381353ae771d791209da52e4093008544130333cdabb62846090af4b", "sr": 24000, "seconds": 1.0},