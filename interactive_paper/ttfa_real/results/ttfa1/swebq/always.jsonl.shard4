, 0], [1, 1, 2.0, 2.075, 2.134, 1, 0, 0], [2, 1, 2.135, 2.211, 2.273, 1, 0, 0], [3, 0, 3.135, 3.214, 3.767, 0, 24000, 0], [4, 0, 4.135, 4.46, 5.133, 0, 28800, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.135, "last_real_feed_done": 2.211, "onset": 3.767, "gate_read_done": 3.767, "fire": 3.767, "candidate_first_pcm": 3.767, "stall_note": 3.768, "stall_first_pcm": 4.387, "local_first_pcm": null, "wait_start": 5.133, "expert_req": 3.768, "expert_resp": 6.39, "relay_synth_start": 6.39, "relay_first_pcm": 7.231, "relay_synth_end": 10.02, "first_any_pcm": 3.767, "first_answer_pcm": 7.231, "session_end": 10.161}, "ttfa_answer_s": 5.096, "ttfa_any_s": 1.632}
{"id": "swebq0047", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3280472963, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "what type of art did pablo picasso paint?", "input_path": "/data/bench_audio/swebq0047.wav", "input_sha256": "e2ce0ad9c388ea45f093a2a5a4c93d705500eb0bf7ce06fd006189890b32859b", "input_samples": 42335, "input_s": 2.646, "n_real_chunks": 3, "score": 0.2538, "act": 0.9993, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Pablo Picasso painted modern art, especially Cubism. He also worked in styles including Blue Period, Rose Period, Neoclassicism, and Surrealism, and created paintings, drawings, sculptures, and ceramics.", "expert_answer": "Pablo Picasso painted **modern art**, especially **Cubism**. He also worked in styles including **Blue Period**, **Rose Period**, **Neoclassicism**, and **Surrealism**, and created paintings, drawings, sculptures, and ceramics.", "transcript": "What type of art did Pablo Picasso paint?\n", "asr_s": 0.71, "expert_s": 1.94, "expert_input_samples": 42335, "expert_input_s": 2.646, "expert_input_sha256": "e2ce0ad9c388ea45f093a2a5a4c93d705500eb0bf7ce06fd006189890b32859b", "expert_timed_out": false, "wait_s": 1.457, "relay_synth_ms": 8542, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 336, "feed_lag_sum_ms": 336, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0047_always_relay.wav", "sha256": "7bc29fe913fab6514428e4b33abb6914002e30fe79298a6da83266d3e28ff8c0", "sr": 24000, "seconds": 13.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0047_always_candidate.wav", "sha256": "0ed9f150bbd612c1fa02cdcd8670285bdd9def1b1e84c