{"id": "swebq0076", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2678221014, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "what language do chinese people write in?", "input_path": "/data/bench_audio/swebq0076.wav", "input_sha256": "72d453fb0455c83e1fe8c1ce31f0a77a05162bdc6bf8f941a674d97a4bb0f76e", "input_samples": 37877, "input_s": 2.367, "n_real_chunks": 3, "score": 0.4983, "act": 0.9956, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Chinese people primarily write in Chinese, using Chinese characters. There are different written forms and language varieties, including: Simplified Chinese characters — used mainly in mainland China and Singapore , Traditional Chinese characters — used mainly in Taiwan, Hong Kong, and Macau , Mandarin Chinese — the standard spoken language in mainland China and Taiwan, often reflected in formal writing , Cantonese — sometimes written informally in Hong Kong and nearby regions So the simplest answer is: Chinese people write in Chinese characters, usually in written Chinese.", "expert_answer": "Chinese people primarily write in **Chinese**, using **Chinese characters**.\n\nThere are different written forms and language varieties, including:\n\n- **Simplified Chinese characters** — used mainly in mainland China and Singapore\n- **Traditional Chinese characters** — used mainly in Taiwan, Hong Kong, and Macau\n- **Mandarin Chinese** — the standard spoken language in mainland China and Taiwan, often reflected in formal writing\n- **Cantonese** — sometimes written informally in Hong Kong and nearby regions\n\nSo the simplest answer is: **Chinese people write in Chinese characters, usually in written Chinese.**", "transcript": "What language do Chinese people write in?\n", "asr_s": 0.47, "expert_s": 2.8, "expert_input_samples": 37877, "expert_input_s": 2.367, "expert_input_sha256": "72d453fb0455c83e1fe8c1ce31f0a77a05162bdc6bf8f941a674d97a4bb0f76e", "expert_timed_out": false, "wait_s": 2.919, "relay_synth_ms": 22390, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0076_always_relay.wav", "sha256": "05c6108683d49af53b9557436d28053b6438361bf4b1edf8b82a03dcc03aa179", "sr": 24000, "seconds": 37.84}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0076_always_candidate.wav", "sha256": "95be9d2a587bef5e7f37ce23da16753d61f9aaee04f6444a59db2ca4c7e6753e", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0076_always_stall.wav", "sha256": "851e4fc919d920a74a81b7ec85d302d1d2c024d9acf6620cae2f510ee38bdc14", "sr": 24000, "seconds": 0.28}}, "chunks": [[0, 1, 1.0, 1.084, 1.15, 1, 0, 0], [1, 1, 2.0, 2.082, 2.147, 1, 0, 0], [2, 1, 2.367, 2.45, 2.514, 1, 0, 0], [3, 0, 3.367, 3.443, 4.136, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.367, "last_real_feed_done": 2.45, "onset": 4.136, "gate_read_done": 4.137, "fire": 4.137, "candidate_first_pcm": 4.136, "stall_note": 4.138, "stall_first_pcm": 4.49, "local_first_pcm": null, "wait_start": 4.49, "expert_req": 4.137, "expert_resp": 7.409, "relay_synth_start": 7.41, "relay_first_pcm": 8.395, "relay_synth_end": 29.8, "first_any_pcm": 4.136, "first_answer_pcm": 8.395, "session_end": 30.05}, "ttfa_answer_s": 6.028, "ttfa_any_s": 1.769}
{"id": "swebq0084", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 4130608437, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "where was john jay born?", "input_path": "/data/bench_audio/swebq0084.wav", "input_sha256": "f0ebc0a868b2ea493efcb9489104916c5a187b3b7f9d848d5335610a3cee3f7d", "input_samples": 23016, "input_s": 1.438, "n_real_chunks": 2, "score": 0.557, "act": 0.9912, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "John Jay was born in New York City, New York.", "expert_answer": "John Jay was born in **New York City, New York**.", "transcript": "Where was John Jay born?\n", "asr_s": 10.66, "expert_s": 1.27, "expert_input_samples": 23016, "expert_input_s": 1.438, "expert_input_sha256": "f0ebc0a868b2ea493efcb9489104916c5a187b3b7f9d848d5335610a3cee3f7d", "expert_timed_out": false, "wait_s": 11.088, "relay_synth_ms": 2213, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0084_always_relay.wav", "sha256": "466f6d8446b5ac27fdac7b833b222acb95a2cb9e217a5242f072065d060b115e", "sr": 24000, "seconds": 3.8}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0084_always_candidate.wav", "sha256": "11d40f82e7e5e701925441bdd2feb4697f3711b400b912bf4e17718ffe20774f", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0084_always_stall.wav", "sha256": "34a9e824045dc9de910b3c9669b7bebef72d85bc661742be1a8256f12556371f", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.084, 1.157, 1, 0, 0], [1, 1, 1.438, 1.514, 1.572, 1, 0, 0], [2, 0, 2.438, 2.519, 2.581, 1, 0, 0], [3, 0, 3