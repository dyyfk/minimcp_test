 0, 0], [2, 1, 2.367, 2.43, 2.48, 1, 0, 0], [3, 0, 3.367, 3.431, 4.01, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.367, "last_real_feed_done": 2.43, "onset": 4.01, "gate_read_done": 4.01, "fire": 4.01, "candidate_first_pcm": 4.01, "stall_note": 4.011, "stall_first_pcm": 4.706, "local_first_pcm": null, "wait_start": 4.706, "expert_req": 4.011, "expert_resp": 6.535, "relay_synth_start": 6.535, "relay_first_pcm": 7.255, "relay_synth_end": 8.82, "first_any_pcm": 4.01, "first_answer_pcm": 7.255, "session_end": 8.94}, "ttfa_answer_s": 4.888, "ttfa_any_s": 1.643}
{"id": "swebq0120", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 175395729, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what was the government like in virginia colony?", "input_path": "/data/bench_audio/swebq0120.wav", "input_sha256": "060ecaa64cfe54449fb230fd55960b38e3c1cb3cd21668ba2bd52bb99234a428", "input_samples": 56453, "input_s": 3.528, "n_real_chunks": 4, "score": 0.7635, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Virginia Colony had a representative colonial government under English rule. , It was governed by a royal governor appointed by the English king after Virginia became a royal colony in 1624. , It had an elected lawmaking body called the House of Burgesses, founded in 1619. , The House of Burgesses was the first representative assembly in the English colonies in North America. , Only certain colonists, mainly white male landowners, could vote or serve in government. So, Virginia’s government combined English royal authority with local representative government.", "expert_answer": "The **Virginia Colony** had a **representative colonial government** under English rule.\n\n- It was governed by a **royal governor** appointed by the English king after Virginia became a royal colony in **1624**.\n- It had an elected lawmaking body called the **House of Burgesses**, founded in **1619**.\n- The House of Burgesses was the **first representative assembly in the English colonies in North America**.\n- Only certain colonists, mainly **white male landowners**, could vote or serve in government.\n\nSo, Virginia’s government combined **English royal authority** with **local representative government**.", "transcript": "What was the government like in Virginia Colony?\n", "asr_s": 0.97, "expert_s": 3.27, "expert_input_samples": 56453, "expert_input_s": 3.528, "expert_input_sha256": "060ecaa64cfe54449fb230fd55960b38e3c1cb3cd21668ba2bd52bb99234a428", "expert_timed_out": false, "wait_s": 3.548, "relay_synth_ms": 19161, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_always_relay.wav", "sha256": "b775168bce2b0b63b8a65bddb3eda07222136e88bad393bd484778731e125e3d", "sr": 24000, "seconds": 39.64}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_always_candidate.wav", "sha256": "755202d32b1e42bcb9969377dc3bd29ae18fbb9b11a81734957e65c97b1f8d07", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0120_always_stall.wav", "sha256": "f6741d68618d51f1f0056c8b6c8d61d4b34426fd5f1908a387dee5caaa7f5f18", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.063, 1.113, 1, 0, 0], [1, 1, 2.0, 2.065, 2.115, 1, 0, 0], [2, 1, 3.0, 3.064, 3.114, 1, 0, 0], [3, 1, 3.528, 3.59, 4.075, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.528, "last_real_feed_done": 3.59, "onset": 4.075, "gate_read_done": 4.075, "fire": 4.075, "candidate_first_pcm": 4.075, "stall_note": 4.076, "stall_first_pcm": 4.767, "local_first_pcm": null, "wait_start": 4.767, "expert_req": 4.075, "expert_resp": 8.314, "relay_synth_start": 8.315, "relay_first_pcm": 9.04, "relay_synth_end": 27.476, "first_any_pcm": 4.075, "first_answer_pcm": 9.04, "session_end": 27.667}, "ttfa_answer_s": 5.511, "ttfa_any_s": 0.546}
{"id": "swebq0129", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1940450101, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "who is the arizona cardinals backup quarterback?", "input_path": "/data/bench_audio/swebq0129.wav", "input_sha256": "59a4e5b526e53de955771925c9b8f460065925925fa8c98029e1f8a61e277935", "input_samples": 45307, "input_s": 2.832, "n_real_chunks": 3, "score": 0.9197, "act": 0.9996, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Arizona Cardinals’ backup quarterback is Gardner Minshew II. The official depth chart lists Jacoby Brissett as first, Gardner Minshew II as second, and Carson Beck as third. (azcardinals.com)", "expert_answer": "The Arizona Cardinals’ backup quarterback is **Gardner Minshew II**. The official depth chart lists **Jacoby Brissett** as first, **Gardner Minshew II** as second, and **Carson Beck** as third. ([azcardinals.com](https://www.azcardinals.com/team/depth-chart))", "transcript": "Who is the Arizona Cardinals backup quarterback?\n", "asr_s": 0.7, "expert_s": 6.59, "expert_input_samples": 45307, "expert_input_s": 2.832, "expert_input_sha256": "59a4e5b526e53de955771925c9b8f460065925925fa8c98029e1f8a61e277935", "expert_timed_out": false, "wait_s": 6.425, "relay_synth_ms": 6753, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0129_always_relay.wav", "sha256": "f5650ea9c93e74e61c3d825ddf00297479a9b56d40efb68219ebf43902a4ca23", "sr": 24000, "seconds": 13.72}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0129_always_candidate.wav", "sha256": "edfdb548410d