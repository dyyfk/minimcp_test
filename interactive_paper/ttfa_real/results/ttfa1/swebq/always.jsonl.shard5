{"id": "swebq0077", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3903150144, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what type of government does the us constitution set up?", "input_path": "/data/bench_audio/swebq0077.wav", "input_sha256": "96e0c441edc20dafd53305c61721e09d26f04fb10f02f32de69a9acfba9c216b", "input_samples": 67598, "input_s": 4.225, "n_real_chunks": 5, "score": 0.222, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The U.S. Constitution sets up a federal republic with a representative democracy and separation of powers among three branches: legislative, executive, and judicial.", "expert_answer": "The U.S. Constitution sets up a **federal republic** with a **representative democracy** and **separation of powers** among three branches: **legislative, executive, and judicial**.", "transcript": "What type of government does the U.S. Constitution set up?\n", "asr_s": 0.6, "expert_s": 2.15, "expert_input_samples": 67598, "expert_input_s": 4.225, "expert_input_sha256": "96e0c441edc20dafd53305c61721e09d26f04fb10f02f32de69a9acfba9c216b", "expert_timed_out": false, "wait_s": 2.381, "relay_synth_ms": 5268, "onset_chunk": 4, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0077_always_relay.wav", "sha256": "c67401885cc02f8cf72f6a69c953d12caa70ce6e343cf99165ae286034cfa234", "sr": 24000, "seconds": 11.16}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0077_always_candidate.wav", "sha256": "4cbff3f7f2a1d2b811c0cc7e78dea434eadeadb471abfadb37afa32303f6d729", "sr": 24000, "seconds": 1.0}, "stall