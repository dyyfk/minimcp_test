 2.294, 1, 0, 0], [3, 0, 3.182, 3.246, 3.904, 0, 24000, 0], [4, 0, 4.182, 4.5, 4.83, 0, 12480, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.182, "last_real_feed_done": 2.244, "onset": 3.904, "gate_read_done": 3.904, "fire": 3.904, "candidate_first_pcm": 3.904, "stall_note": 3.905, "stall_first_pcm": 4.436, "local_first_pcm": null, "wait_start": 4.83, "expert_req": 3.905, "expert_resp": 5.983, "relay_synth_start": 5.983, "relay_first_pcm": 6.7, "relay_synth_end": 8.34, "first_any_pcm": 3.904, "first_answer_pcm": 6.7, "session_end": 8.457}, "ttfa_answer_s": 4.519, "ttfa_any_s": 1.722}
{"id": "swebq0048", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1396119058, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "where does greek language come from?", "input_path": "/data/bench_audio/swebq0048.wav", "input_sha256": "0bec9aa61b7853b1972a1a3a3633f38420cff33a6dfa29fb623b001cfbfe47b7", "input_samples": 37877, "input_s": 2.367, "n_real_chunks": 3, "score": 0.6252, "act": 0.997, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Greek language comes from the Hellenic branch of the Indo-European language family. It developed in the Balkan Peninsula, especially in what is now Greece, from early Indo-European-speaking peoples who entered the region in the Bronze Age. The earliest known form is Mycenaean Greek, written in the Linear B script around the 15th–13th centuries BCE. So, in short: Greek originated in ancient Greece as an Indo-European language, specifically the Hellenic branch.", "expert_answer": "The **Greek language** comes from the **Hellenic branch of the Indo-European language family**.\n\nIt developed in the **Balkan Peninsula**, especially in what is now **Greece**, from early Indo-European-speaking peoples who entered the region in the Bronze Age. The earliest known form is **Mycenaean Greek**, written in the **Linear B** script around the **15th–13th centuries BCE**.\n\nSo, in short: **Greek originated in ancient Greece as an Indo-European language, specifically the Hellenic branch.**", "transcript": "Where does Greek language come from?\n", "asr_s": 0.56, "expert_s": 4.17, "expert_input_samples": 37877, "expert_input_s": 2.367, "expert_input_sha256": "0bec9aa61b7853b1972a1a3a3633f38420cff33a6dfa29fb623b001cfbfe47b7", "expert_timed_out": false, "wait_s": 3.478, "relay_synth_ms": 14493, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 170, "feed_lag_sum_ms": 170, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_always_relay.wav", "sha256": "4e8ebe5be8aca11cf67abcc8f30891a9247c7cbb9784e1beebff846d3aed0c18", "sr": 24000, "seconds": 29.52}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_always_candidate.wav", "sha256": "f26bc6b45eab3a77ea1f24f3e47717a37bdc0ce0f248591404665ed3cffb84ba", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0048_always_stall.wav", "sha256": "1048235c3c34cbb259de4ed6b78cbb93d3dd9a523556daddc0bba9bacfa39f71", "sr": 24000, "seconds": 2.28}}, "chunks": [[0, 1, 1.0, 1.063, 1.113, 1, 0, 0], [1, 1, 2.0, 2.064, 2.114, 1, 0, 0], [2, 1, 2.367, 2.429, 2.48, 1, 0, 0], [3, 0, 3.367, 3.432, 4.009, 0, 24000, 0], [4, 0, 4.367, 4.605, 5.262, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.367, "last_real_feed_done": 2.429, "onset": 4.009, "gate_read_done": 4.009, "fire": 4.009, "candidate_first_pcm": 4.009, "stall_note": 4.01, "stall_first_pcm": 4.538, "local_first_pcm": null, "wait_start": 5.262, "expert_req": 4.01, "expert_resp": 8.74, "relay_synth_start": 8.741, "relay_first_pcm": 9.452, "relay_synth_end": 23.234, "first_any_pcm": 4.009, "first_answer_pcm": 9.452, "session_end": 23.405}, "ttfa_answer_s": 7.085, "ttfa_any_s": 1.642}
{"id": "swebq0057", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3667081922, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "what channel is the usa pageant on?", "input_path": "/data/bench_audio/swebq0057.wav", "input_sha256": "1e389adaee4eb8c060654b9f93519531c7910e69e1042c954ce54da4d4a55815", "input_samples": 49765, "input_s": 3.11, "n_real_chunks": 4, "score": 0.9183, "act": 0.9988, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The 2026 Miss USA pageant is not on a TV channel. It was dropped by The CW and is available to stream on QBN — The Queen Beauty Network. (justjared.com) If you meant Miss America instead of Miss USA, tell me and I’ll check that channel too.", "expert_answer": "The **2026 Miss USA pageant is not on a TV channel**. It was dropped by **The CW** and is available to stream on **QBN — The Queen Beauty Network**. ([justjared.com](https://www.justjared.com/2026/08/21/miss-usa-dropped-by-the-cw-just-one-week-before-pageant-new-streaming-details-revealed/?utm_source=openai))\n\nIf you meant **Miss America** instead of **Miss USA**, tell me and I’ll check that channel too.", "transcript": "What channel is the USA pageant on?\n", "asr_s": 0.67, "expert_s": 4.87, "expert_input_samples": 49765, "expert_input_s": 3.11, "expert_input_sha256": "1e389adaee4eb8c060654b9f93519531c7910e69e1042c954ce54da4d4a55815", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 7887, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 17, "feed_lag_max_ms": 457, "feed_lag_sum_ms": 563, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0057_always_relay.wav", "sha256": "ffbc5637771bf522de37c8ad125569aea16f327a7