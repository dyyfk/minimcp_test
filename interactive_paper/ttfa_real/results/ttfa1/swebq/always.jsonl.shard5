{"id": "swebq0102", "pool": "swebq", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3595325503, "protocol": "ttfa-v3", "config_sha256": "aa7a8a6f2040793a4fe8dabcb6d10f2520887b0e0988d37809c3a27ef31575d8", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "who was king after leonidas died?", "input_path": "/data/bench_audio/swebq0102.wav", "input_sha256": "52b2f17e5888906d09a582ffd3497c93fb4748ca4b679f71fa7cae4963c44525", "input_samples": 33419, "input_s": 2.089, "n_real_chunks": 3, "score": 0.6759, "act": 0.9985, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "After Leonidas I died at Thermopylae in 480 BCE, his son Pleistarchus became king of Sparta. Because Pleistarchus was still a child, his cousin Pausanias acted as regent.", "expert_answer": "After **Leonidas I** died at Thermopylae in **480 BCE**, his son **Pleistarchus** became king of Sparta.\n\nBecause Pleistarchus was still a child, his cousin **Pausanias** acted as regent.", "transcript": "Who was king after Leonidas died?\n", "asr_s": 0.55, "expert_s": 3.53, "expert_input_samples": 33419, "expert_input_s": 2.089, "expert_input_sha256": "52b2f17e5888906d09a582ffd3497c93fb4748ca4b679f71fa7cae4963c44525", "expert_timed_out": false, "wait_s": 3.709, "relay_synth_ms": 5954, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 24, "feed_lag_sum_ms": 24, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0102_always_relay.wav", "sha256": "4bfb6700b41c0f2f63c0ca6dc1abc10ea80754a0da32bf666cd7855236912b96", "sr": 24000, "seconds": 11.36}, "candidate": {"path": "/data/ttfa_real/ttfa1/swebq/audio/swebq0102_always_candidate.wav", "sha256": "2b57ba7fea69ea98d05a8d868fdd975dee66782382d957a65d0eab77f44e541d", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/tt