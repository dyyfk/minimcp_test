{"id": "striviaqa0052", "pool": "striviaqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3602061498, "protocol": "ttfa-v3", "config_sha256": "81e2f23f98f19f1f63c3360e6be048d11083a3634e93068c14d5fdb8186e6ebb", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "Which game that contained many D&D; features and references, including a computer controlled dungeon master, created in 1975 by Will Crowther on a DEC PDP-10 computer, the first widely used adventure game, was significantly expanded in 1976 by Don Woods, that inspired a group of students at MIT to write a game called Zork in the summer of 1977 for the PDP-10 minicomputer which became quite popular on the ARPANET?", "input_path": "/data/bench_audio/striviaqa0052.wav", "input_sha256": "c418b10a118861e6ec8461d5cf0e2cbe019dae80c1b4b50459ce391500e145ae", "input_samples": 547258, "input_s": 34.204, "n_real_chunks": 35, "score": 0.5603, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The game you are describing is Adventure, created by Will Crowther in 1975. It was one of the first text- based adventure games and inspired the development of Zork later that year.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 34, "eot_seen": true, "n_speak_chunks": 10, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0052_local_local.wav", "sha256": "590d62e9772d728b53df00df30fd6959bf9b86c23423e0ea3fc9beb1afab12ab", "sr": 24000, "seconds": 10.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.101, 1, 0, 0], [1, 1, 2.0, 2.054, 2.094, 1, 0, 0], [2, 1, 3.0, 3.057, 3.101, 1, 0