{"id": "striviaqa0178", "pool": "striviaqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 93518097, "protocol": "ttfa-v3", "config_sha256": "944261a1f541a965a3d8b273c1b8fe96b13cb1181602805520e75b233ed090df", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "Which famous London events which occurred between April 10th and April 12th 1981 were dealt with in the Scarman report?", "input_path": "/data/bench_audio/striviaqa0178.wav", "input_sha256": "e024a288a1f124836eac6fff164aac5abc4cc879f017f85c026a443a20154302", "input_samples": 97474, "input_s": 6.092, "n_real_chunks": 7, "score": 0.8463, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The events were the 1981 Brixton riots — also known as the Brixton uprising — which took place in Brixton, South London, from April 10 to April 12, 1981. The Scarman Report investigated these disturbances and their underlying causes, including policing and racial tensions.", "expert_answer": "The events were the **1981 Brixton riots** — also known as the **Brixton uprising** — which took place in **Brixton, South London, from April 10 to April 12, 1981**. The **Scarman Report** investigated these disturbances and their underlying causes, including policing and racial tensions.", "transcript": "Which famous London events which occurred between April 10 and April 12, 1981 were dealt with in the Scarman Report?\n", "asr_s": 0.74, "expert_s": 6.29, "expert_input_samples": 97474, "expert_input_s": 6.092, "expert_input_sha256": "e024a288a1f124836eac6fff164aac5abc4cc879f017f85c026a443a20154302", "expert_timed_out": false, "wait_s": 6.414, "relay_synth_ms": 8639, "onset_chunk": 6, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 13, "feed_lag_sum_ms": 13, "audio_files": {"relay": {"path": "/data/tt