{"id": "striviaqa0070", "pool": "striviaqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 176888596, "protocol": "ttfa-v3", "config_sha256": "944261a1f541a965a3d8b273c1b8fe96b13cb1181602805520e75b233ed090df", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "Who won the most of the first ten tournaments called the Women's Hockey World Cup (the field hockey World Cup competition for women), which was inaugurated in 1974?", "input_path": "/data/bench_audio/striviaqa0070.wav", "input_sha256": "de5d567b3c7abedac036a3a293611dc4aef4b66fe9d18e70bdd8545995d08e3a", "input_samples": 160445, "input_s": 10.028, "n_real_chunks": 11, "score": 0.9092, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The Netherlands won the most of the first ten Women’s Hockey World Cup tournaments. Counting the first ten editions — 1974 through 2002 — the Netherlands won 5 of them: 1974, 1978, 1983, 1986, and 1990. (fih.hockey)", "expert_answer": "The **Netherlands** won the most of the first ten Women’s Hockey World Cup tournaments.\n\nCounting the first ten editions — **1974 through 2002** — the Netherlands won **5** of them: **1974, 1978, 1983, 1986, and 1990**. ([fih.hockey](https://www.fih.hockey/events/world-cup/women/fih-hockey-womens-world-cup-spain-and-netherlands-2022-1388/archive))", "transcript": "Who won the most of the first ten tournaments called the Women's Hockey World Cup, the field hockey World Cup competition for women, which was inaugurated in 1974?\n", "asr_s": 0.94, "expert_s": 8.13, "expert_input_samples": 160445, "expert_input_s": 10.028, "expert_input_sha256": "de5d567b3c7abedac036a3a293611dc4aef4b66fe9d18e70bdd8545995d08e3a", "expert_timed_out": false, "wait_s": 8.694, "relay_synth_ms": 8000, "onset_chunk": 10, "eot_seen": false, "n_spea