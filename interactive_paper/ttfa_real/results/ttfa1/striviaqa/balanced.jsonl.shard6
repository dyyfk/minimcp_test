{"id": "striviaqa0126", "pool": "striviaqa", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2673680467, "protocol": "ttfa-v3", "config_sha256": "944261a1f541a965a3d8b273c1b8fe96b13cb1181602805520e75b233ed090df", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 6, "query": "Which 19th century American poet wrote over 1,000 poems which were published between 1890 and 1945, after her death?", "input_path": "/data/bench_audio/striviaqa0126.wav", "input_sha256": "5eaeb592ffc329da4d8406d16dfd6709d3c01ca08ceb94792c93820a1d1528e8", "input_samples": 128184, "input_s": 8.011, "n_real_chunks": 9, "score": 0.5376, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "That would be Emily Dick inson. She was a reclusive poet who wrote more than 1,8 00 poems during her lifetime and many were published posthum ously after she died in 1886. So while they weren't published between 189 0 and 19 45, the bulk of her work did see publication in that period following her death.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 8, "eot_seen": true, "n_speak_chunks": 20, "feed_lag_max_ms": 87, "feed_lag_sum_ms": 87, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0126_balanced_local.wav", "sha256": "2235cfd77306a74e72b5914513f308a98163f2edde1895588da14fd1b6d1e98d", "sr": 24000, "seconds": 19.32}}, "chunks": [[0, 1, 1.0, 1.053, 1.094, 1, 0, 0], [1, 1, 2.0, 2.053, 2.097, 1, 0, 0], [2, 1, 3.0, 3.054, 3.097, 1, 0, 0], [3, 1, 4.0, 4.055, 4.098, 1, 0, 0], [4, 1, 5.0, 5.056, 5.099, 1, 0, 0], [5, 1, 6.0, 6.056, 6.101, 1, 0, 0], [6, 1, 7.0, 7.055, 7.1, 1, 0, 0], [7, 1,