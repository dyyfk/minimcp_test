{"id": "striviaqa0072", "pool": "striviaqa", "arm": "local", "tier": "never", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3833952824, "protocol": "ttfa-v3", "config_sha256": "81e2f23f98f19f1f63c3360e6be048d11083a3634e93068c14d5fdb8186e6ebb", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Manchester United's Kevin Moran was the first player to he sent off in an FA Cup final, which Arsenal player was the second?", "input_path": "/data/bench_audio/striviaqa0072.wav", "input_sha256": "69f68b1c5adf86db8e10545d838328edc2865f4b946bb4e7cceb77ebc7eb6e7b", "input_samples": 138200, "input_s": 8.637, "n_real_chunks": 9, "score": 0.7973, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "Kevin Moran was the first player to be sent off in an FA Cup final, and that happened back in 19 73 when he played for Manchester United. The second player to get a red card in the same competition was Lee Dixon of Ar senal. He was shown a straight red card during the 20 04 FA Cup final against Mill wall. So, yes, it was Lee Dixon who followed K evin Moran into the history books as the second player to receive a sending-off in an FA Cup final.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 8, "eot_seen": true, "n_speak_chunks": 32, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0072_local_local.wav", "sha256": "6d0c7b752b7e30ed64dfdb4c81ac551a1f813ab572d259dd447d7d8cefbc3ee1", "sr": 24000, "seconds": 30.48}}, "chunks": [[0, 1, 1.0, 1.073, 1.129, 1, 0, 0], [1, 1, 2.0, 2.073, 2.131, 1, 0, 0], [2, 1, 3.0, 3.069, 3.123, 1, 0, 0], [3, 1, 4.0, 4.072, 4.13