{"id": "striviaqa0072", "pool": "striviaqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3833952824, "protocol": "ttfa-v3", "config_sha256": "760971df1e172c7bf1d6bc3b4ee980bf878d27e27419c4254baabbe495a6c145", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Manchester United's Kevin Moran was the first player to he sent off in an FA Cup final, which Arsenal player was the second?", "input_path": "/data/bench_audio/striviaqa0072.wav", "input_sha256": "69f68b1c5adf86db8e10545d838328edc2865f4b946bb4e7cceb77ebc7eb6e7b", "input_samples": 138200, "input_s": 8.637, "n_real_chunks": 9, "score": 0.7973, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "Kevin Moran was the first player to be sent off in an FA Cup final, and that happened back in 19 73 when he played for Manchester United. The second player to get a red card in the same competition was Lee Dixon of Ar senal. He was shown a straight red card during the 20 04 FA Cup final against Mill wall. So, yes, it was Lee Dixon who followed K evin Moran into the history books as the second player to receive a sending-off in an FA Cup final.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 8, "eot_seen": true, "n_speak_chunks": 32, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0072_conservative_local.wav", "sha256": "2d77053e6a8b55638a0b47a1da9679428ce6f0ded263687bc8f345268d21b0a0", "sr": 24000, "seconds": 30.48}}, "chunks": [[0, 1, 1.0, 1.061, 1.111, 1, 0, 0], [1, 1, 2.0, 2.063, 2.115, 1, 0, 0], [2, 1, 3.0, 3.063, 3.114