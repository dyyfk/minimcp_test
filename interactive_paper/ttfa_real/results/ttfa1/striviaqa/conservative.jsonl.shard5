{"id": "striviaqa0205", "pool": "striviaqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 908373298, "protocol": "ttfa-v3", "config_sha256": "760971df1e172c7bf1d6bc3b4ee980bf878d27e27419c4254baabbe495a6c145", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 5, "query": "What is a reality TV show in which a group of people live in a large house watched by cameras, first broadcast in the Netherlands in 1999?", "input_path": "/data/bench_audio/striviaqa0205.wav", "input_sha256": "bcd4b146d5cd5cc1a482b5037ab8fb2f2c9b76fd96daef556ee1ada66b6c140f", "input_samples": 143215, "input_s": 8.951, "n_real_chunks": 9, "score": 0.2501, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The show you're talking about is Big Brother. It's a reality TV program where contestants live together in a house that's constantly being watched by cameras. The first version of the show started in the Netherlands back in 199 9. The idea was to let people see what happens when a group of strangers are locked together with no privacy, and all their actions are shown on television.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 9, "eot_seen": true, "n_speak_chunks": 22, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0205_conservative_local.wav", "sha256": "83dbaae16d79da285a7d9d9be66421f233e31fe4815c7b0e03af48b66c8b3e92", "sr": 24000, "seconds": 22.04}}, "chunks": [[0, 1, 1.0, 1.068, 1.12, 1, 0, 0], [1, 1, 2.0, 2.066, 2.119, 1, 0, 0], [2, 1, 3.0, 3.066, 3.117, 1, 0, 0], [3, 1, 4.0, 4.065, 4.118, 1, 0, 0], [4,