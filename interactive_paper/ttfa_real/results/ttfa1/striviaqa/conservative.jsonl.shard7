{"id": "striviaqa0071", "pool": "striviaqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2106338178, "protocol": "ttfa-v3", "config_sha256": "760971df1e172c7bf1d6bc3b4ee980bf878d27e27419c4254baabbe495a6c145", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "For how many years did English monarch King Henry III reign?", "input_path": "/data/bench_audio/striviaqa0071.wav", "input_sha256": "eb33f893951a25732986aebb9915253bff2612a2246fd6ed5afef651ccedc26f", "input_samples": 64711, "input_s": 4.044, "n_real_chunks": 5, "score": 0.733, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "Henry the Third was actually never king. He was a prince, and he died before ever becoming king. So he didn't re ign for any years at all.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 8, "feed_lag_max_ms": 106, "feed_lag_sum_ms": 155, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0071_conservative_local.wav", "sha256": "813ae403d9ac45362eb456997a958118daa9a967012fbf2ddadbc46026f71efe", "sr": 24000, "seconds": 7.72}}, "chunks": [[0, 1, 1.0, 1.083, 1.149, 1, 0, 0], [1, 1, 2.0, 2.083, 2.148, 1, 0, 0], [2, 1, 3.0, 3.085, 3.152, 1, 0, 0], [3, 1, 4.0, 4.083, 4.151, 1, 0, 0], [4, 1, 4.044, 4.228, 5.094, 0, 24000, 0], [5, 0, 5.044, 5.177, 5.965, 0, 24000, 0], [6, 0, 6.044, 6.127, 6.952, 0, 24000, 0], [7, 0, 7.044, 7.127, 7.924, 0, 24000, 0], [8, 0, 8.044, 8.128, 8.927, 0, 24000, 0], [9, 0, 9.044, 9.129, 9.932, 0, 24000, 0], [10, 0, 10.044, 10.13, 11.034, 0, 24000, 0], [11, 0, 11.044, 11.13, 11.69