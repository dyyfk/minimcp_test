{"id": "striviaqa0047", "pool": "striviaqa", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3217218932, "protocol": "ttfa-v3", "config_sha256": "760971df1e172c7bf1d6bc3b4ee980bf878d27e27419c4254baabbe495a6c145", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "On which river are the Victoria Falls?", "input_path": "/data/bench_audio/striviaqa0047.wav", "input_sha256": "9cfc8a0a777a38b1cd215f11a9e4b02df23a6d494a521308a7305aff7cf70780", "input_samples": 57950, "input_s": 3.622, "n_real_chunks": 4, "score": 0.2279, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The Victoria Fall s are on the Zambezi River. They form a spectacular border between Zambia and Zimbabwe, where the river drops dramatically over a wide basalt rock ledge.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 11, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0047_conservative_local.wav", "sha256": "f053e3f062a4565b4f1f85b339ee82a4c500224fd5ec47d3a7f7324ebf2c78d7", "sr": 24000, "seconds": 10.4}}, "chunks": [[0, 1, 1.0, 1.083, 1.151, 1, 0, 0], [1, 1, 2.0, 2.089, 2.162, 1, 0, 0], [2, 1, 3.0, 3.091, 3.163, 1, 0, 0], [3, 1, 3.622, 3.71, 3.783, 1, 0, 0], [4, 0, 4.622, 4.712, 4.996, 0, 0, 0], [5, 0, 5.622, 5.708, 6.531, 0, 24000, 0], [6, 0, 6.622, 6.709, 7.616, 0, 24000, 0], [7, 0, 7.622, 7.711, 8.491, 0, 24000, 0], [8, 0, 8.622, 8.708, 9.425, 0, 24000, 0], [9, 0, 9.622, 9.708, 10.401, 0, 24000, 0], [10, 0, 10.622, 10.711, 11.558, 0, 24000, 0], [11, 0, 11.622, 11.7