0, 0], [8, 0, 8.469, 8.527, 8.994, 0, 24000, 0], [9, 0, 9.469, 9.526, 10.034, 0, 24000, 0], [10, 0, 10.469, 10.523, 11.012, 0, 24000, 0], [11, 0, 11.469, 11.523, 11.989, 0, 24000, 0], [12, 0, 12.469, 12.524, 13.04, 0, 24000, 0], [13, 0, 13.469, 13.522, 14.075, 0, 24000, 0], [14, 0, 14.469, 14.525, 15.084, 0, 24000, 0], [15, 0, 15.469, 15.524, 16.056, 0, 24000, 0], [16, 0, 16.469, 16.53, 17.039, 0, 24000, 0], [17, 0, 17.469, 17.525, 18.022, 0, 24000, 0], [18, 0, 18.469, 18.525, 19.04, 0, 24000, 0], [19, 0, 19.469, 19.526, 20.105, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 4.469, "last_real_feed_done": 4.522, "onset": 5.094, "gate_read_done": 5.094, "fire": null, "candidate_first_pcm": null, "stall_note": null, "stall_first_pcm": null, "local_first_pcm": 5.094, "wait_start": null, "expert_req": null, "expert_resp": null, "relay_synth_start": null, "relay_first_pcm": null, "relay_synth_end": null, "first_any_pcm": 5.094, "first_answer_pcm": 5.094, "session_end": 20.105}, "ttfa_answer_s": 0.625, "ttfa_any_s": 0.625}
{"id": "striviaqa0043", "pool": "striviaqa", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3098483053, "protocol": "ttfa-v3", "config_sha256": "36fb1f5a6d3150bc9e2924638613014e95b57ee10045021a2cba34cf44c19605", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What in the human body are enclosed in the Pleura ?", "input_path": "/data/bench_audio/striviaqa0043.wav", "input_sha256": "ab7b7f9f965aec6f0351871359de79c29f89c001da790d653132572cacb815f9", "input_samples": 60028, "input_s": 3.752, "n_real_chunks": 4, "score": 0.219, "act": 0.9997, "is_info": true, "fired": false, "mode": "local", "answer": "The pleura are thin membranes that enc lose the lungs and line the thoracic cavity. They form a double-layered sac around each lung, with one layer attached to the lung s themselves and the other lining the chest wall. Between these two layers is a small amount of fluid that helps reduce friction as the lungs move during breathing. So, what's enclosed in the ple ura? Prim arily, it' s the lungs themselves, which are surrounded by this protective membrane system.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 27, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/striviaqa/audio/striviaqa0043_aggressive_local.wav", "sha256": "b579552fb8b974a0d64d26eed89ba350d787d24a204c84ef0798451d9ac1a385", "sr": 24000, "seconds": 26.44}}, "chunks": [[0, 1, 1.0, 1.051, 1.092, 1, 0, 0], [1, 1, 2.0, 2.052, 2.093, 1, 0, 0], [2, 1, 3.0, 3.052, 3.092, 1, 0, 0], [3, 1, 3.752, 3.804, 3.846, 1, 0, 0], [4, 0, 4.752