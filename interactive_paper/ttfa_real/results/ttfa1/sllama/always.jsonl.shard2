{"id": "sllama0166", "pool": "sllama", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 122628782, "protocol": "ttfa-v3", "config_sha256": "41a5db294317f43671e96d4157e9209f1111c47f4a217fdcbe5e389282f03cfe", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 2, "query": "How many gods are worshipped in Hinduism?", "input_path": "/data/bench_audio/sllama0166.wav", "input_sha256": "5f2772fd3a4fbcdee3c788aa4fa7e0d66885deedcc8b60820a2a6f0a6e436d9b", "input_samples": 43346, "input_s": 2.709, "n_real_chunks": 3, "score": 0.2219, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "There isn’t a single fixed number. Hinduism is often said to have 33 crore gods — commonly translated as 330 million — but many scholars note that older texts refer to 33 “koti”, which can mean 33 types/classes of deities. In practice, Hindu traditions worship one Supreme Reality in many forms, along with many gods and goddesses such as Brahma, Vishnu, Shiva, Lakshmi, Saraswati, Durga, Ganesha, and others.", "expert_answer": "There isn’t a single fixed number.\n\nHinduism is often said to have **33 crore** gods — commonly translated as **330 million** — but many scholars note that older texts refer to **33 “koti”**, which can mean **33 types/classes** of deities.\n\nIn practice, Hindu traditions worship **one Supreme Reality** in many forms, along with many gods and goddesses such as **Brahma, Vishnu, Shiva, Lakshmi, Saraswati, Durga, Ganesha**, and others.", "transcript": "How many gods are worshipped in Hinduism?\n", "asr_s": 0.45, "expert_s": 3.67, "expert_input_samples": 43346, "expert_input_s": 2.709, "expert_input_sha256": "5f2772fd3a4fbcdee3c788aa4fa7e0d66885deedcc8b60820a2a6f0a6e436d9b", "expert_timed_out": false, "wait_s": 3.585, "relay_synth_ms": 20568, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0166_always_relay.wav", "sha256": "9af0c9189fdccaf1c715f988a8b4b2dbe6fa7c7c1389c6e54dbf0388d3d74729", "sr": 24000, "seconds": 29.52}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0166_always_candidate.wav", "sha256": "8c2711bea095ef8e39fa21b3443c5592461da14df271f7930d424e21830a7984", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0166_always_stall.wav", "sha256": "ed2ae451a843e6e94a4ef23b3519429aad0f9b67a707776b139a416549a762ce", "sr": 24000, "seconds": 0.52}}, "chunks": [[0, 1, 1.0, 1.081, 1.15, 1, 0, 0], [1, 1, 2.0, 2.084, 2.15, 1, 0, 0], [2, 1, 2.709, 2.79, 2.853, 1, 0, 0], [3, 0, 3.709, 3.795, 4.68, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.709, "last_real_feed_done": 2.79, "onset": 4.68, "gate_read_done": 4.68, "fire": 4.68, "candidate_first_pcm": 4.68, "stall_note": 4.681, "stall_first_pcm": 5.211, "local_first_pcm": null, "wait_start": 5.211, "expert_req": 4.681, "expert_resp": 8.796, "relay_synth_start": 8.796, "relay_first_pcm": 9.784, "relay_synth_end": 29.365, "first_any_pcm": 4.68, "first_answer_pcm": 9.784, "session_end": 29.597}, "ttfa_answer_s": 7.075, "ttfa_any_s": 1.971}
