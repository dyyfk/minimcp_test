{"id": "sllama0112", "pool": "sllama", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1331918960, "protocol": "ttfa-v3", "config_sha256": "25e6887f8551649e559d24b54bbd2fe07f238cfc4d1ce1fc5ff87b67005b2d8d", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What is the bright object in the night sky that is not a star?", "input_path": "/data/bench_audio/sllama0112.wav", "input_sha256": "dcf379c5158a0303e07e3a6bc744b9e9ac93c339d6c44d61b4644f708d13e5d9", "input_samples": 65346, "input_s": 4.084, "n_real_chunks": 5, "score": 0.7046, "act": 0.9999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The bright object in the night sky that is not a star is usually a planet—most often Venus, which is commonly called the “Morning Star” or “Evening Star.”", "expert_answer": "The bright object in the night sky that is **not a star** is usually a **planet**—most often **Venus**, which is commonly called the **“Morning Star”** or **“Evening Star.”**", "transcript": "What is the bright object in the night sky that is not a star?\n", "asr_s": 0.79, "expert_s": 1.92, "expert_input_samples": 64000, "expert_input_s": 4.0, "expert_input_sha256": "3a0efde0aaa517c804a127753d8bb7714f82b2e889b39ff70f15dfd3f488dd58", "expert_timed_out": false, "wait_s": 1.657, "relay_synth_ms": 6211, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 1151, "feed_lag_sum_ms": 1151, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0112_aggressive_relay.wav", "sha256": "530d4d6ef2d06a6ec5977302ca02c390f3583721b9542d356de81199976b17b7", "sr": 24000, "seconds": 12.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0112_aggressive_candidate.wav", "sha256": "33d5f58b3dc8e66f251dfe798d705970e8be95fac89df9b5f4b73ad86608de7c", "