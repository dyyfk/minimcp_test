{"id": "sllama0031", "pool": "sllama", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3852345727, "protocol": "ttfa-v3", "config_sha256": "f40edaa94b82cc480a8162abcd570effa331c0a9b7ca31632511f1cd5b9e06ff", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "Which battle marked the end of the Napoleonic Wars? ", "input_path": "/data/bench_audio/sllama0031.wav", "input_sha256": "a9b69846a7b5503ef4ecf1772730208fbd68650ed594112a2ede03d927d1cf9c", "input_samples": 52754, "input_s": 3.297, "n_real_chunks": 4, "score": 0.0682, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The Battle of Waterloo marked the end of the Napoleonic Wars. It was fought on June 1 8, 181 5 in Belgium between the forces of Napoleon Bonaparte and a coalition led by the Duke of Well hang and the Prince Regent, later King George IV of England. Na pole on was decisively defeat ed there, which led to his exile on Saint Helena and effectively ended his rule over France and much of Europe. This battle sign ified the collapse of his empire and brought the long conflict known as the Napoleonic Wars to a close.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 27, "feed_lag_max_ms": 152, "feed_lag_sum_ms": 310, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0031_balanced_local.wav", "sha256": "72e2434a93abd5b8d4858e6130634cf0c0d4261e36d79eacb2545cba12a81116", "sr": 24000, "seconds": 27.28}}, "chunks": [[0, 1, 1.0, 1.086, 1.155, 1, 0, 0], [1, 1, 2.0, 2.081, 2.144, 1, 0, 0], [2, 1, 3.0, 3.084, 3.144, 1, 0, 0], [3, 1, 3.297, 3.37