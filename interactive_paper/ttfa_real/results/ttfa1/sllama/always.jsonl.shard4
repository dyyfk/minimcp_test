{"id": "sllama0164", "pool": "sllama", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3913370498, "protocol": "ttfa-v3", "config_sha256": "41a5db294317f43671e96d4157e9209f1111c47f4a217fdcbe5e389282f03cfe", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 4, "query": "How many gurus are there in Sikhism?", "input_path": "/data/bench_audio/sllama0164.wav", "input_sha256": "598fb938790be51b72d4a004b712f3cb52fa3ab12a4eaa51f67881d22dfb2ed5", "input_samples": 40332, "input_s": 2.521, "n_real_chunks": 3, "score": 0.6587, "act": 0.999, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "There are 10 human Gurus in Sikhism. Sikhs also regard the Guru Granth Sahib — the holy scripture — as the eternal Guru, making it the continuing spiritual authority after the tenth human Guru.", "expert_answer": "There are **10 human Gurus** in Sikhism.\n\nSikhs also regard the **Guru Granth Sahib** — the holy scripture — as the **eternal Guru**, making it the continuing spiritual authority after the tenth human Guru.", "transcript": "How many gurus are there in Sikhism?\n", "asr_s": 0.63, "expert_s": 1.84, "expert_input_samples": 40332, "expert_input_s": 2.521, "expert_input_sha256": "598fb938790be51b72d4a004b712f3cb52fa3ab12a4eaa51f67881d22dfb2ed5", "expert_timed_out": false, "wait_s": 1.502, "relay_synth_ms": 5852, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 1, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0164_always_relay.wav", "sha256": "dcdbd4aa8b948181deff47970932723f2bece98be4e76c4e204265beb9dd6b14", "sr": 24000, "seconds": 13.32}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0164_always_candidate.wav", "sha256": "950a4197f0693b53f26219816f5811ebfbe59fd4e1d59cd264e7161131b44dc4", "sr": 24000, "s