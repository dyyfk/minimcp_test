{"id": "sllama0109", "pool": "sllama", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3249180857, "protocol": "ttfa-v3", "config_sha256": "25e6887f8551649e559d24b54bbd2fe07f238cfc4d1ce1fc5ff87b67005b2d8d", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "Where do hobbits live?", "input_path": "/data/bench_audio/sllama0109.wav", "input_sha256": "d1725d329b6698865438d4779bfdb6a981f5d5b0d7e42479d2d068c7725a8795", "input_samples": 23897, "input_s": 1.494, "n_real_chunks": 2, "score": 0.2537, "act": 0.9984, "is_info": true, "fired": false, "mode": "local", "answer": "Hobbits live in the Shire, which is a peaceful and green region in Middle Earth. They typically reside in cozy little holes or dwellings dug into hillsides called hobbit-holes. These homes are often decorated with beautiful gardens, comfortable furniture, and warm lighting, making them perfect for their love of simple living and comfort.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 5, "eot_seen": true, "n_speak_chunks": 20, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0109_aggressive_local.wav", "sha256": "fb871305adc786bddaa87b8f0b4b33ff20dc5c67bb78d8a27c423b44908a89a7", "sr": 24000, "seconds": 19.92}}, "chunks": [[0, 1, 1.0, 1.075, 1.137, 1, 0, 0], [1, 1, 1.494, 1.571, 1.633, 1, 0, 0], [2, 0, 2.494, 2.571, 2.638, 1, 0, 0], [3, 0, 3.494, 3.57, 3.634, 1, 0, 0], [4, 0, 4.494, 4.574, 4.64, 1, 0, 0], [5, 0, 5.494, 5.573, 6.463, 0, 24000, 0], [6, 0, 6.494, 6.571, 7.355, 0, 24000, 0], [7, 0, 7.494, 7.571, 8.249, 0, 24000, 0], [8, 0, 8.494, 8.