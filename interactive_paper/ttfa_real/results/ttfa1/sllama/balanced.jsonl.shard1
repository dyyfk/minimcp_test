{"id": "sllama0122", "pool": "sllama", "arm": "balanced", "tier": "balanced", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1682844595, "protocol": "ttfa-v3", "config_sha256": "f40edaa94b82cc480a8162abcd570effa331c0a9b7ca31632511f1cd5b9e06ff", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.7972545623779297, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "Which bone is the only one that cannot be directly moved?", "input_path": "/data/bench_audio/sllama0122.wav", "input_sha256": "366fefff3d1a62c151ee1a79fe0bd21648eb987b55d94ad6a31093376ecca085", "input_samples": 59320, "input_s": 3.708, "n_real_chunks": 4, "score": 0.5431, "act": 0.9995, "is_info": true, "fired": false, "mode": "local", "answer": "The bone that cannot be directly moved is the hyoid bone. It' s located in the neck, just below the chin. Unlike other bones, it doesn't attach to any muscles or ligaments from the outside of the body. Instead, it's connected only to muscles inside the mouth and throat. This means you can't move it directly with your hands or muscles on the surface.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 21, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0122_balanced_local.wav", "sha256": "93d0cb1e1e367a39dda3ed77892f04c43a6ebf720330797a2541aba889000685", "sr": 24000, "seconds": 20.8}}, "chunks": [[0, 1, 1.0, 1.056, 1.1, 1, 0, 0], [1, 1, 2.0, 2.055, 2.099, 1, 0, 0], [2, 1, 3.0, 3.056, 3.1, 1, 0, 0], [3, 1, 3.708, 3.763, 3.809, 1, 0, 0], [4, 0, 4.707, 4.764, 5.259, 0, 24000, 0], [5, 0, 5.707, 5.765, 6.265, 0, 24000, 0], [6, 0, 6.707, 6.764, 7.264, 0, 24000, 0], [7, 0, 7.707, 7.764,