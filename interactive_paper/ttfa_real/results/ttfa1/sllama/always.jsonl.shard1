{"id": "sllama0206", "pool": "sllama", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1397961585, "protocol": "ttfa-v3", "config_sha256": "41a5db294317f43671e96d4157e9209f1111c47f4a217fdcbe5e389282f03cfe", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 1, "query": "How many senses do humans have? ", "input_path": "/data/bench_audio/sllama0206.wav", "input_sha256": "5c4e7826c17169fa6a9f3240adcf4e4dce07095eca6df54a91f03b5308abdcc3", "input_samples": 37468, "input_s": 2.342, "n_real_chunks": 3, "score": 0.3818, "act": 0.9984, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "Humans have more than the traditional five senses. The classic five are sight, hearing, smell, taste, and touch, but humans also have senses such as: Balance — vestibular sense , Body position — proprioception , Temperature — thermoception , Pain — nociception , Internal body signals — interoception, such as hunger, thirst, heartbeat, and bladder fullness Depending on how “sense” is defined, humans are often said to have around 9 to 20+ senses, rather than just five.", "expert_answer": "Humans have **more than the traditional five senses**.\n\nThe classic five are **sight, hearing, smell, taste, and touch**, but humans also have senses such as:\n\n- **Balance** — vestibular sense  \n- **Body position** — proprioception  \n- **Temperature** — thermoception  \n- **Pain** — nociception  \n- **Internal body signals** — interoception, such as hunger, thirst, heartbeat, and bladder fullness  \n\nDepending on how “sense” is defined, humans are often said to have **around 9 to 20+ senses**, rather than just five.", "transcript": "How many senses do humans have?\n", "asr_s": 0.62, "expert_s": 2.87, "expert_input_samples": 37468, "expert_input_s": 2.342, "expert_input_sha256": "5c4e7826c17169fa6a9f3240adcf4e4dce07095eca6df54a91f03b5308abdcc3", "expert_timed_out": false, "wait_s": 0.0, "relay_synth_ms": 23017, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 5, "feed_lag_max_ms": 1181, "feed_lag_sum_ms": 4405, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0206_always_relay.wav", "sha256": "65122e6b5612d1dd1a198312ed19ff97ffd3665d80d0c6caa0ed6e364b1f039a", "sr": 24000, "seconds": 35.04}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0206_always_candidate.wav", "sha256": "15a62875070346873d76a09a1ce8fc46c2ea7a0ee5925730b8caff440d30bcd7", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0206_always_stall.wav", "sha256": "ef0400827891fdc9ad7bdeea2d2c6cd91c762b75b9635e83e22015757d125d91", "sr": 24000, "seconds": 6.28}}, "chunks": [[0, 1, 1.0, 1.083, 1.149, 1, 0, 0], [1, 1, 2.0, 2.087, 2.154, 1, 0, 0], [2, 1, 2.342, 2.422, 2.487, 1, 0, 0], [3, 0, 3.342, 3.424, 4.201, 0, 24000, 0], [4, 0, 4.342, 5.601, 6.349, 0, 24000, 0], [5, 0, 5.342, 6.436, 7.201, 0, 24000, 0], [6, 0, 6.342, 7.336, 8.092, 0, 24000, 0], [7, 0, 7.342, 8.19, 8.949, 0, 24000, 0], [8, 0, 8.342, 9.043, 9.894, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 2.342, "last_real_feed_done": 2.422, "onset": 4.201, "gate_read_done": 4.201, "fire": 4.201, "candidate_first_pcm": 4.201, "stall_note": 4.202, "stall_first_pcm": 5.523, "local_first_pcm": null, "wait_start": 9.894, "expert_req": 4.202, "expert_resp": 7.693, "relay_synth_start": 9.894, "relay_first_pcm": 10.778, "relay_synth_end": 32.912, "first_any_pcm": 4.201, "first_answer_pcm": 10.778, "session_end": 33.772}, "ttfa_answer_s": 8.436, "ttfa_any_s": 1.859}
