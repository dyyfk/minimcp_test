{"id": "sllama0164", "pool": "sllama", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3913370498, "protocol": "ttfa-v3", "config_sha256": "25e6887f8551649e559d24b54bbd2fe07f238cfc4d1ce1fc5ff87b67005b2d8d", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H200", "host": "modal", "shard": 4, "query": "How many gurus are there in Sikhism?", "input_path": "/data/bench_audio/sllama0164.wav", "input_sha256": "598fb938790be51b72d4a004b712f3cb52fa3ab12a4eaa51f67881d22dfb2ed5", "input_samples": 40332, "input_s": 2.521, "n_real_chunks": 3, "score": 0.7257, "act": 0.9991, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "There are 10 human Gurus in Sikhism. After the tenth Guru, Guru Gobind Singh, the Guru Granth Sahib—the Sikh holy scripture—was established as the eternal Guru.", "expert_answer": "There are **10 human Gurus** in Sikhism.\n\nAfter the tenth Guru, **Guru Gobind Singh**, the **Guru Granth Sahib**—the Sikh holy scripture—was established as the eternal Guru.", "transcript": "How many gurus are there in Sikhism?\n", "asr_s": 1.3, "expert_s": 2.75, "expert_input_samples": 40332, "expert_input_s": 2.521, "expert_input_sha256": "598fb938790be51b72d4a004b712f3cb52fa3ab12a4eaa51f67881d22dfb2ed5", "expert_timed_out": false, "wait_s": 2.711, "relay_synth_ms": 7474, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 1, "feed_lag_max_ms": 525, "feed_lag_sum_ms": 525, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0164_aggressive_relay.wav", "sha256": "183e34661a2363e478a8e790536dadbbe4d92e01651fe5805ee47b0e63482755", "sr": 24000, "seconds": 10.88}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0164_aggressive_candidate.wav", "sha256": "974d0a6dfe2c8ad1917f09943f7671dfa358b7a53e57530ba39228ffd576e8ff", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttf