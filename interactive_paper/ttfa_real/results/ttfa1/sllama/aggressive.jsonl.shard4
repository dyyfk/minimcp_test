{"id": "sllama0175", "pool": "sllama", "arm": "aggressive", "tier": "aggressive", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 2271038037, "protocol": "ttfa-v3", "config_sha256": "25e6887f8551649e559d24b54bbd2fe07f238cfc4d1ce1fc5ff87b67005b2d8d", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.5533501505851746, "gpu": "NVIDIA H200", "host": "modal", "shard": 4, "query": "Who was the youngest President of the United States?", "input_path": "/data/bench_audio/sllama0175.wav", "input_sha256": "dfd14c79d0ec3177071b7bd0036ecf006e81921c134c67610463c9b8d13d7164", "input_samples": 48448, "input_s": 3.028, "n_real_chunks": 4, "score": 0.5352, "act": 0.9998, "is_info": true, "fired": false, "mode": "local", "answer": "The youngest president of the United States was Theodore Roosevelt. He became president when he was 42 years old.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 8, "feed_lag_max_ms": 132, "feed_lag_sum_ms": 164, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0175_aggressive_local.wav", "sha256": "5aa632d04d860bfd3724660a492bb4d7439888972792fee722a7d97768cb2582", "sr": 24000, "seconds": 7.36}}, "chunks": [[0, 1, 1.0, 1.096, 1.167, 1, 0, 0], [1, 1, 2.0, 2.147, 2.217, 1, 0, 0], [2, 1, 3.0, 3.093, 3.161, 1, 0, 0], [3, 1, 3.028, 3.241, 4.06, 0, 24000, 0], [4, 0, 4.028, 4.143, 4.937, 0, 24000, 0], [5, 0, 5.028, 5.137, 5.923, 0, 24000, 0], [6, 0, 6.028, 6.126, 6.865, 0, 24000, 0], [7, 0, 7.028, 7.108, 7.737, 0, 24000, 0], [8, 0, 8.028, 8.116, 8.925, 0, 24000, 0], [9, 0, 9.028, 9.12, 9.877, 0, 24000, 0], [10, 0, 10.028, 10.123, 10.501, 0, 8640, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.028, "l