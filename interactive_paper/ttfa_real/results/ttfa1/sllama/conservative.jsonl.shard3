{"id": "sllama0011", "pool": "sllama", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3618128893, "protocol": "ttfa-v3", "config_sha256": "15c31db558d31130bad927da8501c9639532be3c233f5ad0ee63d4e7986703bc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 3, "query": "What was the name of the ship that the Pilgrims sailed on to come to America?", "input_path": "/data/bench_audio/sllama0011.wav", "input_sha256": "d95d0f9a3b57d266564cf2f0b4d5b7b25b1b7b584e32659fd9a0b1ad94295049", "input_samples": 72677, "input_s": 4.542, "n_real_chunks": 5, "score": 0.4259, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The ship that the Pilgrims sailed on to come to America was called the May flower. It' s a very famous name, and it's remembered for bringing those early English settlers to what is now Plymouth, Massachusetts. So, the Mayflower.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 4, "eot_seen": true, "n_speak_chunks": 13, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0011_conservative_local.wav", "sha256": "692542e0781fd7e4592e059aea91b6c39c1a81f897e6462928a8ec97c7ef9002", "sr": 24000, "seconds": 13.08}}, "chunks": [[0, 1, 1.0, 1.053, 1.095, 1, 0, 0], [1, 1, 2.0, 2.056, 2.099, 1, 0, 0], [2, 1, 3.0, 3.053, 3.096, 1, 0, 0], [3, 1, 4.0, 4.057, 4.104, 1, 0, 0], [4, 1, 4.542, 4.6, 5.042, 0, 24000, 0], [5, 0, 5.542, 5.598, 6.137, 0, 24000, 0], [6, 0, 6.542, 6.598, 7.142, 0, 24000, 0], [7, 0, 7.542, 7.596, 8.09, 0, 24000, 0], [8, 0, 8.542, 8.596, 9.091, 0, 24000, 0], [9, 0, 9.542, 9.598, 10.16