{"id": "sllama0248", "pool": "sllama", "arm": "conservative", "tier": "conservative", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 3498564466, "protocol": "ttfa-v3", "config_sha256": "15c31db558d31130bad927da8501c9639532be3c233f5ad0ee63d4e7986703bc", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": 0.9057239890098572, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 7, "query": "What was the name of the treaty that ended World War I?", "input_path": "/data/bench_audio/sllama0248.wav", "input_sha256": "954392c34093ec0495216a7b953e35726af6169e7f5fad92684b2be2190533bd", "input_samples": 61818, "input_s": 3.864, "n_real_chunks": 4, "score": 0.1929, "act": 0.9999, "is_info": true, "fired": false, "mode": "local", "answer": "The Treaty of Versailles ended World War I. It was signed in 19 19, after the war ended in 1918. This treaty officially marked the end of the conflict and imposed terms on Germany, including financial responsibility for the war and limits on its military.", "relay_text": "", "expert_answer": "", "transcript": "", "asr_s": null, "expert_s": null, "expert_input_samples": null, "expert_input_s": null, "expert_input_sha256": null, "expert_timed_out": false, "wait_s": null, "relay_synth_ms": null, "onset_chunk": 3, "eot_seen": true, "n_speak_chunks": 17, "feed_lag_max_ms": 0, "feed_lag_sum_ms": 0, "audio_files": {"local": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0248_conservative_local.wav", "sha256": "9eb2d90cc9d24bc70e384916c8f3e00b5c31dd18b848872d547d793698a52518", "sr": 24000, "seconds": 17.28}}, "chunks": [[0, 1, 1.0, 1.084, 1.153, 1, 0, 0], [1, 1, 2.0, 2.087, 2.16, 1, 0, 0], [2, 1, 3.0, 3.086, 3.157, 1, 0, 0], [3, 1, 3.864, 3.949, 4.821, 0, 24000, 0], [4, 0, 4.864, 4.95, 5.716, 0, 24000, 0], [5, 0, 5.864, 5.95, 6.723, 0, 24000, 0], [6, 0, 6.864, 6.949, 7.724, 0, 24000, 0], [7, 0, 7.864, 7.953, 8.737, 0, 24000, 0], [8, 0, 8.864, 8.95, 9.822, 0, 24000, 0], [9, 0, 9.864, 9.9