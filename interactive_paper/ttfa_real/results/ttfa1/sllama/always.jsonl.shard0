 3.053, 3.095, 1, 0, 0], [3, 1, 3.103, 3.157, 3.711, 0, 24000, 0], [4, 0, 4.103, 4.249, 4.712, 0, 24000, 0], [5, 0, 5.103, 5.157, 5.751, 0, 30720, 1]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.103, "last_real_feed_done": 3.157, "onset": 3.711, "gate_read_done": 3.712, "fire": 3.712, "candidate_first_pcm": 3.711, "stall_note": 3.712, "stall_first_pcm": 4.194, "local_first_pcm": null, "wait_start": 5.751, "expert_req": 3.712, "expert_resp": 5.703, "relay_synth_start": 5.751, "relay_first_pcm": 6.31, "relay_synth_end": 6.917, "first_any_pcm": 3.711, "first_answer_pcm": 6.31, "session_end": 7.017}, "ttfa_answer_s": 3.208, "ttfa_any_s": 0.609}
{"id": "sllama0126", "pool": "sllama", "arm": "always", "tier": "always", "lang": "en", "run_id": "ttfa1", "attempt": 1, "seed": 1663299498, "protocol": "ttfa-v3", "config_sha256": "41a5db294317f43671e96d4157e9209f1111c47f4a217fdcbe5e389282f03cfe", "gate_art_sha256": "0e6494c2eeac9bcd86c10b5def3cbd32e98bb0765fa2fd8afc8c1b47915ea372", "threshold": null, "gpu": "NVIDIA H100 80GB HBM3", "host": "modal", "shard": 0, "query": "What is the most watched sports event in the world?", "input_path": "/data/bench_audio/sllama0126.wav", "input_sha256": "e8c9be65ef3922c0174d458212a105683a9ef0fe44a071327493ae193dc01fee", "input_samples": 48163, "input_s": 3.01, "n_real_chunks": 4, "score": 0.5436, "act": 0.9998, "is_info": true, "fired": true, "mode": "escalated", "answer": "", "relay_text": "The FIFA World Cup is generally considered the most watched sports event in the world. , As a tournament, the FIFA World Cup draws the largest global audience. , As a single game, the FIFA World Cup Final is usually cited as the most-watched sporting event; for example, FIFA reported the 2022 final reached about 1.42 billion viewers. (inside.fifa.com) The Olympic Games are also among the biggest globally, but the World Cup is most often ranked No. 1 for worldwide sports viewership.", "expert_answer": "The **FIFA World Cup** is generally considered the **most watched sports event in the world**.\n\n- As a **tournament**, the FIFA World Cup draws the largest global audience.\n- As a **single game**, the **FIFA World Cup Final** is usually cited as the most-watched sporting event; for example, FIFA reported the **2022 final** reached about **1.42 billion viewers**. ([inside.fifa.com](https://inside.fifa.com/organisation/news/reports-detail-record-global-audience-figures-and-positive-sustainability-outcomes-fifa-world-cup-qatar?utm_source=openai))\n\nThe **Olympic Games** are also among the biggest globally, but the World Cup is most often ranked No. 1 for worldwide sports viewership.", "transcript": "What is the most watched sports event in the world?\n", "asr_s": 0.58, "expert_s": 5.32, "expert_input_samples": 48163, "expert_input_s": 3.01, "expert_input_sha256": "e8c9be65ef3922c0174d458212a105683a9ef0fe44a071327493ae193dc01fee", "expert_timed_out": false, "wait_s": 5.282, "relay_synth_ms": 12304, "onset_chunk": 3, "eot_seen": false, "n_speak_chunks": 0, "feed_lag_max_ms": 83, "feed_lag_sum_ms": 83, "audio_files": {"relay": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0126_always_relay.wav", "sha256": "c1df8be46f1e78f67e8f3edaf88a34b77f9cd008178715f08bc4a1736c81a95e", "sr": 24000, "seconds": 29.24}, "candidate": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0126_always_candidate.wav", "sha256": "db16c62aaee471d71d5949e2952028ad75d97613b1d15cb2d11a4cae399ed5d7", "sr": 24000, "seconds": 1.0}, "stall": {"path": "/data/ttfa_real/ttfa1/sllama/audio/sllama0126_always_stall.wav", "sha256": "8cdcb9e568ccd3eb46db67915fa45df6ca06a79eafbed7df6961cfdc5fcfc5c4", "sr": 24000, "seconds": 1.28}}, "chunks": [[0, 1, 1.0, 1.055, 1.1, 1, 0, 0], [1, 1, 2.0, 2.053, 2.094, 1, 0, 0], [2, 1, 3.0, 3.052, 3.093, 1, 0, 0], [3, 1, 3.01, 3.143, 3.633, 0, 24000, 0]], "status": "completed", "error": null, "ts": {"feed_start": 0.0, "input_end": 3.01, "last_real_feed_done": 3.143, "onset": 3.633, "gate_read_done": 3.633, "fire": 3.633, "candidate_first_pcm": 3.633, "stall_note": 3.634, "stall_first_pcm": 4.244, "local_first_pcm": null, "wait_start": 4.244, "expert_req": 3.634, "expert_resp": 9.526, "relay_synth_start": 9.527, "relay_first_pcm": 10.108, "relay_synth_end": 21.832, "first_any_pcm": 3.633, "first_answer_pcm": 10.108, "session_end": 22.001}, "ttfa_answer_s": 7.098, "ttfa_any_s": 0.623}
