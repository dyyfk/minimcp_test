\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Primary turn-based system.} \textbf  {(1)} Speech reaches a duplex-trained local model. \textbf  {(2)} At the end of the user turn, a mid-network (L22) linear read scores the turn in $\sim $30\,ms, before the first output token. \textbf  {(3)} Lower-risk turns stay local; higher-risk turns are sent to a cloud expert. \textbf  {(4)} The local model remains the talker and relays the returned answer. Deployed-channel accuracy rises from 42.2\% to 63.3\% at 57\% escalation in the audio-input/text-output sweep; a TTS-on replay validates the speech path separately.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:hero}{{1}{2}{\textbf {Primary turn-based system.} \textbf {(1)} Speech reaches a duplex-trained local model. \textbf {(2)} At the end of the user turn, a mid-network (L22) linear read scores the turn in $\sim $30\,ms, before the first output token. \textbf {(3)} Lower-risk turns stay local; higher-risk turns are sent to a cloud expert. \textbf {(4)} The local model remains the talker and relays the returned answer. Deployed-channel accuracy rises from 42.2\% to 63.3\% at 57\% escalation in the audio-input/text-output sweep; a TTS-on replay validates the speech path separately}{figure.1}{}}
