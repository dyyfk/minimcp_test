\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Accuracy gains and timing costs on three pools.} Left: observed mean answer-content accuracy against realized expert call rate; C/B/A denote conservative/balanced/aggressive. The dashed line uses the original Table~\ref {tab:transfer} random-mixture convention (\S  \ref {sec:evalproto}). The horizontal always-arm reference passes through the measured always point; it is not an oracle bound. Right: mean, P50, and P95 of the reconstructed time to first audio on a log scale. L/W denote local/always. Each point uses the original recorded pass, with one run per query and arm; no repeated-run uncertainty is implied. Local rows end at answer-text completion and escalated rows when the relay waveform is synthesized; playback duration is excluded (\S  \ref {sec:evalproto}). All five external QA pools, including the weaker cases, appear in the upper block of Table~\ref {tab:transfer}.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:dualview}{{3}{7}{\textbf {Accuracy gains and timing costs on three pools.} Left: observed mean answer-content accuracy against realized expert call rate; C/B/A denote conservative/balanced/aggressive. The dashed line uses the original Table~\ref {tab:transfer} random-mixture convention (\S \ref {sec:evalproto}). The horizontal always-arm reference passes through the measured always point; it is not an oracle bound. Right: mean, P50, and P95 of the reconstructed time to first audio on a log scale. L/W denote local/always. Each point uses the original recorded pass, with one run per query and arm; no repeated-run uncertainty is implied. Local rows end at answer-text completion and escalated rows when the relay waveform is synthesized; playback duration is excluded (\S \ref {sec:evalproto}). All five external QA pools, including the weaker cases, appear in the upper block of Table~\ref {tab:transfer}}{figure.3}{}}
