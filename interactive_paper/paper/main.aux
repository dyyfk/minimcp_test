\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Main results: answer-content accuracy (\%).} Both blocks report the internal test set and four external English speech-QA pools; avg is the equal-pool external mean and $\Delta $ is its gain over always-local, computed before rounding. MiniCPM uses one recorded native session per query and arm, with fixed calibration thresholds. Matched random mixes its local and measured always arms at each pool's realized gate rate (Appendix\nobreakspace  {}\ref  {app:transferdetail}). NVDA uses native-frame replay with cached outcomes; its Internal column is a post-selection diagnostic. Replay details are in Appendix\nobreakspace  {}\ref  {app:nvda}.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:transfer}{{1}{5}{\textbf {Main results: answer-content accuracy (\%).} Both blocks report the internal test set and four external English speech-QA pools; avg is the equal-pool external mean and $\Delta $ is its gain over always-local, computed before rounding. MiniCPM uses one recorded native session per query and arm, with fixed calibration thresholds. Matched random mixes its local and measured always arms at each pool's realized gate rate (Appendix~\ref {app:transferdetail}). NVDA uses native-frame replay with cached outcomes; its Internal column is a post-selection diagnostic. Replay details are in Appendix~\ref {app:nvda}}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}External transfer and its limits}{5}{subsection.4.3}\protected@file@percent }
\newlabel{sec:transfer}{{4.3}{5}{External transfer and its limits}{subsection.4.3}{}}
\newlabel{sec:transfer-neg}{{4.3}{5}{External transfer and its limits}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Accuracy and independently measured TTFA on three pools.} Left: answer-content accuracy against expert call rate. Internal uses post-hoc weights of 0.25 for knowledge/math and 1 for other categories in both coordinates, retaining all 240 queries. Table\nobreakspace  {}\ref  {tab:transfer} retains original query weights; external curves are unweighted. C/B/A denote conservative/balanced/aggressive. The dashed line follows the table's random-mixture convention (\S  \ref  {sec:evalproto}); the horizontal reference is the measured always arm, not an oracle bound. Right: mean and P50 server TTFA from completed sessions in the independent \texttt  {ttfa-v3} run, with original query weights. TTFA is the nonnegative wait after input end until first answer PCM; early answers have zero wait. L/W denote local/always. Each query has one attempt per arm; candidate/stall audio and client playback are excluded. Timing-session answers are unjudged and do not establish the accuracy on the left. Internal counts and tails appear in Table\nobreakspace  {}\ref  {tab:latency}; Table\nobreakspace  {}\ref  {tab:transfer} covers all four external English speech-QA pools evaluated here.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:dualview}{{3}{6}{\textbf {Accuracy and independently measured TTFA on three pools.} Left: answer-content accuracy against expert call rate. Internal uses post-hoc weights of 0.25 for knowledge/math and 1 for other categories in both coordinates, retaining all 240 queries. Table~\ref {tab:transfer} retains original query weights; external curves are unweighted. C/B/A denote conservative/balanced/aggressive. The dashed line follows the table's random-mixture convention (\S \ref {sec:evalproto}); the horizontal reference is the measured always arm, not an oracle bound. Right: mean and P50 server TTFA from completed sessions in the independent \texttt {ttfa-v3} run, with original query weights. TTFA is the nonnegative wait after input end until first answer PCM; early answers have zero wait. L/W denote local/always. Each query has one attempt per arm; candidate/stall audio and client playback are excluded. Timing-session answers are unjudged and do not establish the accuracy on the left. Internal counts and tails appear in Table~\ref {tab:latency}; Table~\ref {tab:transfer} covers all four external English speech-QA pools evaluated here}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Aggregation improves failure prediction at L22.} Mean AUC across five external pools under leave-one-pool-out evaluation on one native audio batch. Gray bars read the latest tail state; blue bars concatenate that state with the tail mean and input mean (\S  \ref  {sec:readlocation}). Arrows indicate the aggregation gain at each layer; the horizontal line marks chance AUC of 0.5.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:native-ablation}{{4}{7}{\textbf {Aggregation improves failure prediction at L22.} Mean AUC across five external pools under leave-one-pool-out evaluation on one native audio batch. Gray bars read the latest tail state; blue bars concatenate that state with the tail mean and input mean (\S \ref {sec:readlocation}). Arrows indicate the aggregation gain at each layer; the horizontal line marks chance AUC of 0.5}{figure.4}{}}
