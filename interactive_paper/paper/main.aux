\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The deployed system.} \textbf  {(1)} Speech streams in 1\,s chunks into a full-duplex local model that decides for itself when to speak. \textbf  {(2)} At that speak commit, a mid-network (L22) linear read scores the turn in $\sim $30\,ms at answer onset; the triggering call may already return the first text unit. \textbf  {(3)} Lower-risk turns stay local; higher-risk turns are sent to a cloud expert while the talker stalls. \textbf  {(4)} The returned answer is spoken verbatim in the talker's own voice. Unweighted answer-content accuracy on the full 240-query internal test set rises from 40.8\% to 62.9\% at 51.7\% escalation (\S  \ref  {sec:evalproto}).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:hero}{{1}{2}{\textbf {The deployed system.} \textbf {(1)} Speech streams in 1\,s chunks into a full-duplex local model that decides for itself when to speak. \textbf {(2)} At that speak commit, a mid-network (L22) linear read scores the turn in $\sim $30\,ms at answer onset; the triggering call may already return the first text unit. \textbf {(3)} Lower-risk turns stay local; higher-risk turns are sent to a cloud expert while the talker stalls. \textbf {(4)} The returned answer is spoken verbatim in the talker's own voice. Unweighted answer-content accuracy on the full 240-query internal test set rises from 40.8\% to 62.9\% at 51.7\% escalation (\S \ref {sec:evalproto})}{figure.1}{}}
