\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Text-trained failure probes transfer to unseen human speech.} Left: text-trained probes are evaluated on TTS audio for the same 600 questions across four models; MiniCPM-o\nobreakspace  {}4.5 reaches 0.855 AUC at L22. Right: MiniCPM-o\nobreakspace  {}4.5 probes fitted on the calibration pool are evaluated on 200 query-disjoint SD-QA human recordings. The text-trained probe (blue) reaches 0.760 at L22 and peaks at 0.800 at L25; gray curves show audio-trained and text-target references. Both panels show relative depth, normalized by the total number of layers in each model.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:xmodal-transfer}{{5}{8}{\textbf {Text-trained failure probes transfer to unseen human speech.} Left: text-trained probes are evaluated on TTS audio for the same 600 questions across four models; MiniCPM-o~4.5 reaches 0.855 AUC at L22. Right: MiniCPM-o~4.5 probes fitted on the calibration pool are evaluated on 200 query-disjoint SD-QA human recordings. The text-trained probe (blue) reaches 0.760 at L22 and peaks at 0.800 at L25; gray curves show audio-trained and text-target references. Both panels show relative depth, normalized by the total number of layers in each model}{figure.5}{}}
